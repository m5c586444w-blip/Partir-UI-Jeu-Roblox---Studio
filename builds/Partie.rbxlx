      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">GoreConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/GoreConfig
-- Valeurs de la bible, section 11. Ne rien ajouter ici sans la bible.
-- Jalon J6 : seulement le ragdoll de la mort (7.3, 11.5). Les deux profils sont ajoutés au jalon J13.
local GoreConfig = {}

-- 11.5 : ragdoll : BallSocketConstraint sur les articulations à la mort ;
-- le corps passe ancré après 10 s immobile, pour économiser la physique
GoreConfig.Ragdoll = { AnchorAfterStill = 10 }

return GoreConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ItemConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/ItemConfig
-- Valeurs de la bible, sections 8 (intro), 8.1, 8.3 et 8.4. Ne rien ajouter ici sans la bible.
local ItemConfig = {}

-- 8 : inventaire
ItemConfig.QuickSlots = 4 -- 3 pour la Mécanicienne (PlayerConfig.Abilities.Mechanic)
ItemConfig.BagMaxWeight = 12 -- kg
ItemConfig.HeavyAbove = 5 -- kg : à deux mains, pas de course, pas d'arme

-- 16.3 : RE_PickupItem, distance ≤ 10 studs
ItemConfig.PickupDistance = 10

-- 8.1 : objets. weight en kg ; stack = pile ; uses = usages ; noise = rayon (studs)
-- duration = durée d'utilisation (s). Les effets sont appliqués par InventoryService.
ItemConfig.Items = {
	ITM_Flashlight = {
		name = "Lampe torche",
		weight = 0.4,
		stack = 1,
		noise = 8,
		light = { angle = 45, range = 120, batteryMinutes = 8, flickerBelow = 0.15 },
	},
	ITM_Headlamp = {
		name = "Lampe frontale",
		weight = 0.2,
		stack = 1,
		noise = 8,
		light = { angle = 45, range = 70, batteryMinutes = 10, handsFree = true, flickerBelow = 0.15 },
	},
	ITM_PowerLight = {
		name = "Lampe puissante",
		weight = 0.8,
		stack = 1,
		noise = 8,
