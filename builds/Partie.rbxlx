      <Item class="Folder" referent="160">
        <Properties>
          <string name="Name">Attacks</string>
        </Properties>
        <Item class="ModuleScript" referent="161">
          <Properties>
            <string name="Name">ATK_Charge</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Attacks/ATK_Charge (Partie)
-- Section 9.10 : Charge : départ à 15–40 studs, signal 0,8 s (cri + pas), 40 + à terre 2 s ; aussi la fausse charge de 9.6. Chaque attaque a un signal sonore avant les dégâts.
-- Dégâts × difficulté (5.4 : dégâts de la créature).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local A = CreatureConfig.Attacks.ATK_Charge
local Attack = {}

local function damageFactor(brain)
	return ActConfig.difficulty(brain.services.PartyLoaderService:GetMatchInfo().difficulty).creatureDamage
end

local function randomLimb()
	return PlayerConfig.Limbs[math.random(1, #PlayerConfig.Limbs)]
end

function Attack.canUse(brain, target)
	local d = brain:DistanceTo(target)
	return d >= A.minRange and d <= A.maxRange
end

-- fake = fausse charge (9.6, cran 7) : s'arrête à 4–8 studs, puis repart
function Attack.run(brain, target, fake)
	brain.ai.CreatureAnimator:PlaySoundAt(A.sound, brain:Position())
	brain.ai.CreatureAnimator:Play(brain.model, "ChargeStart")
	task.wait(A.signal)
	local intimidation = CreatureConfig.Intimidation
	local stopAt = if fake
		then intimidation.FakeChargeStopMin
			+ math.random() * (intimidation.FakeChargeStopMax - intimidation.FakeChargeStopMin)
		else CreatureConfig.Attacks.ATK_Strike.range / 2
	local started = os.clock()
	local limit = A.maxRange / CreatureConfig.Gaits.Sprint.speed * 2
	while os.clock() - started < limit do
		local root = Util.characterRoot(target)
		if root == nil or (brain.fleeUntil or 0) > os.clock() then
			return -- parade : fusée, lampe puissante, bombe anti-ours
		end
		brain:MoveTo(root.Position, "Sprint")
		if brain:DistanceTo(target) <= stopAt then
			break
		end
		task.wait(1 / CreatureConfig.Rates.Brain)
	end
	brain:Stop()
	if fake then
		brain.ai.CreatureAnimator:Play(brain.model, "ChargeStopBluff")
		return
	end
	if brain:DistanceTo(target) <= CreatureConfig.Attacks.ATK_Strike.range then
		brain.services.HealthService:Damage(target, "Torso", A.damage * damageFactor(brain), brain.model)
		local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.PlatformStand = true -- à terre 2 s (renversé)
			task.delay(A.knockdown, function()
				if not target:GetAttribute("isDowned") then
					humanoid.PlatformStand = false
				end
			end)
		end
	end
end

local _ = { damageFactor, randomLimb, Util, A }

return Attack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="162">
          <Properties>
            <string name="Name">ATK_Execution</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Attacks/ATK_Execution (Partie)
-- Section 9.10 : Mise à mort (Alpha, joueur à terre, profil Restricted seulement) : portée 3, signal 1,5 s ; noir à l'instant de la mort. Chaque attaque a un signal sonore avant les dégâts.
-- Dégâts × difficulté (5.4 : dégâts de la créature).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local A = CreatureConfig.Attacks.ATK_Execution
local Attack = {}

local function damageFactor(brain)
	return ActConfig.difficulty(brain.services.PartyLoaderService:GetMatchInfo().difficulty).creatureDamage
end

local function randomLimb()
	return PlayerConfig.Limbs[math.random(1, #PlayerConfig.Limbs)]
end

function Attack.canUse(brain, target)
	local profile = require(Config:WaitForChild("GoreConfig")).Profile
	return brain.id == A.creature
		and profile == A.profile
		and target:GetAttribute("isDowned") == true
		and brain:DistanceTo(target) <= A.range
end

function Attack.run(brain, target)
	brain.ai.CreatureAnimator:Play(brain.model, "Execution")
	task.wait(A.signal)
	if target:GetAttribute("isDowned") and brain:DistanceTo(target) <= A.range then
		target:SetAttribute("blackoutAt", workspace:GetServerTimeNow()) -- 11.2 : noir à l'instant de la mort
		brain.services.HealthService:Kill(target, "Execution")
	end
end

local _ = { damageFactor, randomLimb, Util, A }

return Attack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="163">
          <Properties>
            <string name="Name">ATK_Grab</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Attacks/ATK_Grab (Partie)
-- Section 9.10 : Saisie : portée 6, signal 0,4 s ; 10/s tant que tenu ; traîné après 3 s. Chaque attaque a un signal sonore avant les dégâts.
-- Dégâts × difficulté (5.4 : dégâts de la créature).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local A = CreatureConfig.Attacks.ATK_Grab
local Attack = {}

local function damageFactor(brain)
	return ActConfig.difficulty(brain.services.PartyLoaderService:GetMatchInfo().difficulty).creatureDamage
end

local function randomLimb()
	return PlayerConfig.Limbs[math.random(1, #PlayerConfig.Limbs)]
end

function Attack.canUse(brain, target)
	return brain:DistanceTo(target) <= A.range and target:GetAttribute("grabbedBy") == nil
end

function Attack.run(brain, target)
	brain.ai.CreatureAnimator:Play(brain.model, "Grab")
	task.wait(A.signal)
	if brain:DistanceTo(target) > A.range then
		return
	end
	target:SetAttribute("grabbedBy", brain.id)
	brain.grabbed = target
	brain.grabHits = 0
	local heldFor = 0
	local step = 1 / CreatureConfig.Rates.Brain
	-- parade : un coéquipier frappe (hache 1 coup, machette 2), bombe, tir (FamilyBrain relâche)
	while
		brain.grabbed == target
		and target:GetAttribute("grabbedBy") == brain.id
		and brain.services.HealthService:IsUp(target)
	do
		brain.services.HealthService:Damage(
			target,
			"Torso",
			A.damagePerSecond * step * damageFactor(brain),
			brain.model
		)
		heldFor += step
		-- 19.5 (C2) : saisie tenue plus de 2 s → hémorragie légère
		if heldFor > PlayerConfig.BleedOnDamage.GrabLightAfter then
			brain.services.HealthService:StartBleed(target, "Light")
		end
		if heldFor >= A.dragAfter then
			break -- BHV_Drag prend le relais
		end
		local root, creatureRoot = Util.characterRoot(target), brain.root
		if root and creatureRoot and brain:HasBody() then
			root.CFrame = creatureRoot.CFrame * CFrame.new(0, 0, -A.range / 2)
		end
		task.wait(step)
	end
	if brain.grabbed == target and heldFor < A.dragAfter then
		target:SetAttribute("grabbedBy", nil)
	end
	brain.grabbed = nil
end

local _ = { damageFactor, randomLimb, Util, A }

return Attack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="164">
          <Properties>
            <string name="Name">ATK_ReachThrough</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Attacks/ATK_ReachThrough (Partie)
-- Section 9.10 : Bras par une barricade cassée : 5 studs dans la cabane, signal 0,5 s, saisie ; parade : reclouer, hache. Chaque attaque a un signal sonore avant les dégâts.
-- Dégâts × difficulté (5.4 : dégâts de la créature).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local A = CreatureConfig.Attacks.ATK_ReachThrough
local Attack = {}

local function damageFactor(brain)
	return ActConfig.difficulty(brain.services.PartyLoaderService:GetMatchInfo().difficulty).creatureDamage
end

local function randomLimb()
	return PlayerConfig.Limbs[math.random(1, #PlayerConfig.Limbs)]
end

function Attack.canUse(_brain, target)
	return target:GetAttribute("grabbedBy") == nil
end

function Attack.run(brain, target)
	brain.ai.CreatureAnimator:Play(brain.model, "ReachThrough")
	task.wait(A.signal)
	-- la saisie elle-même suit les règles de ATK_Grab (10/s, parades)
	local grab = brain.attacks.ATK_Grab
	if grab then
		target:SetAttribute("grabbedBy", nil)
		grab.run(brain, target)
	end
end

local _ = { damageFactor, randomLimb, Util, A }

return Attack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="165">
          <Properties>
            <string name="Name">ATK_Slam</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Attacks/ATK_Slam (Partie)
-- Section 9.10 : Frappe au sol (joueur à terre) : portée 5, signal 1,0 s, 60 ; parade : relever le joueur avant. Chaque attaque a un signal sonore avant les dégâts.
-- Dégâts × difficulté (5.4 : dégâts de la créature).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local A = CreatureConfig.Attacks.ATK_Slam
local Attack = {}

local function damageFactor(brain)
	return ActConfig.difficulty(brain.services.PartyLoaderService:GetMatchInfo().difficulty).creatureDamage
end

local function randomLimb()
	return PlayerConfig.Limbs[math.random(1, #PlayerConfig.Limbs)]
end

function Attack.canUse(brain, target)
	return target:GetAttribute("isDowned") == true and brain:DistanceTo(target) <= A.range
end

function Attack.run(brain, target)
	brain.ai.CreatureAnimator:Play(brain.model, "Slam")
	brain.ai.CreatureAnimator:PlaySoundAt("SFX_Growl_Close", brain:Position())
	task.wait(A.signal)
	if target:GetAttribute("isDowned") and brain:DistanceTo(target) <= A.range then
		brain.services.HealthService:Damage(target, "Torso", A.damage * damageFactor(brain), brain.model)
	end
end

local _ = { damageFactor, randomLimb, Util, A }

return Attack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="166">
          <Properties>
            <string name="Name">ATK_Strike</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Attacks/ATK_Strike (Partie)
-- Section 9.10 : Coup : portée 7, signal 0,6 s (grognement), 35 sur un membre, recul. Chaque attaque a un signal sonore avant les dégâts.
-- Dégâts × difficulté (5.4 : dégâts de la créature).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local A = CreatureConfig.Attacks.ATK_Strike
local Attack = {}

local function damageFactor(brain)
	return ActConfig.difficulty(brain.services.PartyLoaderService:GetMatchInfo().difficulty).creatureDamage
end

local function randomLimb()
	return PlayerConfig.Limbs[math.random(1, #PlayerConfig.Limbs)]
end

function Attack.canUse(brain, target)
	return brain:DistanceTo(target) <= A.range
end

function Attack.run(brain, target)
	brain.ai.CreatureAnimator:PlaySoundAt(A.sound, brain:Position())
	brain.ai.CreatureAnimator:Play(brain.model, "StrikeLeft")
	task.wait(A.signal)
	if brain:DistanceTo(target) > A.range then
		return -- esquive
	end
	brain.services.HealthService:Damage(target, randomLimb(), A.damage * damageFactor(brain), brain.model)
	local root = Util.characterRoot(target)
	if root and A.knockback then
		local push = (root.Position - brain:Position()) * Vector3.new(1, 0, 1)
		if push.Magnitude > 0 then
			-- 19.6 (C30) : 40 studs/s vers l'arrière + 15 studs/s vers le haut
			root.AssemblyLinearVelocity += push.Unit * CreatureConfig.KnockbackForce + Vector3.new(
				0,
				CreatureConfig.KnockbackUp,
				0
			)
		end
	end
end

local _ = { damageFactor, randomLimb, Util, A }

return Attack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="167">
          <Properties>
            <string name="Name">ATK_Throw</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Attacks/ATK_Throw (Partie)
-- Section 9.10 : Pierre : 20–120 studs, signal = sifflement de la pierre, 15–30 ; parade : couvert. Chaque attaque a un signal sonore avant les dégâts.
-- Dégâts × difficulté (5.4 : dégâts de la créature).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local A = CreatureConfig.Attacks.ATK_Throw
local Attack = {}

local function damageFactor(brain)
	return ActConfig.difficulty(brain.services.PartyLoaderService:GetMatchInfo().difficulty).creatureDamage
end

-- 19.5 (C10) : erreur de visée = 3 % de la distance, réduite en Difficile et Cauchemar
local function aimError(brain, distance)
	local difficulty = brain.services.PartyLoaderService:GetMatchInfo().difficulty
	local radius = distance * A.aimError * (A.aimErrorFactor[difficulty] or 1)
	local angle = math.random() * math.pi * 2
	local r = radius * math.sqrt(math.random())
	return Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
end

local function randomLimb()
	return PlayerConfig.Limbs[math.random(1, #PlayerConfig.Limbs)]
end

-- cible : un joueur, ou une Part (planche d'une ouverture, lampe)
function Attack.canUse(brain, target)
	local position = if typeof(target) == "Instance" and target:IsA("Player")
		then (Util.characterRoot(target) and Util.characterRoot(target).Position)
		else target.Position
	if position == nil then
		return false
	end
	local d = (position - brain:Position()).Magnitude
	return d >= A.minRange and d <= A.maxRange or not target:IsA("Player")
end

function Attack.run(brain, target)
	local isPlayer = target:IsA("Player")
	local root = if isPlayer then Util.characterRoot(target) else target
	if root == nil then
		return
	end
	local from = brain:Position() + Vector3.new(0, brain.def.height, 0)
	local landing = root.Position
	if isPlayer then
		landing += aimError(brain, (landing - from).Magnitude)
	end
	brain.ai.CreatureAnimator:Play(brain.model, "ThrowOverhand")
	local flight = (landing - from).Magnitude / CreatureConfig.StoneSpeed
	-- signal : sifflement de la pierre, audible avant l'impact
	brain.ai.CreatureAnimator:PlaySoundAt(A.sound, landing)
	task.wait(flight)
	if not isPlayer then
		brain.services.GameStateService:HitBarricade(target)
		brain.services.NoiseService:Emit(
			landing,
			require(Config:WaitForChild("ItemConfig")).Items.ITM_Stone.impactNoise,
			"Impact",
			brain.model
		)
		return
	end
	-- la pierre file vers le point visé (au lâcher) : un joueur qui a bougé l'esquive ;
	-- couvert : un obstacle entre le point de lancer et la cible arrête la pierre
	local params = brain.ai.Perception:BodyParams(brain)
	local hit = workspace:Raycast(from, (landing - from).Unit * A.maxRange, params)
	if hit == nil or target.Character == nil or not hit.Instance:IsDescendantOf(target.Character) then
		return
	end
	local damage = A.damageMin + math.random() * (A.damageMax - A.damageMin)
	-- 19.5 (C2) : une pierre ne cause jamais d'hémorragie grave
	brain.services.HealthService:Damage(
		target,
		randomLimb(),
		damage * damageFactor(brain),
		brain.model,
		nil,
		PlayerConfig.BleedOnDamage.StoneMax,
		"Stone"
	)
end

local _ = { damageFactor, randomLimb, Util, A }

return Attack
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="168">
        <Properties>
          <string name="Name">Behaviors</string>
        </Properties>
        <Item class="ModuleScript" referent="169">
          <Properties>
            <string name="Name">BHV_Ambush</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Ambush (Partie)
-- Section 9.5 : Embuscade : objectif des joueurs connu ; attend à 20–30 studs du chemin probable (90 s max).
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Ambush
local Behavior = {}

local function objectivePoint()
	local state = Util.getMatchState()
	local route = state:GetAttribute("mainRoute")
	local routes = require(Config:WaitForChild("ActConfig")).Routes
	if route and routes[route] then
		return MapConfig.Places[routes[route].place].pos
	end
	if (state:GetAttribute("act") or 0) <= 1 then
		return MapConfig.Places.P05c.pos -- 5.2 : point de repli vers la cabane
	end
	return nil
end

function Behavior.score(brain)
	if brain.id == "CRT_Female" or brain.target == nil or objectivePoint() == nil then
		return 0
	end
	if os.clock() - (brain.lastAmbushAt or -math.huge) < B.maxDuration * 2 then
		return 0
	end
	return B.baseScore
end

function Behavior.start(brain)
	brain.lastAmbushAt = os.clock()
	local goal = objectivePoint()
	local root = Util.characterRoot(brain.target)
	if goal and root then
		-- sur le chemin probable : entre la cible et son objectif, à 20–30 studs de côté
		local mid = root.Position:Lerp(goal, 0.5)
		local side = (goal - root.Position):Cross(Vector3.yAxis)
		local offset = if side.Magnitude > 0 then side.Unit * (B.minDistance + B.maxDistance) / 2 else Vector3.zero
		brain:MoveTo(mid + offset, "Sneak")
	end
end

function Behavior.step(brain)
	if os.clock() - brain.behaviorStartedAt > B.maxDuration then
		brain.behaviorStartedAt = -math.huge -- fin de l'embuscade
		return
	end
	local t = brain.target
	if t and brain:DistanceTo(t) <= B.maxDistance and brain.ai.TensionDirector:AllowAttack(brain, t) then
		brain:Attack(
			if brain:DistanceTo(t) >= CreatureConfig.Attacks.ATK_Charge.minRange then "ATK_Charge" else "ATK_Strike",
			t
		)
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">BHV_Attack</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Attack (Partie)
-- Section 9.5 : Attaquer : cible isolée, directeur d'accord ; une attaque de la table 9.10.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Attack
local Behavior = {}

local Attacks = CreatureConfig.Attacks

-- 19.5 (J12) : attaque imposée par le directeur (prioritaire, sans durée minimale)
function Behavior.isUrgent(brain)
	return brain.id ~= "CRT_Female" and brain.ai.TensionDirector:ForcedAttack(brain)
end

function Behavior.score(brain)
	local t = brain.target
	if t == nil or brain.id == "CRT_Female" then
		return 0
	end
	if brain.ai.TensionDirector:ForcedAttack(brain) then
		return 1
	end
	if not brain.ai.TensionDirector:AllowAttack(brain, t) then
		return 0
	end
	local downed = t:GetAttribute("isDowned") == true
	if not downed and brain.ai.FamilyBrain:Isolation(t) < 1 and not brain.ai.TensionDirector:IsFinalAssault() then
		return 0
	end
	if (brain.vigilance[t] or 0) < CreatureConfig.Vision.TargetAt then
		return 0
	end
	return B.baseScore * brain.ai.FamilyBrain:AttackFactor(brain)
end

function Behavior.step(brain)
	local t = brain.target
	local root = t and Util.characterRoot(t)
	if root == nil then
		return
	end
	local distance = brain:DistanceTo(t)
	if t:GetAttribute("isDowned") then
		local profile = require(Config:WaitForChild("GoreConfig")).Profile
		if
			brain.id == Attacks.ATK_Execution.creature
			and profile == Attacks.ATK_Execution.profile
			and distance <= Attacks.ATK_Execution.range
		then
			brain:Attack("ATK_Execution", t)
		elseif distance <= Attacks.ATK_Slam.range then
			brain:Attack("ATK_Slam", t)
		end
	elseif distance <= Attacks.ATK_Grab.range then
		brain:Attack("ATK_Grab", t)
	elseif distance <= Attacks.ATK_Strike.range then
		brain:Attack("ATK_Strike", t)
	elseif distance >= Attacks.ATK_Charge.minRange and distance <= Attacks.ATK_Charge.maxRange then
		brain:Attack("ATK_Charge", t)
	end
	brain:MoveTo(root.Position, "Run")
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="171">
          <Properties>
            <string name="Name">BHV_Avoid</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Avoid (Partie)
-- Section 9.5 : Éviter : feu ou fusée à moins de 40 studs, aube ; à 05 h 50, rentre au repaire.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Avoid
local Behavior = {}

local TaggedSet = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("TaggedSet"))
Behavior.urgent = true

local function nearFire(brain)
	for _, fire in TaggedSet.list("FireSource") do
		if fire:IsA("BasePart") then
			local keepAway = fire:GetAttribute("keepAway") or B.fireRange
			if (fire.Position - brain:Position()).Magnitude < keepAway then
				return fire, keepAway
			end
		end
	end
	return nil
end

local function dawn()
	local clock = Util.getMatchState():GetAttribute("clock") or 0
	return Util.getMatchState():GetAttribute("creatureRetreat") == true
		or (clock >= CreatureConfig.DawnRetreatHour and clock < require(Config:WaitForChild("ActConfig")).EndHour)
end

function Behavior.score(brain)
	if dawn() and brain.id ~= "CRT_Female" then
		return 1
	end
	-- 8.1 : la créature reste à plus de 40 studs d'une fusée sauf si elle est enragée
	if nearFire(brain) and not brain.enraged then
		return 1
	end
	return 0
end

function Behavior.step(brain)
	if dawn() and brain.id ~= "CRT_Female" then
		brain:MoveTo(MapConfig.Places.P07a.pos, "Run") -- rentre au repaire
		return
	end
	local fire, keepAway = nearFire(brain)
	if fire then
		local away = (brain:Position() - fire.Position) * Vector3.new(1, 0, 1)
		if away.Magnitude < 1 then
			away = Vector3.new(1, 0, 0)
		end
		brain:MoveTo(fire.Position + away.Unit * keepAway * 1.5, "Run") -- constante (marge)
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="172">
          <Properties>
            <string name="Name">BHV_Drag</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Drag (Partie)
-- Section 9.5 : Traîner : joueur à terre ou mort ; emporte le corps vers une réserve (P20, P04, P07b).
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Drag
local Behavior = {}

local function victim(brain)
	for _, player in brain:Candidates() do
		if
			player:GetAttribute("isDowned")
			and (player:GetAttribute("grabbedBy") == nil or player:GetAttribute("grabbedBy") == brain.id)
		then
			return player
		end
	end
	return nil
end

local function nearestReserve(position)
	local best, bestDistance = nil, math.huge
	for _, code in B.reserves do
		local place = MapConfig.Places[code]
		local pos = place.pos
			or Vector3.new((place.zone.minX + place.zone.maxX) / 2, place.yLow, (place.zone.minZ + place.zone.maxZ) / 2)
		local d = (pos - position).Magnitude
		if d < bestDistance then
			best, bestDistance = pos, d
		end
	end
	return best
end

function Behavior.score(brain)
	if brain.id == "CRT_Female" then
		return 0
	end
	return if victim(brain) then B.baseScore else 0
end

function Behavior.step(brain)
	local player = victim(brain)
	local root = player and Util.characterRoot(player)
	if root == nil then
		return
	end
	if brain:DistanceTo(player) > CreatureConfig.Attacks.ATK_Grab.range then
		brain:MoveTo(root.Position, "Run")
		return
	end
	-- 7.3 : traîné à 10 studs/s vers une réserve ; le groupe a jusqu'à la fin du compte à rebours
	player:SetAttribute("grabbedBy", brain.id)
	local reserve = nearestReserve(brain:Position())
	brain:MoveTo(reserve, "Walk")
	if brain.humanoid then
		brain.humanoid.WalkSpeed = CreatureConfig.DragSpeed
	end
	if brain:HasBody() and brain.root then
		root.CFrame = brain.root.CFrame * CFrame.new(0, 0, brain.def.height * CreatureConfig.Technical.DragOffset)
	end
	if brain:Arrived(MapConfig.Places.P07b.radius) then
		player:SetAttribute("grabbedBy", nil)
	end
end

function Behavior.stop(brain)
	for _, player in brain:Candidates() do
		if player:GetAttribute("grabbedBy") == brain.id then
			player:SetAttribute("grabbedBy", nil)
		end
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="173">
          <Properties>
            <string name="Name">BHV_Feed</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Feed (Partie)
-- Section 9.5 : Manger : faim > 0,7 ; va à P19 ou à une carcasse.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Feed
local Behavior = {}

function Behavior.score(brain)
	if brain.id == "CRT_Female" or brain.hunger <= B.hungerAbove then
		return 0
	end
	return brain.hunger
end

function Behavior.start(brain)
	brain:MoveTo(MapConfig.Places[B.places[1]].pos, "Walk")
end

function Behavior.step(brain)
	if brain:Arrived(MapConfig.Places[B.places[1]].radius) then
		brain:Stop()
		brain.ai.CreatureAnimator:Play(brain.model, "FeedCrouch")
		brain.hunger = 0
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="174">
          <Properties>
            <string name="Name">BHV_Guard</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Guard (Partie)
-- Section 9.5 : Garder : femelle, joueur à moins de 40 studs du repaire ; attaque sans avertissement.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Guard
local Behavior = {}

Behavior.urgent = true

local function intruder(brain)
	local lair = MapConfig.Places[CreatureConfig.LairPlace].pos
	for _, player in brain:Candidates() do
		local root = Util.characterRoot(player)
		if root and (root.Position - lair).Magnitude <= B.range then
			return player
		end
	end
	return nil
end

function Behavior.score(brain)
	if brain.id ~= "CRT_Female" then
		return 0
	end
	return if intruder(brain) then 1 else 0
end

function Behavior.step(brain)
	local player = intruder(brain)
	local root = player and Util.characterRoot(player)
	if root == nil then
		return
	end
	brain.target = player
	brain.vigilance[player] = CreatureConfig.Vision.TargetAt
	local distance = brain:DistanceTo(player)
	if distance <= CreatureConfig.Attacks.ATK_Grab.range then
		brain:Attack("ATK_Grab", player)
	elseif distance <= CreatureConfig.Attacks.ATK_Strike.range then
		brain:Attack("ATK_Strike", player)
	end
	brain:MoveTo(root.Position, "Run")
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="175">
          <Properties>
            <string name="Name">BHV_Intimidate</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Intimidate (Partie)
-- Section 9.5 : Intimider : joueurs près du territoire ou du repaire ; monte d'un cran sur l'échelle 9.6.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Intimidate
local Behavior = {}

local Intimidation = CreatureConfig.Intimidation

local function nearTerritory(brain)
	for _, player in brain:Candidates() do
		local root = Util.characterRoot(player)
		if root then
			local p05 = MapConfig.Places.P05
			local lair = MapConfig.Places[CreatureConfig.LairPlace]
			local territory = CreatureConfig.Personalities.Territorial.territoryRadius
			if
				(root.Position - p05.pos).Magnitude <= territory
				or (root.Position - lair.pos).Magnitude <= territory
			then
				return player
			end
		end
	end
	return nil
end

function Behavior.score(brain)
	if brain.id == "CRT_Female" then
		return 0
	end
	local player = brain.target or nearTerritory(brain)
	if player == nil then
		return 0
	end
	-- 9.6 : chaque cran attend le précédent ; un cran par activation
	if os.clock() - brain.ladder.lastStepAt < Intimidation.StepWithin / #Intimidation.Steps then
		return 0
	end
	local factor = if brain.personality then (CreatureConfig.Personalities[brain.personality].intimidation or 1) else 1
	return math.clamp(B.baseScore * factor, 0, 1)
end

function Behavior.start(brain)
	local player = brain.target or nearTerritory(brain)
	if player then
		brain.ai.FamilyBrain:IntimidationStep(brain, player)
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="176">
          <Properties>
            <string name="Name">BHV_Mark</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Mark (Partie)
-- Section 9.5 : Marquer : hors combat, près d'un arbre à pierres ; ajoute des pierres, casse une branche à 3 m.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Mark
local Behavior = {}

local TaggedSet = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("TaggedSet"))

local function nearestTree(brain)
	local best, bestDistance = nil, math.huge
	for _, tree in TaggedSet.list(CreatureConfig.StoneTreeTag) do
		if tree:IsA("BasePart") then
			local d = (tree.Position - brain:Position()).Magnitude
			if d < bestDistance then
				best, bestDistance = tree, d
			end
		end
	end
	return best, bestDistance
end

function Behavior.score(brain)
	if brain.id == "CRT_Female" or brain.target ~= nil then
		return 0
	end
	local tree, distance = nearestTree(brain)
	if tree == nil then
		return 0
	end
	return math.clamp(1 - distance / CreatureConfig.Simulation.NodeSpacing, 0, 1) * B.baseScore
end

function Behavior.step(brain)
	local tree = nearestTree(brain)
	if tree == nil then
		return
	end
	brain:MoveTo(tree.Position, "Walk")
	if brain:Arrived(B.branchHeight * 2) then
		brain:Stop()
		brain.ai.CreatureAnimator:Play(brain.model, "StackStones")
		brain.ai.EventDirector:GrowStonePile(tree)
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="177">
          <Properties>
            <string name="Name">BHV_Mimic</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Mimic (Partie)
-- Section 9.5 : Imiter : éclaireur, une cible s'éloigne du groupe ; rejoue un son préenregistré (9.8).
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Mimic
local Behavior = {}

function Behavior.score(brain)
	if brain.def.role ~= "Scout" or brain.target == nil then
		return 0
	end
	if
		os.clock() - (brain.lastMimicAt or -math.huge)
		< B.minDuration * CreatureConfig.Technical.MimicCooldownFactor
	then
		return 0
	end
	local isolation = brain.ai.FamilyBrain:Isolation(brain.target)
	local factor = if brain.personality == "Playful" then CreatureConfig.Personalities.Playful.mimic else 1
	return math.clamp(isolation * B.baseScore * factor, 0, 1)
end

function Behavior.start(brain)
	brain.lastMimicAt = os.clock()
	brain:Stop()
	brain.ai.MimicService:Play(brain, brain.target)
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="178">
          <Properties>
            <string name="Name">BHV_Observe</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Observe (Partie)
-- Section 9.5 : Observer : tension basse, cible inconsciente ; se poste à 40–90 studs derrière un tronc.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Observe
local Behavior = {}

local function target(brain)
	return brain.target
end

function Behavior.score(brain)
	local t = target(brain)
	if brain.id == "CRT_Female" or t == nil then
		return 0
	end
	if brain.ai.TensionDirector:IsPaused() then
		return 1 -- 9.12 : pic → les créatures passent en Observer ou Fuir
	end
	-- fuit si éclairée ou approchée à 25 studs
	if brain.litAt and os.clock() - brain.litAt < B.minDuration then
		return 0
	end
	if brain:DistanceTo(t) < B.fleeIfApproached then
		return 0
	end
	return B.baseScore * (1 - brain.ai.TensionDirector:Intensity() / 100)
end

function Behavior.step(brain)
	local t = target(brain)
	local root = t and Util.characterRoot(t)
	if root == nil then
		return
	end
	local here = brain:Position()
	local away = (here - root.Position) * Vector3.new(1, 0, 1)
	if away.Magnitude < 1 then
		away = Vector3.new(1, 0, 0)
	end
	local distance = (B.minDistance + B.maxDistance) / 2
	brain:MoveTo(root.Position + away.Unit * distance, "Sneak")
	brain:FaceTowards(root.Position)
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="179">
          <Properties>
            <string name="Name">BHV_Retreat</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Retreat (Partie)
-- Section 9.5 : Fuir blessée : 15 % de PV perdus en 10 s, fusée, bombe anti-ours ; revient enragée.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Retreat
local Behavior = {}

Behavior.urgent = true

function Behavior.score(brain)
	if (brain.fleeUntil or 0) > os.clock() then
		return 1
	end
	if brain:RecentDamage(B.window) >= brain.maxHealth * B.healthLost then
		return 1
	end
	if brain.ai.TensionDirector:IsPaused() and brain.behaviorId == "BHV_Retreat" then
		return B.baseScore
	end
	return 0
end

function Behavior.start(brain)
	brain.retreatUntil = os.clock() + B.minDuration + math.random() * (B.maxDuration - B.minDuration)
	-- vers la forêt dense ou les tunnels (DÉFAUT : le plus proche des deux)
	local forest = MapConfig.Places.P04.zone
	local forestCenter =
		Vector3.new((forest.minX + forest.maxX) / 2, MapConfig.Places.P04.yLow, (forest.minZ + forest.maxZ) / 2)
	local tunnels = MapConfig.Places.P07a.pos
	local here = brain:Position()
	brain:MoveTo(
		if (forestCenter - here).Magnitude < (tunnels - here).Magnitude then forestCenter else tunnels,
		"Sprint"
	)
end

function Behavior.step(brain)
	if os.clock() >= (brain.retreatUntil or 0) then
		brain.enraged = true -- revient enragée
		brain.fleeUntil = nil
		brain.damageLog = {}
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="180">
          <Properties>
            <string name="Name">BHV_Roam</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Roam (Partie)
-- Section 9.5 : Errance : parcourt son territoire (score fixe 0,2).
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Roam
local Behavior = {}

function Behavior.score(_brain)
	return B.fixedScore
end

function Behavior.step(brain)
	if brain:Arrived() then
		-- DÉFAUT : un nœud CreatureNav voisin, tiré au hasard
		local here = brain:Position()
		local angle = math.random() * 2 * math.pi
		local spacing = CreatureConfig.Simulation.NodeSpacing
		local goal = here + Vector3.new(math.cos(angle) * spacing, 0, math.sin(angle) * spacing)
		if brain.id == "CRT_Female" then
			goal = MapConfig.Places[CreatureConfig.LairPlace].pos -- la femelle reste au repaire
		end
		brain:MoveTo(goal, "Walk")
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="181">
          <Properties>
            <string name="Name">BHV_Sabotage</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Sabotage (Partie)
-- Section 9.5 : Saboter : groupe soudé depuis 120 s ; casse les lanternes, renverse le feu, vole un sac posé.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Sabotage
local Behavior = {}

local TaggedSet = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("TaggedSet"))

local function sabotageTarget(brain)
	local best, bestDistance = nil, math.huge
	for _, tag in { "FireSource", "LightSource" } do
		for _, item in TaggedSet.list(tag) do
			if item:IsA("BasePart") and not brain:IsPointSeen(item.Position) then
				local d = (item.Position - brain:Position()).Magnitude
				if d < bestDistance then
					best, bestDistance = item, d
				end
			end
		end
	end
	return best
end

function Behavior.score(brain)
	if brain.id == "CRT_Female" or not brain.ai.FamilyBrain:GroupTight() then
		return 0
	end
	return if sabotageTarget(brain) then B.baseScore else 0
end

function Behavior.step(brain)
	local item = sabotageTarget(brain)
	if item == nil then
		return
	end
	brain:MoveTo(item.Position, "Sneak")
	if (item.Position - brain:Position()).Magnitude <= CreatureConfig.Attacks.ATK_Strike.range then
		item:Destroy()
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="182">
          <Properties>
            <string name="Name">BHV_Siege</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Siege (Partie)
-- Section 9.5 : Siège (acte 2) : tourne à 25–40 studs, lance depuis le bord du canyon, teste les barricades.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Siege
local Behavior = {}

Behavior.urgent = true

function Behavior.score(brain)
	if brain.id == "CRT_Female" then
		return 0
	end
	return if Util.getMatchState():GetAttribute("siegeActive") then 1 else 0
end

local function outsidePlayer(brain)
	local cabin = MapConfig.Places.P05c
	for _, player in brain:Candidates() do
		local root = Util.characterRoot(player)
		if root and (root.Position - cabin.pos).Magnitude > cabin.radius then
			-- 5.2 : un joueur resté dehors pendant le siège est la cible prioritaire
			if (root.Position - cabin.pos).Magnitude <= MapConfig.Places.P05.radius then
				return player
			end
		end
	end
	return nil
end

function Behavior.step(brain)
	local cabin = MapConfig.Places.P05c.pos
	local angle = (os.clock() / B.maxRadius) + (if brain.id == "CRT_Alpha" then 0 else math.pi)
	local radius = (B.minRadius + B.maxRadius) / 2
	brain:MoveTo(cabin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius), "Walk")
	-- 19.5 (C20, C34) : cadence selon la phase du siège (heure serveur du début : siegeStartedAt)
	local startedAt = Util.getMatchState():GetAttribute("siegeStartedAt")
	local phase = startedAt and ActConfig.siegePhase(workspace:GetServerTimeNow() - startedAt)
	if phase == nil or phase.silence then
		return
	end
	if os.clock() < (brain.nextSiegeThrowAt or 0) then
		return
	end
	local jitter = phase.jitter and (math.random() * 2 - 1) * phase.jitter or 0
	brain.nextSiegeThrowAt = os.clock() + phase.interval + jitter
	local outside = outsidePlayer(brain)
	if outside then
		brain.target = outside
		brain:Attack("ATK_Throw", outside)
		return
	end
	-- tester les barricades (3:20–5:00) : une ouverture cédée → bras ; une ouverture clouée reçoit une pierre
	local openings = brain.services.GameStateService:GetOpenings()
	for _, part in openings do
		if phase.barricadeAttempts and part:GetAttribute("planks") == 0 then
			for _, player in brain:Candidates() do
				local root = Util.characterRoot(player)
				if
					root
					and (root.Position - part.Position).Magnitude <= CreatureConfig.Attacks.ATK_ReachThrough.range
				then
					brain:Attack("ATK_ReachThrough", player)
					return
				end
			end
		end
	end
	local nailed = {}
	for _, part in openings do
		if part:GetAttribute("planks") == 1 then
			table.insert(nailed, part)
		end
	end
	if #nailed > 0 then
		brain:Attack("ATK_Throw", nailed[math.random(1, #nailed)])
	else
		-- impact cosmétique sur le toit (19.5 : sans effet hors des ouvertures)
		brain.ai.CreatureAnimator:PlaySoundAt(CreatureConfig.Attacks.ATK_Throw.sound, cabin)
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="183">
          <Properties>
            <string name="Name">BHV_Stalk</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Stalk (Partie)
-- Section 9.5 : Traquer : cible choisie, pas encore isolée ; suit à 50–80 studs sans être vue.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Stalk
local Behavior = {}

function Behavior.score(brain)
	local t = brain.target
	if brain.id == "CRT_Female" or t == nil then
		return 0
	end
	if brain.ai.FamilyBrain:Isolation(t) >= 1 then
		return 0 -- isolée : place à l'attaque
	end
	return B.baseScore
end

function Behavior.step(brain)
	local t = brain.target
	local root = t and Util.characterRoot(t)
	if root == nil then
		return
	end
	local away = (brain:Position() - root.Position) * Vector3.new(1, 0, 1)
	if away.Magnitude < 1 then
		away = Vector3.new(0, 0, 1)
	end
	local distance = (B.minDistance + B.maxDistance) / 2
	-- 9.4 : piste de sang suivie au pas
	brain:MoveTo(root.Position + away.Unit * distance, if t:GetAttribute("bleed") ~= "None" then "Walk" else "Sneak")
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="184">
          <Properties>
            <string name="Name">BHV_Throw</string>
            <string name="Source"><![CDATA[-- ServerScriptService/AI/Behaviors/BHV_Throw (Partie)
-- Section 9.5 : Lancer : en hauteur, cible à 20–120 studs ; pierres sur les joueurs, les lampes, les planches.
-- Score de 0 à 1 (interprétation de la colonne « Score élevé quand », à régler en phase B3).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local B = CreatureConfig.Behaviors.BHV_Throw
local Behavior = {}

function Behavior.score(brain)
	local t = brain.target
	if t == nil or brain.id == "CRT_Female" then
		return 0
	end
	local root = Util.characterRoot(t)
	local distance = brain:DistanceTo(t)
	if root == nil or distance < B.minDistance or distance > B.maxDistance then
		return 0
	end
	-- « en hauteur » : au-dessus de la cible (DÉFAUT : d'au moins la hauteur de la créature)
	if brain:Position().Y - root.Position.Y < brain.def.height then
		return 0
	end
	local factor = if brain.personality == "Playful" then CreatureConfig.Personalities.Playful.stones else 1
	return math.clamp(B.baseScore * factor, 0, 1)
end

function Behavior.step(brain)
	local t = brain.target
	if t == nil then
		return
	end
	brain:Stop()
	-- 19.5 (C10) : 1 lancer toutes les 3 à 5 s hors siège
	if os.clock() >= (brain.nextThrowAt or 0) then
		local interval = B.intervalMin + math.random() * (B.intervalMax - B.intervalMin)
		-- 9.8 et 19.6 (C31) : « lance plus » après 2 tirs reçus = fréquence ×1,5
		if brain.memory.shotsTaken >= CreatureConfig.Memory.ShotsToAdapt then
			interval /= CreatureConfig.Memory.ThrowMoreFactor
		end
		brain.nextThrowAt = os.clock() + interval
		brain:Attack("ATK_Throw", t)
	end
end

local _ = { MapConfig, Util, B }

return Behavior
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="185">
        <Properties>
          <string name="Name">CreatureAnimator</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/CreatureAnimator (Partie)
-- Sections 13.7 et 14.2 : animations ANIM_Creature_* (objets Animation de
-- ReplicatedStorage/Animations/Creature, identifiants collés par Gabriel) et sons placés dans le monde
-- (10.3 : chaque son de créature a une position). Un identifiant manquant produit un avertissement,
-- jamais une erreur.
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AudioConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("AudioConfig"))

local CreatureAnimator = {}

local warned = {}
-- DÉFAUT : durée de vie d'un son posé (s)
local SOUND_LIFETIME = 10

local function warnOnce(key, text)
	if not warned[key] then
		warned[key] = true
		warn(text)
	end
end

-- joue ANIM_Creature_<name> sur le modèle (si l'Animation existe et a un identifiant)
function CreatureAnimator:Play(model, name)
	local folder = ReplicatedStorage:FindFirstChild("Animations")
	local creatureFolder = folder and folder:FindFirstChild("Creature")
	local animation = creatureFolder and creatureFolder:FindFirstChild("ANIM_Creature_" .. name)
	if animation == nil or animation.AnimationId == "" then
		warnOnce("anim:" .. name, "CreatureAnimator : animation sans identifiant ANIM_Creature_" .. name)
		return nil
	end
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator == nil then
		return nil
	end
	local track = animator:LoadAnimation(animation)
	track:Play()
	return track
end

-- son posé à une position (prefix accepté : « SFX_WoodKnock » choisit une variante _01…)
function CreatureAnimator:PlaySoundAt(soundId, position)
	local id = AudioConfig.Sounds[soundId]
	if id == nil then
		-- variantes numérotées
		local variants = {}
		for key, value in AudioConfig.Sounds do
			if string.sub(key, 1, #soundId) == soundId then
				table.insert(variants, value)
			end
		end
		id = variants[1] and variants[math.random(1, #variants)]
	end
	if id == nil or id == "" then
		warnOnce("sound:" .. soundId, "CreatureAnimator : son manquant " .. soundId .. " (13.7)")
		return nil
	end
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.Position = position
	part.Parent = workspace
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Parent = part
	sound:Play()
	Debris:AddItem(part, SOUND_LIFETIME)
	return sound
end

function CreatureAnimator:Init() end

function CreatureAnimator:Start() end

return CreatureAnimator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="186">
        <Properties>
          <string name="Name">CreatureBrain</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/CreatureBrain (Partie)
-- Sections 9.2, 9.3, 9.5 et 9.11 : une créature. Choisit un comportement (IA à utilité, 5 fois/s),
-- l'exécute (machine à états), se déplace (PathfindingService, ou graphe CreatureNav quand aucun
-- joueur n'est à moins de 600 studs : plus de corps physique). Modèle : ServerStorage/Creatures ;
-- absent → capsule de la taille de 9.2 (J10), nommée MANQUANT_<ID>.
local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local Util = require(Shared:WaitForChild("Util"))

local CreatureBrain = {}
CreatureBrain.__index = CreatureBrain

local behaviors = {} -- [id] = module
local attacks = {} -- [id] = module
local ai = nil -- modules du dossier AI
local services = nil

local REPATH_DISTANCE = CreatureConfig.Technical.RepathDistance
local CAPSULE_WIDTH = CreatureConfig.Technical.CapsuleWidth
local CAPSULE_COLOR = CreatureConfig.Technical.CapsuleColor

function CreatureBrain.Setup(allServices, aiModules)
	services = allServices
	ai = aiModules
	local folder = script.Parent
	for _, module in folder:WaitForChild("Behaviors"):GetChildren() do
		if module:IsA("ModuleScript") then
			behaviors[module.Name] = require(module)
		end
	end
	for _, module in folder:WaitForChild("Attacks"):GetChildren() do
		if module:IsA("ModuleScript") then
			attacks[module.Name] = require(module)
		end
	end
end

local function buildBody(id, def)
	local folder = ServerStorage:FindFirstChild("Creatures")
	local template = folder and folder:FindFirstChild(def.model)
	if template then
		return template:Clone()
	end
	-- J10 : capsule de 10 studs (8 pour un éclaireur, 9 pour la femelle)
	local model = Instance.new("Model")
	model.Name = "MANQUANT_" .. id
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Shape = Enum.PartType.Cylinder
	root.Size = Vector3.new(def.height, CAPSULE_WIDTH * 2, CAPSULE_WIDTH * 2)
	root.CFrame = CFrame.Angles(0, 0, math.pi / 2)
	root.Color = CAPSULE_COLOR
	root.Parent = model
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.one * CAPSULE_WIDTH
	head.Color = CAPSULE_COLOR
	head.CFrame = CFrame.new(0, def.height / 2, 0)
	head.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = head
	weld.Parent = root
	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = def.height / 2
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid
	model.PrimaryPart = root
	return model
end

function CreatureBrain.new(id, spawnPosition, family)
	local def = CreatureConfig.Family[id]
	local info = services.PartyLoaderService:GetMatchInfo()
	local healthFactor = ActConfig.difficulty(info.difficulty).creatureHealth
	local self = setmetatable({
		id = id,
		def = def,
		family = family,
		services = services,
		ai = ai,
		attacks = attacks,
		maxHealth = def.health * healthFactor,
		vigilance = {},
		knownPosition = {},
		lastSeen = {},
		lastHeard = nil,
		memory = { litCount = 0, shotsTaken = 0, flares = 0, grudge = {}, hidingSpots = {}, pathCells = {} },
		ladder = { step = 0, lastStepAt = -math.huge, lastContact = os.clock() },
		hunger = 0,
		enraged = false,
		behavior = nil,
		behaviorId = nil,
		behaviorStartedAt = 0,
		scores = {},
		damageLog = {},
		lastDamageAt = -math.huge,
		virtualPosition = spawnPosition,
		gait = "Walk",
		path = nil,
		goal = nil,
	}, CreatureBrain)
	self.health = self.maxHealth
	local model = buildBody(id, def)
	model:AddTag("Creature")
	model:SetAttribute("creatureId", id)
	model:SetAttribute("health", self.health)
	self.model = model
	self.root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	self.head = model:FindFirstChild("Head") or self.root
	self.humanoid = model:FindFirstChildOfClass("Humanoid")
	return self
end

function CreatureBrain:Position()
	if self.model.Parent == workspace and self.root then
		return self.root.Position
	end
	return self.virtualPosition
end

function CreatureBrain:HasBody()
	return self.model.Parent == workspace
end

-- paramètres de rayon construits une seule fois (aucune exclusion), au lieu d'un RaycastParams par appel
local SEEN_PARAMS = RaycastParams.new()

-- vrai si un joueur voit ce point (pour faire apparaître le corps hors de vue, 9.3 et 10.1)
function CreatureBrain:IsPointSeen(position)
	for _, player in Players:GetPlayers() do
		local head = player.Character and player.Character:FindFirstChild("Head")
		if head and (head.Position - position).Magnitude < CreatureConfig.Simulation.BodyRange then
			local hit = workspace:Raycast(head.Position, position - head.Position, SEEN_PARAMS)
			if hit == nil or (hit.Position - position).Magnitude < CAPSULE_WIDTH then
				local look = head.CFrame.LookVector
				if look:Dot((position - head.Position).Unit) > 0 then
					return true
				end
			end
		end
	end
	return false
end

local function nearestPlayerDistance(position)
	local best = math.huge
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if root then
			best = math.min(best, (root.Position - position).Magnitude)
		end
	end
	return best
end

-- 9.3 : corps physique seulement si un joueur est à moins de 600 studs
function CreatureBrain:UpdateBody()
	local position = self:Position()
	local near = nearestPlayerDistance(position) < CreatureConfig.Simulation.BodyRange
	if near and not self:HasBody() then
		if not self:IsPointSeen(position) then
			self.model:PivotTo(CFrame.new(position))
			self.model.Parent = workspace
			if self.root then
				self.root:SetNetworkOwner(nil)
			end
		end
	elseif not near and self:HasBody() then
		self.virtualPosition = self.root.Position
		self.model.Parent = nil
	end
end

function CreatureBrain:SetGait(gait)
	local now = os.clock()
	if gait == "Sprint" then
		local sprint = CreatureConfig.Gaits.Sprint
		if (self.sprintRecoverUntil or 0) > now then
			gait = "Run"
		elseif self.gait ~= "Sprint" then
			self.sprintUntil = now + sprint.duration
		end
	end
	if self.gait == "Sprint" and gait == "Sprint" and (self.sprintUntil or 0) <= now then
		self.sprintRecoverUntil = now + CreatureConfig.Gaits.Sprint.recovery
		gait = "Run"
	end
	self.gait = gait
	if self.humanoid then
		self.humanoid.WalkSpeed = CreatureConfig.Gaits[gait].speed
	end
end

function CreatureBrain:Stop()
	self.goal = nil
	self.path = nil
	if self:HasBody() and self.humanoid and self.root then
		self.humanoid:MoveTo(self.root.Position)
	end
end

function CreatureBrain:FaceTowards(position)
	if self:HasBody() and self.root then
		local flat = Vector3.new(position.X, self.root.Position.Y, position.Z)
		if (flat - self.root.Position).Magnitude > 0.1 then
			self.root.CFrame = CFrame.lookAt(self.root.Position, flat)
		end
	end
end

local function pathParams()
	local p = CreatureConfig.Path
	return {
		AgentRadius = p.AgentRadius,
		AgentHeight = p.AgentHeight,
		AgentCanJump = p.AgentCanJump,
		Costs = {
			Water = p.Costs.Water,
			Sand = p.Costs.Sand,
			Pebble = p.Costs.Pebble,
			Rock = p.Costs.Rock,
			Grass = p.Costs.Grass,
			LeafyGrass = p.Costs.LeafyGrass,
			Cover = p.Modifiers.Cover,
			Trail = p.Modifiers.Trail,
			Forbidden = p.Modifiers.Forbidden,
		},
	}
end

-- se déplace vers `goal` avec une allure (9.2) ; à pas de pathfinding près de la cible (9.11)
function CreatureBrain:MoveTo(goal, gait)
	self:SetGait(gait or self.gait)
	if self.goal and (self.goal - goal).Magnitude < REPATH_DISTANCE and self.path then
		return
	end
	self.goal = goal
	self.path = nil
	self.waypointIndex = 1
	if not self:HasBody() then
		self.path = ai.NavGraph:Path(self.virtualPosition, goal)
		return
	end
	if (goal - self.root.Position).Magnitude <= CreatureConfig.Path.DirectRange then
		self.humanoid:MoveTo(goal)
		return
	end
	local path = PathfindingService:CreatePath(pathParams())
	local ok = pcall(function()
		path:ComputeAsync(self.root.Position, goal)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		self.path = {}
		for _, waypoint in path:GetWaypoints() do
			table.insert(self.path, waypoint.Position)
		end
	else
		self.humanoid:MoveTo(goal) -- repli : déplacement direct
	end
end

function CreatureBrain:Arrived(tolerance)
	return self.goal == nil or (self:Position() - self.goal).Magnitude <= (tolerance or CAPSULE_WIDTH * 2)
end

local function followPath(self, dt)
	if self.path == nil then
		return
	end
	local target = self.path[self.waypointIndex or 1]
	if target == nil then
		self.path = nil
		return
	end
	if self:HasBody() then
		self.humanoid:MoveTo(target)
		if (self.root.Position - target).Magnitude < CAPSULE_WIDTH * 2 then
			self.waypointIndex += 1
		end
	else
		-- simulation à distance : déplacement sur le graphe à l'allure courante
		local speed = CreatureConfig.Gaits[self.gait].speed
		local delta = target - self.virtualPosition
		local stepLength = speed * dt
		if delta.Magnitude <= stepLength then
			self.virtualPosition = target
			self.waypointIndex += 1
		else
			self.virtualPosition += delta.Unit * stepLength
		end
	end
	-- bruit de pas (9.2) selon l'allure
	local noise = CreatureConfig.Gaits[self.gait].noise
	if noise and self:HasBody() then
		services.NoiseService:Emit(self.root.Position, noise, NoiseTypes.Footstep, self.model)
	end
end

-- 9.2 : régénération hors combat, jusqu'à 70 % ; 19.6 (C29) : 10 s sans dégâts reçus ni attaque lancée
local function regen(self, dt)
	local lastCombat = math.max(self.lastDamageAt, self.lastAttackAt or -math.huge)
	if os.clock() - lastCombat >= CreatureConfig.OutOfCombatAfter then
		local cap = self.maxHealth * CreatureConfig.Regen.MaxFraction
		if self.health < cap then
			self.health = math.min(cap, self.health + CreatureConfig.Regen.PerSecond * dt)
			self.model:SetAttribute("health", self.health)
		end
	end
end

function CreatureBrain:TakeDamage(amount, shooter, weaponId)
	if self.dead then
		return
	end
	self.health -= amount
	self.lastDamageAt = os.clock()
	table.insert(self.damageLog, { time = os.clock(), amount = amount })
	self.model:SetAttribute("health", self.health)
	if shooter then
		-- 9.7 : rancune = dégâts ÷ 200 ; tirs du Pisteur comptés double
		local factor = if shooter:GetAttribute("role") == "Tracker" then CreatureConfig.Target.TrackerShotFactor else 1
		self.memory.grudge[shooter] = (self.memory.grudge[shooter] or 0) + amount * factor
		self.memory.shotsTaken += 1
		self.vigilance[shooter] = CreatureConfig.Vision.TargetAt
	end
	if self.health <= 0 then
		self.dead = true
		self.family:OnDeath(self, shooter, weaponId)
	end
end

-- dégâts perdus dans la fenêtre (9.5 : 15 % en 10 s → fuite)
function CreatureBrain:RecentDamage(window)
	local total = 0
	local now = os.clock()
	for _, entry in self.damageLog do
		if now - entry.time <= window then
			total += entry.amount
		end
	end
	return total
end

-- lance une attaque de 9.10 (signal sonore avant les dégâts)
function CreatureBrain:Attack(attackId, target)
	local attack = attacks[attackId]
	if attack == nil or self.busy then
		return false
	end
	if attack.canUse and not attack.canUse(self, target) then
		return false
	end
	self.busy = true
	self.lastAttackAt = os.clock() -- 19.6 (C29) : une attaque lancée compte comme combat
	ai.TensionDirector:RegisterAttackAttempt(self, target)
	task.spawn(function()
		local ok, err = pcall(attack.run, self, target)
		if not ok then
			warn("CreatureBrain : " .. attackId .. " : " .. tostring(err))
		end
		self.busy = false
	end)
	return true
end

-- choix du comportement (9.5) : garde le comportement en cours sauf si un autre dépasse son score ×1,25,
-- et chaque comportement a une durée minimale
local function choose(self)
	local best, bestScore = nil, -1
	self.scores = {}
	for id, module in behaviors do
		local ok, score = pcall(module.score, self)
		score = if ok and type(score) == "number" then math.clamp(score, 0, 1) else 0
		self.scores[id] = score
		if score > bestScore then
			best, bestScore = id, score
		end
	end
	local current = self.behaviorId
	if current then
		local def = CreatureConfig.Behaviors[current]
		local minDuration = def and def.minDuration or 0
		local currentScore = self.scores[current] or 0
		local module = behaviors[best]
		local urgent = module.urgent == true or (module.isUrgent ~= nil and module.isUrgent(self) == true)
		if not urgent and os.clock() - self.behaviorStartedAt < minDuration and currentScore > 0 then
			return
		end
		if best ~= current and bestScore <= currentScore * CreatureConfig.SwitchFactor then
			return
		end
	end
	if best and best ~= current then
		if current and behaviors[current].stop then
			behaviors[current].stop(self)
		end
		self.behaviorId = best
		self.behavior = behaviors[best]
		self.behaviorStartedAt = os.clock()
		self.model:SetAttribute("behavior", best)
		if self.behavior.start then
			self.behavior.start(self)
		end
	end
end

function CreatureBrain:Tick(dt)
	if self.dead then
		return
	end
	self:UpdateBody()
	regen(self, dt)
	self.hunger =
		math.min(1, self.hunger + CreatureConfig.Behaviors.BHV_Feed.hungerPerMinute * dt / Util.SECONDS_PER_MINUTE)
	if not self.busy then
		choose(self)
		if self.behavior and self.behavior.step then
			local ok, err = pcall(self.behavior.step, self, dt)
			if not ok then
				warn("CreatureBrain : " .. tostring(self.behaviorId) .. " : " .. tostring(err))
			end
		end
	end
	followPath(self, dt)
	self.model:SetAttribute("targetUserId", if self.target then self.target.UserId else nil)
end

-- joueurs que la créature peut cibler (pas en cinématique, vivants, pas extraits)
function CreatureBrain:Candidates()
	local list = {}
	for _, player in Players:GetPlayers() do
		if
			services.HealthService:IsAlive(player)
			and not services.CinematicService:IsProtected(player)
			and player:GetAttribute("extracted") == nil
		then
			table.insert(list, player)
		end
	end
	return list
end

function CreatureBrain:DistanceTo(player)
	local root = Util.characterRoot(player)
	return if root then (root.Position - self:Position()).Magnitude else math.huge
end

function CreatureBrain:IsTagged(tag)
	return CollectionService:HasTag(self.model, tag)
end

function CreatureBrain:Destroy()
	self.model:Destroy()
end

return CreatureBrain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="187">
        <Properties>
          <string name="Name">CreatureDebug</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/CreatureDebug (Partie)
-- Section 9.13 : en Studio seulement, affiche au-dessus de chaque créature : comportement, cible,
-- scores, vigilance par joueur, chemin prévu, et la tension du directeur. Le texte est mis à jour par
-- le serveur dans un clone de ReplicatedStorage/UITemplates/CreatureDebug (15.1 : clone d'un modèle) ;
-- la touche F8 l'affiche ou le cache (CreatureDebugController, client).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local CreatureDebug = {}

local ai = nil

local function describe(brain)
	local lines = {
		("%s  PV %d/%d  %s"):format(brain.id, brain.health, brain.maxHealth, brain.personality or ""),
		("comportement : %s"):format(brain.behaviorId or "—"),
		("cible : %s"):format(brain.target and brain.target.Name or "—"),
	}
	local scores = {}
	for id, score in brain.scores do
		if score > 0 then
			table.insert(scores, ("%s %.2f"):format(string.gsub(id, "^BHV_", ""), score))
		end
	end
	table.sort(scores)
	table.insert(lines, "scores : " .. table.concat(scores, ", "))
	local vigilance = {}
	for player, value in brain.vigilance do
		table.insert(vigilance, ("%s %.2f"):format(player.Name, value))
	end
	table.insert(lines, "vigilance : " .. table.concat(vigilance, ", "))
	table.insert(lines, ("chemin : %d points"):format(brain.path and #brain.path or 0))
	table.insert(lines, ("tension : %.0f"):format(ai.TensionDirector:Intensity()))
	return table.concat(lines, "\n")
end

function CreatureDebug:Init(_services, aiModules)
	ai = aiModules
end

function CreatureDebug:Start()
	if not RunService:IsStudio() then
		return
	end
	task.spawn(function()
		local templates = ReplicatedStorage:WaitForChild("UITemplates", Util.GUI_WAIT_TIMEOUT)
		local template = templates and templates:FindFirstChild("CreatureDebug")
		if template == nil then
			warn("UI manquante : UITemplates/CreatureDebug")
			return
		end
		while true do
			task.wait(1 / CreatureConfig.Rates.Family)
			for _, brain in ai.FamilyBrain:GetBrains() do
				local tag = brain.model:FindFirstChild("CreatureDebug")
				if tag == nil and brain.head then
					tag = template:Clone()
					tag.Adornee = brain.head
					tag.Parent = brain.model
				end
				local label = tag and tag:FindFirstChild("Info")
				if label then
					label.Text = describe(brain)
				end
			end
		end
	end)
end

return CreatureDebug
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="188">
        <Properties>
          <string name="Name">EventDirector</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/EventDirector (Partie)
-- Section 10 : événements inexpliqués EVT_01 à EVT_22. Règles de 10.1 : le son avant l'image ; rien
-- n'apparaît sous les yeux (hors du champ de tous les joueurs ou à plus de 80 studs) ; 1 événement au
-- plus toutes les 45 s par joueur ; le même jamais deux fois en 10 min. Fréquence × taille du groupe (5.5).
-- Modèles : ServerStorage/Props (16.1) ; absent → bloc gris MANQUANT_<ID>. Sons : AudioConfig (13.7).
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CinematicConfig = require(Config:WaitForChild("CinematicConfig"))
local DirectorConfig = require(Config:WaitForChild("DirectorConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local EventDirector = {}

local services = nil
local ai = nil
local lastForPlayer = {} -- [Player] = os.clock()
local lastEvent = {} -- [EVT_xx] = os.clock()
local guarantees = { sightings = 0, signs = 0 }
local Staging = DirectorConfig.Staging
-- DÉFAUT (technique) : durée de vie d'un décor posé par un événement (s)
local PROP_LIFETIME = Staging.NoRepeatFor

-- 10.1 : un point est-il sous les yeux d'un joueur (dans son champ, à moins de 80 studs) ?
local function inViewOfAnyone(position)
	for _, player in Players:GetPlayers() do
		local head = player.Character and player.Character:FindFirstChild("Head")
		if head then
			local offset = position - head.Position
			if offset.Magnitude <= Staging.OutOfViewOrBeyond and head.CFrame.LookVector:Dot(offset.Unit) > 0 then
				return true
			end
		end
	end
	return false
end

local function spawnProp(propId, position)
	if inViewOfAnyone(position) then
		return nil
	end
	local folder = ServerStorage:FindFirstChild("Props")
	local base = string.gsub(propId, "^Prop_", "")
	base = string.gsub(base, "_%u$", "")
	local template = folder and (folder:FindFirstChild(propId) or folder:FindFirstChild(base))
	local prop
	if template then
		prop = template:Clone()
		prop:PivotTo(CFrame.new(position))
	else
		prop = Instance.new("Part")
		prop.Name = "MANQUANT_" .. propId
		prop.Size = ItemConfig.PlaceholderSize
		prop.Color = ItemConfig.PlaceholderColor
		prop.Anchored = true
		prop.Position = position
	end
	prop.Parent = workspace
	Debris:AddItem(prop, PROP_LIFETIME)
	return prop
end

-- point au loin ou tout près d'un joueur, hors de sa vue (derrière lui)
local function pointNear(player, distance)
	local root = Util.characterRoot(player)
	if root == nil then
		return nil
	end
	local back = -root.CFrame.LookVector
	local side = root.CFrame.RightVector * (math.random() - 0.5)
	return root.Position + (back + side).Unit * distance
end

-- 9.6 et EVT_01 : la faune se tait autour d'un point (lu par AmbienceController)
function EventDirector:FaunaSilence(position, radius)
	Util.getMatchState():SetAttribute(
		"faunaSilence",
		Util.encode({ x = position.X, z = position.Z, r = radius, at = workspace:GetServerTimeNow() })
	)
end

-- 9.5 BHV_Mark et EVT_04 : le tas de pierres grandit d'un niveau
function EventDirector:GrowStonePile(tree)
	local pile = tree:FindFirstChild("StonePile")
	if pile == nil then
		pile = spawnProp("Prop_StonePile_A", tree.Position)
		if pile then
			pile.Name = "StonePile"
			pile.Parent = tree
		end
	end
	if pile then
		pile:SetAttribute("level", (pile:GetAttribute("level") or 0) + 1)
	end
end

local HANDLERS = {}

HANDLERS.FaunaSilence = function(def, player)
	local root = Util.characterRoot(player)
	if root then
		EventDirector:FaunaSilence(root.Position, def.radius)
		return true
	end
	return false
end

HANDLERS.Sound = function(def, player)
	local far = pointNear(player, if def.nearWater then DirectorConfig.nearDistance() else DirectorConfig.farDistance())
	if far == nil then
		return false
	end
	ai.CreatureAnimator:PlaySoundAt(def.sounds[1], far)
	if def.pair then
		-- puis la réponse de l'autre côté
		local root = Util.characterRoot(player)
		task.delay(Staging.PerPlayerInterval / 10, function()
			if root then
				ai.CreatureAnimator:PlaySoundAt(def.sounds[#def.sounds], root.Position + (root.Position - far))
			end
		end)
	end
	return true
end

HANDLERS.Prop = function(def, player)
	local place = def.places and MapConfig.Places[def.places[1]]
	local position = if place then place.pos else pointNear(player, Staging.OutOfViewOrBeyond)
	if position == nil then
		return false
	end
	local prop = spawnProp(def.props[math.random(1, #def.props)], position)
	if prop and def.tag then
		CollectionService:AddTag(prop, def.tag)
	end
	return prop ~= nil
end

HANDLERS.Footprints = function(def)
	local place = MapConfig.Places[def.places[math.random(1, #def.places)]]
	local position = place.pos
		+ Vector3.new(math.random(-place.radius, place.radius), 0, math.random(-place.radius, place.radius))
	if inViewOfAnyone(position) then
		return false
	end
	ai.FamilyBrain:PlaceFootprint(position)
	return true
end

HANDLERS.Mimic = function(_def, player)
	for _, brain in ai.FamilyBrain:GetBrains() do
		if brain.def.role == "Scout" and not brain.dead then
			ai.MimicService:Play(brain, player)
			return true
		end
	end
	return false
end

HANDLERS.Smell = function(_def, player)
	player:SetAttribute("smellAt", workspace:GetServerTimeNow()) -- vignettage vert très léger (client)
	return true
end

HANDLERS.EyeShine = function(def, player)
	local position = pointNear(player, def.distance)
	if position and player:GetAttribute("lightOn") then
		local marker = spawnProp(def.effect, position)
		if marker then
			Debris:AddItem(marker, def.duration)
			return true
		end
	end
	return false
end

HANDLERS.TabletBar = function(_def, player)
	if player:GetAttribute("tabletOpen") then
		player:SetAttribute("network", true)
		task.delay(require(Config:WaitForChild("CreatureConfig")).Technical.TabletBarDuration, function()
			player:SetAttribute("network", false)
		end)
		return true
	end
	return false
end

HANDLERS.EchoSteps = function(def, player)
	local root = Util.characterRoot(player)
	if root then
		task.delay(def.delay, function()
			ai.CreatureAnimator:PlaySoundAt(
				def.sounds[1],
				root.Position - root.CFrame.LookVector * DirectorConfig.nearDistance()
			)
		end)
		return true
	end
	return false
end

HANDLERS.Radio = function(def, player)
	if services.InventoryService:Has(player, "ITM_Walkie") then
		local root = Util.characterRoot(player)
		if root then
			ai.CreatureAnimator:PlaySoundAt(def.sounds[1], root.Position)
			return true
		end
	end
	return false
end

-- événements qui demandent un décor précis posé dans Studio (porte P17, corps de Leah, sac, silhouette) :
-- ils ne se déclenchent que si l'objet existe (Workspace/Places/<lieu>/<nom>)
local function placed(code, name)
	local places = workspace:FindFirstChild("Places")
	local folder = places and places:FindFirstChild(code, true)
	return folder and folder:FindFirstChild(name, true)
end

HANDLERS.Door = function(def)
	local door = placed(def.places[1], "Door")
	if door and door:IsA("BasePart") and not inViewOfAnyone(door.Position) then
		door.CFrame *= CFrame.Angles(0, math.rad(90), 0) -- constante (porte ouverte d'un quart de tour)
		ai.CreatureAnimator:PlaySoundAt(def.sounds[1], door.Position)
		return true
	end
	return false
end

HANDLERS.MoveBody = function()
	local body = placed("P09", "Body_LeahBrandt")
	local camp = MapConfig.Places.P09
	if body and not inViewOfAnyone(body:GetPivot().Position) then
		body:PivotTo(
			CFrame.new(
				camp.pos
					+ Vector3.new(
						math.random(-camp.radius, camp.radius) / 2,
						0,
						math.random(-camp.radius, camp.radius) / 2
					)
			)
		)
		return true
	end
	return false
end

HANDLERS.AlignBag = function()
	for _, bag in workspace:FindFirstChild("WorldItems") and workspace.WorldItems:GetChildren() or {} do
		if bag.Name == "DeadBag" and bag:IsA("BasePart") and not inViewOfAnyone(bag.Position) then
			bag:SetAttribute("aligned", true)
			return true
		end
	end
	return false
end

HANDLERS.Silhouette = function(def)
	for _, brain in ai.FamilyBrain:GetBrains() do
		if brain.id == "CRT_Alpha" and not brain.dead and not brain:HasBody() then
			local lake = MapConfig.Places[def.places[1]].pos
			brain.virtualPosition = lake
			return true
		end
	end
	return false
end

local function eligible(id, def, act, player)
	if act < def.acts[1] or act > def.acts[2] then
		return false
	end
	if os.clock() - (lastEvent[id] or -math.huge) < Staging.NoRepeatFor then
		return false
	end
	return os.clock() - (lastForPlayer[player] or -math.huge) >= Staging.PerPlayerInterval
end

-- tire un événement du catalogue « bas » pour un joueur
function EventDirector:RequestLow(player)
	local state = Util.getMatchState()
	local act = state:GetAttribute("act") or 0
	local players = if player then { player } else Players:GetPlayers()
	local info = services.PartyLoaderService:GetMatchInfo()
	-- 5.5 : événements du directeur ×0,8 / ×1,0 / ×1,2 selon la taille du groupe
	if math.random() > ActConfig.groupSize(info.playerCount).directorEvents then
		return false
	end
	for _, p in players do
		local ids = table.clone(DirectorConfig.LowCatalog) -- 19.6 (C32) ; copie mélangée
		for i = #ids, 2, -1 do
			local j = math.random(1, i)
			ids[i], ids[j] = ids[j], ids[i]
		end
		for _, id in ids do
			local def = DirectorConfig.Events[id]
			local handler = HANDLERS[def.kind]
			if handler and eligible(id, def, act, p) and handler(def, p) then
				lastEvent[id] = os.clock()
				lastForPlayer[p] = os.clock()
				guarantees.signs += 1
				return true
			end
		end
	end
	return false
end

-- 19.6 (C32) : les événements hors catalogue « bas » suivent leurs propres règles. DÉFAUT : un événement
-- qui a des lieux (`places`) est tenté quand le joueur est dans l'un d'eux ; un événement sans lieu est tenté
-- une fois par acte ; EVT_08 (imitation) est joué par BHV_Mimic. Les cadences de 10.1 s'appliquent.
local ownTriedInAct = {} -- [id] = numéro d'acte de la dernière tentative
local lowSet = {}
for _, id in DirectorConfig.LowCatalog do
	lowSet[id] = true
end

function EventDirector:RequestOwnRules(player)
	local act = Util.getMatchState():GetAttribute("act") or 0
	local root = Util.characterRoot(player)
	if root == nil then
		return false
	end
	for _, id in Util.sortedKeys(DirectorConfig.Events) do
		local def = DirectorConfig.Events[id]
		local handler = HANDLERS[def.kind]
		if not lowSet[id] and def.kind ~= "Mimic" and handler and eligible(id, def, act, player) then
			local wanted
			if def.places then
				wanted = false
				for _, code in def.places do
					wanted = wanted or ai.Perception:InPlace(root.Position, code)
				end
			else
				wanted = ownTriedInAct[id] ~= act
				ownTriedInAct[id] = act
			end
			if wanted and handler(def, player) then
				lastEvent[id] = os.clock()
				lastForPlayer[player] = os.clock()
				return true
			end
		end
	end
	return false
end

-- 9.12 acte 1 : garantis 1 aperçu lointain (CS_03) et 2 signes ; au-delà de la moitié de l'acte
function EventDirector:EnsureAct1Guarantees()
	local act = ActConfig.Acts[1]
	local started = services.GameStateService and Util.getMatchState():GetAttribute("act") == 1
	if not started then
		return
	end
	self.act1Start = self.act1Start or os.clock()
	if os.clock() - self.act1Start < act.minDuration / 2 then
		return
	end
	if guarantees.signs < DirectorConfig.Act1.GuaranteedSigns then
		self:RequestLow()
	end
	if guarantees.sightings < DirectorConfig.Act1.GuaranteedSightings then
		local players = Players:GetPlayers()
		local player = players[math.random(1, math.max(1, #players))]
		if player then
			guarantees.sightings += 1
			services.CinematicService:Play("CS_03", { player })
			local def = CinematicConfig.Cinematics.CS_03
			self:FaunaSilence(
				Util.characterRoot(player) and Util.characterRoot(player).Position or Vector3.zero,
				DirectorConfig.Events.EVT_01.radius
			)
			for _, brain in ai.FamilyBrain:GetBrains() do
				if brain.id == "CRT_Alpha" then
					local point = pointNear(player, (def.silhouetteMin + def.silhouetteMax) / 2)
					if point then
						brain.virtualPosition = point
					end
				end
			end
		end
	end
end

function EventDirector:Init(allServices, aiModules)
	services = allServices
	ai = aiModules
end

function EventDirector:Start() end

return EventDirector
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="189">
        <Properties>
          <string name="Name">FamilyBrain</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/FamilyBrain (Partie)
-- Sections 9.2, 9.7, 9.8 et 9.9 : crée la famille (5.5 : Alpha, éclaireurs selon la taille du groupe ;
-- femelle dans les tunnels), tire la personnalité de l'Alpha, choisit les cibles (toutes les 2 s),
-- coordonne (pince, rabattage, séparation ; jamais plus de 2 créatures visibles par joueur),
-- applique les coups reçus, les parades et l'échelle d'intimidation (9.6). 2 fois/s.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local DirectorConfig = require(Config:WaitForChild("DirectorConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local Util = require(Shared:WaitForChild("Util"))

local CreatureBrain = require(script.Parent:WaitForChild("CreatureBrain"))

local FamilyBrain = {}

local services = nil
local ai = nil
local brains = {} -- liste de CreatureBrain
local byModel = {} -- [Model] = brain
local tightSince = nil
local Target = CreatureConfig.Target

function FamilyBrain:GetBrains()
	return brains
end

-- 9.7 I : distance au coéquipier le plus proche ÷ 60, plafonné à 1
function FamilyBrain:Isolation(player)
	local root = Util.characterRoot(player)
	if root == nil then
		return 0
	end
	local best = math.huge
	for _, other in Players:GetPlayers() do
		if other ~= player and services.HealthService:IsAlive(other) then
			local otherRoot = Util.characterRoot(other)
			if otherRoot then
				best = math.min(best, (otherRoot.Position - root.Position).Magnitude)
			end
		end
	end
	return math.min(1, best / Target.IsolationDistance)
end

-- 9.8 : groupe dans un rayon de 25 studs pendant 120 s
function FamilyBrain:GroupTight()
	return tightSince ~= nil and os.clock() - tightSince >= CreatureConfig.Memory.TightGroupFor
end

-- 9.8 : personnalité de l'Alpha : fréquence d'attaque
function FamilyBrain:AttackFactor(brain)
	if brain.personality == nil then
		return 1
	end
	local p = CreatureConfig.Personalities[brain.personality]
	local factor = p.attackFrequency or 1
	if brain.personality == "Territorial" then
		local inside = (brain:Position() - MapConfig.Places[p.territoryPlace].pos).Magnitude <= p.territoryRadius
		factor = if inside then p.attackFrequency else 1
	end
	return factor
end

local function averageHealth(player)
	local total = 0
	for _, limb in PlayerConfig.Limbs do
		total += services.HealthService:GetFraction(player, limb)
	end
	return total / #PlayerConfig.Limbs
end

-- 9.7 : S = 3,0 I + 1,5 B + 1,0 N + 1,2 L + 2,0 R + 0,8 P + 0,5 C
function FamilyBrain:Score(brain, player)
	local w = Target.Weights
	local I = self:Isolation(player)
	local B = math.clamp(
		1 - averageHealth(player) + (if player:GetAttribute("bleed") ~= "None" then Target.BleedBonus else 0),
		0,
		1
	)
	local N = math.clamp(services.NoiseService:RecentNoise(player, Target.NoiseWindow) / Target.NoiseDivisor, 0, 1)
	local L = if player:GetAttribute("lightOn")
		then Target.LampOn
		elseif player:GetAttribute("tabletOpen") then Target.TabletOpen
		else 0
	local R = math.clamp(
		(brain.memory.grudge[player] or 0) / Target.GrudgeDamageDivisor
			+ (brain.memory.grudgeBonus and brain.memory.grudgeBonus[player] or 0),
		0,
		1
	)
	local P = math.clamp(1 - brain:DistanceTo(player) / Target.ProximityDistance, 0, 1)
	local C = if services.EvidenceService:CarriesClassA(player) then 1 else 0
	-- 19.5 (C6) : le porteur d'un blessé a +0,5
	local carrier = if player:GetAttribute("carrying") ~= nil then Target.CarrierBonus else 0
	return w.I * I + w.B * B + w.N * N + w.L * L + w.R * R + w.P * P + w.C * C + carrier
end

-- la cible change seulement si un autre joueur dépasse le score actuel de 20 %
local function updateTarget(brain)
	local best, bestScore = nil, -1
	local currentScore = -1
	for _, player in brain:Candidates() do
		if (brain.vigilance[player] or 0) >= CreatureConfig.Vision.KnowsPositionAt or brain.knownPosition[player] then
			local score = FamilyBrain:Score(brain, player)
			-- 5.2 : un joueur resté dehors pendant le siège est la cible prioritaire (BHV_Siege)
			if player == brain.target then
				currentScore = score
			end
			if score > bestScore then
				best, bestScore = player, score
			end
		end
	end
	if
		brain.target
		and brain.target.Parent
		and currentScore >= 0
		and bestScore <= currentScore * (1 + Target.SwitchMargin)
	then
		return
	end
	brain.target = best
end

-- 9.6 : échelle d'intimidation
function FamilyBrain:IntimidationStep(brain, player)
	local ladder = brain.ladder
	local steps = CreatureConfig.Intimidation.Steps
	if os.clock() - ladder.lastStepAt > CreatureConfig.Intimidation.StepWithin then
		ladder.step = 0 -- trop longtemps : on recommence en bas
	end
	ladder.step = math.min(#steps, ladder.step + 1)
	ladder.lastStepAt = os.clock()
	ladder.lastContact = os.clock()
	local root = Util.characterRoot(player)
	local position = brain:Position()
	local kind = steps[ladder.step]
	local animator = ai.CreatureAnimator
	if kind == "FaunaSilence" then
		ai.EventDirector:FaunaSilence(position, CreatureConfig.Intimidation.FaunaSilenceRadius)
	elseif kind == "WoodKnock" then
		animator:Play(brain.model, "WoodKnock")
		animator:PlaySoundAt("SFX_WoodKnock", position)
		for _, other in Players:GetPlayers() do
			-- 19.6 (C33) : un coup « au loin » s'entend jusqu'à la distance « au loin » la plus grande
			if brain:DistanceTo(other) <= DirectorConfig.Far.max then
				services.FearService:OnWoodKnock(other)
			end
		end
	elseif kind == "Call" then
		animator:Play(brain.model, "Call")
		animator:PlaySoundAt("SFX_Call_Long", position)
		services.FearService:OnScream(position)
		services.EvidenceService:OnCreatureCall(position)
	elseif kind == "NearThrow" and root then
		-- branche ou pierre qui tombe à côté du joueur, pas sur lui
		local landing = root.Position
			+ Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit * DirectorConfig.nearDistance()
		animator:PlaySoundAt("SFX_StoneGround", landing)
		services.NoiseService:Emit(
			landing,
			require(Config:WaitForChild("ItemConfig")).Items.ITM_Stone.impactNoise,
			NoiseTypes.Impact,
			brain.model
		)
	elseif kind == "BranchSnap" and root then
		animator:PlaySoundAt(
			"SFX_BranchSnap",
			root.Position + (position - root.Position).Unit * DirectorConfig.nearDistance()
		)
	elseif kind == "ChestBeat" then
		if brain.id == "CRT_Alpha" then
			animator:Play(brain.model, "ChestBeat")
			animator:PlaySoundAt("SFX_ChestBeat", position)
		end
	elseif kind == "FakeCharge" then
		-- 60 % des cas si le joueur ne fuit pas et n'éclaire pas ; sinon vraie charge (DÉFAUT)
		local fake = not player:GetAttribute("lightOn") and math.random() < CreatureConfig.Intimidation.FakeChargeChance
		local charge = brain.attacks.ATK_Charge
		if charge and charge.canUse(brain, player) then
			task.spawn(charge.run, brain, player, fake)
		end
	elseif kind == "Attack" then
		brain.vigilance[player] = CreatureConfig.Vision.TargetAt
		brain.target = player
	end
end

-- dégâts reçus (WeaponService.CreatureHit)
local function onHit(model, damage, shooter, weaponId, _isHead, _part, extra)
	local brain = byModel[model]
	if brain == nil then
		return
	end
	brain:TakeDamage(damage, shooter, weaponId)
	-- parades de la saisie : hache 1 coup, machette 2, tir
	if brain.grabbed then
		brain.grabHits = (brain.grabHits or 0) + 1
		if extra.grabReleaseHits == nil or brain.grabHits >= extra.grabReleaseHits then
			brain.grabbed:SetAttribute("grabbedBy", nil)
			brain.grabbed = nil
		end
	end
	-- pistolet lance-fusées : éblouit, la créature fuit 8 s
	if extra.flee then
		brain.fleeUntil = os.clock() + extra.flee
	end
end

function FamilyBrain:OnDeath(brain, shooter)
	brain.model:SetAttribute("dead", true)
	brain.model:AddTag("CreatureCorpse")
	if brain.humanoid then
		brain.humanoid.Health = 0
	end
	ai.CreatureAnimator:Play(brain.model, "DeathFall")
	if brain.id == "CRT_Alpha" then
		services.GameStateService:OnAlphaKilled() -- 5.3 : fin « Ordonnance 69-01 »
	end
	ai.TensionDirector:StrongEvent(shooter)
end

local function spawnFamily()
	local info = services.PartyLoaderService:GetMatchInfo()
	local random = Random.new(info.seed)
	local group = ActConfig.groupSize(info.playerCount)
	local list = table.clone(group.creatures)
	table.insert(list, "CRT_Female") -- tunnels uniquement, quelle que soit la taille du groupe
	-- DÉFAUT : départ de la famille au repaire (P07a pour la surface, P07b pour la femelle)
	for _, id in list do
		local spawnAt = if id == "CRT_Female"
			then MapConfig.Places[CreatureConfig.LairPlace].pos
			else MapConfig.Places.P07a.pos
		local brain = CreatureBrain.new(id, spawnAt, FamilyBrain)
		if id == "CRT_Alpha" then
			brain.personality = CreatureConfig.PersonalityOrder[random:NextInteger(1, #CreatureConfig.PersonalityOrder)]
			print("FamilyBrain : personnalité de l'Alpha : " .. brain.personality)
			brain.model:SetAttribute("personality", brain.personality)
		end
		table.insert(brains, brain)
		byModel[brain.model] = brain
	end
end

-- 9.9 : jamais plus de 2 créatures visibles en même temps par un joueur
local function enforceReadability()
	for _, player in Players:GetPlayers() do
		local visible = {}
		for _, brain in brains do
			if brain:HasBody() and not brain.dead then
				local seen = ai.Perception:CanSee(brain, player)
				if seen then
					table.insert(visible, brain)
				end
			end
		end
		if #visible > CreatureConfig.MaxVisiblePerPlayer then
			table.sort(visible, function(a, b)
				return a:DistanceTo(player) < b:DistanceTo(player)
			end)
			for i = CreatureConfig.MaxVisiblePerPlayer + 1, #visible do
				visible[i].fleeUntil = os.clock() + CreatureConfig.Behaviors.BHV_Retreat.minDuration / 10
			end
		end
	end
end

local function updateTightGroup()
	local players = {}
	for _, player in Players:GetPlayers() do
		if services.HealthService:IsAlive(player) and Util.characterRoot(player) then
			table.insert(players, Util.characterRoot(player).Position)
		end
	end
	local tight = #players > 1
	for i = 1, #players do
		for j = i + 1, #players do
			if (players[i] - players[j]).Magnitude > CreatureConfig.Memory.TightGroupRadius * 2 then
				tight = false
			end
		end
	end
	if tight then
		tightSince = tightSince or os.clock()
	else
		tightSince = nil
	end
end

-- 9.9 : pince et rabattage — les éclaireurs suivent la cible de l'Alpha
local function coordinate()
	local alpha = nil
	for _, brain in brains do
		if brain.id == "CRT_Alpha" and not brain.dead then
			alpha = brain
		end
	end
	for _, brain in brains do
		if brain.def.role == "Scout" and not brain.dead and alpha and alpha.target then
			brain.target = alpha.target
			brain.vigilance[alpha.target] =
				math.max(brain.vigilance[alpha.target] or 0, CreatureConfig.Vision.KnowsPositionAt)
		end
	end
end

-- empreinte fraîche (attribut createdAt = os.clock() côté serveur, createdTime = heure serveur)
function FamilyBrain:PlaceFootprint(position)
	local spec = CreatureConfig.Footprints
	local part = Instance.new("Part")
	part.Name = "Footprint"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Color = ItemConfig.PlaceholderColor -- Decal_Footprint_Big à créer (13.5)
	part.Size = spec.Size
	part.Position = position
	part:SetAttribute("createdAt", os.clock())
	part:SetAttribute("createdTime", workspace:GetServerTimeNow())
	part:AddTag("Footprint")
	part.Parent = workspace
	game:GetService("Debris"):AddItem(part, spec.Lifetime)
	return part
end

local function footprints()
	for _, brain in brains do
		if brain:HasBody() and brain.root and not brain.dead then
			local position = brain.root.Position - Vector3.new(0, brain.def.height / 2, 0)
			if
				brain.lastFootprint == nil
				or (position - brain.lastFootprint).Magnitude >= CreatureConfig.Footprints.Spacing
			then
				brain.lastFootprint = position
				FamilyBrain:PlaceFootprint(position)
			end
		end
	end
end

-- 7.7 : le Pisteur devine la direction de la créature (±45°, recharge 60 s) ; attribut trackerDirection
local trackerCooldown = {}
local function trackerAbility(player)
	local ability = PlayerConfig.Abilities.Tracker
	local root = Util.characterRoot(player)
	if root == nil or os.clock() - (trackerCooldown[player] or -math.huge) < ability.DirectionCooldown then
		return
	end
	trackerCooldown[player] = os.clock()
	local nearest, best = nil, math.huge
	for _, brain in brains do
		if not brain.dead then
			local d = (brain:Position() - root.Position).Magnitude
			if d < best then
				nearest, best = brain, d
			end
		end
	end
	if nearest then
		local offset = nearest:Position() - root.Position
		local angle = math.deg(math.atan2(offset.X, -offset.Z))
		angle += (math.random() * 2 - 1) * ability.DirectionErrorDegrees
		player:SetAttribute("trackerDirection", angle)
		player:SetAttribute("trackerDirectionAt", workspace:GetServerTimeNow())
	end
end

-- 9.9 : la femelle garde P07b ; l'Alpha ne suit les joueurs dans les tunnels qu'à partir de l'acte 4
function FamilyBrain:CanEnterTunnels(brain)
	if brain.id == "CRT_Female" then
		return true
	end
	return brain.id == "CRT_Alpha"
		and (Util.getMatchState():GetAttribute("act") or 0) >= CreatureConfig.AlphaInTunnelsFromAct
end

function FamilyBrain:Init(allServices, aiModules)
	services = allServices
	ai = aiModules
	CreatureBrain.Setup(allServices, aiModules)
end

function FamilyBrain:Start()
	services.WeaponService.CreatureHit:Connect(onHit)
	services.InventoryService.AbilityUsed:Connect(function(player, role)
		if role == "Tracker" then
			trackerAbility(player)
		end
	end)
	services.InventoryService.BearSpray:Connect(function(_player, origin, direction, cone)
		for _, brain in brains do
			local toCreature = brain:Position() - origin
			if toCreature.Magnitude <= cone and direction:Dot(toCreature.Unit) > 0 then
				-- lâche sa prise et recule 4 s
				if brain.grabbed then
					brain.grabbed:SetAttribute("grabbedBy", nil)
					brain.grabbed = nil
				end
				brain.fleeUntil = os.clock() + CreatureConfig.Repellents.BearSprayRecoil
			end
		end
	end)
	-- 9.7 R : +0,5 si filmée à moins de 30 studs ; +0,3 par fusée
	services.EvidenceService.Filmed:Connect(function(player, model, distance)
		local brain = byModel[model]
		if brain and distance <= Target.GrudgeFilmedDistance then
			brain.memory.grudgeBonus = brain.memory.grudgeBonus or {}
			brain.memory.grudgeBonus[player] = math.max(brain.memory.grudgeBonus[player] or 0, Target.GrudgeFilmed)
		end
	end)
	CollectionService:GetInstanceAddedSignal("FireSource"):Connect(function(source)
		if source.Name ~= "Flare" then
			return
		end
		for _, brain in brains do
			brain.memory.flares += 1
			-- 9.8 : fuite réduite de 8 à 4 s à partir de la 2e fusée
			local flee = if brain.memory.flares >= 2
				then CreatureConfig.Memory.FlareFleeLater
				else CreatureConfig.Memory.FlareFleeFirst
			if
				source:IsA("BasePart")
				and (source.Position - brain:Position()).Magnitude <= CreatureConfig.Repellents.FlareKeepAway
				and not brain.enraged
			then
				brain.fleeUntil = os.clock() + flee
			end
		end
	end)
	task.spawn(function()
		services.PartyLoaderService:WaitUntilLoaded()
		spawnFamily()
		local brainStep = 1 / CreatureConfig.Rates.Brain
		local familyEvery = math.max(1, math.floor(CreatureConfig.Rates.Brain / CreatureConfig.Rates.Family))
		local targetEvery = Target.Interval * CreatureConfig.Rates.Brain
		local perceptionNear = 1 / CreatureConfig.Rates.PerceptionNear
		local tick = 0
		-- perception : 10 fois/s à moins de 150 studs, 2 fois/s au-delà
		task.spawn(function()
			local farCounter = 0
			local farEvery = CreatureConfig.Rates.PerceptionNear / CreatureConfig.Rates.PerceptionFar
			while true do
				task.wait(perceptionNear)
				farCounter += 1
				for _, brain in brains do
					if not brain.dead then
						for _, player in Players:GetPlayers() do
							local near = brain:DistanceTo(player) <= CreatureConfig.Rates.PerceptionNearRange
							if near then
								ai.Perception:UpdatePlayer(brain, player, perceptionNear)
							elseif farCounter % farEvery == 0 then
								ai.Perception:UpdatePlayer(brain, player, perceptionNear * farEvery)
							end
						end
					end
				end
			end
		end)
		services.NoiseService.Emitted:Connect(function(noise)
			for _, brain in brains do
				if not brain.dead and noise.source ~= brain.model then
					ai.Perception:OnNoise(brain, noise)
				end
			end
		end)
		while true do
			task.wait(brainStep)
			tick += 1
			for _, brain in brains do
				if not brain.dead then
					if tick % targetEvery == 0 then
						updateTarget(brain)
					end
					brain:Tick(brainStep)
				end
			end
			footprints()
			if tick % familyEvery == 0 then
				updateTightGroup()
				coordinate()
				enforceReadability()
			end
		end
	end)
end

return FamilyBrain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="190">
        <Properties>
          <string name="Name">MimicService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/MimicService (Partie)
-- Section 9.8 : imitation des éclaireurs — sons préenregistrés du jeu, jamais la vraie voix d'un joueur :
-- sifflement humain (SFX_Whistle_01–03), appel « Hey ! » (VO_<ROLE>_Hey), appel à l'aide d'un
-- personnage mort (VO_<ROLE>_Help). 7.7 : l'Opératrice radio entend les éclaireurs imiter à 150 studs
-- et voit leur direction (attributs mimicAt et mimicDirection, en degrés depuis le nord).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MimicService = {}

local ai = nil

local function deadRole()
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("isDead") then
			return player:GetAttribute("role")
		end
	end
	return nil
end

local function teammateRole(target)
	for _, player in Players:GetPlayers() do
		if player ~= target and player:GetAttribute("role") then
			return player:GetAttribute("role")
		end
	end
	return nil
end

function MimicService:Play(brain, target)
	local position = brain:Position()
	local sound
	local dead = deadRole()
	if dead then
		sound = ("VO_%s_Help"):format(dead) -- 9.9 : séparation, appel à l'aide d'un mort
	elseif target and teammateRole(target) and math.random() < 0.5 then -- constante (une chance sur deux)
		sound = ("VO_%s_Hey"):format(teammateRole(target))
	else
		sound = ("SFX_Whistle_0%d"):format(math.random(1, 3)) -- constante (3 sifflements, 9.8)
	end
	ai.CreatureAnimator:Play(brain.model, "MimicCall")
	ai.CreatureAnimator:PlaySoundAt(sound, position)
	-- 7.7 : l'Opératrice radio repère les voix imitées
	local range = PlayerConfig.Abilities.RadioOperator.MimicHearRange
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if
			player:GetAttribute("role") == "RadioOperator"
			and root
			and (root.Position - position).Magnitude <= range
		then
			local offset = position - root.Position
			player:SetAttribute("mimicDirection", math.deg(math.atan2(offset.X, -offset.Z)))
			player:SetAttribute("mimicAt", workspace:GetServerTimeNow())
		end
	end
end

function MimicService:Init(_services, aiModules)
	ai = aiModules
end

function MimicService:Start() end

return MimicService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="191">
        <Properties>
          <string name="Name">NavGraph</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/NavGraph (Partie)
-- Section 9.3 : graphe CreatureNav pour la simulation à distance : un nœud tous les 200 studs, plus
-- un par lieu. Des Part taguées « CreatureNav » dans Workspace/Navigation (posées à la main) s'ajoutent.
-- Les nœuds voisins (8 directions) sont reliés ; chemin par A*.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))

local NavGraph = {}

local nodes = {} -- { position = Vector3, links = { index } }

local function groundY(x, z, fallback)
	local origin = Vector3.new(x, MapConfig.HighestPlayableY * 2, z)
	local hit = workspace:Raycast(origin, Vector3.new(0, -MapConfig.HighestPlayableY * 4, 0)) -- constante (rayon vertical assez long)
	return if hit then hit.Position.Y else fallback
end

local function build()
	local spacing = CreatureConfig.Simulation.NodeSpacing
	local half = MapConfig.PlayableHalf
	local grid = {}
	for x = -half, half, spacing do
		for z = -half, half, spacing do
			local y = groundY(x, z, MapConfig.Terrain.SouthY)
			table.insert(nodes, { position = Vector3.new(x, y, z), links = {} })
			grid[x .. ":" .. z] = #nodes
		end
	end
	for x = -half, half, spacing do
		for z = -half, half, spacing do
			local index = grid[x .. ":" .. z]
			for dx = -1, 1 do
				for dz = -1, 1 do
					local other = grid[(x + dx * spacing) .. ":" .. (z + dz * spacing)]
					if other and other ~= index then
						table.insert(nodes[index].links, other)
					end
				end
			end
		end
	end
	-- un nœud par lieu, relié aux 4 nœuds de grille les plus proches
	local extra = {}
	for _, place in MapConfig.Places do
		if place.pos and not place.outOfBounds then
			table.insert(extra, place.pos)
		end
	end
	for _, part in CollectionService:GetTagged("CreatureNav") do
		if part:IsA("BasePart") then
			table.insert(extra, part.Position)
		end
	end
	for _, position in extra do
		table.insert(nodes, { position = position, links = {} })
		local index = #nodes
		local sorted = {}
		for i = 1, index - 1 do
			table.insert(sorted, i)
		end
		table.sort(sorted, function(a, b)
			return (nodes[a].position - position).Magnitude < (nodes[b].position - position).Magnitude
		end)
		for i = 1, math.min(4, #sorted) do -- constante (4 voisins)
			table.insert(nodes[index].links, sorted[i])
			table.insert(nodes[sorted[i]].links, index)
		end
	end
end

function NavGraph:Nearest(position)
	local best, bestDistance = nil, math.huge
	for index, node in nodes do
		local d = (node.position - position).Magnitude
		if d < bestDistance then
			best, bestDistance = index, d
		end
	end
	return best
end

-- liste de positions du nœud le plus proche de `from` à celui de `to` (A*)
function NavGraph:Path(from, to)
	local start, goal = self:Nearest(from), self:Nearest(to)
	if start == nil or goal == nil then
		return { to }
	end
	local open, came, g = { [start] = true }, {}, { [start] = 0 }
	local function h(i)
		return (nodes[i].position - nodes[goal].position).Magnitude
	end
	while next(open) do
		local current, best = nil, math.huge
		for i in open do
			local f = g[i] + h(i)
			if f < best then
				current, best = i, f
			end
		end
		if current == goal then
			local path = { nodes[goal].position }
			while came[current] do
				current = came[current]
				table.insert(path, 1, nodes[current].position)
			end
			table.insert(path, to)
			return path
		end
		open[current] = nil
		for _, link in nodes[current].links do
			local cost = g[current] + (nodes[link].position - nodes[current].position).Magnitude
			if g[link] == nil or cost < g[link] then
				g[link] = cost
				came[link] = current
				open[link] = true
			end
		end
	end
	return { to }
end

function NavGraph:Init() end

function NavGraph:Start()
	task.spawn(build)
end

return NavGraph
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="192">
        <Properties>
          <string name="Name">Perception</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/Perception (Partie)
-- Section 9.4 : vue (portée Rv, cône 120°, périphérie 200° ×0,4, deux rayons tête et torse, feuillages
-- tagués « Foliage » transparents), vigilance par joueur, ouïe (atténuations), odorat (vent), lumière.
-- Section 7.6 : coefficient de visibilité du joueur. Rafraîchie 10 fois/s à moins de 150 studs, 2 fois/s au-delà.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local TaggedSet = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TaggedSet"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local Perception = {}

local services = nil
local Vision = CreatureConfig.Vision
local Hearing = CreatureConfig.Hearing
local Visibility = PlayerConfig.Visibility
local riverSamples = {} -- points le long de R1, R2, R3 (atténuation près d'un ruisseau)
local OPEN_PLACES = { "P02", "P06", "P08", "P12" } -- 7.6 « à découvert » : lahar, plateau, zone interdite, prairie

local function flat(a, b)
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

local function inPlace(position, code)
	local place = MapConfig.Places[code]
	if place == nil then
		return false
	end
	if place.zone then
		local z = place.zone
		return position.X >= z.minX and position.X <= z.maxX and position.Z >= z.minZ and position.Z <= z.maxZ
	end
	if place.corridor then
		local c = place.corridor
		local a, b = c.from, c.to
		local p = Vector2.new(position.X, position.Z)
		local t = math.clamp((p - a):Dot(b - a) / (b - a):Dot(b - a), 0, 1)
		return (p - (a + (b - a) * t)).Magnitude <= c.width / 2
	end
	return place.pos ~= nil and place.radius ~= nil and flat(position, place.pos) <= place.radius
end

function Perception:InPlace(position, code)
	return inPlace(position, code)
end

local function isOpenGround(position)
	for _, code in OPEN_PLACES do
		if inPlace(position, code) then
			return true
		end
	end
	return false
end

local function weather()
	return Util.getMatchState():GetAttribute("weather") or "Clear"
end

-- 7.6 et 8.3 : coefficient de visibilité du joueur
function Perception:VisibilityOf(player, distance)
	local root = Util.characterRoot(player)
	-- 19.5 (C7, HC2) : dans le vide sanitaire, invisible à la vue (pas à l'ouïe ni à l'odorat)
	if root == nil or player:GetAttribute("hiddenFromSight") then
		return 0
	end
	local stance = player:GetAttribute("stance")
	local open = isOpenGround(root.Position)
	local value = if open then Visibility.StandingOpen else Visibility.StandingForest
	if stance == "Crouch" then
		value *= Visibility.CrouchFactor
	elseif stance == "Prone" and not open then
		value *= Visibility.ProneInFernsFactor
		if distance > Visibility.ProneInFernsMaxDistance then
			return 0
		end
	end
	if player:GetAttribute("lightOn") then
		value *= Visibility.LightOnFactor
	end
	if (player:GetAttribute("flashUntil") or 0) > workspace:GetServerTimeNow() then
		value *= require(Config:WaitForChild("ItemConfig")).Items.ITM_PhotoCamera.flashLightFactor
	end
	if player:GetAttribute("tabletOpen") then
		value *= Visibility.TabletOpenFactor
	end
	local w = weather()
	if w == "Rain" or w == "Fog" then
		value *= Visibility.RainOrFogFactor
	end
	return value
end

-- 9.4 : portée de vue de base (sans le coefficient du joueur)
function Perception:BaseRange()
	local state = Util.getMatchState()
	local clock = state:GetAttribute("clock") or 0
	local dawn = (state:GetAttribute("act") or 0) >= #ActConfig.Acts
		or (clock >= ActConfig.Dawn.FinalAssaultHour and clock < ActConfig.EndHour)
	local range = if dawn then Vision.RangeDawn else Vision.RangeNight
	range *= ActConfig.difficulty(services.PartyLoaderService:GetMatchInfo().difficulty).perception
	range *= Vision.WeatherFactor[weather()] or 1
	return range
end

-- RaycastParams de la vue : la créature et la végétation taguée « Foliage » sont transparentes.
-- Construits une fois par créature, mis à jour seulement quand un « Foliage » est ajouté ou retiré.
local function rayParams(brain)
	if brain.sightParams == nil then
		brain.sightParams = TaggedSet.excludeParams({ brain.model }, { "Foliage" })
	end
	return brain.sightParams:Get()
end

-- RaycastParams qui n'excluent que la créature (pierres, ATK_Throw), construits une fois par créature
function Perception:BodyParams(brain)
	if brain.bodyParams == nil then
		brain.bodyParams = TaggedSet.excludeParams({ brain.model }, {})
	end
	return brain.bodyParams:Get()
end

-- vrai si la créature voit le joueur ; renvoie aussi le facteur de périphérie
function Perception:CanSee(brain, player)
	local head = brain.head
	local character = player.Character
	if head == nil or character == nil then
		return false, 0
	end
	local target = character:FindFirstChild("Head")
	local torso = character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
	if target == nil or torso == nil then
		return false, 0
	end
	local toTarget = target.Position - head.Position
	local angle = math.deg(math.acos(math.clamp(head.CFrame.LookVector:Dot(toTarget.Unit), -1, 1)))
	local factor
	if angle <= Vision.Cone / 2 then
		factor = 1
	elseif angle <= Vision.Peripheral / 2 then
		factor = Vision.PeripheralFactor
	else
		return false, 0
	end
	local params = rayParams(brain)
	for _, part in { target, torso } do
		local hit = workspace:Raycast(head.Position, part.Position - head.Position, params)
		if hit == nil or hit.Instance:IsDescendantOf(character) then
			return true, factor
		end
	end
	return false, 0
end

-- mise à jour de la vigilance d'un joueur pour une créature
function Perception:UpdatePlayer(brain, player, dt)
	local root = Util.characterRoot(player)
	local vigilance = brain.vigilance[player] or 0
	if root == nil or not services.HealthService:IsAlive(player) or services.CinematicService:IsProtected(player) then
		brain.vigilance[player] = math.max(0, vigilance - Vision.DecayRate * dt)
		return
	end
	local position = brain:Position()
	local distance = (root.Position - position).Magnitude
	local visibility = self:VisibilityOf(player, distance)
	local rv = self:BaseRange() * visibility
	if player:GetAttribute("lightOn") then
		rv = math.min(rv, Visibility.LightOnMaxDistance) -- 7.6 : lampe : visible jusqu'à 600 studs
		if distance <= Visibility.LightOnMaxDistance then
			rv = math.max(rv, distance + 1)
		end
	end
	local seen, factor = false, 0
	if brain.model.Parent == workspace and distance <= rv and rv > 0 then
		seen, factor = self:CanSee(brain, player)
	end
	if seen then
		vigilance += Vision.GainRate * (1 - distance / rv) * visibility * factor * dt
		brain.knownPosition[player] = root.Position
		brain.lastSeen[player] = os.clock()
	else
		vigilance -= Vision.DecayRate * dt
	end
	-- odorat (9.4) : selon le vent, joueur au vent senti à 80 studs, de travers 30, sous le vent 10
	local wind = workspace.GlobalWind
	if wind.Magnitude > 0 then
		local fromPlayer = (position - root.Position).Unit
		local cos = wind.Unit:Dot(fromPlayer)
		local smell = CreatureConfig.Smell
		local range = if cos > 0.5 then smell.Upwind elseif cos < -0.5 then smell.Downwind else smell.Crosswind -- constante (cos 60°)
		if distance <= range then
			vigilance = math.max(vigilance, Vision.KnowsPositionAt)
			brain.knownPosition[player] = root.Position
		end
	end
	-- lumière (9.4) : un faisceau qui touche la créature dans sa portée → vigilance du porteur à 1
	if player:GetAttribute("lightOn") and brain.head then
		local head = player.Character and player.Character:FindFirstChild("Head")
		local range = player:GetAttribute("lightRange") or 0
		if head and distance <= range then
			local toCreature = (brain.head.Position - head.Position).Unit
			local angle = math.deg(math.acos(math.clamp(head.CFrame.LookVector:Dot(toCreature), -1, 1)))
			if angle <= require(Config:WaitForChild("AmbienceConfig")).Lamp.Angle / 2 then
				if vigilance < Vision.TargetAt then
					brain.memory.litCount += 1
				end
				vigilance = Vision.TargetAt
				brain.knownPosition[player] = root.Position
				brain.litAt = os.clock()
			end
		end
	end
	brain.vigilance[player] = math.clamp(vigilance, 0, Vision.TargetAt)
end

-- atténuation d'un bruit à sa source (9.4)
local function attenuation(position)
	local value = 1
	if weather() == "Rain" then
		value *= Hearing.Attenuation.Rain
	end
	for _, sample in riverSamples do
		if flat(position, sample) <= Hearing.StreamRange then
			value *= Hearing.Attenuation.Stream
			break
		end
	end
	if inPlace(position, Hearing.WaterfallPlace) then
		value *= Hearing.Attenuation.Waterfall
	end
	if inPlace(position, Hearing.CabinPlace) then
		value *= Hearing.Attenuation.CabinWalls
	end
	return value
end

-- 9.4 : un bruit est entendu si distance ≤ rayon × ouïe × atténuation
function Perception:OnNoise(brain, noise)
	local position = brain:Position()
	local distance = (noise.position - position).Magnitude
	if distance > noise.radius * brain.def.hearing * attenuation(noise.position) then
		return false
	end
	local errorRadius = distance * Hearing.PositionError
	local offset = Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * errorRadius
	brain.lastHeard =
		{ position = noise.position + offset, time = os.clock(), kind = noise.kind, source = noise.source }
	local source = noise.source
	if typeof(source) == "Instance" and source:IsA("Player") then
		if noise.kind == "Gunshot" then
			brain.vigilance[source] = Vision.TargetAt -- un coup de feu met la vigilance du tireur à 1,0
			brain.knownPosition[source] = noise.position
		else
			-- DÉFAUT : un bruit entendu fait tourner la tête (vigilance au moins 0,3)
			brain.vigilance[source] = math.max(brain.vigilance[source] or 0, Vision.TurnHeadAt)
		end
	end
	return true
end

-- échantillons des ruisseaux (ancres et contrôles des tracés R1–R3)
local function sampleRivers()
	for _, path in MapConfig.Paths do
		if path.kind == "River" then
			local previous = nil
			for _, point in path.points do
				local xz = point.c or point
				local current = Vector3.new(xz[1], 0, xz[2])
				if previous then
					local steps = math.ceil((current - previous).Magnitude / Hearing.StreamRange)
					for i = 0, steps do
						table.insert(riverSamples, previous:Lerp(current, i / steps))
					end
				end
				previous = current
			end
		end
	end
end

function Perception:Init(allServices)
	services = allServices
	sampleRivers()
end

function Perception:Start()
	local _ = Players
end

return Perception
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="193">
        <Properties>
          <string name="Name">TensionDirector</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AI/TensionDirector (Partie)
-- Section 9.12 : tension T par joueur (0 à 100) et intensité de groupe (moyenne des T), 1 fois/s.
-- T = 0,5 × peur + 0,3 × (100 − santé moyenne) + 20 × e^(−t/30).
-- Il ne déplace pas la créature : il autorise ou interdit les attaques, impose des pauses, et demande
-- des événements (EventDirector).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local DirectorConfig = require(Config:WaitForChild("DirectorConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local TensionDirector = {}

local services = nil
local ai = nil
local tension = {} -- [Player] = T
local lastStrong = {} -- [Player] = os.clock()
local intensity = 0
local lowSince, highSince = nil, nil
local pausedUntil = 0
local deathsInAct = {} -- [act] = nombre
local deathTimes = {}
local attackAttempts = {} -- [act] = nombre
local isolatedSince = {} -- [Player] = os.clock()
local shotCreature = {} -- [Player] = true (acte 1 : un joueur qui tire peut mourir)
local Tension = DirectorConfig.Tension

function TensionDirector:Intensity()
	return intensity
end

function TensionDirector:Tension(player)
	return tension[player] or 0
end

function TensionDirector:IsPaused()
	return os.clock() < pausedUntil and not self:IsFinalAssault()
end

function TensionDirector:IsFinalAssault()
	return Util.getMatchState():GetAttribute("finalAssault") == true
end

-- événement fort vécu (attaque, créature vue de près, mort d'un coéquipier)
function TensionDirector:StrongEvent(player)
	if player then
		lastStrong[player] = os.clock()
	end
end

function TensionDirector:RegisterAttackAttempt(_brain, target)
	local act = Util.getMatchState():GetAttribute("act") or 0
	attackAttempts[act] = (attackAttempts[act] or 0) + 1
	if typeof(target) == "Instance" and target:IsA("Player") then
		self:StrongEvent(target)
	end
end

function TensionDirector:AttackAttempts(act)
	return attackAttempts[act] or 0
end

-- 19.5 (J12) : attaque imposée à l'acte 3 (10 min passées, moins de 2 tentatives)
local act3StartedAt = nil
function TensionDirector:ForcedAttack(brain)
	local state = Util.getMatchState()
	if state:GetAttribute("act") ~= 3 or act3StartedAt == nil then -- constante (numéro d'acte)
		return false
	end
	if os.clock() - act3StartedAt < DirectorConfig.Act3.ForceAttackAfter then
		return false
	end
	if self:AttackAttempts(3) >= DirectorConfig.Act3.MinAttackAttempts then -- constante (numéro d'acte)
		return false
	end
	return brain.target ~= nil and self:AllowAttack(brain, brain.target)
end

-- règles d'acte (9.12) : la créature peut-elle attaquer ce joueur maintenant ?
function TensionDirector:AllowAttack(brain, player)
	local state = Util.getMatchState()
	local act = state:GetAttribute("act") or 0
	if state:GetAttribute("creatureRetreat") then
		-- 5.2 : aucune attaque après 05 h 50, sauf dans les tunnels
		local root = Util.characterRoot(player)
		if root == nil or not ai.Perception:InPlace(root.Position, "P07b") then
			return false
		end
	end
	-- 19.6 (C26) : après le démarrage du van, attaque immédiate autorisée sur les joueurs autour du van
	if state:GetAttribute("vanStartedAt") then
		local root = Util.characterRoot(player)
		local p01 = MapConfig.Places.P01
		if root and (root.Position - p01.pos).Magnitude <= p01.radius then
			return true
		end
	end
	if self:IsPaused() then
		return false
	end
	if act == 0 then
		return false -- 5.2 : la créature ne se montre pas
	end
	local difficulty = services.PartyLoaderService:GetMatchInfo().difficulty
	if act == 1 then
		if brain.personality == "Playful" and CreatureConfig.Personalities.Playful.noKillAct1 then
			return false -- harcèle sans tuer en acte 1
		end
		local isolated = isolatedSince[player] and os.clock() - isolatedSince[player] >= DirectorConfig.Act1.IsolatedFor
		return isolated or shotCreature[player] == true
	elseif act == 2 then
		local limit = DirectorConfig.Act2MaxDeaths[difficulty] or DirectorConfig.Act2MaxDeaths.Normal
		return (deathsInAct[2] or 0) < limit
	elseif act == 3 then -- constante (numéro d'acte)
		for _, time in deathTimes do
			if os.clock() - time < DirectorConfig.Act3.Window then
				return false -- au plus 1 mort par tranche de 3 min
			end
		end
		return true
	end
	return true -- acte 4 : dernier assaut
end

local function averageHealth(player)
	local total = 0
	for _, limb in PlayerConfig.Limbs do
		total += services.HealthService:GetFraction(player, limb)
	end
	return total / #PlayerConfig.Limbs * Tension.Max
end

local function groupCenter(except)
	local sum, count = Vector3.zero, 0
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if player ~= except and root and services.HealthService:IsAlive(player) then
			sum += root.Position
			count += 1
		end
	end
	return if count > 0 then sum / count else nil
end

local function tick()
	local total, count = 0, 0
	for _, player in Players:GetPlayers() do
		if services.HealthService:IsAlive(player) then
			local t = os.clock() - (lastStrong[player] or -math.huge)
			local value = Tension.FearWeight * (player:GetAttribute("fear") or 0)
				+ Tension.HealthWeight * (Tension.Max - averageHealth(player))
				+ Tension.EventWeight * math.exp(-t / Tension.EventDecay)
			tension[player] = math.clamp(value, 0, Tension.Max)
			total += tension[player]
			count += 1
			-- acte 1 : joueur isolé à plus de 200 studs du groupe
			local root = Util.characterRoot(player)
			local center = groupCenter(player)
			if root and center and (root.Position - center).Magnitude > DirectorConfig.Act1.IsolatedDistance then
				isolatedSince[player] = isolatedSince[player] or os.clock()
			else
				isolatedSince[player] = nil
			end
		end
	end
	intensity = if count > 0 then total / count else 0
	Util.getMatchState():SetAttribute("intensity", intensity)

	-- montée : intensité < 25 pendant 120 s → un événement du catalogue « bas »
	if intensity < DirectorConfig.Rise.Below then
		lowSince = lowSince or os.clock()
		if os.clock() - lowSince >= DirectorConfig.Rise.For then
			lowSince = nil
			ai.EventDirector:RequestLow()
		end
	else
		lowSince = nil
	end
	-- pic : intensité > 75 pendant 90 s → pause de 60 à 90 s (sauf acte 4)
	if intensity > DirectorConfig.Peak.Above and not TensionDirector:IsFinalAssault() then
		highSince = highSince or os.clock()
		if os.clock() - highSince >= DirectorConfig.Peak.For then
			highSince = nil
			pausedUntil = os.clock()
				+ DirectorConfig.Peak.PauseMin
				+ math.random() * (DirectorConfig.Peak.PauseMax - DirectorConfig.Peak.PauseMin)
		end
	else
		highSince = nil
	end
	-- acte 1 : 1 aperçu lointain (CS_03) et 2 signes garantis (EventDirector)
	local state = Util.getMatchState()
	if state:GetAttribute("act") == 1 then
		ai.EventDirector:EnsureAct1Guarantees()
	end
	-- 19.6 (C32) : événements hors catalogue « bas », selon leurs propres règles (acte, lieu)
	for _, player in Players:GetPlayers() do
		ai.EventDirector:RequestOwnRules(player)
	end
end

function TensionDirector:Init(allServices, aiModules)
	services = allServices
	ai = aiModules
end

function TensionDirector:Start()
	local state = Util.getMatchState()
	state:GetAttributeChangedSignal("act"):Connect(function()
		if state:GetAttribute("act") == 3 then -- constante (numéro d'acte)
			act3StartedAt = os.clock()
		end
	end)
	services.HealthService.Died:Connect(function(player)
		local act = Util.getMatchState():GetAttribute("act") or 0
		deathsInAct[act] = (deathsInAct[act] or 0) + 1
		table.insert(deathTimes, os.clock())
		for _, other in Players:GetPlayers() do
			if other ~= player then
				self:StrongEvent(other) -- mort d'un coéquipier
			end
		end
	end)
	services.WeaponService.CreatureHit:Connect(function(_model, _damage, shooter)
		shotCreature[shooter] = true
	end)
	task.spawn(function()
		local step = 1 / CreatureConfig.Rates.Director
		while true do
			task.wait(step)
			tick()
		end
	end)
	local _ = ActConfig
end

return TensionDirector
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="194">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ServerScriptService/Bootstrap (Partie)
-- Section 16.1 : charge les services dans l'ordre. Chaque service reçoit Init(services)
-- (références entre services, aucune attente), puis Start() une fois tous initialisés.
local ServerScriptService = game:GetService("ServerScriptService")

local servicesFolder = ServerScriptService:WaitForChild("Services")

-- ordre de chargement : DataService d'abord, les autres en dépendent
local ORDER = {
	"DataService",
	"ReturnService",
	"PartyLoaderService",
	"NoiseService",
	"InteractionService",
	"CharacterService",
	"SpawnService",
	"HealthService",
	"StaminaService",
	"FearService",
	"InventoryService",
	"ItemSpawnService",
	"WeaponService",
	"EvidenceService",
	"DocumentService",
	"TabletService",
	"CinematicService",
	"WeatherService",
	"ExtractionService",
	"GameStateService",
	"HiddenClueService",
	"GoreService",
}

local services = {}
for _, name in ORDER do
	local module = servicesFolder:FindFirstChild(name)
	if module == nil then
		warn("Bootstrap : service manquant : Services/" .. name)
	else
		services[name] = require(module)
	end
end

for _, name in ORDER do
	local service = services[name]
	if service ~= nil and service.Init ~= nil then
		local ok, err = pcall(service.Init, service, services)
		if not ok then
			warn("Bootstrap : échec de " .. name .. ".Init : " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service ~= nil and service.Start ~= nil then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn("Bootstrap : échec de " .. name .. ".Start : " .. tostring(err))
		end
	end
end

-- 16.1 : modules de ServerScriptService/AI (IA de la créature), après les services
local AI_ORDER = {
	"NavGraph",
	"Perception",
	"CreatureAnimator",
	"MimicService",
	"TensionDirector",
	"EventDirector",
	"FamilyBrain",
	"CreatureDebug",
}
local aiFolder = ServerScriptService:WaitForChild("AI")
local aiModules = {}
for _, name in AI_ORDER do
	local module = aiFolder:FindFirstChild(name)
	if module == nil then
		warn("Bootstrap : module d'IA manquant : AI/" .. name)
	else
		aiModules[name] = require(module)
	end
end
for _, name in AI_ORDER do
	local module = aiModules[name]
	if module and module.Init then
		local ok, err = pcall(module.Init, module, services, aiModules)
		if not ok then
			warn("Bootstrap : échec de AI/" .. name .. ".Init : " .. tostring(err))
		end
	end
end
for _, name in AI_ORDER do
	local module = aiModules[name]
	if module and module.Start then
		local ok, err = pcall(module.Start, module)
		if not ok then
			warn("Bootstrap : échec de AI/" .. name .. ".Start : " .. tostring(err))
		end
	end
end

print("Bootstrap (Partie) : services démarrés")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="195">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="196">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/CharacterService (Partie)
-- Sections 7.1 et 16.2 : l'avatar Roblox n'est jamais utilisé. Au spawn, le serveur clone le skin
-- choisi (ReplicatedStorage/Characters/<ROLE>/Skin_<n>) et l'assigne à Player.Character.
-- Modèle absent (MANQUANT, 13.3) : un mannequin Roblox neutre nommé MANQUANT_CHR_<ROLE>_Skin_<n>.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))

local CharacterService = {}

-- (player, character) : personnage créé et posé au départ
CharacterService.Spawned = Signal.new()

local services = nil
local roleOf = {} -- [Player] = role id
local order = {} -- ordre d'arrivée (index du point de départ)
local matchReady = false

local function takenRoles()
	local taken = {}
	for _, role in roleOf do
		taken[role] = true
	end
	return taken
end

-- rôle de la configuration de partie, sinon le premier rôle libre (DÉFAUT : test dans Studio, ou rôle non choisi)
local function assignRole(player, info)
	local entry = info.roles[player.UserId]
	local taken = takenRoles()
	if entry and entry.role and not taken[entry.role] then
		return entry.role
	end
	for _, role in PlayerConfig.Roles do
		if not taken[role.id] then
			return role.id
		end
	end
	return nil
end

local function equippedSkin(player, role)
	local data = services.DataService:WaitForData(player)
	local skin = data and data.equipped and data.equipped[role]
	return skin or ProgressionConfig.DefaultSkin
end

local function buildCharacter(player, role)
	local skin = equippedSkin(player, role)
	local folder = ReplicatedStorage:FindFirstChild(PlayerConfig.CharactersFolder)
	local roleFolder = folder and folder:FindFirstChild(role)
	local template = roleFolder and roleFolder:FindFirstChild(PlayerConfig.SkinPrefix .. skin)
	local character
	if template ~= nil then
		character = template:Clone()
	else
		-- 13.3 : CHR_<ROLE>_Skin_A–C MANQUANT → mannequin neutre, noté dans SUIVI.md
		warn(("CharacterService : modèle manquant Characters/%s/%s%s"):format(role, PlayerConfig.SkinPrefix, skin))
		character =
			Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
		character:SetAttribute("placeholder", ("MANQUANT_CHR_%s_%s%s"):format(role, PlayerConfig.SkinPrefix, skin))
	end
	character.Name = player.Name
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- la mort est gérée par HealthService (ragdoll, sac au sol), pas par Roblox
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
	end
	return character
end

-- personnage assigné à la main (CharacterAutoLoads = false) : Roblox ne copie pas StarterGui ;
-- le serveur clone donc chaque ScreenGui déjà présent (15.1 : clones de modèles existants)
local function ensureGui(player)
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	if playerGui == nil then
		return
	end
	for _, gui in game:GetService("StarterGui"):GetChildren() do
		if gui:IsA("LayerCollector") and playerGui:FindFirstChild(gui.Name) == nil then
			gui:Clone().Parent = playerGui
		end
	end
end

local function setup(player)
	if roleOf[player] ~= nil or player.Parent == nil then
		return
	end
	local info = services.PartyLoaderService:GetMatchInfo()
	local role = assignRole(player, info)
	if role == nil then
		warn("CharacterService : aucun rôle libre pour " .. player.Name)
		return
	end
	roleOf[player] = role
	table.insert(order, player)
	player:SetAttribute("role", role)

	ensureGui(player)
	local character = buildCharacter(player, role)
	player.Character = character
	character.Parent = workspace
	services.SpawnService:Place(player, character, info.start, table.find(order, player))
	CharacterService.Spawned:Fire(player, character)
end

function CharacterService:GetRole(player)
	return roleOf[player]
end

-- rôles présents dans la partie (4.4 : sous 10 joueurs, les rôles non pris n'existent pas)
function CharacterService:GetPlayersByRole()
	local result = {}
	for player, role in roleOf do
		if player.Parent ~= nil then
			result[role] = player
		end
	end
	return result
end

function CharacterService:IsMatchReady()
	return matchReady
end

function CharacterService:Init(allServices)
	services = allServices
	Players.CharacterAutoLoads = false
end

function CharacterService:Start()
	task.spawn(function()
		local _, players = services.PartyLoaderService:WaitUntilLoaded()
		matchReady = true
		for _, player in players do
			task.spawn(setup, player)
		end
		for _, player in Players:GetPlayers() do
			task.spawn(setup, player)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		if matchReady then
			setup(player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		roleOf[player] = nil
	end)
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="197">
        <Properties>
          <string name="Name">CinematicService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/CinematicService (Partie)
-- Sections 6.1 et 16.2 : déclenche les cinématiques. Une cinématique de lieu ne joue que pour les
-- joueurs dans son rayon ; les cinématiques de fin jouent pour tous. Pendant une cinématique, le
-- personnage est invulnérable et retiré des cibles de la créature, plus 3 s après (attribut
-- cinematicUntil, heure serveur). En partie : passer = vote à la majorité des joueurs concernés.
-- RE_PlayCinematic (S → C) : ("Play", id, extra) / ("Stop", id) / ("SkipVotes", n, total).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CinematicConfig = require(Config:WaitForChild("CinematicConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local CinematicService = {}

CinematicService.Finished = Signal.new() -- (id, skipped)

local remote = nil
local radioOutOfRange -- défini plus bas
local current = nil -- { id, viewers = {Player}, votes = {[Player]=true}, done = Signal }

local function viewersFor(id, explicit)
	local def = CinematicConfig.Cinematics[id]
	if explicit then
		return explicit
	end
	if def.scope == "Place" then
		local place = MapConfig.Places[def.place]
		local list = {}
		for _, player in Players:GetPlayers() do
			local root = Util.characterRoot(player)
			if root and (root.Position - place.pos).Magnitude <= (place.radius or 0) then
				table.insert(list, player)
			end
		end
		return list
	end
	return Players:GetPlayers()
end

-- 19.5 (C24) : les joueurs hors du rayon d'une cinématique de lieu reçoivent un message radio,
-- dit par le personnage du joueur le plus proche du lieu (parmi ceux qui la voient)
radioOutOfRange = function(id, viewers)
	local def = CinematicConfig.Cinematics[id]
	local text = CinematicConfig.OutOfRangeRadioText[id]
	if def.scope ~= "Place" or text == nil or #viewers == 0 then
		return
	end
	local place = MapConfig.Places[def.place]
	local speaker, best = nil, math.huge
	for _, viewer in viewers do
		local root = Util.characterRoot(viewer)
		local distance = if root then (root.Position - place.pos).Magnitude else math.huge
		if distance < best then
			speaker, best = viewer, distance
		end
	end
	if speaker == nil then
		return
	end
	for _, player in Players:GetPlayers() do
		if not table.find(viewers, player) and not player:GetAttribute("isDead") then
			Util.notify(player, id, { player = speaker.DisplayName })
		end
	end
end

local function finish(skipped)
	if current == nil then
		return
	end
	local ended = current
	current = nil
	local safeUntil = workspace:GetServerTimeNow() + CinematicConfig.SafetyAfter
	for _, player in ended.viewers do
		if player.Parent then
			player:SetAttribute("cinematicUntil", safeUntil)
			if skipped and remote then
				remote:FireClient(player, "Stop", ended.id)
			end
		end
	end
	CinematicService.Finished:Fire(ended.id, skipped)
	ended.done:Fire()
end

-- joue une cinématique et attend sa fin ; `players` facultatif (sinon selon la portée de 6.2)
function CinematicService:PlayAndWait(id, players, extra)
	local def = CinematicConfig.Cinematics[id]
	if def == nil then
		warn("CinematicService : cinématique inconnue " .. tostring(id))
		return
	end
	-- 19.5 (C23) : vidéo dans la tablette — ni caméra, ni file d'attente, ni invulnérabilité
	if def.inTablet then
		for _, player in viewersFor(id, players) do
			if remote then
				remote:FireClient(player, "Play", id, extra)
			end
		end
		return
	end
	while current ~= nil do
		current.done:Wait()
	end
	local viewers = viewersFor(id, players)
	radioOutOfRange(id, viewers)
	if #viewers == 0 then
		return
	end
	local done = Signal.new()
	current = { id = id, viewers = viewers, votes = {}, done = done }
	local untilTime = workspace:GetServerTimeNow() + def.duration + CinematicConfig.SafetyAfter
	for _, player in viewers do
		player:SetAttribute("cinematicUntil", untilTime)
		if remote then
			remote:FireClient(player, "Play", id, extra)
		end
	end
	local mine = current
	task.delay(def.duration, function()
		if current == mine then
			finish(false)
		end
	end)
	done:Wait()
end

function CinematicService:Play(id, players, extra)
	task.spawn(self.PlayAndWait, self, id, players, extra)
end

function CinematicService:IsProtected(player)
	return (player:GetAttribute("cinematicUntil") or 0) > workspace:GetServerTimeNow()
end

local function onSkipVote(player)
	if current == nil or not table.find(current.viewers, player) then
		return
	end
	current.votes[player] = true
	local count = 0
	for voter in current.votes do
		if voter.Parent then
			count += 1
		end
	end
	for _, viewer in current.viewers do
		if remote and viewer.Parent then
			remote:FireClient(viewer, "SkipVotes", count, #current.viewers)
		end
	end
	if count * 2 > #current.viewers then
		finish(true)
	end
end

function CinematicService:Init() end

function CinematicService:Start()
	remote = Util.getRemote("RE_PlayCinematic")
	local skip = Util.getRemote("RE_CinematicSkipVote")
	if skip then
		RateLimiter.connect(skip, onSkipVote)
	end
end

return CinematicService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="198">
        <Properties>
          <string name="Name">DocumentService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/DocumentService (Partie)
-- Sections 2.7, 8.3 et 16.2 : documents trouvés (texte de LoreConfig.Documents), journal du groupe
-- (appli Journal de la tablette, dans l'ordre de découverte), tablette des géologues (DOC_07, DOC_08),
-- carnet Halvorsen (DOC_12, pages débloquées par l'histoire).
-- RE_OpenDocument (S → C) : (docId) ; le client affiche DocumentGui.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local DocumentService = {}

DocumentService.Read = Signal.new() -- (docId, player) : première lecture par le groupe

local services = nil
local journal = {} -- liste ordonnée des docId lus par le groupe
local openRemote = nil

local function publish()
	Util.getMatchState():SetAttribute("journal", Util.encode(journal))
end

function DocumentService:HasRead(docId)
	return table.find(journal, docId) ~= nil
end

-- ajoute au journal du groupe ; renvoie true à la première lecture
function DocumentService:AddToJournal(docId, player)
	if self:HasRead(docId) then
		return false
	end
	table.insert(journal, docId)
	publish()
	self.Read:Fire(docId, player)
	return true
end

function DocumentService:Open(player, docId)
	if openRemote and LoreConfig.Documents[docId] then
		openRemote:FireClient(player, docId)
	end
end

-- document ramassé dans le monde
function DocumentService:Collect(player, docId, _part)
	self:AddToJournal(docId, player)
	self:Open(player, docId)
	services.EvidenceService:OnDocument(player, docId)
end

-- 16.4 et 2.7 : pages du carnet (la page 1 est débloquée au départ)
local pages = table.clone(ProgressionConfig.DefaultNotebookPages)

function DocumentService:UnlockNotebookPage(index)
	pages[index] = true
	Util.getMatchState():SetAttribute("notebookPages", Util.encode(pages))
end

function DocumentService:GetNotebookPages()
	return pages
end

local function onItemUsed(player, itemId)
	if itemId == "ITM_TabletGeo" then
		-- 8.3 : la tablette des géologues contient DOC_07 et DOC_08 ; la lire copie la couche « tunnels »
		for _, docId in ItemConfig.Items.ITM_TabletGeo.documents do
			DocumentService:AddToJournal(docId, player)
		end
		Util.getMatchState():SetAttribute("tunnelLayer", true)
		DocumentService:Open(player, "DOC_07")
	elseif itemId == "ITM_Notebook" then
		-- 7.7 : la Descendante lit le carnet familial
		if player:GetAttribute("role") == "Descendant" then
			DocumentService:Open(player, "DOC_12")
		end
	end
end

function DocumentService:Init(allServices)
	services = allServices
end

function DocumentService:Start()
	openRemote = Util.getRemote("RE_OpenDocument")
	publish()
	DocumentService:UnlockNotebookPage(1)
	services.InventoryService.ItemUsed:Connect(onItemUsed)
end

return DocumentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="199">
        <Properties>
          <string name="Name">EvidenceService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/EvidenceService (Partie)
-- Section 8.4 : preuves A/B/C. Une preuve est un objet d'inventaire ; elle ne compte que si un
-- survivant la sort de la forêt (CommitForSurvivor, appelé à l'extraction).
-- Vidéo A : créature visible à 60 % au moins, à 30 studs ou moins, 2 s sans interruption
-- (le caméscope a la vision nocturne). Carte mémoire ITM_SDCard créée après la vidéo.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local TaggedSet = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TaggedSet"))
local Util = require(Shared:WaitForChild("Util"))

local EvidenceService = {}

EvidenceService.Filmed = Signal.new() -- (player, creature, distance) : rancune +0,5 si filmée à moins de 30 studs (9.7)
EvidenceService.Created = Signal.new() -- (player, itemId)

local services = nil
local recordingSince = {} -- [Player] = os.clock() du début de la séquence visible
local Evidence = ItemConfig.Evidence

local VIDEO_CHECK = require(Config:WaitForChild("PlayerConfig")).Technical.VideoCheckInterval

local function creatures()
	return TaggedSet.list("Creature")
end

-- RaycastParams par (créature, personnage qui filme) : feuillages « Foliage » transparents ;
-- construits une fois, mis à jour seulement quand un « Foliage » est ajouté ou retiré
local visibilityParams = setmetatable({}, { __mode = "k" })
local function visibilityFor(creature, ignore)
	local key = ignore and ignore[1] or creature
	local byCreature = visibilityParams[creature]
	if byCreature == nil then
		byCreature = setmetatable({}, { __mode = "k" })
		visibilityParams[creature] = byCreature
	end
	if byCreature[key] == nil then
		local base = { creature }
		for _, inst in ignore or {} do
			table.insert(base, inst)
		end
		byCreature[key] = TaggedSet.excludeParams(base, { "Foliage" })
	end
	return byCreature[key]:Get()
end

-- fraction des parties de la créature visibles depuis `origin` (les feuillages tagués « Foliage » ne bloquent pas)
function EvidenceService:VisibleFraction(origin, creature, ignore)
	local parts = {}
	for _, part in creature:GetDescendants() do
		if part:IsA("BasePart") and part.Transparency < 1 then
			table.insert(parts, part)
		end
	end
	if #parts == 0 then
		return 0
	end
	local params = visibilityFor(creature, ignore)
	local visible = 0
	for _, part in parts do
		local hit = workspace:Raycast(origin, part.Position - origin, params)
		if hit == nil then
			visible += 1
		end
	end
	return visible / #parts
end

local function give(player, itemId, extra)
	if services.InventoryService:Add(player, itemId, 1, extra) then
		EvidenceService.Created:Fire(player, itemId)
		return true
	end
	return false
end

local function nearestCreature(position, maxDistance)
	local best, bestDistance = nil, maxDistance
	for _, creature in creatures() do
		local d = (creature:GetPivot().Position - position).Magnitude
		if d <= bestDistance then
			best, bestDistance = creature, d
		end
	end
	return best, bestDistance
end

local function checkVideo(dt)
	for _, player in Players:GetPlayers() do
		local entry = services.InventoryService:Selected(player)
		local head = player.Character and player.Character:FindFirstChild("Head")
		if entry and entry.id == "ITM_Camcorder" and entry.recording and head then
			-- 8.1 : 6 min d'enregistrement
			local minutes = ItemConfig.Items.ITM_Camcorder.recordMinutes
			entry.battery = math.max(0, (entry.battery or 1) - dt / (minutes * Util.SECONDS_PER_MINUTE))
			if entry.battery <= 0 then
				entry.recording = false
			end
			local creature, distance = nearestCreature(head.Position, Evidence.VideoA.maxDistance)
			local ok = creature ~= nil
				and EvidenceService:VisibleFraction(head.Position, creature, { player.Character })
					>= Evidence.VideoA.minVisibleFraction
			if ok then
				EvidenceService.Filmed:Fire(player, creature, distance)
				recordingSince[player] = recordingSince[player] or os.clock()
				if os.clock() - recordingSince[player] >= Evidence.VideoA.minDuration then
					recordingSince[player] = nil
					entry.recording = false
					give(player, "ITM_SDCard")
				end
			else
				recordingSince[player] = nil
			end
		else
			recordingSince[player] = nil
		end
	end
end

local function nearTagged(tag, position, range)
	for _, inst in TaggedSet.list(tag) do
		local pos = inst:IsA("Model") and inst:GetPivot().Position or inst.Position
		if (pos - position).Magnitude <= range then
			return inst
		end
	end
	return nil
end

local function onItemUsed(player, itemId, entry)
	local root = Util.characterRoot(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if root == nil or head == nil then
		return
	end
	if itemId == "ITM_Camcorder" then
		-- 7.7 : seul le Caméraman produit des preuves de classe A
		if player:GetAttribute("role") == "Cameraman" then
			entry.recording = not entry.recording
			player:SetAttribute("isFilming", entry.recording)
		end
	elseif itemId == "ITM_PhotoCamera" then
		local def = ItemConfig.Items.ITM_PhotoCamera
		-- flash = lumière ×3 pendant 0,2 s (lu par la perception)
		player:SetAttribute("flashUntil", workspace:GetServerTimeNow() + def.flashDuration)
		entry.uses = (entry.uses or def.uses) - 1
		local creature = nearestCreature(head.Position, Evidence.PhotoB.maxDistance)
		if creature and EvidenceService:VisibleFraction(head.Position, creature, { player.Character }) > 0 then
			give(player, "EVD_PhotoCreature")
		elseif
			(root.Position - MapConfig.Places[Evidence.PhotoC.place].pos).Magnitude
			<= MapConfig.Places[Evidence.PhotoC.place].radius
		then
			give(player, "EVD_PhotoCharnier")
		end
		if entry.uses <= 0 then
			services.InventoryService:Remove(player, itemId, 1)
		end
	elseif itemId == "ITM_PlasterKit" then
		local print_ = nearTagged("Footprint", root.Position, ItemConfig.PickupDistance)
		local age = print_ and (os.clock() - (print_:GetAttribute("createdAt") or -math.huge))
		if print_ and age <= Evidence.PlasterB.footprintMaxAge then
			local now = workspace:GetServerTimeNow()
			player:SetAttribute("busyUntil", now + Evidence.PlasterB.workTime)
			task.delay(Evidence.PlasterB.workTime, function()
				player:SetAttribute("busyUntil", nil)
				if services.HealthService:IsUp(player) then
					entry.uses = (entry.uses or ItemConfig.Items.ITM_PlasterKit.uses) - 1
					give(player, "EVD_Cast")
					if entry.uses <= 0 then
						services.InventoryService:Remove(player, itemId, 1)
					end
				end
			end)
		end
	elseif itemId == "ITM_AudioRecorder" then
		entry.recording = not entry.recording
	elseif itemId == "ITM_SampleBag" then
		local p05 = MapConfig.Places.P05
		local nearStructure = nearTagged("StickStructure", root.Position, ItemConfig.PickupDistance)
		local nearRim = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(p05.pos.X, p05.pos.Z)).Magnitude
				<= p05.radius
			-- DÉFAUT : « au bord » = plus près du bord (Y 400) que du fond (Y 250)
			and root.Position.Y >= (p05.rimY + p05.floorY) / 2
		if nearStructure or nearRim then
			if services.InventoryService:Remove(player, itemId, 1) then
				give(player, "EVD_Hair")
			end
		end
	end
end

-- 8.4 : enregistrement d'un cri à moins de 150 studs (appelé par l'IA à chaque cri)
function EvidenceService:OnCreatureCall(position)
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		local entry = services.InventoryService:Selected(player)
		if root and entry and entry.id == "ITM_AudioRecorder" and entry.recording then
			if (root.Position - position).Magnitude <= Evidence.CallB.maxDistance then
				entry.recording = false
				give(player, "EVD_Call")
			end
		end
	end
end

-- 8.4 : document ramassé (DOC_03 à DOC_10) = preuve C
function EvidenceService:OnDocument(player, docId)
	if table.find(Evidence.DocumentC, docId) then
		give(player, "EVD_Document", { doc = docId })
	end
end

-- preuves portées par un joueur : { { itemId, class, kind, doc } }
function EvidenceService:Carried(player)
	local result = {}
	local inv = services.InventoryService:Get(player)
	if inv == nil then
		return result
	end
	for _, list in { inv.quick, inv.bag } do
		for _, entry in list do
			local def = entry and ItemConfig.Items[entry.id]
			if def and def.evidence then
				for _ = 1, entry.count or 1 do
					table.insert(
						result,
						{ itemId = entry.id, class = def.evidence.class, kind = def.evidence.kind, doc = entry.doc }
					)
				end
			end
		end
	end
	return result
end

function EvidenceService:CarriesClassA(player)
	for _, e in self:Carried(player) do
		if e.class == "A" then
			return true
		end
	end
	return false
end

-- 8.4 et 16.4 : un survivant sort de la forêt : preuves sauvegardées (200 au plus), XP de 8.4
function EvidenceService:CommitForSurvivor(player)
	local carried = self:Carried(player)
	local data = services.DataService:GetData(player)
	local xp = 0
	if data then
		for _, e in carried do
			table.insert(data.evidence, { class = e.class, kind = e.kind, date = os.time() })
			xp += ProgressionConfig.XPGains["Evidence" .. e.class] or 0
			if e.class == "B" then
				data.evidenceBOut = (data.evidenceBOut or 0) + 1 -- 19.5 (C38) : sac « Cold Trail »
			end
		end
		-- DÉFAUT : au-delà de 200, les plus anciennes sont retirées
		while #data.evidence > ProgressionConfig.MaxEvidence do
			table.remove(data.evidence, 1)
		end
		data.xp += xp
	end
	return carried, xp
end

-- appli Preuves de la tablette : preuves du groupe, classe, qui les porte
local function publishGroup()
	local list = {}
	for _, player in Players:GetPlayers() do
		for _, e in EvidenceService:Carried(player) do
			table.insert(list, { class = e.class, kind = e.kind, holder = player.DisplayName })
		end
	end
	Util.getMatchState():SetAttribute("evidence", Util.encode(list))
end

function EvidenceService:Init(allServices)
	services = allServices
end

function EvidenceService:Start()
	services.InventoryService.ItemUsed:Connect(onItemUsed)
	services.InventoryService.Changed:Connect(publishGroup)
	task.spawn(function()
		while true do
			task.wait(VIDEO_CHECK)
			checkVideo(VIDEO_CHECK)
		end
	end)
end

return EvidenceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="200">
        <Properties>
          <string name="Name">ExtractionService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/ExtractionService (Partie)
-- Sections 3.3, 5.2 et 16.2 : voies d'extraction E1–E4.
-- Une voie principale est tirée parmi E1, E2, E3 ; E4 est ouverte si DOC_07 a été lu.
-- Préparation (acte 3) : E1 changer la roue (cric, 20 s / 10 s Mécanicienne) ; E2 réparer la radio
-- (câble + batterie, 30 s) ; E3 réparer le bulldozer (jerrican + relais, 40 s).
-- Déclenchement (acte 4, DÉFAUT) : E1 démarrer le van (clés) ; E2 appeler puis tenir 180 s sur l'aire ;
-- E3 conduire 650 studs à 8 studs/s ; E4 dégager le bouchon (60 s, DOC_07 + une lampe).
-- Ancres : Part de Workspace/Places nommées E1_Van, E2_Radio, E2_Pad, E3_Bulldozer, E4_Plug si
-- Gabriel les pose ; sinon ancres invisibles aux coordonnées de MapConfig (DÉFAUT).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local ExtractionService = {}

ExtractionService.Prepared = Signal.new() -- (routeId) : la voie est prête (fin de l'acte 3)
ExtractionService.Extracted = Signal.new() -- (routeId, players) : extraction déclenchée
ExtractionService.Calling = Signal.new() -- (routeId, endTime) : E2, attente de l'hélicoptère

local services = nil
local routes = {} -- [routeId] = { prepared, triggered, prompts = {} }
local mainRoute = nil
local triggersOpen = false

local Routes = ActConfig.Routes

local function anchor(name, position)
	local places = workspace:FindFirstChild("Places")
	local found = places and places:FindFirstChild(name, true)
	if found and found:IsA("BasePart") then
		return found
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Size = ItemConfig.PlaceholderSize
	part.Position = position
	part.Parent = workspace
	return part
end

-- joueurs debout dans un rayon
local function playersNear(position, radius)
	local list = {}
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if root and services.HealthService:IsUp(player) and (root.Position - position).Magnitude <= radius then
			table.insert(list, player)
		end
	end
	return list
end

-- objets demandés : portés par le joueur ou par un coéquipier tout près
local function hasItems(player, position, items)
	local nearby = playersNear(position, ItemConfig.PickupDistance)
	if not table.find(nearby, player) then
		table.insert(nearby, player)
	end
	for _, id in items do
		local found = false
		for _, p in nearby do
			if services.InventoryService:Has(p, id) then
				found = true
			end
		end
		if not found then
			return false
		end
	end
	return true
end

local function consume(player, position, items)
	local nearby = playersNear(position, ItemConfig.PickupDistance)
	table.insert(nearby, 1, player)
	for _, id in items do
		for _, p in nearby do
			if services.InventoryService:Remove(p, id, 1) then
				break
			end
		end
	end
end

-- 8.1 : caisse à outils : réparations à vitesse normale ; sans elle, ×2 plus long ;
-- 5.2 et 7.7 : durée propre à la Mécanicienne
local function repairDuration(route, base)
	return function(player)
		local duration = (route.roleRepairTime and route.roleRepairTime[player:GetAttribute("role")]) or base
		if
			player:GetAttribute("role") == "Mechanic" and not (route.roleRepairTime and route.roleRepairTime.Mechanic)
		then
			duration /= require(Config:WaitForChild("PlayerConfig")).Abilities.Mechanic.RepairFactor
		end
		if not services.InventoryService:Has(player, "ITM_ToolBox") then
			duration *= ItemConfig.Items.ITM_ToolBox.withoutFactor
		end
		return duration
	end
end

local function prepared(routeId)
	routes[routeId].prepared = true
	ExtractionService.Prepared:Fire(routeId)
end

local function extract(routeId, players)
	local state = routes[routeId]
	if state.triggered then
		return
	end
	state.triggered = true
	ExtractionService.Extracted:Fire(routeId, players)
end

local function prompt(routeId, part, opts)
	local p = services.InteractionService:CreatePrompt(part, opts)
	table.insert(routes[routeId].prompts, p)
	return p
end

local SETUP = {}

SETUP.E1 = function(route)
	local part = anchor("E1_Van", MapConfig.Extractions.E1.pos)
	prompt("E1", part, {
		action = LoreConfig.Prompts.ChangeWheel,
		durationFor = repairDuration(route, route.repairTime),
		holdDuration = route.repairTime,
		canUse = function(player)
			return not routes.E1.prepared and hasItems(player, part.Position, { "ITM_Jack" })
		end,
		onTriggered = function()
			prepared("E1")
		end,
	})
	prompt("E1", part, {
		action = LoreConfig.Prompts.Drive,
		canUse = function(player)
			return routes.E1.prepared and triggersOpen and hasItems(player, part.Position, { "ITM_Keys" })
		end,
		onTriggered = function(player)
			-- 5.2 et 19.6 (C26) : démarrage bruyant (1 500 studs) ; le directeur autorise une attaque immédiate
			-- sur le van (attribut vanStartedAt lu par TensionDirector:AllowAttack) ; les joueurs autour du van
			-- partent (P01, rayon 60)
			services.NoiseService:Emit(part.Position, ActConfig.Routes.E1.startNoise, NoiseTypes.Vehicle, player)
			Util.getMatchState():SetAttribute("vanStartedAt", workspace:GetServerTimeNow())
			extract("E1", playersNear(MapConfig.Places.P01.pos, MapConfig.Places.P01.radius))
		end,
	})
end

SETUP.E2 = function(route)
	local p11 = MapConfig.Places.P11
	local radio = anchor("E2_Radio", p11.pos + Vector3.new(0, p11.cabinOffset, 0))
	local pad = MapConfig.Extractions.E2
	prompt("E2", radio, {
		action = LoreConfig.Prompts.Repair,
		durationFor = repairDuration(route, route.repairTime),
		holdDuration = route.repairTime,
		canUse = function(player)
			return not routes.E2.prepared and hasItems(player, radio.Position, route.needs)
		end,
		onTriggered = function(player)
			consume(player, radio.Position, route.needs)
			prepared("E2")
			-- 2.7 : DOC_09 rejoué quand la radio est réparée
			for _, listener in playersNear(radio.Position, p11.radius + p11.cabinOffset) do
				services.DocumentService:AddToJournal("DOC_09", listener)
				services.DocumentService:Open(listener, "DOC_09")
			end
		end,
	})
	prompt("E2", radio, {
		action = LoreConfig.Prompts.Call,
		canUse = function()
			return routes.E2.prepared and triggersOpen and not routes.E2.calling
		end,
		onTriggered = function()
			routes.E2.calling = true
			local endTime = workspace:GetServerTimeNow() + route.holdTime
			Util.getMatchState():SetAttribute("helicopterAt", endTime)
			ExtractionService.Calling:Fire("E2", endTime)
			task.delay(route.holdTime, function()
				local half = pad.area / 2
				local list = {}
				for _, player in Players:GetPlayers() do
					local root = Util.characterRoot(player)
					if root and services.HealthService:IsUp(player) then
						local d = root.Position - pad.pos
						if math.abs(d.X) <= half.X and math.abs(d.Z) <= half.Y then
							table.insert(list, player)
						end
					end
				end
				extract("E2", list)
			end)
		end,
	})
end

SETUP.E3 = function(route)
	local p10 = MapConfig.Places.P10
	local bulldozer = anchor("E3_Bulldozer", p10.pos)
	prompt("E3", bulldozer, {
		action = LoreConfig.Prompts.Repair,
		durationFor = repairDuration(route, route.repairTime),
		holdDuration = route.repairTime,
		canUse = function(player)
			return not routes.E3.prepared and hasItems(player, bulldozer.Position, route.needs)
		end,
		onTriggered = function(player)
			consume(player, bulldozer.Position, route.needs)
			prepared("E3")
		end,
	})
	prompt("E3", bulldozer, {
		action = LoreConfig.Prompts.Drive,
		canUse = function()
			return routes.E3.prepared and triggersOpen and not routes.E3.driving
		end,
		onTriggered = function()
			routes.E3.driving = true
			-- 5.2 : conduire 650 studs jusqu'à la barrière, lent (8 studs/s) ; la créature peut y grimper
			local target = MapConfig.Extractions.E3.pos
			local direction = (target - bulldozer.Position) * Vector3.new(1, 0, 1)
			local goal = bulldozer.Position + direction.Unit * route.driveDistance
			local duration = route.driveDistance / route.driveSpeed
			bulldozer:AddTag("Bulldozer")
			local tween =
				TweenService:Create(bulldozer, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Position = goal })
			tween:Play()
			tween.Completed:Wait()
			-- DÉFAUT : les joueurs à portée d'interaction du bulldozer partent avec lui
			extract("E3", playersNear(bulldozer.Position, ItemConfig.PickupDistance))
		end,
	})
end

SETUP.E4 = function(route)
	local plug = anchor("E4_Plug", MapConfig.Places.P07c.pos)
	prompt("E4", plug, {
		action = LoreConfig.Prompts.ClearPlug,
		holdDuration = route.clearTime,
		canUse = function(player)
			local hasLight = player:GetAttribute("lightOn") == true
			return triggersOpen and services.DocumentService:HasRead("DOC_07") and hasLight
		end,
		onTriggered = function()
			local p07c = MapConfig.Places.P07c
			-- DÉFAUT : les joueurs à portée d'interaction de la sortie partent
			extract("E4", playersNear(plug.Position, math.max(p07c.radius, ItemConfig.PickupDistance)))
		end,
	})
end

-- fin du siège : tirage de la voie principale (graine de la partie)
function ExtractionService:DrawMainRoute(seed)
	local random = Random.new(seed)
	mainRoute = ActConfig.MainRoutes[random:NextInteger(1, #ActConfig.MainRoutes)]
	Util.getMatchState():SetAttribute("mainRoute", mainRoute)
	return mainRoute
end

function ExtractionService:GetMainRoute()
	return mainRoute
end

-- acte 3 : active la voie principale, et E4 si DOC_07 a été lu
function ExtractionService:Activate()
	local list = { mainRoute }
	if services.DocumentService:HasRead(ActConfig.SecretRoute.requiresDocument) then
		table.insert(list, ActConfig.SecretRoute.id)
	end
	for _, routeId in list do
		if routes[routeId] == nil then
			routes[routeId] = { prompts = {} }
			SETUP[routeId](Routes[routeId])
		end
	end
	Util.getMatchState():SetAttribute("routes", Util.encode(list))
end

-- E4 ouverte dès que DOC_07 est lu pendant l'acte 3 ou 4
function ExtractionService:OnDocumentRead(docId)
	if docId == ActConfig.SecretRoute.requiresDocument and mainRoute ~= nil then
		self:Activate()
	end
end

-- acte 4 : les déclenchements deviennent possibles (DÉFAUT)
function ExtractionService:OpenTriggers()
	triggersOpen = true
end

function ExtractionService:IsPrepared(routeId)
	return routes[routeId] ~= nil and routes[routeId].prepared == true
end

function ExtractionService:Init(allServices)
	services = allServices
end

function ExtractionService:Start()
	services.DocumentService.Read:Connect(function(docId)
		self:OnDocumentRead(docId)
	end)
end

return ExtractionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="201">
        <Properties>
          <string name="Name">FearService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/FearService (Partie)
-- Section 7.5 : peur de 0 à 100 (attribut fear), jamais affichée en chiffre.
-- Lumière : la lampe du joueur allumée (attribut lightOn) ou une source taguée « LightSource »
-- dont la portée (attribut range) couvre le joueur. Feu et fusée : tag « FireSource » (attribut radius).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TaggedSet = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("TaggedSet"))

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local NoiseTypes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NoiseTypes"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local FearService = {}

local Fear = PlayerConfig.Fear
local services = nil
local state = {} -- [Player] = { lastScream, seenBodies = {}, lastOrder }

local function nearestTeammate(player, position)
	local best = math.huge
	for _, other in Players:GetPlayers() do
		if other ~= player and services.HealthService:IsAlive(other) then
			local root = Util.characterRoot(other)
			if root then
				best = math.min(best, (root.Position - position).Magnitude)
			end
		end
	end
	return best
end

local function inLight(player, position, radius)
	if player:GetAttribute("lightOn") then
		return true
	end
	for _, source in TaggedSet.list("LightSource") do
		local part = if source:IsA("BasePart") then source else source:FindFirstAncestorWhichIsA("BasePart")
		local range = source:GetAttribute("range") or 0
		if part and (part.Position - position).Magnitude <= math.max(range, radius) then
			return true
		end
	end
	return false
end

local function nearFire(position)
	for _, source in TaggedSet.list("FireSource") do
		local part = if source:IsA("BasePart") then source else source:FindFirstAncestorWhichIsA("BasePart")
		local radius = source:GetAttribute("radius") or 0
		if part and (part.Position - position).Magnitude <= radius then
			return true
		end
	end
	return false
end

-- change la peur ; les hausses sont multipliées par le facteur du rôle (Descendante ×1,25)
function FearService:Add(player, amount)
	if not services.HealthService:IsAlive(player) then
		return
	end
	if amount > 0 then
		amount *= Fear.RoleFactor[player:GetAttribute("role")] or 1
	end
	local fear = math.clamp((player:GetAttribute("fear") or 0) + amount, 0, Fear.Max)
	player:SetAttribute("fear", fear)
	local s = state[player]
	if
		fear >= Fear.InvoluntaryScreamAt
		and s
		and os.clock() - (s.lastScream or -math.huge) >= Fear.InvoluntaryScreamCooldown
	then
		s.lastScream = os.clock()
		local root = Util.characterRoot(player)
		if root then
			-- 7.5 : cri involontaire (bruit 200) ; les coéquipiers à moins de 100 studs : +10
			services.NoiseService:Emit(root.Position, Fear.InvoluntaryScreamNoise, NoiseTypes.Scream, player)
			self:OnScream(root.Position, player)
		end
	end
end

-- 7.5 : cri à moins de 100 studs : +10 (cri de joueur ou de créature)
function FearService:OnScream(position, except)
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if player ~= except and root and (root.Position - position).Magnitude <= Fear.ScreamRadius then
			self:Add(player, Fear.Scream)
		end
	end
end

-- 7.5 : coup sur tronc entendu (+4) ; appelé par l'IA
function FearService:OnWoodKnock(player)
	self:Add(player, Fear.WoodKnock)
end

-- 7.5 et 19.6 (C1) : voir la créature : +20 à 150 studs, montant linéairement jusqu'à +35 à 20 studs
function FearService:OnSeeCreature(player, distance)
	if distance > Fear.SeeCreatureRange then
		return
	end
	local closeness =
		math.clamp((Fear.SeeCreatureRange - distance) / (Fear.SeeCreatureRange - Fear.SeeCreatureCloseRange), 0, 1)
	self:Add(player, Fear.SeeCreatureMin + (Fear.SeeCreatureMax - Fear.SeeCreatureMin) * closeness)
end

-- ligne de vue depuis la tête du joueur vers `target` (Model) ; feuillages « Foliage » transparents (DÉFAUT,
-- comme pour la vue de la créature). RaycastParams construits une fois par personnage (TaggedSet).
local sightParams = setmetatable({}, { __mode = "k" })
local function canSee(player, target, position)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if head == nil then
		return false
	end
	-- DÉFAUT : « voir » = la cible est devant le joueur (demi-espace de son regard)
	if head.CFrame.LookVector:Dot(position - head.Position) <= 0 then
		return false
	end
	local cache = sightParams[character]
	if cache == nil then
		cache = TaggedSet.excludeParams({ character }, { "Foliage" })
		sightParams[character] = cache
	end
	local hit = workspace:Raycast(head.Position, position - head.Position, cache:Get())
	return hit == nil or hit.Instance:IsDescendantOf(target)
end

local function pivotOf(instance)
	return if instance:IsA("Model") then instance:GetPivot().Position else instance.Position
end

-- 7.7 : ordre du Meneur : −20 aux coéquipiers à 15 studs, recharge 90 s
function FearService:LeaderOrder(player)
	local ability = PlayerConfig.Abilities.Leader
	local s = state[player]
	local root = Util.characterRoot(player)
	if player:GetAttribute("role") ~= "Leader" or not s or not root then
		return false
	end
	if os.clock() - (s.lastOrder or -math.huge) < ability.OrderCooldown then
		return false
	end
	s.lastOrder = os.clock()
	for _, other in Players:GetPlayers() do
		local otherRoot = Util.characterRoot(other)
		if otherRoot and (otherRoot.Position - root.Position).Magnitude <= ability.OrderRange then
			self:Add(other, ability.OrderFear)
		end
	end
	return true
end

local function tick(dt)
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if state[player] and root and services.HealthService:IsAlive(player) then
			local position = root.Position
			local delta = 0
			if inLight(player, position, Fear.NoLightRadius) then
				delta += Fear.InLightPerSecond
			else
				delta += Fear.NoLightPerSecond
			end
			local mate = nearestTeammate(player, position)
			if mate > Fear.AloneRadius then
				delta += Fear.AlonePerSecond
			elseif mate <= Fear.TeammateRadius then
				delta += Fear.TeammatePerSecond
			end
			if nearFire(position) then
				delta += Fear.NearFirePerSecond
			end
			-- 7.5 et 19.6 (C1) : voir un corps à 40 studs ou moins, en ligne de vue (+15 une fois par corps)
			local s = state[player]
			for _, corpse in TaggedSet.list("Corpse") do
				local pivot = pivotOf(corpse)
				if
					not s.seenBodies[corpse]
					and corpse ~= player.Character
					and (pivot - position).Magnitude <= Fear.SeeBodyRange
					and canSee(player, corpse, pivot)
				then
					s.seenBodies[corpse] = true
					FearService:Add(player, Fear.SeeBody)
				end
			end
			-- voir la créature en ligne de vue jusqu'à 150 studs, au plus toutes les 10 s par créature
			for _, creature in TaggedSet.list("Creature") do
				local pivot = pivotOf(creature)
				local distance = (pivot - position).Magnitude
				local last = s.seenCreatures[creature]
				if
					distance <= Fear.SeeCreatureRange
					and (last == nil or os.clock() - last >= Fear.SeeCreatureCooldown)
					and creature.Parent == workspace
					and canSee(player, creature, pivot)
				then
					s.seenCreatures[creature] = os.clock()
					FearService:OnSeeCreature(player, distance)
				end
			end
			FearService:Add(player, delta * dt)
		end
	end
end

function FearService:Init(allServices)
	services = allServices
end

function FearService:Start()
	services.CharacterService.Spawned:Connect(function(player)
		state[player] = { seenBodies = {}, seenCreatures = {} }
		player:SetAttribute("fear", 0)
	end)
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
		end
	end)
end

return FearService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="202">
        <Properties>
          <string name="Name">GameStateService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/GameStateService (Partie)
-- Sections 5 et 16.2 : actes, horloge, siège (acte 2), voie d'extraction, fins, fin à 06 h 00.
-- État publié dans MatchState : act, clock (heure décimale), objective, objectives (JSON),
-- siegeActive, finalAssault, creatureRetreat, mainRoute, routes, gameOver.
-- Interprétation (DÉFAUT, voir SUIVI.md) : un acte ne s'achève pas avant sa durée minimale, même
-- si sa condition est remplie ; il s'achève à sa durée maximale sinon.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CinematicConfig = require(Config:WaitForChild("CinematicConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local GameStateService = {}

local HOURS = 24 -- constante (heures dans une journée)

GameStateService.ActChanged = Signal.new() -- (act)
GameStateService.SiegeStarted = Signal.new()
GameStateService.SiegeEnded = Signal.new()
GameStateService.BarricadeBroken = Signal.new() -- (openingPart) : tentative d'entrée (ATK_ReachThrough)
GameStateService.GameEnded = Signal.new() -- (results)

local services = nil
local state = nil
local info = nil
local act = 0
local actStartedAt = 0
local transition = nil -- { from, to, startedAt }
local cluesFound = {}
local campEntered = false
local cabinEnteredAt = nil
local alphaKilled = false
local extracted = {} -- [Player] = routeId
local extractionDone = false
local openings = {} -- [name] = part

-- 19.5 (C19) : objectifs séquentiels. Chaque étape : { text, done = fn, count = fn }.
-- MatchState.objective = étape en cours (+ ligne facultative) ; objectives = liste de la tablette.
local objectiveSteps = nil
local objectiveExtra = nil -- fonction qui rend un texte facultatif ou nil (E4)
local objectiveHistory = {} -- textes des étapes terminées
local currentStep = nil

local function stepText(step)
	if step.count then
		return Util.formatMessage(step.text, { n = step.count() })
	end
	return step.text
end

local function setObjective(text, extra)
	local shown = text or ""
	if extra then
		shown ..= "\n" .. extra -- DÉFAUT : la ligne facultative sous l'objectif en cours
	end
	if state:GetAttribute("objective") == shown then
		return
	end
	state:SetAttribute("objective", shown)
	local list = table.clone(objectiveHistory)
	if text and text ~= "" then
		table.insert(list, text)
	end
	if extra then
		table.insert(list, extra)
	end
	state:SetAttribute("objectives", Util.encode(list))
	local remote = Util.getRemote("RE_Objective")
	if remote then
		remote:FireAllClients(act, shown)
	end
end

local function updateObjectives()
	if objectiveSteps == nil then
		return
	end
	local current = objectiveSteps[#objectiveSteps]
	for _, step in objectiveSteps do
		if not (step.done and step.done()) then
			current = step
			break
		end
	end
	if currentStep and currentStep ~= current then
		table.insert(objectiveHistory, stepText(currentStep))
	end
	currentStep = current
	setObjective(stepText(current), objectiveExtra and objectiveExtra())
end

-- texts : liste de textes de la bible ; rules : { [i] = { done = fn, count = fn } }
local function setObjectives(texts, rules, extra)
	if currentStep then
		table.insert(objectiveHistory, stepText(currentStep))
		currentStep = nil
	end
	objectiveSteps = {}
	for i, text in texts do
		local rule = rules and rules[i] or {}
		table.insert(objectiveSteps, { text = text, done = rule.done, count = rule.count })
	end
	objectiveExtra = extra
	updateObjectives()
end

-- un joueur du groupe porte cet objet
local function groupHas(itemId)
	for _, player in Players:GetPlayers() do
		if services.HealthService:IsAlive(player) and services.InventoryService:Has(player, itemId) then
			return true
		end
	end
	return false
end

local function elapsedInAct()
	return os.clock() - actStartedAt
end

-- 5.1 : dans un acte, l'heure avance linéairement de l'heure de début à l'heure de fin sur la
-- durée maximale ; au changement d'acte, elle saute à l'heure de début suivante en 10 s
local function updateClock()
	local def = ActConfig.Acts[act]
	local clock
	if transition then
		local t = math.clamp((os.clock() - transition.startedAt) / ActConfig.ActTransition, 0, 1)
		local to = transition.to
		if to < transition.from then
			to += HOURS
		end
		clock = (transition.from + (to - transition.from) * t) % HOURS
		if t >= 1 then
			transition = nil
		end
	else
		local t = math.clamp(elapsedInAct() / def.maxDuration, 0, 1)
		clock = (def.start + (def.finish - def.start) * t) % HOURS
		if def.finish == HOURS and t >= 1 then
			clock = 0
		end
	end
	state:SetAttribute("clock", clock)
	return clock
end

local function setAct(newAct)
	local previous = state:GetAttribute("clock") or ActConfig.Acts[newAct].start
	act = newAct
	actStartedAt = os.clock()
	if newAct > 0 then
		transition = { from = previous, to = ActConfig.Acts[newAct].start, startedAt = os.clock() }
	end
	state:SetAttribute("act", newAct)
	GameStateService.ActChanged:Fire(newAct)
	print(("GameStateService : acte %d (%s)"):format(newAct, ActConfig.Acts[newAct].name))
end

local function maxReached()
	return elapsedInAct() >= ActConfig.Acts[act].maxDuration
end

local function minReached()
	return elapsedInAct() >= ActConfig.Acts[act].minDuration
end

local function step()
	task.wait(PlayerConfig.Technical.Tick)
	updateClock()
	updateObjectives()
end

local function alivePlayers()
	local list = {}
	for _, player in Players:GetPlayers() do
		if services.HealthService:IsAlive(player) and extracted[player] == nil then
			table.insert(list, player)
		end
	end
	return list
end

local function anyInside(place)
	for _, player in alivePlayers() do
		local root = Util.characterRoot(player)
		if root and (root.Position - place.pos).Magnitude <= place.radius then
			return true
		end
	end
	return false
end

-- 5.2 : barricades de la cabane (porte, fenêtre, trou du toit). Part nommées Door, Window, RoofHole
-- dans Workspace/Places/P05c si posées à la main ; sinon ancres invisibles autour de P05c (DÉFAUT).
local function setupBarricades()
	local cabin = MapConfig.Places.P05c
	local places = workspace:FindFirstChild("Places")
	local folder = places and places:FindFirstChild("P05c")
	for index, name in ActConfig.Siege.Openings do
		local part = folder and folder:FindFirstChild(name)
		if part == nil or not part:IsA("BasePart") then
			part = Instance.new("Part")
			part.Name = name
			part.Anchored = true
			part.CanCollide = false
			part.Transparency = 1
			part.Size = ItemConfig.PlaceholderSize
			local angle = (index - 1) * (2 * math.pi / #ActConfig.Siege.Openings)
			local r = cabin.radius / 2
			part.Position = cabin.pos + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
			part.Parent = workspace
		end
		part:SetAttribute("planks", 0)
		part:SetAttribute("impacts", 0)
		part:AddTag("Barricade")
		openings[name] = part
		services.InteractionService:CreatePrompt(part, {
			action = require(Config:WaitForChild("LoreConfig")).Prompts.Barricade,
			holdDuration = ActConfig.Siege.PlankTime,
			roleHoldDuration = ActConfig.Siege.RolePlankTime,
			canUse = function(player)
				return part:GetAttribute("planks") == 0 and services.InventoryService:Has(player, "ITM_Plank")
			end,
			onTriggered = function(player)
				if services.InventoryService:Remove(player, "ITM_Plank", 1) then
					part:SetAttribute("planks", 1)
					part:SetAttribute("impacts", 0)
					services.NoiseService:Emit(
						part.Position,
						ItemConfig.Items.ITM_Plank.nailNoise,
						NoiseTypes.Repair,
						player
					)
				end
			end,
		})
	end
end

-- 5.2 : une planche reçoit 4 impacts avant de céder ; appelé par l'IA (pierres du siège)
function GameStateService:HitBarricade(part)
	if part:GetAttribute("planks") ~= 1 then
		return
	end
	local impacts = (part:GetAttribute("impacts") or 0) + 1
	part:SetAttribute("impacts", impacts)
	if impacts >= ActConfig.Siege.PlankImpacts then
		part:SetAttribute("planks", 0)
		self.BarricadeBroken:Fire(part)
	end
end

function GameStateService:GetOpenings()
	return openings
end

function GameStateService:GetAct()
	return act
end

-- 9.12 et 5.3 : appelé par l'IA quand l'Alpha meurt
function GameStateService:OnAlphaKilled()
	alphaKilled = true
	state:SetAttribute("alphaKilled", true)
end

local function cluesCount()
	local found = 0
	for _ in cluesFound do
		found += 1
	end
	return found
end

local function runAct1()
	setAct(1)
	local tabletRead = function()
		return services.DocumentService:HasRead("DOC_07")
	end
	-- DÉFAUT : « Fouiller le camp » est fait quand le camp est atteint et qu'un indice ou la tablette
	-- y a été trouvé
	setObjectives(ActConfig.Objectives[1], {
		{
			done = function()
				return campEntered and (cluesCount() > 0 or tabletRead())
			end,
		},
		{ done = tabletRead },
		{
			done = function()
				return cluesCount() >= ActConfig.Act1.CluesNeeded
			end,
			count = function()
				return math.min(cluesCount(), ActConfig.Act1.CluesNeeded)
			end,
		},
	})
	while true do
		if not campEntered and anyInside(MapConfig.Places[ActConfig.Act1.CampPlace]) then
			campEntered = true
			services.CinematicService:Play("CS_04") -- 1re entrée dans P09
		end
		local found = cluesCount()
		-- 5.2 : la tablette indique le point de repli ; l'objectif de la cabane vient une fois l'acte fini
		if
			extractionDone
			or (tabletRead() and found >= ActConfig.Act1.CluesNeeded and minReached())
			or maxReached()
		then
			break
		end
		step()
	end
end

local function barricaded()
	local n = 0
	for _, part in openings do
		if (part:GetAttribute("planks") or 0) > 0 then
			n += 1
		end
	end
	return n
end

local function runAct2()
	setAct(2)
	services.WeatherService:SiegeChange() -- 5.2 : la météo se dégrade
	local siege = ActConfig.Siege
	local cabin = MapConfig.Places[siege.CabinPlace]
	setObjectives(ActConfig.Objectives[2], {
		{
			done = function()
				return cabinEnteredAt ~= nil or state:GetAttribute("siegeActive") == true
			end,
		},
		{
			-- DÉFAUT : l'étape passe à « Tenir » quand les 3 ouvertures sont barricadées ou que le siège commence
			done = function()
				return barricaded() >= #siege.Openings or state:GetAttribute("siegeActive") == true
			end,
			count = barricaded,
		},
		{},
	})
	-- le siège commence 60 s après l'entrée du premier joueur, ou à 23 h 05 si personne n'y est
	while true do
		if cabinEnteredAt == nil and anyInside(cabin) then
			cabinEnteredAt = os.clock()
		end
		local clock = updateClock()
		if extractionDone or (cabinEnteredAt and os.clock() - cabinEnteredAt >= siege.StartDelayAfterEntry) then
			break
		end
		if transition == nil and clock >= siege.StartHourIfNobody and clock < ActConfig.Acts[2].finish then
			break
		end
		step()
	end
	state:SetAttribute("siegeActive", true)
	state:SetAttribute("siegeStartedAt", workspace:GetServerTimeNow())
	GameStateService.SiegeStarted:Fire()
	services.CinematicService:Play("CS_06")
	local started = os.clock()
	while os.clock() - started < siege.Duration and not extractionDone do
		step()
	end
	state:SetAttribute("siegeActive", false)
	state:SetAttribute("silence", true)
	local quiet = os.clock()
	while os.clock() - quiet < siege.SilenceAfter and not extractionDone do
		step()
	end
	state:SetAttribute("silence", false)
	GameStateService.SiegeEnded:Fire()
	-- 5.2 : page 2 du carnet ; voie d'extraction tirée et annoncée (CS_07)
	services.DocumentService:UnlockNotebookPage(siege.NotebookPageUnlocked)
	for _, player in Players:GetPlayers() do
		local data = services.DataService:GetData(player)
		if data then
			data.notebookPages[siege.NotebookPageUnlocked] = true
		end
	end
	local route = services.ExtractionService:DrawMainRoute(info.seed)
	services.CinematicService:PlayAndWait("CS_07", nil, { text = ActConfig.RouteAnnounce[route] })
end

-- 19.5 (C19) : ligne facultative de E4 si DOC_07 a été lu
local function secretLine(actNumber)
	return function()
		local secret = ActConfig.SecretRoute
		if services.DocumentService:HasRead(secret.requiresDocument) then
			return ActConfig.Objectives[actNumber][secret.id][1]
		end
		return nil
	end
end

-- règles d'avancement des objectifs de l'acte 3 (DÉFAUT : objet porté par un joueur du groupe)
local function act3Rules(route)
	local prepared = function()
		return services.ExtractionService:IsPrepared(route)
	end
	local has = function(itemId)
		return function()
			return prepared() or groupHas(itemId)
		end
	end
	if route == "E1" then
		return { { done = has("ITM_Keys") }, { done = has("ITM_Jack") }, { done = prepared } }
	elseif route == "E2" then
		local p11 = MapConfig.Places.P11
		return {
			{ done = has("ITM_CoaxCable") },
			{
				-- la batterie est à la tour : un joueur qui la porte est dans P11
				done = function()
					if prepared() then
						return true
					end
					for _, player in Players:GetPlayers() do
						local root = Util.characterRoot(player)
						if
							root
							and services.InventoryService:Has(player, "ITM_CarBattery")
							and (root.Position - p11.pos).Magnitude <= p11.radius
						then
							return true
						end
					end
					return false
				end,
			},
			{ done = prepared },
		}
	end
	return { { done = has("ITM_Jerrycan") }, { done = has("ITM_StarterRelay") }, { done = prepared } }
end

local function runAct3()
	setAct(3) -- constante (numéro d'acte, 5.1)
	services.CinematicService:Play("CS_08")
	services.ExtractionService:Activate()
	local mainRoute = services.ExtractionService:GetMainRoute()
	setObjectives(ActConfig.Objectives[3][mainRoute], act3Rules(mainRoute), secretLine(3)) -- constante (acte 3)
	while true do
		local route = services.ExtractionService:GetMainRoute()
		if extractionDone or (services.ExtractionService:IsPrepared(route) and minReached()) or maxReached() then
			break
		end
		step()
	end
end

local ACT_DAWN = 4 -- constante (numéro de l'acte 4, 5.1)

local function runAct4()
	setAct(4) -- constante (numéro d'acte, 5.1)
	services.CinematicService:Play("CS_09")
	local mainRoute = services.ExtractionService:GetMainRoute()
	local hold = ActConfig.Routes.E2.holdTime
	setObjectives(ActConfig.Objectives[ACT_DAWN][mainRoute], {
		{
			-- E2 : secondes restantes avant l'hélicoptère (durée entière avant l'appel)
			count = function()
				local at = state:GetAttribute("helicopterAt")
				return if at then math.max(0, math.ceil(at - workspace:GetServerTimeNow())) else hold
			end,
		},
	}, secretLine(ACT_DAWN))
	-- 5.2 : à 05 h 00, dernier assaut
	state:SetAttribute("finalAssault", true)
	services.ExtractionService:OpenTriggers()
	while not extractionDone do
		local clock = updateClock()
		if clock >= ActConfig.Dawn.CreatureRetreatHour then
			state:SetAttribute("creatureRetreat", true) -- aucune attaque après 05 h 50, sauf dans les tunnels
		end
		if maxReached() or clock >= ActConfig.EndHour then
			break
		end
		step()
	end
end

-- 5.3 : fins et récompenses
local function computeResults()
	local endings = {}
	local survivors, truthSurvivors = 0, 0
	local classA = false
	for player, route in extracted do
		if route == "E4" then
			truthSurvivors += 1
		else
			survivors += 1
		end
		if services.EvidenceService:CarriesClassA(player) then
			classA = true
		end
	end
	if survivors > 0 then
		endings.Survie = true
		if classA then
			endings.Preuve = true
		end
	end
	if truthSurvivors > 0 then
		endings.Verite = true
		if classA then
			endings.Preuve = true
		end
	end
	if alphaKilled then
		endings.Ordonnance = true
		endings.Survie = nil -- Ordonnance 69-01 remplace Survie
	end
	if survivors + truthSurvivors == 0 then
		endings.Silence = true
	end

	local players = {}
	local evidence = {}
	local xpByUser = {}
	for _, player in Players:GetPlayers() do
		local status = if extracted[player]
			then "Extracted"
			elseif player:GetAttribute("isDead") then "Dead"
			else "Missing"
		table.insert(players, { name = player.DisplayName, status = status })
		local data = services.DataService:GetData(player)
		local xp = ProgressionConfig.XPGains.GamePlayed
		if extracted[player] then
			local carried, evidenceXp = services.EvidenceService:CommitForSurvivor(player)
			xp += ProgressionConfig.XPGains.Survival + evidenceXp
			for _, e in carried do
				table.insert(evidence, { class = e.class, kind = e.kind, holder = player.DisplayName })
			end
		end
		if data then
			data.plays += 1
			-- l'XP des preuves a déjà été ajoutée par EvidenceService:CommitForSurvivor
			data.xp += ProgressionConfig.XPGains.GamePlayed + (if extracted[player]
				then ProgressionConfig.XPGains.Survival
				else 0)
			if extracted[player] then
				data.survivals += 1
				data.nightmareUnlocked = true -- 5.4 : Cauchemar après une première survie
			end
			for ending in endings do
				data.endings[ending] = true
			end
			if endings.Verite then
				data.notebookPages[ActConfig.Endings.Verite.notebookPage] = true -- 5.3 : page 3 du carnet
			end
			services.DataService:Save(player)
		end
		xpByUser[tostring(player.UserId)] = xp
	end
	return { endings = endings, players = players, evidence = evidence, xp = xpByUser }
end

local function endingCinematics(results)
	local order = {}
	if results.endings.Ordonnance then
		table.insert(order, ActConfig.Endings.Ordonnance.cinematic)
	end
	if results.endings.Survie then
		for _, route in extracted do
			if route ~= "E4" then
				table.insert(order, ActConfig.Endings.Survie.cinematics[route])
				break
			end
		end
	end
	if results.endings.Verite then
		table.insert(order, ActConfig.Endings.Verite.cinematic)
	end
	if results.endings.Preuve then
		table.insert(order, ActConfig.Endings.Preuve.cinematic)
	end
	if results.endings.Silence then
		table.insert(order, ActConfig.Endings.Silence.cinematic)
	end
	for _, id in order do
		services.CinematicService:PlayAndWait(id, Players:GetPlayers())
	end
end

local function endGame()
	state:SetAttribute("gameOver", true)
	local results = computeResults()
	GameStateService.GameEnded:Fire(results)
	endingCinematics(results)
	local remote = Util.getRemote("RE_EndGame")
	if remote then
		remote:FireAllClients(results)
	end
	services.ReturnService:ReturnAll(results)
end

local function run()
	local _, players = services.PartyLoaderService:WaitUntilLoaded()
	info = services.PartyLoaderService:GetMatchInfo()
	-- attendre que les personnages soient posés
	local waited = 0
	while waited < PlayerConfig.Technical.Tick * 10 do
		local ready = true
		for _, player in players do
			if player.Parent and player:GetAttribute("role") == nil then
				ready = false
			end
		end
		if ready then
			break
		end
		task.wait(PlayerConfig.Technical.Tick)
		waited += PlayerConfig.Technical.Tick
	end
	state:SetAttribute("difficulty", info.difficulty)
	services.WeatherService:Begin(info)
	setupBarricades()

	-- acte 0 : arrivée, 3 min fixes
	setAct(0)
	setObjectives(ActConfig.Objectives[0])
	services.CinematicService:Play(CinematicConfig.StartCinematic[info.start] or CinematicConfig.StartCinematic.S1)
	if info.start == "S3" then
		campEntered = true -- 5.2 : déjà au camp si départ S3
	end
	while not maxReached() and not extractionDone do
		step()
	end
	local acts = { runAct1, runAct2, runAct3, runAct4 }
	for _, runAct in acts do
		if extractionDone or #alivePlayers() == 0 then
			break
		end
		runAct()
	end
	endGame()
end

function GameStateService:Init(allServices)
	services = allServices
	state = Util.getMatchState()
	state:SetAttribute("act", 0)
	state:SetAttribute("clock", ActConfig.Acts[0].start)
end

function GameStateService:Start()
	services.ItemSpawnService.ClueFound:Connect(function(clueId)
		cluesFound[clueId] = true
		state:SetAttribute("cluesFound", Util.encode(Util.sortedKeys(cluesFound)))
	end)
	services.ExtractionService.Extracted:Connect(function(routeId, list)
		for _, player in list do
			extracted[player] = routeId
			player:SetAttribute("extracted", routeId)
		end
		if #list > 0 then
			extractionDone = true
		end
	end)
	-- DOC_08 lu : vidéo de la tablette (CS_05) pour le lecteur
	services.DocumentService.Read:Connect(function(docId, player)
		if docId == "DOC_08" and player then
			services.CinematicService:Play("CS_05", { player })
		end
	end)
	-- tous morts : la partie s'arrête (Silence)
	services.HealthService.Died:Connect(function()
		if #alivePlayers() == 0 and not state:GetAttribute("gameOver") then
			extractionDone = true
		end
	end)
	task.spawn(run)
end

return GameStateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="203">
        <Properties>
          <string name="Name">GoreService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/GoreService (Partie)
-- DÉFAUT : module ajouté (16.2 ne nomme pas le service du gore, jalon J13).
-- Section 11 : profil Restricted / Moderate. Démembrement (Restricted) : un coup de plus de 50 sur un
-- bras ou une jambe à moins de 10 % de PV détache le membre (pièce libre + capuchon Gore_Stump_<Membre>,
-- sans détail anatomique). Corps des géologues : variantes « Restricted » / « Moderate » posées dans
-- Studio (enfants des modèles Body_* de Workspace/Places). Sang, flaques et plaies : affichage client
-- (GoreController), selon le profil et l'option « Gore réduit » (11.4).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local GoreConfig = require(Config:WaitForChild("GoreConfig"))

local GoreService = {}

local services = nil

-- parties de rig par membre (R15 ; un skin découpé en 6 maillages peut nommer ses pièces pareil, 7.1)
local RIG_PARTS = {
	ArmL = { "LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm" },
	ArmR = { "RightUpperArm", "RightLowerArm", "RightHand", "Right Arm" },
	LegL = { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "Left Leg" },
	LegR = { "RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg" },
}

function GoreService:Profile()
	return GoreConfig.Profiles[GoreConfig.Profile] or GoreConfig.Profiles.Moderate
end

local function detach(player, limb)
	local character = player.Character
	if character == nil or player:GetAttribute("lost" .. limb) then
		return
	end
	player:SetAttribute("lost" .. limb, true)
	for _, name in RIG_PARTS[limb] do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			for _, joint in part:GetChildren() do
				if joint:IsA("Motor6D") then
					joint:Destroy()
				end
			end
			part.CanCollide = true
			part.Parent = workspace -- pièce libre
		end
	end
	local stumps = ReplicatedStorage:FindFirstChild("Items")
	local stump = stumps and stumps:FindFirstChild(GoreConfig.Dismember.StumpPrefix .. limb)
	if stump then
		stump:Clone().Parent = character
	end
end

local function onDamaged(player, limb, amount)
	if not GoreService:Profile().dismember or not table.find(GoreConfig.Dismember.Limbs, limb) then
		return
	end
	if
		amount > GoreConfig.Dismember.MinHit
		and services.HealthService:GetFraction(player, limb) < GoreConfig.Dismember.MaxLimbFraction
	then
		detach(player, limb)
	end
end

-- variantes des corps des géologues selon le profil (DÉFAUT : enfants nommés comme le profil)
local function applyBodies()
	local places = workspace:FindFirstChild("Places")
	if places == nil then
		return
	end
	local wanted = GoreService:Profile().geologistBodies
	for _, body in places:GetDescendants() do
		if body:IsA("Model") and string.match(body.Name, "^Body_") then
			-- 19.6 (C1) : les corps des géologues comptent pour « voir un corps » (+15 de peur)
			body:AddTag("Corpse")
			for _, variant in body:GetChildren() do
				if variant.Name == "Restricted" or variant.Name == "Moderate" then
					variant.Parent = if variant.Name == wanted then body else nil
				end
			end
		end
	end
end

function GoreService:Init(allServices)
	services = allServices
	Players:SetAttribute("goreProfile", GoreConfig.Profile)
	workspace:SetAttribute("goreProfile", GoreConfig.Profile)
end

function GoreService:Start()
	services.HealthService.Damaged:Connect(onDamaged)
	applyBodies()
end

return GoreService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="204">
        <Properties>
          <string name="Name">HealthService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/HealthService (Partie)
-- Section 7.3 : santé par membre, sang, hémorragies, à terre, relever, mort définitive, ragdoll.
-- Attributs du joueur (16.3) : hpHead, hpTorso, hpArmL, hpArmR, hpLegL, hpLegR, blood,
-- bleed ("None", "Light", "Heavy"), splinted, isDowned, downedEnd (heure serveur), isDead.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ActConfig = require(Config:WaitForChild("ActConfig"))
local GoreConfig = require(Config:WaitForChild("GoreConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))

local HealthService = {}

HealthService.Damaged = Signal.new() -- (player, limb, amount, source)
HealthService.Downed = Signal.new() -- (player)
HealthService.Revived = Signal.new() -- (player, rescuer)
HealthService.Died = Signal.new() -- (player, cause)

-- 9.4 : points de piste laissés par une hémorragie { position, time }
HealthService.BloodTrail = {}

local services = nil
local state = {} -- [Player] = { downedLimb, lastTrail, revivePrompt, carryPrompt, downedRemaining }
local carryWeld = {} -- [Player porté] = WeldConstraint

local function attr(limb)
	return "hp" .. limb
end

local function maxHealth(player, limb)
	local role = player:GetAttribute("role")
	local override = PlayerConfig.RoleLimbHealth[role]
	return (override and override[limb]) or PlayerConfig.LimbHealth[limb]
end

local function fraction(player, limb)
	return (player:GetAttribute(attr(limb)) or 0) / maxHealth(player, limb)
end

function HealthService:GetFraction(player, limb)
	return fraction(player, limb)
end

function HealthService:IsAlive(player)
	return player:GetAttribute("isDead") ~= true and player:GetAttribute("hpTorso") ~= nil
end

function HealthService:IsUp(player)
	return self:IsAlive(player) and player:GetAttribute("isDowned") ~= true
end

-- 7.3 : membre sous 30 %
function HealthService:IsLow(player, limb)
	return fraction(player, limb) < PlayerConfig.LowLimbThreshold
end

-- 7.2 : boiter (jambe < 30 %, sauf attelle)
function HealthService:IsLimping(player)
	if player:GetAttribute("splinted") then
		return false
	end
	return self:IsLow(player, "LegL") or self:IsLow(player, "LegR")
end

function HealthService:Setup(player)
	for _, limb in PlayerConfig.Limbs do
		player:SetAttribute(attr(limb), maxHealth(player, limb))
	end
	player:SetAttribute("blood", PlayerConfig.Blood.Max)
	player:SetAttribute("bleed", "None")
	player:SetAttribute("splinted", false)
	player:SetAttribute("isDowned", false)
	player:SetAttribute("downedEnd", nil)
	player:SetAttribute("isDead", false)
	state[player] = { lastTrail = nil }
end

-- 11.5 : ragdoll — chaque Motor6D devient un BallSocketConstraint ; ancré après 10 s immobile
local function ragdoll(character)
	for _, motor in character:GetDescendants() do
		if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
			local a0 = Instance.new("Attachment")
			a0.CFrame = motor.C0
			a0.Parent = motor.Part0
			local a1 = Instance.new("Attachment")
			a1.CFrame = motor.C1
			a1.Parent = motor.Part1
			local socket = Instance.new("BallSocketConstraint")
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.Parent = motor.Parent
			motor.Enabled = false
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end
	task.spawn(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		local still = 0
		local step = 1
		while character.Parent ~= nil and root and still < GoreConfig.Ragdoll.AnchorAfterStill do
			task.wait(step)
			if root.AssemblyLinearVelocity.Magnitude < 0.5 then
				still += step
			else
				still = 0
			end
		end
		for _, part in character:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
	end)
end

local function clearRevivePrompt(player)
	local s = state[player]
	if s and s.revivePrompt then
		s.revivePrompt:Destroy()
		s.revivePrompt = nil
	end
	if s and s.carryPrompt then
		s.carryPrompt:Destroy()
		s.carryPrompt = nil
	end
	if s then
		s.downedRemaining = nil
	end
end

local function playerById(userId)
	return if userId then Players:GetPlayerByUserId(userId) else nil
end

-- le corps porté n'a plus de masse ni de collision ; les collisions d'origine sont rendues ensuite
local savedCollide = {} -- [Player porté] = { [BasePart] = CanCollide }
local function setCarriedPhysics(player, carried)
	local character = player.Character
	if character == nil then
		return
	end
	local saved = savedCollide[player] or {}
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			part.Massless = carried
			if carried then
				saved[part] = part.CanCollide
				part.CanCollide = false
			elseif saved[part] ~= nil then
				part.CanCollide = saved[part]
			end
		end
	end
	savedCollide[player] = if carried then saved else nil
end

-- 19.5 (C6) : poser le joueur porté (ou le lâcher si le porteur tombe, meurt ou part)
function HealthService:PutDown(carried)
	local carrier = playerById(carried:GetAttribute("carriedBy"))
	local weld = carryWeld[carried]
	if weld then
		weld:Destroy()
		carryWeld[carried] = nil
	end
	carried:SetAttribute("carriedBy", nil)
	setCarriedPhysics(carried, false)
	if carrier then
		carrier:SetAttribute("carrying", nil)
		local s = state[carrier]
		if s and s.putDownPrompt then
			s.putDownPrompt:Destroy()
			s.putDownPrompt = nil
		end
	end
end

-- 19.5 (C6) : charger un coéquipier à terre sur l'épaule
function HealthService:PickUp(carrier, carried)
	local carrierRoot = carrier.Character and carrier.Character:FindFirstChild("HumanoidRootPart")
	local carriedRoot = carried.Character and carried.Character:FindFirstChild("HumanoidRootPart")
	if carrierRoot == nil or carriedRoot == nil then
		return
	end
	if carrier:GetAttribute("carrying") ~= nil or carried:GetAttribute("carriedBy") ~= nil then
		return
	end
	setCarriedPhysics(carried, true)
	carriedRoot.CFrame = carrierRoot.CFrame * CFrame.new(PlayerConfig.Technical.CarryOffset)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = carrierRoot
	weld.Part1 = carriedRoot
	weld.Parent = carrierRoot
	carryWeld[carried] = weld
	carrier:SetAttribute("carrying", carried.UserId)
	carried:SetAttribute("carriedBy", carrier.UserId)
	-- ni arme à feu ni lampe en main : la lampe tenue s'éteint (la frontale reste)
	if services.InventoryService and carrier:GetAttribute("lightOn") then
		services.InventoryService:SetLight(carrier, true)
	end
	-- poser : Utiliser 1 s, invite visible du seul porteur
	local s = state[carrier]
	if s and services.InteractionService then
		s.putDownPrompt = services.InteractionService:CreatePrompt(carriedRoot, {
			action = LoreConfig.Prompts.PutDown,
			holdDuration = PlayerConfig.Carry.PutDownTime,
			key = PlayerConfig.Technical.CarryKey,
			gamepadKey = PlayerConfig.Technical.CarryGamepadKey,
			visibleTo = function(other)
				return other == carrier
			end,
			canUse = function(other)
				return other == carrier
			end,
			onTriggered = function()
				HealthService:PutDown(carried)
			end,
		})
	end
end

-- lâche tout portage lié à ce joueur (porteur ou porté)
local function releaseCarry(player)
	if player:GetAttribute("carriedBy") ~= nil then
		HealthService:PutDown(player)
	end
	local carried = playerById(player:GetAttribute("carrying"))
	if carried then
		HealthService:PutDown(carried)
	end
	player:SetAttribute("carrying", nil)
end

function HealthService:Kill(player, cause)
	if player:GetAttribute("isDead") then
		return
	end
	clearRevivePrompt(player)
	releaseCarry(player)
	player:SetAttribute("isDead", true)
	player:SetAttribute("isDowned", false)
	player:SetAttribute("downedEnd", nil)
	local character = player.Character
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")
		-- 7.3 : l'inventaire tombe dans un sac ramassable
		if root and services.InventoryService then
			services.InventoryService:DropAllAsBag(player, root.Position)
		end
		character:AddTag("Corpse")
		ragdoll(character)
	end
	self.Died:Fire(player, cause)
end

function HealthService:Revive(player, rescuer)
	if not player:GetAttribute("isDowned") or player:GetAttribute("isDead") then
		return
	end
	local s = state[player]
	clearRevivePrompt(player)
	releaseCarry(player)
	-- 7.3 : le joueur revient avec 20 % sur le membre touché
	local limb = s and s.downedLimb
	if limb == "Blood" then
		player:SetAttribute("blood", PlayerConfig.ReviveBlood)
	elseif limb ~= nil then
		player:SetAttribute(attr(limb), maxHealth(player, limb) * PlayerConfig.Downed.ReviveLimbFraction)
	end
	player:SetAttribute("isDowned", false)
	player:SetAttribute("downedEnd", nil)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
	end
	self.Revived:Fire(player, rescuer)
end

function HealthService:SetDowned(player, limb)
	if player:GetAttribute("isDowned") or player:GetAttribute("isDead") then
		return
	end
	local info = services.PartyLoaderService:GetMatchInfo()
	local duration = ActConfig.difficulty(info.difficulty).downedTime
	local s = state[player]
	s.downedLimb = limb
	s.downedRemaining = duration
	-- un porteur qui tombe lâche le joueur porté
	releaseCarry(player)
	player:SetAttribute("isDowned", true)
	player:SetAttribute("downedEnd", workspace:GetServerTimeNow() + duration)
	self.Downed:Fire(player)

	-- relever : un coéquipier maintient l'invite 6 s (3 s pour la Médecin)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root and services.InteractionService then
		s.revivePrompt = services.InteractionService:CreatePrompt(root, {
			action = LoreConfig.Prompts.Revive,
			holdDuration = PlayerConfig.Downed.ReviveTime,
			roleHoldDuration = PlayerConfig.Downed.RoleReviveTime,
			-- 19.5 (C6) : pas de relèvement pendant le portage
			canUse = function(rescuer)
				return rescuer ~= player and HealthService:IsUp(rescuer) and player:GetAttribute("carriedBy") == nil
			end,
			visibleTo = function(rescuer)
				return rescuer ~= player
			end,
			onTriggered = function(rescuer)
				HealthService:Revive(player, rescuer)
			end,
		})
		-- 19.5 (C6) : porter — n'importe quel joueur, maintenir 2 s
		s.carryPrompt = services.InteractionService:CreatePrompt(root, {
			action = LoreConfig.Prompts.Carry,
			holdDuration = PlayerConfig.Carry.PickUpTime,
			key = PlayerConfig.Technical.CarryKey,
			gamepadKey = PlayerConfig.Technical.CarryGamepadKey,
			canUse = function(rescuer)
				return rescuer ~= player
					and HealthService:IsUp(rescuer)
					and rescuer:GetAttribute("carrying") == nil
					and player:GetAttribute("carriedBy") == nil
			end,
			visibleTo = function(rescuer)
				return rescuer ~= player
			end,
			onTriggered = function(rescuer)
				HealthService:PickUp(rescuer, player)
			end,
		})
	end
end

-- compte à rebours d'un joueur à terre (deux fois moins vite s'il est porté, C6)
local function downedTick(player, dt)
	local s = state[player]
	if s == nil or s.downedRemaining == nil or not player:GetAttribute("isDowned") then
		return
	end
	local speed = if player:GetAttribute("carriedBy") ~= nil then PlayerConfig.Carry.DownedTimeFactor else 1
	s.downedRemaining -= dt * speed
	if s.downedRemaining <= 0 then
		HealthService:Kill(player, "DownedTimeout")
		return
	end
	player:SetAttribute("downedEnd", workspace:GetServerTimeNow() + s.downedRemaining / speed)
end

local function setBleed(player, level)
	local order = { None = 0, Light = 1, Heavy = 2 }
	if order[level] > order[player:GetAttribute("bleed") or "None"] then
		player:SetAttribute("bleed", level)
	end
end

function HealthService:StartBleed(player, level)
	if self:IsAlive(player) then
		setBleed(player, level)
	end
end

-- bandage : arrête une hémorragie légère ; grave → légère. Médecin avec trousse : arrête la grave.
function HealthService:TreatBleed(player, canStopHeavy)
	local bleed = player:GetAttribute("bleed")
	if bleed == "Heavy" then
		player:SetAttribute("bleed", if canStopHeavy then "None" else "Light")
	elseif bleed == "Light" then
		player:SetAttribute("bleed", "None")
	end
end

-- membre le plus abîmé (proportion), voir PlayerConfig.HealTarget
function HealthService:MostDamagedLimb(player)
	local worst, worstFraction = PlayerConfig.Limbs[1], math.huge
	for _, limb in PlayerConfig.Limbs do
		local f = fraction(player, limb)
		if f < worstFraction then
			worst, worstFraction = limb, f
		end
	end
	return worst
end

function HealthService:Heal(player, limb, amount)
	limb = limb or self:MostDamagedLimb(player)
	local value = math.min(maxHealth(player, limb), (player:GetAttribute(attr(limb)) or 0) + amount)
	player:SetAttribute(attr(limb), value)
end

function HealthService:Splint(player)
	player:SetAttribute("splinted", true)
end

-- dégâts sur un membre ; `bleed` optionnel ("Light" / "Heavy") impose le niveau ;
-- `maxBleed` optionnel plafonne le niveau tiré des seuils (19.5, C2 : pierres → légère au plus) ;
-- `kind` optionnel : "Stone" (pierre lancée, 19.6 C3), "Burn" (brûlure du lance-fusées, C14)
function HealthService:Damage(player, limb, amount, source, bleed, maxBleed, kind)
	if not self:IsAlive(player) or amount <= 0 then
		return
	end
	-- 6.1 : invulnérable pendant une cinématique, plus 3 s
	if services.CinematicService and services.CinematicService:IsProtected(player) then
		return
	end
	if player:GetAttribute("isDowned") then
		-- 19.6 (C3) : une pierre ou un tir allié retire 10 s au compte à rebours, sans tuer ;
		-- une attaque de la créature tue
		local friendly = typeof(source) == "Instance" and source:IsA("Player")
		local s = state[player]
		if kind == "Burn" then
			return -- la brûlure du lance-fusées fait partie du tir allié, déjà compté
		end
		if (kind == "Stone" or friendly) and s and s.downedRemaining then
			-- DÉFAUT : le compte à rebours ne descend pas sous un pas de calcul (le coup ne tue pas)
			s.downedRemaining =
				math.max(PlayerConfig.Technical.Tick, s.downedRemaining - PlayerConfig.Downed.HitPenalty)
		elseif not friendly and kind ~= "Stone" then
			self:Kill(player, source)
		end
		return
	end
	local value = math.max(0, (player:GetAttribute(attr(limb)) or 0) - amount)
	player:SetAttribute(attr(limb), value)
	-- 19.5 (C2) : 20 à 34 → légère ; 35 ou plus → grave
	local onDamage = PlayerConfig.BleedOnDamage
	if bleed then
		setBleed(player, bleed)
	elseif amount >= onDamage.HeavyAt and maxBleed ~= "Light" then
		setBleed(player, "Heavy")
	elseif amount >= onDamage.LightAt then
		setBleed(player, "Light")
	end
	if player:GetAttribute("splinted") and (limb == "LegL" or limb == "LegR") then
		player:SetAttribute("splinted", false)
	end
	self.Damaged:Fire(player, limb, amount, source)
	-- 7.3 : à terre quand la tête ou le torse tombe à 0
	if value <= 0 and (limb == "Head" or limb == "Torso") then
		self:SetDowned(player, limb)
	end
end

local function rootOf(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function tick(dt)
	for _, player in Players:GetPlayers() do
		downedTick(player, dt)
		if HealthService:IsAlive(player) then
			local bleed = player:GetAttribute("bleed")
			if bleed ~= "None" then
				local rate = if bleed == "Heavy"
					then PlayerConfig.Blood.HeavyBleedPerSecond
					else PlayerConfig.Blood.LightBleedPerSecond
				local blood = math.max(0, player:GetAttribute("blood") - rate * dt)
				player:SetAttribute("blood", blood)
				if blood <= 0 then
					HealthService:Kill(player, "Blood")
				elseif blood < PlayerConfig.Blood.DownedBelow then
					HealthService:SetDowned(player, "Blood")
				end
				-- 9.4 : un point de piste tous les n studs, actif n secondes
				local smell = CreatureConfig.Smell
				local root = rootOf(player)
				if smell and smell.TrailSpacing and root then
					local s = state[player]
					if s.lastTrail == nil or (root.Position - s.lastTrail).Magnitude >= smell.TrailSpacing then
						s.lastTrail = root.Position
						table.insert(HealthService.BloodTrail, { position = root.Position, time = os.clock() })
					end
				end
			end
		end
	end
	-- purge des points de piste expirés
	local smell = CreatureConfig.Smell
	if smell and smell.TrailLifetime then
		local now = os.clock()
		local trail = HealthService.BloodTrail
		while #trail > 0 and now - trail[1].time > smell.TrailLifetime do
			table.remove(trail, 1)
		end
	end
end

function HealthService:Init(allServices)
	services = allServices
end

function HealthService:Start()
	services.CharacterService.Spawned:Connect(function(player)
		HealthService:Setup(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		clearRevivePrompt(player)
		releaseCarry(player)
		state[player] = nil
	end)
	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
		end
	end)
end

return HealthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="205">
        <Properties>
          <string name="Name">HiddenClueService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/HiddenClueService (Partie)
-- 19.5 (C7) : 4 « marques de mineurs » (MapConfig.HiddenClues), visibles seulement par la Descendante
-- à 8 studs et seulement si elle est dans le groupe. Elle les découvre en s'approchant (serveur) ;
-- HiddenClueController les affiche pour elle seule. DÉFAUT : service à part (les effets touchent la
-- tablette, la cabane, le gué et le puits).
-- Effets : HC1 repère de la boîte de munitions sur la tablette ; HC2 trappe vers un vide sanitaire
-- (2 joueurs, attribut hiddenFromSight) ; HC3 gué silencieux (attribut noiseFactor) ; HC4 descente du
-- puits P21 sans corde (sinon ITM_Rope, 8.1).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local HiddenClueService = {}

local DESCENDANT = "Descendant"
local RANGE = PlayerConfig.Abilities.Descendant.HiddenClueRange

local services = nil
local marks = {} -- [id] = Part
local found = {} -- [id] = true
local crawlers = {} -- joueurs dans le vide sanitaire (HC2)

local function positionOf(spec)
	return spec.pos or MapConfig.resolve(spec.place)
end

-- première partie taguée (posée à la main en B1), sinon le point de repli
local function taggedPart(tag)
	return CollectionService:GetTagged(tag)[1]
end

local function inside(part, position)
	local p = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y and math.abs(p.Z) <= half.Z
end

function HiddenClueService:IsFound(id)
	return found[id] == true
end

-- HC2 : entrer dans le vide sanitaire ou en sortir
local function toggleCrawl(player, mark, spec)
	local root = Util.characterRoot(player)
	if root == nil then
		return
	end
	local index = table.find(crawlers, player)
	if index then
		table.remove(crawlers, index)
		player:SetAttribute("hiddenFromSight", nil)
		root.CFrame = CFrame.new(mark.Position + Vector3.new(0, PlayerConfig.Technical.SpawnLift, 0))
		return
	end
	if #crawlers >= spec.capacity then
		return
	end
	table.insert(crawlers, player)
	player:SetAttribute("hiddenFromSight", true)
	local space = taggedPart(spec.tag)
	root.CFrame = CFrame.new(if space then space.Position else mark.Position)
end

local EFFECTS = {}

EFFECTS.AmmoBoxMarker = function()
	local draw = services.ItemSpawnService:GetDraw()
	local index = draw and draw.AmmoBox
	if index == nil then
		return -- pas de boîte (Cauchemar)
	end
	local position = MapConfig.resolve(MapConfig.KeyItems.AmmoBox.spots[index])
	if position then
		services.TabletService:AddMarker(position)
	end
end

EFFECTS.CrawlSpace = function(id, spec)
	local mark = marks[id]
	services.InteractionService:CreatePrompt(mark, {
		action = LoreConfig.Prompts.Open,
		canUse = function(player)
			return services.HealthService:IsAlive(player)
				and (table.find(crawlers, player) ~= nil or #crawlers < spec.capacity)
		end,
		onTriggered = function(player)
			toggleCrawl(player, mark, spec)
		end,
	})
end

EFFECTS.Ford = function(id, spec)
	local ford = taggedPart(spec.tag)
	services.TabletService:AddMarker(if ford then ford.Position else marks[id].Position)
	if ford == nil then
		warn("HiddenClueService : Part taguée « " .. spec.tag .. " » absente (gué de " .. id .. ", à poser en B1)")
		return
	end
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				local root = Util.characterRoot(player)
				local onFord = root ~= nil and inside(ford, root.Position)
				player:SetAttribute("noiseFactor", if onFord then spec.noiseFactor else nil)
			end
			task.wait(PlayerConfig.Technical.Tick)
		end
	end)
end

EFFECTS.Ring = function() end -- lu par l'invite du puits (HiddenClueService:IsFound)

local function discover(id)
	if found[id] then
		return
	end
	found[id] = true
	marks[id]:SetAttribute("found", true)
	local spec = MapConfig.HiddenClues[id]
	EFFECTS[spec.effect](id, spec)
end

-- 8.1 : descendre dans le puits P21 avec une corde ; 19.5 (HC4) : sans corde une fois l'anneau trouvé
local function setupWell()
	local well = MapConfig.Places.P21
	local anchor = Instance.new("Part")
	anchor.Name = "P21_Well"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.Transparency = 1
	anchor.Size = MapConfig.HiddenClueMarkSize
	anchor.Position = well.pos
	anchor.Parent = workspace
	services.InteractionService:CreatePrompt(anchor, {
		action = LoreConfig.Prompts.Descend,
		canUse = function(player)
			return services.HealthService:IsUp(player)
				and (services.InventoryService:Has(player, "ITM_Rope") or found.HC4 == true)
		end,
		onTriggered = function(player)
			local root = Util.characterRoot(player)
			if root then
				root.CFrame = CFrame.new(well.pos.X, well.tubeY + MapConfig.WellDescentLift, well.pos.Z)
			end
		end,
	})
end

function HiddenClueService:Init(allServices)
	services = allServices
end

function HiddenClueService:Start()
	local folder = Instance.new("Folder")
	folder.Name = "HiddenClues"
	folder.Parent = workspace
	for _, id in Util.sortedKeys(MapConfig.HiddenClues) do
		local mark = Instance.new("Part")
		mark.Name = "HiddenClue_" .. id -- MANQUANT_HiddenMark : décalque de la marque (13.5)
		mark.Anchored = true
		mark.CanCollide = false
		mark.CanQuery = false
		mark.Transparency = 1 -- affichée par HiddenClueController pour la Descendante seulement
		mark.Size = MapConfig.HiddenClueMarkSize
		mark.Position = positionOf(MapConfig.HiddenClues[id])
		mark:SetAttribute("clueId", id)
		mark:AddTag("HiddenClue")
		mark.Parent = folder
		marks[id] = mark
	end
	setupWell()
	Players.PlayerRemoving:Connect(function(player)
		local index = table.find(crawlers, player)
		if index then
			table.remove(crawlers, index)
		end
	end)
	services.HealthService.Died:Connect(function(player)
		local index = table.find(crawlers, player)
		if index then
			table.remove(crawlers, index)
			player:SetAttribute("hiddenFromSight", nil)
		end
	end)
	-- découverte : la Descendante (vivante, debout) passe à 8 studs d'une marque
	task.spawn(function()
		while true do
			task.wait(PlayerConfig.Technical.Tick)
			for _, player in Players:GetPlayers() do
				local root = Util.characterRoot(player)
				if player:GetAttribute("role") == DESCENDANT and root and services.HealthService:IsUp(player) then
					for id, mark in marks do
						if not found[id] and (mark.Position - root.Position).Magnitude <= RANGE then
							discover(id)
						end
					end
				end
			end
		end
	end)
end

return HiddenClueService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="206">
        <Properties>
          <string name="Name">InteractionService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/InteractionService (Partie)
-- Section 16.2 et 16.3 : les interactions passent par des ProximityPrompt (style Custom, affichés par
-- InteractGui). Durée de maintien propre à chaque joueur (rôle, caisse à outils) : le serveur écrit
-- l'attribut hold_<UserId> sur l'invite ; le client l'applique ; le serveur vérifie le temps réel.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("ItemConfig"))
local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))

local InteractionService = {}

local KEY = PlayerConfig.Technical.InteractKey
local GAMEPAD_KEY = PlayerConfig.Technical.InteractGamepadKey
local HOLD_TOLERANCE = PlayerConfig.Technical.HoldTolerance

local prompts = {} -- [ProximityPrompt] = opts
local holdStart = {} -- [prompt][player] = os.clock()

local function durationFor(opts, player)
	if opts.durationFor then
		return opts.durationFor(player)
	end
	local role = player:GetAttribute("role")
	return (opts.roleHoldDuration and opts.roleHoldDuration[role]) or opts.holdDuration or 0
end

-- hide_<UserId> : l'invite n'est pas affichée à ce joueur (InteractController l'ignore)
local function refresh(prompt, opts)
	for _, player in Players:GetPlayers() do
		prompt:SetAttribute("hold_" .. player.UserId, durationFor(opts, player))
		local hidden = opts.visibleTo ~= nil and not opts.visibleTo(player)
		prompt:SetAttribute("hide_" .. player.UserId, if hidden then true else nil)
	end
end

-- crée une invite sur `parent` (BasePart ou Attachment). opts : action, object, holdDuration,
-- roleHoldDuration, durationFor(player), canUse(player), onTriggered(player), maxDistance,
-- key, gamepadKey (touches propres à l'invite), visibleTo(player) (masquée aux autres)
function InteractionService:CreatePrompt(parent, opts)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.ActionText = opts.action or ""
	prompt.ObjectText = opts.object or ""
	prompt.KeyboardKeyCode = opts.key or KEY
	prompt.GamepadKeyCode = opts.gamepadKey or GAMEPAD_KEY
	prompt.HoldDuration = opts.holdDuration or 0
	prompt.MaxActivationDistance = opts.maxDistance or ItemConfig.PickupDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	prompts[prompt] = opts
	holdStart[prompt] = {}
	refresh(prompt, opts)

	prompt.PromptButtonHoldBegan:Connect(function(player)
		holdStart[prompt][player] = os.clock()
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player)
		holdStart[prompt][player] = nil
	end)
	prompt.Triggered:Connect(function(player)
		if opts.canUse and not opts.canUse(player) then
			return
		end
		local needed = durationFor(opts, player)
		if needed > 0 then
			local began = holdStart[prompt][player]
			if began == nil or os.clock() - began + HOLD_TOLERANCE < needed then
				return -- maintien trop court : refusé
			end
		end
		holdStart[prompt][player] = nil
		opts.onTriggered(player)
	end)
	prompt.Destroying:Connect(function()
		prompts[prompt] = nil
		holdStart[prompt] = nil
	end)
	return prompt
end

-- recalcule les durées propres à chaque joueur (inventaire ou rôle changé)
function InteractionService:Refresh()
	for prompt, opts in prompts do
		refresh(prompt, opts)
	end
end

function InteractionService:Init() end

-- 7.8 et 16.3 : RE_Ping (position) — repère visible 10 s par le groupe ;
-- clone de ReplicatedStorage/UITemplates/PingMarker (15.5)
local function onPing(player, position)
	if typeof(position) ~= "Vector3" or player:GetAttribute("isDead") then
		return
	end
	local templates = ReplicatedStorage:FindFirstChild("UITemplates")
	local marker = templates and templates:FindFirstChild("PingMarker")
	local anchor = Instance.new("Part")
	anchor.Name = "Ping_" .. player.Name
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = position
	anchor.Parent = workspace
	if marker then
		marker:Clone().Parent = anchor
	else
		warn("UI manquante : UITemplates/PingMarker")
	end
	game:GetService("Debris"):AddItem(anchor, PlayerConfig.Communication.PingDuration)
end

function InteractionService:Start()
	Players.PlayerAdded:Connect(function()
		self:Refresh()
	end)
	local remote = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util")).getRemote("RE_Ping")
	if remote then
		require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RateLimiter")).connect(remote, onPing)
	end
end

return InteractionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="207">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/InventoryService (Partie)
-- Sections 8 et 8.1, 16.3 : 4 emplacements rapides (3 pour la Mécanicienne), sac limité à 12 kg,
-- objets lourds (> 5 kg) à deux mains, utilisation des objets, lampes et piles.
-- Remotes : RE_EquipSlot, RE_UseItem, RE_DropItem, RE_PickupItem, RE_ToggleLight.
-- Numéros d'emplacement (DÉFAUT) : 1..N = emplacements rapides, N+1.. = lignes du sac ; 0 = capacité du rôle.
-- État répliqué : attribut inventory (JSON { quick, bag, selected, weight }), heldItem, heavyHands,
-- lightOn, lightBattery, busyUntil.
local CollectionService = game:GetService("CollectionService")
local TaggedSet = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("TaggedSet"))
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local InventoryService = {}

InventoryService.Changed = Signal.new() -- (player)
InventoryService.ItemUsed = Signal.new() -- (player, itemId, entry)
InventoryService.AbilityUsed = Signal.new() -- (player, role)
InventoryService.BearSpray = Signal.new() -- (player, origin, direction, cone)
InventoryService.ProjectileLanded = Signal.new() -- (player, itemId, position)

local services = nil
local inventories = {} -- [Player] = { quick = {}, bag = {}, selected = 1 }

local THROW = ItemConfig.Throw
local placeNoiseTrap -- défini plus bas
local NOISE_TRAP = ItemConfig.NoiseTrap
local traps = {} -- [Player] = Part du piège posé (un seul à la fois, 19.6 C11)

local function itemDef(id)
	return ItemConfig.Items[id] or WeaponConfig.Weapons[id]
end

local function weightOf(entry)
	local def = itemDef(entry.id)
	local weight = (def and def.weight) or 0
	-- 19.6 (C9) : une cassette pèse 0,1 kg, un document papier 0,05 kg
	local doc = entry.doc and LoreConfig.Documents[entry.doc]
	if def and def.tapeWeight and doc and doc.kind == "Tape" then
		weight = def.tapeWeight
	end
	return weight * (entry.count or 1)
end

local function isHeavy(id)
	local def = ItemConfig.Items[id]
	return def ~= nil and (def.twoHands or (def.weight or 0) > ItemConfig.HeavyAbove)
end

local function quickCount(player)
	if player:GetAttribute("role") == "Mechanic" then
		return PlayerConfig.Abilities.Mechanic.QuickSlots
	end
	return ItemConfig.QuickSlots
end

local function bagWeight(inv)
	local total = 0
	for _, entry in inv.bag do
		total += weightOf(entry)
	end
	return total
end

local function publish(player)
	local inv = inventories[player]
	if inv == nil then
		return
	end
	local quick = {}
	for i = 1, quickCount(player) do
		quick[i] = inv.quick[i] or false
	end
	player:SetAttribute(
		"inventory",
		Util.encode({ quick = quick, bag = inv.bag, selected = inv.selected, weight = bagWeight(inv) })
	)
	local held = inv.quick[inv.selected]
	player:SetAttribute("heldItem", held and held.id or nil)
	local heavy = false
	for _, entry in inv.quick do
		if entry and isHeavy(entry.id) then
			heavy = true
		end
	end
	player:SetAttribute("heavyHands", heavy)
	InventoryService.Changed:Fire(player)
end

-- entrée par numéro d'emplacement ; renvoie entry, liste, index
local function entryAt(player, slot)
	local inv = inventories[player]
	if inv == nil or type(slot) ~= "number" then
		return nil
	end
	local n = quickCount(player)
	if slot >= 1 and slot <= n then
		return inv.quick[slot], inv.quick, slot
	end
	local bagIndex = slot - n
	return inv.bag[bagIndex], inv.bag, bagIndex
end

local function newEntry(id, count, extra)
	local entry = { id = id, count = count or 1 }
	local def = itemDef(id)
	if def and def.uses then
		entry.uses = def.uses
	end
	if def and (def.light or def.recordMinutes) then
		entry.battery = 1
	end
	local weapon = WeaponConfig.Weapons[id]
	if weapon and weapon.ammo then
		-- 19.5 (C12) : arme chargée à pleine capacité
		entry.ammo = weapon.magazine or weapon.ammo
	end
	if extra then
		for k, v in extra do
			entry[k] = v
		end
	end
	return entry
end

function InventoryService:Get(player)
	return inventories[player]
end

function InventoryService:Selected(player)
	local inv = inventories[player]
	return inv and inv.quick[inv.selected] or nil, inv and inv.selected or nil
end

-- nombre d'unités d'un objet dans tout l'inventaire
function InventoryService:Count(player, id)
	local inv = inventories[player]
	local total = 0
	if inv then
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if entry and entry.id == id then
					total += entry.count or 1
				end
			end
		end
	end
	return total
end

function InventoryService:Has(player, id)
	return self:Count(player, id) > 0
end

-- retire `count` unités d'un objet ; renvoie true si tout a été retiré
function InventoryService:Remove(player, id, count)
	local inv = inventories[player]
	count = count or 1
	if inv == nil or self:Count(player, id) < count then
		return false
	end
	for _, list in { inv.quick, inv.bag } do
		for key, entry in list do
			if count > 0 and entry and entry.id == id then
				local take = math.min(count, entry.count or 1)
				entry.count -= take
				count -= take
				if entry.count <= 0 then
					if list == inv.quick then
						list[key] = nil
					else
						table.remove(list, key)
					end
				end
			end
		end
	end
	publish(player)
	return true
end

-- ajoute un objet : d'abord une pile existante, puis un emplacement rapide libre, puis le sac (12 kg).
-- Un objet lourd (> 5 kg) va seulement dans un emplacement rapide (porté à deux mains).
function InventoryService:Add(player, id, count, extra)
	local inv = inventories[player]
	local def = itemDef(id)
	if inv == nil then
		return false
	end
	count = count or 1
	local stack = (def and def.stack) or 1
	if extra == nil then
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if count > 0 and entry and entry.id == id and entry.count < stack then
					local add = math.min(count, stack - entry.count)
					entry.count += add
					count -= add
				end
			end
		end
	end
	while count > 0 do
		local put = math.min(count, stack)
		local entry = newEntry(id, put, extra)
		local placed = false
		for i = 1, quickCount(player) do
			if inv.quick[i] == nil then
				inv.quick[i] = entry
				placed = true
				break
			end
		end
		if not placed and not isHeavy(id) and bagWeight(inv) + weightOf(entry) <= ItemConfig.BagMaxWeight then
			table.insert(inv.bag, entry)
			placed = true
		end
		if not placed then
			publish(player)
			return false
		end
		count -= put
	end
	publish(player)
	return true
end

-- objet posé dans le monde (ItemSpawnService) ; renvoie la Part
function InventoryService:SpawnWorld(id, count, position, extra)
	return services.ItemSpawnService:SpawnWorldItem(id, count, position, extra)
end

local function dropEntry(player, entry)
	local root = Util.characterRoot(player)
	if root then
		local extra = table.clone(entry)
		extra.id = nil
		extra.count = nil
		InventoryService:SpawnWorld(entry.id, entry.count, root.Position - Vector3.new(0, 2, 0), extra)
		local def = itemDef(entry.id)
		if def and def.dropNoise then
			services.NoiseService:Emit(root.Position, def.dropNoise, NoiseTypes.Item, player)
		end
	end
end

function InventoryService:Drop(player, slot)
	local entry, list, index = entryAt(player, slot)
	if entry == nil then
		return
	end
	if list == inventories[player].quick then
		list[index] = nil
	else
		table.remove(list, index)
	end
	if entry.lit then
		self:SetLight(player, false)
	end
	dropEntry(player, entry)
	publish(player)
end

-- 7.3 : à la mort, l'inventaire tombe dans un sac ramassable
function InventoryService:DropAllAsBag(player, position)
	local inv = inventories[player]
	if inv == nil then
		return
	end
	self:SetLight(player, false)
	local contents = {}
	for i = 1, quickCount(player) do
		if inv.quick[i] then
			table.insert(contents, inv.quick[i])
		end
	end
	for _, entry in inv.bag do
		table.insert(contents, entry)
	end
	inv.quick, inv.bag = {}, {}
	publish(player)
	if #contents > 0 then
		services.ItemSpawnService:SpawnBag(contents, position)
	end
end

-- prend le contenu d'un sac au sol ; le reste y reste
function InventoryService:TakeBag(player, bagPart)
	local contents = Util.decode(bagPart:GetAttribute("contents"), {})
	local left = {}
	for _, entry in contents do
		local extra = table.clone(entry)
		extra.id, extra.count = nil, nil
		if not self:Add(player, entry.id, entry.count, next(extra) and extra or nil) then
			table.insert(left, entry)
		end
	end
	if #left == 0 then
		bagPart:Destroy()
	else
		bagPart:SetAttribute("contents", Util.encode(left))
	end
end

function InventoryService:Pickup(player, part)
	if part == nil or not part:IsDescendantOf(workspace) then
		return false
	end
	local root = Util.characterRoot(player)
	if root == nil or not services.HealthService:IsUp(player) then
		return false
	end
	local position = part:IsA("Model") and part:GetPivot().Position or part.Position
	if (position - root.Position).Magnitude > ItemConfig.PickupDistance then
		return false
	end
	local id = part:GetAttribute("itemId")
	if id == nil then
		return false
	end
	-- documents (2.7) : lus et rangés dans le journal du groupe
	if string.match(id, "^DOC_") then
		services.DocumentService:Collect(player, id, part)
		part:Destroy()
		return true
	end
	if id == "AmmoBox" then
		-- 3.4 : 5 balles de fusil + 6 de revolver + 4 cartouches (rangées en réserve, AMMO_<arme>)
		for weaponId, amount in WeaponConfig.AmmoBox do
			self:Add(player, "AMMO_" .. weaponId, amount)
		end
		part:Destroy()
		return true
	end
	local extra = Util.decode(part:GetAttribute("payload"), nil)
	if self:Add(player, id, part:GetAttribute("count") or 1, extra) then
		services.ItemSpawnService:OnPickedUp(player, part)
		part:Destroy()
		return true
	end
	return false
end

function InventoryService:Equip(player, slot)
	local inv = inventories[player]
	if inv == nil or type(slot) ~= "number" or slot < 1 or slot > quickCount(player) then
		return
	end
	-- 8 : objet lourd porté : il reste en main
	local held = inv.quick[inv.selected]
	if held and isHeavy(held.id) and slot ~= inv.selected then
		return
	end
	if held and held.lit and not (itemDef(held.id).light or {}).handsFree then
		self:SetLight(player, false)
	end
	inv.selected = slot
	publish(player)
end

-- lampes (8.1, 12.1) : SpotLight à 45° sur la tête du personnage, portée de l'objet
local function lightEntry(player)
	local inv = inventories[player]
	if inv == nil then
		return nil
	end
	local held = inv.quick[inv.selected]
	-- 19.5 (C6) : pas de lampe en main pendant le portage (la frontale marche)
	local handsBusy = player:GetAttribute("carrying") ~= nil
	if held and itemDef(held.id) and itemDef(held.id).light and not handsBusy then
		return held
	end
	for _, list in { inv.quick, inv.bag } do
		for _, entry in list do
			local def = entry and itemDef(entry.id)
			if def and def.light and def.light.handsFree then
				return entry -- la frontale éclaire sans être en main
			end
		end
	end
	return nil
end

function InventoryService:SetLight(player, on)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local existing = head and head:FindFirstChild("PlayerLamp")
	local inv = inventories[player]
	if inv then
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if entry then
					entry.lit = nil
				end
			end
		end
	end
	if not on then
		if existing then
			existing:Destroy()
		end
		player:SetAttribute("lightOn", false)
		publish(player)
		return
	end
	local entry = lightEntry(player)
	if entry == nil or (entry.battery or 0) <= 0 or head == nil then
		return
	end
	local def = itemDef(entry.id).light
	entry.lit = true
	if existing then
		existing:Destroy()
	end
	local lamp = Instance.new("SpotLight")
	lamp.Name = "PlayerLamp"
	lamp.Angle = def.angle
	lamp.Range = math.min(def.range, AmbienceConfig.Lamp.EngineMaxRange)
	lamp.Shadows = true
	lamp.Face = Enum.NormalId.Front
	lamp:SetAttribute("range", def.range) -- portée de jeu (8.1), lue par la perception
	lamp:AddTag("PlayerLamp")
	lamp.Parent = head
	player:SetAttribute("lightOn", true)
	player:SetAttribute("lightRange", def.range)
	publish(player)
end

-- utilisation à durée : bloque les autres actions (« pas en action », 16.3)
local function busy(player, duration, done)
	local now = workspace:GetServerTimeNow()
	if (player:GetAttribute("busyUntil") or 0) > now then
		return false
	end
	player:SetAttribute("busyUntil", now + duration)
	task.delay(duration, function()
		player:SetAttribute("busyUntil", nil)
		if services.HealthService:IsUp(player) then
			done()
		end
	end)
	return true
end

local function consumeUse(player, entry, slot)
	if entry.uses then
		entry.uses -= 1
		if entry.uses <= 0 then
			entry.count -= 1
			if entry.count <= 0 then
				local _, list, index = entryAt(player, slot)
				if list == inventories[player].quick then
					list[index] = nil
				else
					table.remove(list, index)
				end
			else
				entry.uses = itemDef(entry.id).uses
			end
		end
	else
		InventoryService:Remove(player, entry.id, 1)
	end
	publish(player)
end

local function placeSource(position, duration, opts)
	local part = Instance.new("Part")
	part.Name = opts.name
	part.Size = ItemConfig.FireVisuals.Size
	part.Anchored = true
	part.CanCollide = false
	part.Color = opts.color
	part.Material = Enum.Material.Neon
	part.Position = position
	local light = Instance.new("PointLight")
	light.Color = opts.color
	light.Range = math.min(opts.radius, AmbienceConfig.Lamp.EngineMaxRange)
	light.Parent = part
	part:SetAttribute("radius", opts.radius)
	part:SetAttribute("range", opts.radius)
	part:SetAttribute("keepAway", opts.keepAway)
	part:SetAttribute("visibleRange", opts.visibleRange)
	CollectionService:AddTag(part, "FireSource")
	CollectionService:AddTag(part, "LightSource")
	part.Parent = workspace
	Debris:AddItem(part, duration)
	return part
end

-- 19.5 (C10) : trajectoire balistique à 70 studs/s (gravité du moteur), portée horizontale de 60 studs
-- au plus ; bruit 50 à l'impact. Rend le point d'impact et la durée du vol.
local throwParams = setmetatable({}, { __mode = "k" }) -- RaycastParams par personnage, construits une fois
local function ballistic(player, origin, direction)
	local params = throwParams[player.Character]
	if params == nil then
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		throwParams[player.Character] = params
	end
	local velocity = direction.Unit * THROW.Speed
	local gravity = Vector3.new(0, -workspace.Gravity, 0)
	local position, t = origin, 0
	while t < THROW.MaxFlight do
		local nextVelocity = velocity + gravity * THROW.SimStep
		local delta = (velocity + nextVelocity) / 2 * THROW.SimStep
		local flat = (position + delta - origin) * Vector3.new(1, 0, 1)
		if flat.Magnitude > THROW.MaxRange then
			-- portée maximale atteinte : l'objet tombe à la verticale de ce point
			local down = workspace:Raycast(position, Vector3.new(0, -THROW.MaxRange, 0), params)
			return (down and down.Position) or position, t
		end
		local hit = workspace:Raycast(position, delta, params)
		t += THROW.SimStep
		if hit then
			return hit.Position, t
		end
		position += delta
		velocity = nextVelocity
	end
	return position, t
end

local function throw(player, entry, slot, aim)
	local root = Util.characterRoot(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if root == nil or head == nil then
		return
	end
	local def = itemDef(entry.id)
	local direction = if typeof(aim) == "Vector3" and aim.Magnitude > 0 then aim else root.CFrame.LookVector
	local landing, flight = ballistic(player, head.Position, direction)
	consumeUse(player, entry, slot)
	task.delay(flight, function()
		local noise = def.impactNoise or def.breakNoise or THROW.ImpactNoise
		services.NoiseService:Emit(landing, noise, NoiseTypes.Impact, player)
		InventoryService.ProjectileLanded:Fire(player, entry.id, landing)
	end)
end

local EFFECTS = {}

EFFECTS.RechargeLight = function(player, entry, slot, def)
	local light = lightEntry(player)
	if light == nil then
		return
	end
	busy(player, def.duration, function()
		light.battery = 1
		consumeUse(player, entry, slot)
	end)
end

local function healDuration(player, def)
	-- 7.7 : la Médecin soigne ×2 (DÉFAUT : deux fois plus vite)
	if player:GetAttribute("role") == "Medic" then
		return def.duration / PlayerConfig.Abilities.Medic.HealFactor
	end
	return def.duration
end

EFFECTS.Bandage = function(player, entry, slot, def)
	busy(player, healDuration(player, def), function()
		services.HealthService:TreatBleed(player, false)
		services.HealthService:Heal(player, nil, def.heal)
		consumeUse(player, entry, slot)
	end)
end

EFFECTS.Splint = function(player, entry, slot, def)
	busy(player, healDuration(player, def), function()
		services.HealthService:Splint(player)
		consumeUse(player, entry, slot)
	end)
end

EFFECTS.Medkit = function(player, entry, slot, def)
	busy(player, healDuration(player, def), function()
		services.HealthService:Heal(player, nil, def.heal)
		-- 8.1 : arrête une hémorragie grave (Médecin seulement)
		if player:GetAttribute("role") == "Medic" then
			services.HealthService:TreatBleed(player, true)
		end
		consumeUse(player, entry, slot)
	end)
end

EFFECTS.Flare = function(player, entry, slot, def)
	local root = Util.characterRoot(player)
	if root == nil then
		return
	end
	consumeUse(player, entry, slot)
	services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
	-- DÉFAUT : la fusée allumée est posée aux pieds du joueur
	placeSource(root.Position - Vector3.new(0, ItemConfig.FireVisuals.GroundOffset, 0), def.burn, {
		name = "Flare",
		color = ItemConfig.FireVisuals.FlareColor,
		radius = def.lightRadius,
		keepAway = def.creatureKeepAway,
	})
end

EFFECTS.Campfire = function(player, entry, slot, def)
	local root = Util.characterRoot(player)
	if root == nil or InventoryService:Count(player, "ITM_Branch") < def.branchesNeeded then
		return
	end
	InventoryService:Remove(player, "ITM_Branch", def.branchesNeeded)
	consumeUse(player, entry, slot)
	services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
	local flare = ItemConfig.Items.ITM_Flare
	placeSource(
		root.Position
			+ root.CFrame.LookVector * ItemConfig.FireVisuals.CampfireAhead
			- Vector3.new(0, ItemConfig.FireVisuals.GroundOffset, 0),
		def.burn,
		{
			name = "Campfire",
			color = ItemConfig.FireVisuals.CampfireColor,
			radius = flare.lightRadius, -- 8.1 : même effet qu'une fusée
			keepAway = flare.creatureKeepAway,
			visibleRange = def.visibleRange,
		}
	)
end

EFFECTS.BearSpray = function(player, entry, slot, def)
	local root = Util.characterRoot(player)
	if root == nil then
		return
	end
	consumeUse(player, entry, slot)
	services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
	InventoryService.BearSpray:Fire(player, root.Position, root.CFrame.LookVector, def.cone)
end

-- 19.6 (C11) : piège à bruit (boîte de conserve + corde) aux pieds du Pyrotechnicien ; se déclenche au
-- passage de la créature ou d'un autre joueur (DÉFAUT : le poseur ne le déclenche pas) ; bruit de 150 studs
-- pendant 3 s, puis le piège disparaît
placeNoiseTrap = function(player)
	local root = Util.characterRoot(player)
	if root == nil then
		return
	end
	local trap = Instance.new("Part")
	trap.Name = "NoiseTrap_" .. player.Name
	trap.Anchored = true
	trap.CanCollide = false
	trap.Size = ItemConfig.PlaceholderSize
	trap.Color = ItemConfig.PlaceholderColor
	trap.Position = root.Position - Vector3.new(0, ItemConfig.FireVisuals.GroundOffset, 0)
	trap.Parent = workspace
	traps[player] = trap
	task.spawn(function()
		local triggered = false
		while trap.Parent and not triggered do
			task.wait(PlayerConfig.Technical.Tick)
			for _, creature in TaggedSet.list("Creature") do
				local pivot = creature:GetPivot().Position
				if (pivot - trap.Position).Magnitude <= NOISE_TRAP.TriggerRadius then
					triggered = true
				end
			end
			for _, other in Players:GetPlayers() do
				local otherRoot = Util.characterRoot(other)
				if
					other ~= player
					and otherRoot
					and (otherRoot.Position - trap.Position).Magnitude <= NOISE_TRAP.TriggerRadius
				then
					triggered = true
				end
			end
		end
		local elapsed = 0
		while triggered and elapsed < NOISE_TRAP.Duration do
			services.NoiseService:Emit(trap.Position, NOISE_TRAP.Radius, NoiseTypes.Item, player)
			task.wait(NOISE_TRAP.EmitInterval)
			elapsed += NOISE_TRAP.EmitInterval
		end
		trap:Destroy()
		if traps[player] == trap then
			traps[player] = nil
		end
	end)
end

local function useAbility(player)
	local role = player:GetAttribute("role")
	if role == "Leader" then
		services.FearService:LeaderOrder(player)
	elseif role == "Pyrotechnician" then
		-- 7.7 : 1 fusée par 2 piles + 1 ruban ; piège : boîte de conserve + corde
		local recipes = PlayerConfig.Abilities.Pyrotechnician
		local function canCraft(recipe)
			for id, n in recipe do
				if InventoryService:Count(player, id) < n then
					return false
				end
			end
			return true
		end
		if canCraft(recipes.FlareRecipe) then
			for id, n in recipes.FlareRecipe do
				InventoryService:Remove(player, id, n)
			end
			InventoryService:Add(player, "ITM_Flare", 1)
		elseif canCraft(recipes.NoiseTrapRecipe) and traps[player] == nil then
			-- 19.6 (C11) : piège posé en 6 s, un seul à la fois
			busy(player, NOISE_TRAP.PlaceTime, function()
				if not canCraft(recipes.NoiseTrapRecipe) or traps[player] ~= nil then
					return
				end
				for id, n in recipes.NoiseTrapRecipe do
					InventoryService:Remove(player, id, n)
				end
				placeNoiseTrap(player)
			end)
		end
	end
	InventoryService.AbilityUsed:Fire(player, role)
end

function InventoryService:Use(player, slot, aim)
	if not services.HealthService:IsUp(player) then
		return
	end
	if slot == 0 then
		useAbility(player)
		return
	end
	local entry = entryAt(player, slot)
	if entry == nil then
		return
	end
	local def = itemDef(entry.id)
	if def == nil then
		return
	end
	if def.throwable then
		throw(player, entry, slot, aim)
	elseif def.effect and EFFECTS[def.effect] then
		local root = Util.characterRoot(player)
		if def.noise and root and def.effect ~= "Flare" and def.effect ~= "BearSpray" then
			services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
		end
		EFFECTS[def.effect](player, entry, slot, def)
	end
	-- effets traités ailleurs : preuves, tablette, documents (EvidenceService, TabletService, DocumentService)
	self.ItemUsed:Fire(player, entry.id, entry, slot)
end

-- 8.1 et 8.3 : décharge des lampes allumées
local function drainLights(dt)
	for player, inv in inventories do
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if entry and entry.lit then
					local def = itemDef(entry.id).light
					entry.battery =
						math.max(0, (entry.battery or 0) - dt / (def.batteryMinutes * Util.SECONDS_PER_MINUTE))
					player:SetAttribute("lightBattery", entry.battery)
					if entry.battery <= 0 then
						InventoryService:SetLight(player, false)
					end
				end
			end
		end
	end
end

-- objets de départ (8.1, colonne « Où »)
function InventoryService:GiveStarting(player, weaponId)
	local role = player:GetAttribute("role")
	local start = ItemConfig.StartingItems
	if not start.Flashlight.exceptRoles[role] then
		self:Add(player, start.Flashlight.item, 1)
	end
	for id, n in start.Roles[role] or {} do
		self:Add(player, id, n)
	end
	for id, n in start.All do
		self:Add(player, id, n)
	end
	-- 8.2 : armes de rôle (pistolet lance-fusées, hache) et arme choisie au lobby
	for id, weapon in WeaponConfig.Weapons do
		if weapon.owner == role then
			self:Add(player, id, 1)
		end
	end
	if weaponId and WeaponConfig.Weapons[weaponId] then
		self:Add(player, weaponId, 1)
	end
	-- 19.5 (C12) : réserve de départ (pistolet lance-fusées : 2 fusées)
	for id, weapon in WeaponConfig.Weapons do
		if weapon.startReserve and self:Has(player, id) then
			self:Add(player, "AMMO_" .. id, weapon.startReserve)
		end
	end
end

function InventoryService:Init(allServices)
	services = allServices
end

function InventoryService:Start()
	services.CharacterService.Spawned:Connect(function(player)
		inventories[player] = { quick = {}, bag = {}, selected = 1 }
		local info = services.PartyLoaderService:GetMatchInfo()
		local entry = info.roles[player.UserId]
		self:GiveStarting(player, entry and entry.weapon)
		services.InteractionService:Refresh()
	end)
	Players.PlayerRemoving:Connect(function(player)
		inventories[player] = nil
	end)

	local handlers = {
		RE_EquipSlot = function(player, slot)
			self:Equip(player, slot)
		end,
		RE_UseItem = function(player, slot, aim)
			self:Use(player, slot, if typeof(aim) == "Vector3" then aim else nil)
		end,
		RE_DropItem = function(player, slot)
			self:Drop(player, slot)
		end,
		RE_PickupItem = function(player, part)
			if typeof(part) == "Instance" then
				self:Pickup(player, part)
			end
		end,
		RE_ToggleLight = function(player)
			-- 16.3 : lampe équipée, pile > 0
			local root = Util.characterRoot(player)
			local on = not player:GetAttribute("lightOn")
			self:SetLight(player, on)
			if root then
				services.NoiseService:Emit(
					root.Position,
					ItemConfig.Items.ITM_Flashlight.noise,
					NoiseTypes.Item,
					player
				)
			end
		end,
	}
	for name, handler in handlers do
		local remote = Util.getRemote(name)
		if remote then
			RateLimiter.connect(remote, handler)
		end
	end

	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			drainLights(step)
		end
	end)
end

return InventoryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="208">
        <Properties>
          <string name="Name">ItemSpawnService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/ItemSpawnService (Partie)
-- Sections 3.4, 8.1 et 2.7 : tirages avec la graine de la partie (écrite dans la console) :
-- 6 points d'indice sur 12, un emplacement par objet clé, objets et documents à lieu fixe.
-- Modèles : ReplicatedStorage/Items/Item_<Nom> (13.3) ; absent → bloc gris MANQUANT_<ID>.
-- Workspace/CluePoints peut contenir des Part nommées comme les codes (C01, K1, A3…) : elles
-- remplacent les coordonnées de MapConfig (réglage à la main en phase B).
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local ItemSpawnService = {}

ItemSpawnService.ClueFound = Signal.new() -- (clueId, player)

local services = nil
local folder = nil
local drawn = {} -- résultat du tirage, pour la console et les tests

local PLACEHOLDER_SIZE = ItemConfig.PlaceholderSize
local SPAWN_LIFT = ItemConfig.SpawnLift

local function modelName(id)
	return (string.gsub(id, "^ITM_", "Item_"))
end

local function makeVisual(id, position)
	local itemsFolder = ReplicatedStorage:FindFirstChild(ItemConfig.ModelsFolder)
	local template = itemsFolder and itemsFolder:FindFirstChild(modelName(id))
	if template then
		local clone = template:Clone()
		local part = clone:IsA("BasePart") and clone
			or clone.PrimaryPart
			or clone:FindFirstChildWhichIsA("BasePart", true)
		clone:PivotTo(CFrame.new(position))
		return clone, part
	end
	local part = Instance.new("Part")
	part.Name = "MANQUANT_" .. modelName(id)
	part.Size = PLACEHOLDER_SIZE
	part.Color = ItemConfig.PlaceholderColor
	part.Material = Enum.Material.SmoothPlastic
	part.Position = position
	return part, part
end

-- objet posé dans le monde, ramassable (ProximityPrompt « Ramasser »)
function ItemSpawnService:SpawnWorldItem(id, count, position, payload, clueId)
	local visual, part = makeVisual(id, position + Vector3.new(0, SPAWN_LIFT, 0))
	if part == nil then
		visual:Destroy()
		visual, part = makeVisual("MANQUANT", position)
	end
	for _, p in visual:IsA("BasePart") and { visual } or visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	visual:SetAttribute("itemId", id)
	visual:SetAttribute("count", count or 1)
	if payload and next(payload) then
		visual:SetAttribute("payload", Util.encode(payload))
	end
	if clueId then
		visual:SetAttribute("clueId", clueId)
		CollectionService:AddTag(visual, "Clue")
	end
	CollectionService:AddTag(visual, "WorldItem")
	visual.Parent = folder
	local def = ItemConfig.Items[id]
	services.InteractionService:CreatePrompt(part, {
		action = LoreConfig.Prompts.Pickup,
		object = def and def.name or "",
		onTriggered = function(player)
			services.InventoryService:Pickup(player, visual)
		end,
	})
	return visual
end

-- sac d'un joueur mort (7.3)
function ItemSpawnService:SpawnBag(contents, position)
	local visual, part = makeVisual("ITM_Bag", position)
	visual.Name = "DeadBag"
	for _, p in visual:IsA("BasePart") and { visual } or visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	visual:SetAttribute("contents", Util.encode(contents))
	visual.Parent = folder
	services.InteractionService:CreatePrompt(part, {
		action = LoreConfig.Prompts.Open,
		onTriggered = function(player)
			services.InventoryService:TakeBag(player, visual)
		end,
	})
	return visual
end

function ItemSpawnService:OnPickedUp(player, part)
	local clueId = part:GetAttribute("clueId")
	if clueId then
		self.ClueFound:Fire(clueId, player)
	end
end

local function markerOr(code, fallback)
	local markers = workspace:FindFirstChild("CluePoints")
	local marker = markers and markers:FindFirstChild(code)
	if marker and marker:IsA("BasePart") then
		return marker.Position
	end
	return fallback
end

local function shuffle(list, random)
	for i = #list, 2, -1 do
		local j = random:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- 3.4 : 6 points sur 12. DÉFAUT (algorithme) : chacun des 4 documents tirés (DOC_03 à DOC_06)
-- reçoit un point distinct parmi ceux qui peuvent le contenir ; les points restants sont tirés
-- parmi C09–C12 (objets). Chaque point tiré contient donc quelque chose.
local function drawCluePoints(random)
	local documents = { "DOC_03", "DOC_04", "DOC_05", "DOC_06" }
	local docPoints, itemPoints = {}, {}
	for code, point in MapConfig.CluePoints do
		if string.match(point.contents[1], "^DOC_") then
			table.insert(docPoints, code)
		else
			table.insert(itemPoints, code)
		end
	end
	table.sort(docPoints)
	table.sort(itemPoints)
	local assignment
	-- appariement aléatoire document → point compatible (recommencé jusqu'à réussir)
	for _ = 1, 100 do
		assignment = {}
		local used = {}
		local ok = true
		for _, doc in shuffle(table.clone(documents), random) do
			local options = {}
			for _, code in docPoints do
				if not used[code] and table.find(MapConfig.CluePoints[code].contents, doc) then
					table.insert(options, code)
				end
			end
			if #options == 0 then
				ok = false
				break
			end
			local code = options[random:NextInteger(1, #options)]
			used[code] = true
			assignment[code] = { doc }
		end
		if ok then
			break
		end
	end
	local remaining = MapConfig.CluePointsDrawn - #documents
	for _, code in shuffle(table.clone(itemPoints), random) do
		if remaining <= 0 then
			break
		end
		assignment[code] = MapConfig.CluePoints[code].contents
		remaining -= 1
	end
	return assignment
end

local function spawnAll(info)
	local random = Random.new(info.seed)
	print(("ItemSpawnService : graine %d"):format(info.seed))

	-- points d'indice
	local clues = drawCluePoints(random)
	drawn.clues = clues
	local drawnCodes = Util.sortedKeys(clues)
	print("ItemSpawnService : points d'indice tirés : " .. table.concat(drawnCodes, ", "))
	for code, contents in clues do
		local base = markerOr(code, MapConfig.CluePoints[code].pos)
		for i, id in contents do
			local offset = Vector3.new((i - 1) * ItemConfig.ClueItemSpacing, 0, 0)
			local count = if string.match(id, "^DOC_") then 1 else MapConfig.ClueItemQuantity[id] or 1
			ItemSpawnService:SpawnWorldItem(id, count, base + offset, nil, code)
		end
	end

	-- objets clés (un emplacement tiré par objet)
	local difficulty = ActConfig.difficulty(info.difficulty)
	for key, spec in MapConfig.KeyItems do
		if spec.item == "AmmoBox" and not difficulty.ammoBox then
			continue -- 5.4 : pas de boîte de munitions en Cauchemar
		end
		local index = random:NextInteger(1, #spec.spots)
		local code = ({
			Keys = "K",
			AmmoBox = "A",
			Jack = "J",
			CoaxCable = "R",
			CarBattery = "R",
			Jerrycan = "R",
			StarterRelay = "R",
		})[key] .. tostring(index)
		local position = markerOr(code, MapConfig.resolve(spec.spots[index]))
		drawn[key] = index
		if position then
			ItemSpawnService:SpawnWorldItem(spec.item, 1, position)
		end
	end

	-- objets à lieu fixe (8.1)
	for _, spec in MapConfig.FixedItems do
		for _, place in spec.places do
			local position = MapConfig.resolve(place)
			if position then
				ItemSpawnService:SpawnWorldItem(spec.item, spec.count or 1, position)
			end
		end
	end
	-- DÉFAUT : l'appareil photo de C03–C06 est posé sur un des points tirés parmi eux, s'il y en a un
	local photoPoints = {}
	for _, code in MapConfig.PhotoCameraCluePoints do
		if clues[code] then
			table.insert(photoPoints, code)
		end
	end
	if #photoPoints > 0 then
		local code = photoPoints[random:NextInteger(1, #photoPoints)]
		ItemSpawnService:SpawnWorldItem(
			"ITM_PhotoCamera",
			1,
			markerOr(code, MapConfig.CluePoints[code].pos) + Vector3.new(0, 0, ItemConfig.ClueItemSpacing)
		)
	end

	-- 19.6 (C17) : branches et pierres partout au sol — Part taguées « GroundItem » (attribut itemId,
	-- ITM_Branch ou ITM_Stone) posées dans le décor ; DÉFAUT : une unité par Part
	for _, marker in CollectionService:GetTagged("GroundItem") do
		local id = marker:GetAttribute("itemId")
		if marker:IsA("BasePart") and (id == "ITM_Branch" or id == "ITM_Stone") then
			ItemSpawnService:SpawnWorldItem(id, 1, marker.Position)
		end
	end

	-- documents à lieu fixe (2.7) ; DOC_09 est un message radio (rejoué par la tour, J9)
	for doc, place in MapConfig.FixedDocuments do
		if doc ~= "DOC_09" and LoreConfig.Documents and LoreConfig.Documents[doc] then
			local position = MapConfig.resolve(place)
			if position then
				ItemSpawnService:SpawnWorldItem(doc, 1, position + ItemConfig.DocumentOffset)
			end
		end
	end
end

function ItemSpawnService:GetDraw()
	return drawn
end

function ItemSpawnService:Init(allServices)
	services = allServices
	folder = Instance.new("Folder")
	folder.Name = "WorldItems"
	folder.Parent = workspace
end

function ItemSpawnService:Start()
	task.spawn(function()
		services.PartyLoaderService:WaitUntilLoaded()
		spawnAll(services.PartyLoaderService:GetMatchInfo())
	end)
end

return ItemSpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="209">
        <Properties>
          <string name="Name">NoiseService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/NoiseService (Partie)
-- Section 16.2 : reçoit tous les bruits (sections 7 et 8) et les diffuse à la perception (9.4).
-- Un bruit = { position, radius, kind, source, time }.
-- DÉFAUT : la pluie (×0,6, 12.3 et 9.4) est appliquée une seule fois, par la perception (AI/Perception).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))

local NoiseService = {}

-- (noise) : chaque bruit émis
NoiseService.Emitted = Signal.new()

local history = {} -- [Player] = { {time, radius} } (9.7 : bruit des 10 dernières secondes)

function NoiseService:Emit(position, radius, kind, source)
	if radius == nil or radius <= 0 then
		return
	end
	-- 19.5 (C7, HC3) : passage silencieux (attribut noiseFactor) — bruits de déplacement seulement (DÉFAUT)
	if
		typeof(source) == "Instance"
		and source:IsA("Player")
		and source:GetAttribute("noiseFactor")
		and (kind == NoiseTypes.Footstep or kind == NoiseTypes.Jump)
	then
		radius *= source:GetAttribute("noiseFactor")
	end
	local noise = {
		position = position,
		radius = radius,
		kind = kind or NoiseTypes.Other,
		source = source,
		time = os.clock(),
	}
	if typeof(source) == "Instance" and source:IsA("Player") then
		local list = history[source]
		if list == nil then
			list = {}
			history[source] = list
		end
		table.insert(list, { time = noise.time, radius = noise.radius })
	end
	self.Emitted:Fire(noise)
	return noise
end

-- 9.7 : plus fort bruit fait par le joueur pendant les `window` dernières secondes
-- (interprétation de « bruit des 10 dernières secondes », voir SUIVI.md)
function NoiseService:RecentNoise(player, window)
	local list = history[player]
	if list == nil then
		return 0
	end
	local now = os.clock()
	local loudest = 0
	for index = #list, 1, -1 do
		local entry = list[index]
		if now - entry.time > window then
			table.remove(list, index)
		elseif entry.radius > loudest then
			loudest = entry.radius
		end
	end
	return loudest
end

function NoiseService:Init() end

function NoiseService:Start()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		history[player] = nil
	end)
end

return NoiseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="210">
        <Properties>
          <string name="Name">PartyLoaderService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/PartyLoaderService (Partie)
-- Section 16.2 : lit la configuration de partie écrite par le Lobby (MemoryStore,
-- clé Launch_<id>, 16.4), puis attend les joueurs, 60 s au plus.
-- Section 16.1 : si la version du Lobby diffère de celle de la Partie, la partie n'a pas lieu.
local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))
local Version = require(Shared:WaitForChild("Version"))

local PartyLoaderService = {}

-- (launchData, players) : configuration lue et joueurs présents à la fin de l'attente.
-- launchData vaut nil hors serveur réservé (test dans Studio).
PartyLoaderService.Loaded = Signal.new()

local services = nil
local memory = LaunchConfig.MemoryStore
local launchMap = nil
local state = "loading" -- "loading", "ready" ou "rejecting"
local rejectKey = nil
local launchData = nil
local presentPlayers = {}
local waitingFor = nil -- [userId] = true pendant l'attente des joueurs

local function sendBack(player)
	services.ReturnService:ReturnPlayers({ player }, nil, rejectKey)
end

-- la partie ne peut pas avoir lieu : chaque joueur présent ou à venir repart au Lobby
-- avec le message `messageKey` (4.6)
local function reject(messageKey, reason)
	warn("PartyLoaderService : " .. reason)
	state = "rejecting"
	rejectKey = messageKey
	for _, player in Players:GetPlayers() do
		task.spawn(sendBack, player)
	end
end

local function finish(data, players)
	state = "ready"
	launchData = data
	presentPlayers = players
	PartyLoaderService.Loaded:Fire(data, players)
end

-- attend les joueurs annoncés dans la configuration, ArrivalTimeout secondes au plus
local function waitForPlayers(data)
	local expected = {}
	local expectedCount = 0
	for _, entry in data.players do
		expected[entry.userId] = true
		expectedCount += 1
	end
	waitingFor = expected
	-- 4.6 : MSG_WaitingPlayers aux joueurs déjà là (les suivants le reçoivent à l'arrivée)
	for _, player in Players:GetPlayers() do
		Util.notify(player, "MSG_WaitingPlayers")
	end

	local done = false
	local connection = nil

	local function complete()
		if done then
			return
		end
		done = true
		waitingFor = nil
		if connection ~= nil then
			connection:Disconnect()
		end
		local present = {}
		for userId in expected do
			local player = Players:GetPlayerByUserId(userId)
			if player ~= nil then
				table.insert(present, player)
			end
		end
		-- 4.6 : MSG_PlayerMissing pour chaque absent, envoyé aux présents
		for _, entry in data.players do
			if Players:GetPlayerByUserId(entry.userId) == nil then
				for _, player in present do
					Util.notify(player, "MSG_PlayerMissing", { player = entry.name })
				end
			end
		end
		-- TODO(J9): un joueur absent après 60 s — son rôle n'existe pas dans la partie (4.4, étape 3)
		print(("PartyLoaderService : %d/%d joueur(s) arrivé(s)"):format(#present, expectedCount))
		finish(data, present)
	end

	local function check()
		for userId in expected do
			if Players:GetPlayerByUserId(userId) == nil then
				return
			end
		end
		complete()
	end

	connection = Players.PlayerAdded:Connect(check)
	task.delay(LaunchConfig.ArrivalTimeout, complete)
	check()
end

local function load()
	if game.PrivateServerId == "" then
		-- DÉFAUT : hors serveur réservé (test dans Studio), aucune configuration de partie
		warn("PartyLoaderService : pas de serveur réservé (Studio ?), aucune configuration de partie")
		finish(nil, Players:GetPlayers())
		return
	end
	if launchMap == nil then
		-- 4.6 : configuration introuvable → MSG_LaunchConfigMissing
		reject("MSG_LaunchConfigMissing", "MemoryStore inaccessible")
		return
	end

	local key = memory.LaunchKeyPrefix .. game.PrivateServerId
	local ok, data = Util.retry(memory.Attempts, memory.RetryDelay, function()
		return launchMap:GetAsync(key)
	end)
	if not ok then
		reject("MSG_LaunchConfigMissing", "lecture de la configuration impossible : " .. tostring(data))
		return
	end
	if type(data) ~= "table" then
		reject("MSG_LaunchConfigMissing", "configuration de partie introuvable (" .. key .. ")")
		return
	end
	if data.version ~= Version.Number then
		-- 16.1 : la Partie compare les versions et renvoie le groupe au Lobby
		reject(
			"MSG_VersionMismatch",
			("version du Lobby %s, version de la Partie %d"):format(tostring(data.version), Version.Number)
		)
		return
	end

	-- 3.4 : graine écrite dans la console pour rejouer un bug
	print(("PartyLoaderService : graine %s, départ %s"):format(tostring(data.seed), tostring(data.start)))
	waitForPlayers(data)
end

-- informations de partie pour les autres services (difficulté, météo, départ, graine, rôles).
-- DÉFAUT : hors serveur réservé (Studio), partie de test : Normal, météo aléatoire, départ S1,
-- graine os.time(), rôles attribués dans l'ordre de PlayerConfig.Roles.
local testSeed = os.time()
function PartyLoaderService:GetMatchInfo()
	local data = launchData
	local roles = {}
	if data ~= nil then
		for _, entry in data.players do
			roles[entry.userId] = { role = entry.role, weapon = entry.weapon }
		end
	end
	return {
		difficulty = data and data.difficulty or LaunchConfig.Votes.DefaultDifficulty,
		weather = data and data.weather or LaunchConfig.Votes.DefaultWeather,
		start = data and data.start or "S1",
		seed = data and data.seed or testSeed,
		roles = roles,
		playerCount = if data then #data.players else #Players:GetPlayers(),
		isTest = data == nil,
	}
end

-- configuration de la partie (nil tant qu'elle n'est pas lue, ou hors serveur réservé)
function PartyLoaderService:GetLaunchData()
	return launchData
end

-- attend la fin du chargement ; renvoie la configuration et les joueurs présents
function PartyLoaderService:WaitUntilLoaded()
	if state ~= "ready" then
		self.Loaded:Wait()
	end
	return launchData, presentPlayers
end

function PartyLoaderService:Init(allServices)
	services = allServices
	local ok, result = pcall(function()
		return MemoryStoreService:GetHashMap(memory.LaunchMapName)
	end)
	if ok then
		launchMap = result
	else
		warn("PartyLoaderService : MemoryStore inaccessible : " .. tostring(result))
	end
end

function PartyLoaderService:Start()
	Players.PlayerAdded:Connect(function(player)
		if state == "rejecting" then
			sendBack(player)
		elseif waitingFor ~= nil then
			Util.notify(player, "MSG_WaitingPlayers")
		end
		-- DÉFAUT : un joueur absent de la configuration, ou arrivé après les 60 s, peut rester
	end)

	task.spawn(load)
end

return PartyLoaderService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="211">
        <Properties>
          <string name="Name">ReturnService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/ReturnService (Partie)
-- Section 16.2 : téléportation vers le Lobby avec les résultats.
-- Les résultats (fin obtenue, survivants, preuves sorties, XP : 4.4 étape 8) sont calculés au jalon J9.
-- Ils voyagent dans les données de téléportation pour l'affichage seulement (ResultsGui) :
-- les gains sont sauvegardés par DataService ici (au départ du joueur), jamais relus depuis ces données.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Version = require(Shared:WaitForChild("Version"))

local ReturnService = {}

-- renvoie les joueurs au Lobby (MSG_ReturnToLobby, 4.6) ; `results` = table affichée à l'arrivée (peut être nil)
function ReturnService:ReturnPlayers(players, results, messageKey)
	local placeId = LaunchConfig.PlaceIds.Lobby
	local travellers = {}
	for _, player in players do
		if player.Parent ~= nil then
			table.insert(travellers, player)
			Util.notify(player, messageKey or "MSG_ReturnToLobby")
		end
	end
	if #travellers == 0 then
		return true
	end

	local options = Instance.new("TeleportOptions")
	options:SetTeleportData({ version = Version.Number, results = results })

	-- DÉFAUT : nouvel essai après un échec, comme au départ (LaunchConfig.Teleport)
	local teleport = LaunchConfig.Teleport
	for attempt = 1, teleport.Attempts do
		local ok, err = pcall(function()
			return TeleportService:TeleportAsync(placeId, travellers, options)
		end)
		if ok then
			return true
		end
		warn(
			("ReturnService : retour au Lobby impossible (essai %d, normal en Studio) : %s"):format(
				attempt,
				tostring(err)
			)
		)
		if attempt < teleport.Attempts then
			task.wait(teleport.RetryDelay)
		end
	end
	return false
end

function ReturnService:ReturnAll(results)
	return self:ReturnPlayers(Players:GetPlayers(), results)
end

function ReturnService:Init() end

function ReturnService:Start()
	TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
		warn(
			("ReturnService : téléportation échouée pour %s (%s) : %s"):format(
				player.Name,
				tostring(teleportResult),
				tostring(errorMessage)
			)
		)
	end)
end

return ReturnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="212">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/SpawnService (Partie)
-- Sections 3.3 et 16.2 : départs S1–S3 ; autour du point, 10 points espacés de 6 studs.
-- Workspace/SpawnPoints peut contenir des Part nommées S1_1 … S3_10 (posées à la main en phase B) :
-- elles remplacent le calcul.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("MapConfig"))
local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))

local SpawnService = {}

-- DÉFAUT : les 10 points sont alignés d'ouest en est, centrés sur le départ
local SPAWN_LIFT = PlayerConfig.Technical.SpawnLift

local function computedPoint(start, index)
	local base = MapConfig.Spawns[start] or MapConfig.Spawns.S1
	local count = MapConfig.SpawnPointCount
	local slot = ((index - 1) % count) - (count - 1) / 2
	return base + Vector3.new(slot * MapConfig.SpawnPointSpacing, SPAWN_LIFT, 0)
end

function SpawnService:GetPoint(start, index)
	local folder = workspace:FindFirstChild("SpawnPoints")
	local marker = folder and folder:FindFirstChild(("%s_%d"):format(start, index))
	if marker and marker:IsA("BasePart") then
		return marker.Position + Vector3.new(0, SPAWN_LIFT, 0)
	end
	return computedPoint(start, index)
end

function SpawnService:Place(_player, character, start, index)
	local point = self:GetPoint(start, index or 1)
	character:PivotTo(CFrame.new(point))
end

function SpawnService:Init() end

function SpawnService:Start() end

return SpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="213">
        <Properties>
          <string name="Name">StaminaService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/StaminaService (Partie)
-- Sections 7.2 et 7.4 : postures (RE_SetStance), vitesses, endurance, bruits de pas et de saut.
-- Attributs : stance ("Stand", "Crouch", "Prone", "Run"), stamina, isExhausted.
-- Le serveur fixe Humanoid.WalkSpeed ; il compare la vitesse réelle à la posture (16.3).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))

local StaminaService = {}

local VOXEL = 4 -- constante (résolution des voxels du terrain Roblox)

local services = nil
local state = {} -- [Player] = { lastEffort, exhaustedUntil, lastStep, moving }
local Movement = PlayerConfig.Movement
local Stamina = PlayerConfig.Stamina

local function maxStamina(player)
	local role = player:GetAttribute("role")
	local value = Stamina.RoleMax[role] or Stamina.Max
	if services.HealthService:IsLow(player, "Torso") then
		value *= PlayerConfig.LowTorsoStaminaFactor
	end
	return value
end

-- matériau sous les pieds : "Water" (eau aux genoux), "Ash" (Sand = cendre, 3.6), "Snow", ou nil
local function terrainKind(character, humanoid)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		local knee = root.Position - Vector3.new(0, VOXEL / 2, 0)
		local half = Vector3.one * (VOXEL / 2)
		local region = Region3.new(knee - half, knee + half):ExpandToGrid(VOXEL)
		local ok, materials, occupancies = pcall(function()
			return workspace.Terrain:ReadVoxels(region, VOXEL)
		end)
		if ok and materials[1] and materials[1][1] and materials[1][1][1] == Enum.Material.Water then
			if occupancies[1][1][1] > 0 then
				return "Water"
			end
		end
	end
	local floor = humanoid.FloorMaterial
	if floor == Enum.Material.Sand then
		return "Ash"
	elseif floor == Enum.Material.Snow then
		return "Snow"
	end
	return nil
end

local function canRun(player)
	local s = state[player]
	return not (s and s.exhaustedUntil and os.clock() < s.exhaustedUntil)
		and (player:GetAttribute("stamina") or 0) > 0
		and not services.HealthService:IsLimping(player)
		and player:GetAttribute("heavyHands") ~= true -- 8 : objet lourd à deux mains : pas de course
		and (player:GetAttribute("carrying") == nil or Movement.RoleCanRunCarrying[player:GetAttribute("role")])
end

-- mode de déplacement effectif et vitesse
local function movementFor(player)
	local stance = player:GetAttribute("stance") or "Stand"
	local role = player:GetAttribute("role")
	if player:GetAttribute("isDowned") then
		return "Downed", PlayerConfig.Downed.CrawlSpeed, 0
	end
	local mode = PlayerConfig.Stances[stance] or "Walk"
	if mode == "Run" and not canRun(player) then
		mode = "Walk"
	end
	if player:GetAttribute("carrying") ~= nil and mode ~= "Run" then
		mode = "Carry"
	end
	local entry = Movement[mode]
	local speed = entry.speed
	local noise = entry.noise
	if mode == "Run" then
		speed = Movement.RoleRunSpeed[role] or speed
		noise = Movement.RoleRunNoise[role] or noise
	elseif mode == "Carry" then
		speed = Movement.RoleCarrySpeed[role] or speed
	end
	if services.HealthService:IsLimping(player) then
		speed *= Movement.LimpSpeedFactor
		noise += Movement.LimpNoiseBonus
	end
	return mode, speed, noise
end

local function tick(dt)
	local weather = services.PartyLoaderService:GetMatchInfo().weather
	local weatherEntry = AmbienceConfig.Weathers[weather]
	for _, player in Players:GetPlayers() do
		local s = state[player]
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if s and humanoid and services.HealthService:IsAlive(player) then
			local mode, speed, noise = movementFor(player)
			local kind = terrainKind(character, humanoid)
			if kind then
				speed *= Movement.TerrainSpeedFactor[kind]
				if kind == "Water" then
					noise *= Movement.WaterNoiseFactor
				end
			end
			humanoid.WalkSpeed = speed

			local root = character:FindFirstChild("HumanoidRootPart")
			local velocity = root and root.AssemblyLinearVelocity or Vector3.zero
			local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			local moving = humanoid.MoveDirection.Magnitude > 0.1 and horizontal > 0.5
			if
				horizontal > speed * PlayerConfig.Technical.StanceSpeedTolerance + 1
				and humanoid.FloorMaterial ~= Enum.Material.Air
			then
				warn(("StaminaService : vitesse anormale pour %s (%.1f > %.1f)"):format(player.Name, horizontal, speed))
			end

			-- endurance (7.4)
			local stamina = player:GetAttribute("stamina") or maxStamina(player)
			local cost = 0
			if moving and mode == "Run" then
				cost += Stamina.RunCostPerSecond
			end
			if player:GetAttribute("carrying") ~= nil and moving then
				cost += Stamina.CarryCostPerSecond
			end
			if cost > 0 then
				stamina -= cost * dt
				s.lastEffort = os.clock()
			elseif os.clock() - (s.lastEffort or 0) >= Stamina.RegenDelay then
				local regen = if moving then Stamina.RegenWalkingPerSecond else Stamina.RegenIdlePerSecond
				if (player:GetAttribute("fear") or 0) >= PlayerConfig.Fear.MisplacedSoundsAt then
					regen *= PlayerConfig.Fear.StaminaRegenFactorAt80
				end
				-- 12.3 et 19.6 (C18) : « endurance ×0,85 » par neige s'applique à la récupération
				if weatherEntry and weatherEntry.staminaFactor then
					regen *= weatherEntry.staminaFactor
				end
				stamina += regen * dt
			end
			stamina = math.clamp(stamina, 0, maxStamina(player))
			if stamina <= 0 and not (s.exhaustedUntil and os.clock() < s.exhaustedUntil) then
				s.exhaustedUntil = os.clock() + Stamina.ExhaustedDuration
			end
			local exhausted = s.exhaustedUntil ~= nil and os.clock() < s.exhaustedUntil
			player:SetAttribute("stamina", stamina)
			player:SetAttribute("isExhausted", exhausted)
			if exhausted and root then
				services.NoiseService:Emit(root.Position, Stamina.ExhaustedPantNoise, NoiseTypes.Pant, player)
			end

			-- bruits de pas
			if
				moving
				and root
				and noise > 0
				and os.clock() - (s.lastStep or 0) >= PlayerConfig.Technical.FootstepNoiseInterval
			then
				s.lastStep = os.clock()
				services.NoiseService:Emit(root.Position, noise, NoiseTypes.Footstep, player)
			end
		end
	end
end

local function onCharacter(player, character)
	state[player] = { lastEffort = 0 }
	player:SetAttribute("stance", "Stand")
	player:SetAttribute("stamina", maxStamina(player))
	player:SetAttribute("isExhausted", false)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	humanoid.StateChanged:Connect(function(_, new)
		local root = character:FindFirstChild("HumanoidRootPart")
		if new == Enum.HumanoidStateType.Jumping then
			player:SetAttribute("stamina", math.max(0, (player:GetAttribute("stamina") or 0) - Stamina.JumpCost))
			state[player].lastEffort = os.clock()
		elseif new == Enum.HumanoidStateType.Landed and root then
			services.NoiseService:Emit(root.Position, Movement.JumpLandNoise, NoiseTypes.Jump, player)
		end
	end)
end

function StaminaService:Init(allServices)
	services = allServices
end

function StaminaService:Start()
	services.CharacterService.Spawned:Connect(onCharacter)
	local remote = Util.getRemote("RE_SetStance")
	if remote then
		RateLimiter.connect(remote, function(player, stance)
			if type(stance) == "string" and PlayerConfig.Stances[stance] then
				player:SetAttribute("stance", stance)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
		end
	end)
end

return StaminaService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="214">
        <Properties>
          <string name="Name">TabletService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/TabletService (Partie)
-- DÉFAUT : module ajouté — 16.2 ne nomme pas le service qui traite RE_TabletAction (16.3).
-- Section 8.3 : une tablette par groupe (Meneur, sinon le premier joueur), écran = visibilité ×1,5,
-- batterie de 30 min d'écran allumé, GPS à ±30 studs toutes les 10 s (50 % « Pas de signal GPS »
-- sous forêt dense), 8 repères, Réseau : une barre au sommet de P11 et à P23, SMS au ranger Hollis.
-- RE_TabletAction (C → S) : (app, action, data). Contrôle : porte la tablette.
-- Attributs : tabletOpen, tabletBattery, gpsX, gpsZ, gpsSignal, tabletMessage (joueur) ;
-- markers (MatchState, JSON).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))

local TabletService = {}

local services = nil
local Tablet = ItemConfig.Tablet
local markers = {}
local random = Random.new()

local function tabletEntry(player)
	local inv = services.InventoryService:Get(player)
	if inv == nil then
		return nil
	end
	for _, list in { inv.quick, inv.bag } do
		for _, entry in list do
			if entry and entry.id == "ITM_TabletField" then
				return entry
			end
		end
	end
	return nil
end

local function setOpen(player, open)
	local entry = tabletEntry(player)
	if entry == nil or (open and (entry.battery or 1) <= 0) then
		open = false
	end
	player:SetAttribute("tabletOpen", open)
end

local function inDenseForest(position)
	local zone = MapConfig.Places.P04.zone
	return position.X >= zone.minX and position.X <= zone.maxX and position.Z >= zone.minZ and position.Z <= zone.maxZ
end

-- 8.3 : une barre au sommet de P11 et à P23 (DÉFAUT : « sommet » = dans le rayon et au niveau de la cabine)
local function hasNetwork(position)
	for _, code in Tablet.NetworkPlaces do
		local place = MapConfig.Places[code]
		local flat = Vector2.new(position.X - place.pos.X, position.Z - place.pos.Z).Magnitude
		local minY = place.pos.Y + (place.cabinOffset or 0) / 2
		if flat <= place.radius and position.Y >= minY then
			return true
		end
	end
	return false
end

local function updateGps(player)
	local root = Util.characterRoot(player)
	if root == nil or tabletEntry(player) == nil then
		return
	end
	if inDenseForest(root.Position) and random:NextNumber() < Tablet.DenseForestNoSignalChance then
		player:SetAttribute("gpsSignal", false)
		return
	end
	local e = Tablet.GpsError
	player:SetAttribute("gpsSignal", true)
	player:SetAttribute("gpsX", root.Position.X + random:NextNumber(-e, e))
	player:SetAttribute("gpsZ", root.Position.Z + random:NextNumber(-e, e))
	player:SetAttribute("network", hasNetwork(root.Position))
end

local ACTIONS = {
	Device = {
		Toggle = function(player)
			setOpen(player, not player:GetAttribute("tabletOpen"))
		end,
		Close = function(player)
			setOpen(player, false)
		end,
	},
	Map = {
		AddMarker = function(_player, data)
			if type(data) ~= "table" or type(data.x) ~= "number" or type(data.z) ~= "number" then
				return
			end
			if #markers >= Tablet.MaxMarkers then
				return
			end
			table.insert(markers, { x = data.x, z = data.z })
			Util.getMatchState():SetAttribute("markers", Util.encode(markers))
		end,
		RemoveMarker = function(_player, data)
			if type(data) == "table" and type(data.index) == "number" and markers[data.index] then
				table.remove(markers, data.index)
				Util.getMatchState():SetAttribute("markers", Util.encode(markers))
			end
		end,
	},
	Network = {
		Send = function(player)
			local root = Util.characterRoot(player)
			if root and hasNetwork(root.Position) then
				-- 8.3 : réponse automatique du ranger Hollis
				player:SetAttribute("tabletMessage", LoreConfig.Tablet.HollisReply)
			else
				player:SetAttribute("tabletMessage", LoreConfig.Tablet.NoNetwork)
			end
		end,
	},
}

local function onAction(player, app, action, data)
	if type(app) ~= "string" or type(action) ~= "string" then
		return
	end
	if tabletEntry(player) == nil then
		return -- 16.3 : porte la tablette
	end
	local handlers = ACTIONS[app]
	local handler = handlers and handlers[action]
	if handler then
		handler(player, data)
	end
end

local function tick(dt)
	for _, player in Players:GetPlayers() do
		local entry = tabletEntry(player)
		if entry == nil and player:GetAttribute("tabletOpen") then
			player:SetAttribute("tabletOpen", false)
		end
		if entry and player:GetAttribute("tabletOpen") then
			entry.battery = math.max(0, (entry.battery or 1) - dt / (Tablet.BatteryMinutes * Util.SECONDS_PER_MINUTE))
			player:SetAttribute("tabletBattery", entry.battery)
			if entry.battery <= 0 then
				setOpen(player, false)
			end
		elseif entry then
			player:SetAttribute("tabletBattery", entry.battery or 1)
		end
	end
end

-- repère posé par le jeu (19.5, C7 : indice caché HC1, gué de HC3) ; hors de la limite des joueurs
function TabletService:AddMarker(position)
	table.insert(markers, { x = position.X, z = position.Z })
	Util.getMatchState():SetAttribute("markers", Util.encode(markers))
end

function TabletService:Init(allServices)
	services = allServices
end

function TabletService:Start()
	local remote = Util.getRemote("RE_TabletAction")
	if remote then
		RateLimiter.connect(remote, onAction)
	end
	services.InventoryService.ItemUsed:Connect(function(player, itemId)
		if itemId == "ITM_TabletField" then
			setOpen(player, not player:GetAttribute("tabletOpen"))
		end
	end)
	-- 8.3 : sans Meneur, la tablette va au premier joueur du groupe
	task.spawn(function()
		local _, players = services.PartyLoaderService:WaitUntilLoaded()
		task.wait(PlayerConfig.Technical.Tick * 2)
		local hasLeader = false
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("role") == "Leader" then
				hasLeader = true
			end
		end
		local first = players[1] or Players:GetPlayers()[1]
		if not hasLeader and first then
			services.InventoryService:Add(first, "ITM_TabletField", 1)
		end
	end)
	task.spawn(function()
		local elapsed = 0
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
			elapsed += step
			if elapsed >= Tablet.GpsInterval then
				elapsed = 0
				for _, player in Players:GetPlayers() do
					updateGps(player)
				end
			end
		end
	end)
end

return TabletService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="215">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/WeaponService (Partie)
-- Sections 8.2 et 16.3 : validation des tirs (origine à moins de 5 studs de la tête, cadence,
-- munitions), dégâts sur la créature (corps / tête), tir allié en Difficile et Cauchemar,
-- rechargement balle par balle interruptible, mêlée.
-- Créatures : modèles tagués « Creature » ; un coup est signalé par CreatureHit (l'IA applique les PV).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local WeaponService = {}

-- (creatureModel, damage, shooter, weaponId, isHead, hitPart) ; extra = { blind, flee, grabRelease }
WeaponService.CreatureHit = Signal.new()
WeaponService.Fired = Signal.new() -- (player, weaponId, origin)

local services = nil
local lastShot = {} -- [Player] = os.clock()
local reloading = {} -- [Player] = thread

-- DÉFAUT : portée maximale d'un rayon de tir (la diagonale de la carte)
local MAX_RANGE = WeaponConfig.Weapons.WPN_Rifle.noise

local function heldWeapon(player)
	local entry = services.InventoryService:Selected(player)
	if entry and WeaponConfig.Weapons[entry.id] then
		return entry, WeaponConfig.Weapons[entry.id]
	end
	return nil
end

local function creatureFrom(part)
	local node = part
	while node and node ~= workspace do
		if CollectionService:HasTag(node, "Creature") then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function playerFrom(part)
	local model = part:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

local function friendlyFireOn()
	local info = services.PartyLoaderService:GetMatchInfo()
	return ActConfig.difficulty(info.difficulty).friendlyFire
end

-- RaycastParams du tireur : construits une fois par personnage (8 plombs par tir au fusil à pompe)
local shooterParams = setmetatable({}, { __mode = "k" })
local function cast(shooter, origin, direction, range)
	local character = shooter.Character
	local params = character and shooterParams[character]
	if params == nil then
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		if character then
			shooterParams[character] = params
		end
	end
	return workspace:Raycast(origin, direction.Unit * range, params)
end

-- `shot` : table propre à un tir (plusieurs plombs) ; un coéquipier à terre n'est pénalisé qu'une fois par tir
local function applyHit(shooter, weaponId, weapon, result, creatureDamage, friendlyDamage, shot)
	if result == nil then
		return
	end
	local creature = creatureFrom(result.Instance)
	if creature then
		local isHead = result.Instance.Name == "Head"
		local damage = creatureDamage
		if weapon.damageHead and isHead then
			damage = weapon.damageHead
		end
		WeaponService.CreatureHit:Fire(creature, damage, shooter, weaponId, isHead, result.Instance, {
			blind = weapon.blindDuration,
			flee = weapon.creatureFleeDuration,
			grabReleaseHits = weapon.grabReleaseHits,
		})
		return
	end
	local victim = playerFrom(result.Instance)
	if victim and victim ~= shooter and friendlyFireOn() then
		-- 19.6 (C3) : à terre, un tir allié retire 10 s une seule fois par tir, quel que soit le nombre de plombs
		if victim:GetAttribute("isDowned") and shot then
			if shot[victim] then
				return
			end
			shot[victim] = true
		end
		-- 8.2 : tir allié (torse) ; 19.6 (C14) : lance-fusées = brûlure, jamais d'hémorragie grave
		local maxBleed = if weapon.burnPerSecond then "Light" else nil
		services.HealthService:Damage(victim, "Torso", friendlyDamage, shooter, nil, maxBleed)
		if weapon.burnPerSecond then
			task.spawn(function()
				for _ = 1, weapon.burnDuration do
					task.wait(1) -- constante (une brûlure par seconde)
					services.HealthService:Damage(victim, "Torso", weapon.burnPerSecond, shooter, nil, "Light", "Burn")
				end
			end)
		end
	end
end

local function cancelReload(player)
	local thread = reloading[player]
	if thread then
		task.cancel(thread)
		reloading[player] = nil
		player:SetAttribute("isReloading", false)
	end
end

local function publishAmmo(player)
	local entry, weapon = heldWeapon(player)
	if entry and weapon.ammo then
		player:SetAttribute("ammo", entry.ammo or 0)
		player:SetAttribute("ammoReserve", services.InventoryService:Count(player, "AMMO_" .. entry.id))
	else
		player:SetAttribute("ammo", nil)
		player:SetAttribute("ammoReserve", nil)
	end
end

local function onFire(player, origin, direction, _timestamp)
	if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" or direction.Magnitude < 0.01 then
		return
	end
	if not services.HealthService:IsUp(player) or player:GetAttribute("heavyHands") then
		return
	end
	local head = player.Character and player.Character:FindFirstChild("Head")
	local entry, weapon = heldWeapon(player)
	-- 19.5 (C6) : pas d'arme à feu pendant le portage
	if weapon and not weapon.melee and player:GetAttribute("carrying") ~= nil then
		return
	end
	if head == nil or entry == nil then
		return
	end
	-- 16.3 : origine à moins de 5 studs de la tête
	if (origin - head.Position).Magnitude > WeaponConfig.MaxOriginOffset then
		return
	end
	-- 7.7 : l'Opératrice ne peut pas porter d'arme à feu
	if not weapon.melee and player:GetAttribute("role") == WeaponConfig.NoFirearmRole then
		return
	end
	-- cadence
	local interval = weapon.fireInterval or weapon.reloadTime or 0
	if os.clock() - (lastShot[player] or -math.huge) < interval then
		return
	end
	if weapon.ammo and (entry.ammo or 0) <= 0 then
		return -- 8.2 : tir impossible sans munitions
	end
	cancelReload(player) -- le rechargement est interruptible
	lastShot[player] = os.clock()

	if weapon.melee then
		local result = cast(player, origin, direction, WeaponConfig.MeleeRange[entry.id])
		applyHit(player, entry.id, weapon, result, weapon.damage, weapon.friendlyDamage)
		services.NoiseService:Emit(head.Position, weapon.noise, NoiseTypes.Melee, player)
		return
	end

	entry.ammo -= 1
	services.NoiseService:Emit(head.Position, weapon.noise, NoiseTypes.Gunshot, player)
	WeaponService.Fired:Fire(player, entry.id, origin)
	if weapon.pellets then
		local shot = {}
		for _ = 1, weapon.pellets do
			local spread = math.rad(weapon.spreadDegrees or 0)
			local dir = (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(
				(math.random() - 0.5) * spread,
				(math.random() - 0.5) * spread,
				0
			)).LookVector
			local result = cast(player, origin, dir, weapon.zeroBeyond or MAX_RANGE)
			if result then
				local distance = (result.Position - origin).Magnitude
				-- 19.5 (C13) : plein dégât jusqu'à 15 studs, baisse linéaire jusqu'à 30 % à 40 studs,
				-- 30 % jusqu'à 60 studs, 0 au-delà (portée du rayon)
				local factor = 1
				if distance > weapon.fullDamageRange then
					local t = math.clamp(
						(distance - weapon.fullDamageRange) / (weapon.reducedRange - weapon.fullDamageRange),
						0,
						1
					)
					factor = 1 - (1 - weapon.reducedFactor) * t
				end
				applyHit(
					player,
					entry.id,
					weapon,
					result,
					weapon.damagePerPellet * factor,
					weapon.friendlyPerPellet,
					shot
				)
			end
		end
	else
		local result = cast(player, origin, direction, MAX_RANGE)
		applyHit(
			player,
			entry.id,
			weapon,
			result,
			weapon.damageBody or weapon.damage,
			weapon.friendlyTorso or weapon.friendlyDamage
		)
	end
	publishAmmo(player)
end

-- 8.2 : rechargement manuel balle par balle, interruptible ; bras < 30 % : ×1,5 plus lent (7.3)
local function onReload(player)
	local entry, weapon = heldWeapon(player)
	if entry == nil or not weapon.ammo or reloading[player] then
		return
	end
	local ammoId = "AMMO_" .. entry.id
	if services.InventoryService:Count(player, ammoId) <= 0 then
		return -- 16.3 : réserve > 0
	end
	local perRound = weapon.reloadPerRound or weapon.reloadTime
	if services.HealthService:IsLow(player, "ArmL") or services.HealthService:IsLow(player, "ArmR") then
		perRound *= PlayerConfig.LowArmReloadFactor
	end
	player:SetAttribute("isReloading", true)
	reloading[player] = task.spawn(function()
		local capacity = weapon.magazine or weapon.ammo
		while (entry.ammo or 0) < capacity and services.InventoryService:Count(player, ammoId) > 0 do
			task.wait(perRound)
			local current = heldWeapon(player)
			if current ~= entry or not services.InventoryService:Remove(player, ammoId, 1) then
				break
			end
			entry.ammo += 1
			publishAmmo(player)
		end
		reloading[player] = nil
		player:SetAttribute("isReloading", false)
	end)
end

function WeaponService:Init(allServices)
	services = allServices
end

function WeaponService:Start()
	local fire = Util.getRemote("RE_FireWeapon")
	if fire then
		RateLimiter.connect(fire, onFire)
	end
	local reload = Util.getRemote("RE_Reload")
	if reload then
		RateLimiter.connect(reload, onReload)
	end
	services.InventoryService.Changed:Connect(function(player)
		local entry = heldWeapon(player)
		if reloading[player] and entry == nil then
			cancelReload(player)
		end
		publishAmmo(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastShot[player] = nil
		cancelReload(player)
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="216">
        <Properties>
          <string name="Name">WeatherService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/WeatherService (Partie)
-- Sections 12.3 et 12.4 : météo tirée à chaque partie (sauf vote « fixe »), passage en pluie
-- (ou neige au-dessus de Y = 350) pendant l'acte 2, vent global et rafales.
-- État : MatchState.weather (Clear, Fog, Rain, Snow).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local WeatherService = {}

local services = nil
local current = nil
local random = nil

local function draw()
	local roll = random:NextNumber()
	local sum = 0
	for _, id in AmbienceConfig.WeatherOrder do
		sum += AmbienceConfig.Weathers[id].probability
		if roll <= sum then
			return id
		end
	end
	return AmbienceConfig.WeatherOrder[#AmbienceConfig.WeatherOrder]
end

local function apply(id)
	current = id
	Util.getMatchState():SetAttribute("weather", id)
	local wind = AmbienceConfig.Wind[id]
	workspace.GlobalWind = Vector3.new(table.unpack(wind.base))
end

function WeatherService:Get()
	return current
end

function WeatherService:Entry()
	return AmbienceConfig.Weathers[current]
end

-- 12.3 : pendant l'acte 2, nuit claire ou brouillard → pluie ; neige au-dessus de 350 (la cabane)
function WeatherService:SiegeChange()
	local rule = AmbienceConfig.SiegeWeather
	if rule.from[current] then
		local cabin = require(Config:WaitForChild("MapConfig")).Places.P05c
		apply(if cabin.pos.Y > rule.snowAboveY then rule.toAbove else rule.to)
	end
end

-- 12.4 : rafales (ajoutées au vent de base dans sa direction)
local function gustLoop()
	while true do
		local wind = AmbienceConfig.Wind[current]
		if wind and wind.sine and (wind.gust or 0) > 0 then
			-- pluie : force du vent en sinus autour du vent de base (DÉFAUT, C21)
			local base = Vector3.new(table.unpack(wind.base))
			local phase = os.clock() / AmbienceConfig.WindSinePeriod * math.pi * 2
			workspace.GlobalWind = base + base.Unit * wind.gust * (0.5 + 0.5 * math.sin(phase))
			task.wait(AmbienceConfig.WindSineStep)
		elseif wind == nil or (wind.gust or 0) <= 0 or wind.gustIntervalMin == nil then
			task.wait(AmbienceConfig.Wind.Clear.gustIntervalMin)
		else
			task.wait(random:NextNumber(wind.gustIntervalMin, wind.gustIntervalMax))
			local base = Vector3.new(table.unpack(wind.base))
			workspace.GlobalWind = base + base.Unit * wind.gust
			task.wait(AmbienceConfig.GustDuration)
			workspace.GlobalWind = base
		end
	end
end

function WeatherService:Begin(info)
	random = Random.new(info.seed)
	local chosen = info.weather
	if chosen == nil or chosen == "Random" or AmbienceConfig.Weathers[chosen] == nil then
		chosen = draw()
	end
	apply(chosen)
	print("WeatherService : météo " .. chosen)
	task.spawn(gustLoop)
end

function WeatherService:Init(allServices)
	services = allServices
end

function WeatherService:Start()
	local _ = services
end

return WeatherService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="217">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/DataService (les deux places)
-- Section 16.2 et 16.4 : DataStore PisteFroide_v1, clé player_<UserId>,
-- verrouillage de session, sauvegarde toutes les 120 s et à la fermeture.
-- Le verrou est rangé dans les métadonnées de la clé : la valeur garde exactement le format de 16.4.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

-- (player, data) : données chargées et prêtes
DataService.Loaded = Signal.new()

local store = nil -- nil si les API DataStore sont inaccessibles (Studio sans accès)
local sessions = {} -- [Player] = { data = table, released = bool }

local function keyFor(userId)
	return ProgressionConfig.KeyPrefix .. tostring(userId)
end

-- données par défaut d'un nouveau joueur (16.4)
local function buildDefaultData()
	local endings = {}
	for _, endingId in ProgressionConfig.EndingIds do
		endings[endingId] = false
	end

	local skins = {}
	local equipped = {}
	for _, role in PlayerConfig.Roles do
		-- un rôle sans identifiant n'a pas de clé de données
		if role.id ~= nil then
			local owned = {}
			for _, skinId in ProgressionConfig.SkinIds do
				owned[skinId] = skinId == ProgressionConfig.DefaultSkin
			end
			skins[role.id] = owned
			equipped[role.id] = ProgressionConfig.DefaultSkin
		end
	end

	local museumRead = {}
	for _, panelId in ProgressionConfig.MuseumPanelIds do
		museumRead[panelId] = false
	end

	return {
		version = ProgressionConfig.DataVersion,
		xp = 0,
		plays = 0,
		survivals = 0,
		endings = endings,
		evidence = {},
		skins = skins,
		equipped = equipped,
		notebookPages = Util.deepCopy(ProgressionConfig.DefaultNotebookPages),
		museumRead = museumRead,
		nightmareUnlocked = false,
		-- 19.5 (C38) : accessoires débloqués et portés (DÉFAUT : champs ajoutés à 16.4)
		evidenceBOut = 0,
		accessories = {},
		equippedAccessories = {},
		-- 17.2 : les défauts PC / mobile sont appliqués par le client (SettingsController) ; seules les
		-- valeurs changées par le joueur sont enregistrées
		settings = {},
	}
end

-- vrai si une autre session (autre serveur) tient un verrou encore frais
local function isLockedByOther(metadata)
	if metadata == nil or metadata.lockJobId == nil then
		return false
	end
	if metadata.lockJobId == game.JobId then
		return false
	end
	local age = os.time() - (metadata.lockTime or 0)
	return age < ProgressionConfig.SessionLock.StaleAfter
end

local function lockMetadata()
	return { lockJobId = game.JobId, lockTime = os.time() }
end

-- une tentative : prend le verrou et lit les données.
-- Renvoie "ok" + données, ou "locked" si une autre session tient le verrou.
local function tryAcquire(userId)
	local status = "ok"
	local loaded = nil
	store:UpdateAsync(keyFor(userId), function(current, keyInfo)
		local metadata = keyInfo and keyInfo:GetMetadata() or nil
		if isLockedByOther(metadata) then
			status = "locked"
			return nil -- annule l'écriture
		end
		status = "ok"
		loaded = current or buildDefaultData()
		return loaded, { userId }, lockMetadata()
	end)
	return status, loaded
end

-- écrit les données ; `release` libère le verrou (départ du joueur, fermeture)
local function writeSession(player, session, release)
	if store == nil then
		return
	end
	local userId = player.UserId
	local stolen = false
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(userId), function(_current, keyInfo)
			local metadata = keyInfo and keyInfo:GetMetadata() or nil
			if isLockedByOther(metadata) then
				stolen = true
				return nil -- une autre session a repris la clé : ne pas l'écraser
			end
			stolen = false
			local newMetadata = if release then {} else lockMetadata()
			return session.data, { userId }, newMetadata
		end)
	end)
	if not ok then
		warn(("DataService : échec de sauvegarde pour %d : %s"):format(userId, tostring(err)))
	elseif stolen then
		warn(("DataService : verrou repris par une autre session pour %d, sauvegarde annulée"):format(userId))
	end
end

-- DÉFAUT : quelques compteurs publiés en attributs pour l'interface (lecture seule côté client)
local PUBLISHED = { "xp", "plays", "survivals", "nightmareUnlocked" }
local PUBLISHED_JSON = {
	"settings",
	"evidence",
	"notebookPages",
	"museumRead",
	"skins",
	"equipped",
	"endings",
	"accessories",
	"equippedAccessories",
}
local function publishAttributes(player, data)
	for _, key in PUBLISHED do
		player:SetAttribute(key, data[key])
	end
	for _, key in PUBLISHED_JSON do
		player:SetAttribute(key .. "Json", Util.encode(data[key]))
	end
end

-- 17.2 : RE_SaveSettings (DÉFAUT : remote ajoutée, 16.3 n'en prévoit pas) — valeurs vérifiées
local function validSetting(key, value)
	local spec = ProgressionConfig.Settings[key]
	if spec == nil then
		return false
	end
	if spec.options then
		return table.find(spec.options, value) ~= nil
	end
	return type(value) == "number" and value >= spec.min and value <= spec.max
end

function DataService:SaveSettings(player, values)
	local session = sessions[player]
	if session == nil or type(values) ~= "table" then
		return
	end
	for key, value in values do
		if type(key) == "string" and validSetting(key, value) then
			session.data.settings[key] = value
		end
	end
	publishAttributes(player, session.data)
end

local function onPlayerAdded(player)
	if sessions[player] ~= nil then
		return
	end

	if store == nil then
		-- Studio sans accès aux API : données par défaut, jamais sauvegardées
		sessions[player] = { data = buildDefaultData(), released = true }
		publishAttributes(player, sessions[player].data)
		player:SetAttribute("dataLoaded", true)
		DataService.Loaded:Fire(player, sessions[player].data)
		return
	end

	local lock = ProgressionConfig.SessionLock
	for attempt = 1, lock.LoadAttempts do
		if player.Parent == nil then
			return -- le joueur est parti pendant le chargement
		end
		local ok, status, data = pcall(tryAcquire, player.UserId)
		if ok and status == "ok" then
			local session = { data = Util.reconcile(data, buildDefaultData()), released = false }
			if player.Parent == nil then
				-- parti entre-temps : on rend le verrou tout de suite
				writeSession(player, session, true)
				return
			end
			sessions[player] = session
			publishAttributes(player, session.data)
			player:SetAttribute("dataLoaded", true)
			DataService.Loaded:Fire(player, session.data)
			return
		end
		if not ok then
			warn(
				("DataService : échec de chargement pour %d (essai %d) : %s"):format(
					player.UserId,
					attempt,
					tostring(status)
				)
			)
		end
		if attempt < lock.LoadAttempts then
			task.wait(lock.LoadRetryDelay)
		end
	end

	-- 4.6 : le joueur joue sans données, rien n'est sauvegardé pour lui (MSG_DataLoadFailed)
	warn(
		("DataService : données indisponibles pour %d, aucune sauvegarde pendant cette session"):format(player.UserId)
	)
	Util.notify(player, "MSG_DataLoadFailed")
	player:SetAttribute("dataLoaded", false)
end

local function releaseSession(player)
	local session = sessions[player]
	if session == nil then
		return
	end
	sessions[player] = nil
	if session.released then
		return
	end
	session.released = true
	writeSession(player, session, true)
end

-- données du joueur, ou nil si pas (encore) chargées
function DataService:GetData(player)
	local session = sessions[player]
	return session and session.data or nil
end

function DataService:IsLoaded(player)
	return sessions[player] ~= nil
end

-- attend les données du joueur ; nil si le joueur part ou si le chargement échoue
function DataService:WaitForData(player)
	while player.Parent ~= nil and sessions[player] == nil and player:GetAttribute("dataLoaded") ~= false do
		task.wait()
	end
	return self:GetData(player)
end

-- sauvegarde immédiate en gardant le verrou
function DataService:Save(player)
	local session = sessions[player]
	if session ~= nil and not session.released then
		publishAttributes(player, session.data)
		writeSession(player, session, false)
	end
end

function DataService:Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(ProgressionConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn(
			"DataService : DataStore inaccessible (en Studio : activer l'accès aux API). Données non sauvegardées. "
				.. tostring(result)
		)
	end
end

function DataService:Start()
	local settingsRemote = Util.getRemote("RE_SaveSettings")
	if settingsRemote then
		require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RateLimiter")).connect(
			settingsRemote,
			function(player, values)
				DataService:SaveSettings(player, values)
			end
		)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(releaseSession)

	-- sauvegarde périodique (16.2 : toutes les 120 s)
	task.spawn(function()
		while true do
			task.wait(ProgressionConfig.AutosaveInterval)
			for player in table.clone(sessions) do
				task.spawn(DataService.Save, DataService, player)
			end
		end
	end)

	-- sauvegarde à la fermeture du serveur
	game:BindToClose(function()
		local pending = 0
		for player in table.clone(sessions) do
			pending += 1
			task.spawn(function()
				releaseSession(player)
				pending -= 1
			end)
		end
		while pending > 0 do
			task.wait()
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="218">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="219">
      <Properties>
        <string name="Name">Creatures</string>
      </Properties>
    </Item>
    <Item class="Folder" referent="220">
      <Properties>
        <string name="Name">Props</string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="221">
      <Properties>
        <string name="Name">TerrainBuilder</string>
        <string name="Source"><![CDATA[-- ServerStorage/TerrainBuilder (Partie) — script d'édition, lancé une seule fois en mode Edit (3.7)
-- Barre de commande de Studio :
--   require(game.ServerStorage.TerrainBuilder).Build()        -- relief, eau, matériaux, lieux, limites
--   require(game.ServerStorage.TerrainBuilder).Vegetation()   -- végétation (après import des modèles)
-- Graine fixe 1924 : la carte est identique à chaque régénération. Toutes les valeurs : MapConfig.
-- Étapes de 3.7 : 1 relief de base (collines gaussiennes + pente sud → nord), 2 bruit fractal et crêtes,
-- 3 rivières (lit 0,35 × largeur + 4, raccord 3 × largeur, fond toujours descendant), 4 gorges,
-- 5 aplanir chaque lieu (raccord 1,5 × rayon), 6 routes et sentiers (pente max 8 % / 15 %),
-- 7 matériaux (pente > 40° = Rock ou Basalt, puis biomes), 8 eau (R1, R2, R3, lac P20),
-- 9 végétation (Workspace/Vegetation/Chunk_X_Z, blocs de 512 studs).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local MapConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("MapConfig"))

local TerrainBuilder = {}

local T = MapConfig.Terrain
local CELL = T.Cell
local HALF = MapConfig.DecorHalf
local N = math.floor(2 * HALF / CELL) + 1
local VOXEL = 4 -- constante (résolution des voxels du terrain Roblox)

local height = {} -- [i][j] hauteur du sol (studs)
local material = {} -- [i][j] nom de matériau imposé (rivière, route…)
local water = {} -- [i][j] niveau d'eau, ou nil

local function toCell(v)
	return math.clamp(math.floor((v + HALF) / CELL + 0.5) + 1, 1, N)
end

local function toWorld(i)
	return (i - 1) * CELL - HALF
end

local function getH(x, z)
	return height[toCell(x)][toCell(z)]
end

-- 1. relief de base : pente douce du sud (Y ≈ 40) au nord (Y ≈ 420), plus les ancres gaussiennes
local function baseHeight(_x, z)
	local t = math.clamp((MapConfig.PlayableHalf - z) / (2 * MapConfig.PlayableHalf), 0, 1)
	return T.SouthY + (T.NorthY - T.SouthY) * t
end

local function anchors(x, z, h)
	for _, a in T.Anchors do
		local dx = (x - a.pos.X) / a.radius.X
		local dz = (z - a.pos.Y) / a.radius.Y
		local w = math.exp(-(dx * dx + dz * dz))
		h += (a.height - baseHeight(a.pos.X, a.pos.Y)) * w
	end
	return h
end

-- 2. bruit fractal : 5 octaves, période 1 600, amplitude 60, fréquence ×2 et amplitude ÷2 par octave ;
-- bruit en crêtes d'amplitude 40 sur les crêtes (ancres « Crête »)
local function noise(x, z)
	local total, period, amplitude = 0, T.Noise.period, T.Noise.amplitude
	for _ = 1, T.Noise.octaves do
		total += math.noise(x / period, z / period, T.Seed) * amplitude
		period /= 2
		amplitude /= 2
	end
	local ridge = 0
	for _, a in T.Anchors do
		if string.find(a.name, "Crête") then
			local dx = (x - a.pos.X) / a.radius.X
			local dz = (z - a.pos.Y) / a.radius.Y
			local w = math.exp(-(dx * dx + dz * dz))
			ridge += (1 - math.abs(math.noise(x / T.Noise.period, z / T.Noise.period, T.Seed + 1))) * T.Noise.ridgeAmplitude * w
		end
	end
	return total + ridge
end

-- tracé d'un chemin (3.5) : liste de points (X, Z) ; « c » = contrôles de Bézier cubique
local function resolve(point)
	if type(point) == "string" then
		local p = MapConfig.Places[point].pos
		return Vector2.new(p.X, p.Z)
	end
	return Vector2.new(point[1], point[2])
end

local function bezier(p0, p1, p2, p3, t)
	local u = 1 - t
	return p0 * u * u * u + p1 * 3 * u * u * t + p2 * 3 * u * t * t + p3 * t * t * t -- constante (Bézier cubique)
end

local function samplePath(path, step)
	local anchorsList, samples = {}, {}
	local i = 1
	local points = path.points
	while i <= #points do
		local p = points[i]
		if type(p) == "table" and p.c then
			i += 1
		else
			table.insert(anchorsList, { index = i, pos = resolve(p) })
			i += 1
		end
	end
	for k = 1, #anchorsList - 1 do
		local a, b = anchorsList[k], anchorsList[k + 1]
		local controls = {}
		for j = a.index + 1, b.index - 1 do
			table.insert(controls, Vector2.new(points[j].c[1], points[j].c[2]))
		end
		local length = (b.pos - a.pos).Magnitude
		local count = math.max(1, math.ceil(length / step))
		for s = 0, count - 1 do
			local t = s / count
			local p
			if #controls == 2 then
				p = bezier(a.pos, controls[1], controls[2], b.pos, t)
			else
				p = a.pos:Lerp(b.pos, t)
			end
			table.insert(samples, p)
		end
	end
	table.insert(samples, anchorsList[#anchorsList].pos)
	return samples
end

local function widthAt(path, f)
	if path.widths then
		local w = path.widths
		local x = f * (#w - 1) + 1
		local lo = math.floor(x)
		local hi = math.min(#w, lo + 1)
		return w[lo] + (w[hi] - w[lo]) * (x - lo)
	end
	return path.width
end

-- applique une hauteur cible sur une bande (largeur), raccordée sur `blend`
local function stamp(center, halfWidth, blend, target, mat)
	local reach = halfWidth + blend
	for i = toCell(center.X - reach), toCell(center.X + reach) do
		for j = toCell(center.Y - reach), toCell(center.Y + reach) do
			local d = (Vector2.new(toWorld(i), toWorld(j)) - center).Magnitude
			if d <= halfWidth then
				height[i][j] = target
				if mat then
					material[i][j] = mat
				end
			elseif d <= reach then
				local w = 1 - (d - halfWidth) / blend
				height[i][j] = height[i][j] + (target - height[i][j]) * w * w
			end
		end
	end
end

local function buildHeights()
	for i = 1, N do
		height[i], material[i], water[i] = {}, {}, {}
		local x = toWorld(i)
		for j = 1, N do
			local z = toWorld(j)
			height[i][j] = anchors(x, z, baseHeight(x, z)) + noise(x, z)
		end
		if i % 64 == 0 then -- constante (pause pour ne pas figer Studio)
			task.wait()
		end
	end
end

-- 4. gorges : Ape Canyon (150, de (2 300, −600) à (3 000, −2 200)) ; Lava Canyon (70, le long de R2 entre Z = 1 600 et 2 600)
-- 19.5 (C40) : profil en trapèze — largeur `top` au bord, `bottom` au fond ; parois à plus de 60°
local function carveGorge(center, top, bottom, rimY, depth, mat)
	local floor = rimY - depth
	local halfTop, halfBottom = top / 2, math.min(bottom, top) / 2
	for i = toCell(center.X - halfTop), toCell(center.X + halfTop) do
		for j = toCell(center.Y - halfTop), toCell(center.Y + halfTop) do
			local d = (Vector2.new(toWorld(i), toWorld(j)) - center).Magnitude
			if d <= halfTop then
				local h = floor
				if d > halfBottom and halfTop > halfBottom then
					h = floor + (d - halfBottom) / (halfTop - halfBottom) * depth
				end
				if h < height[i][j] then
					height[i][j] = h
					material[i][j] = mat
				end
			end
		end
	end
end

-- contrôle : une paroi à moins de 60° est signalée (à retoucher à la main en B1)
local function checkWalls(name, top, bottom, depth)
	local run = (top - math.min(bottom, top)) / 2
	local degrees = if run <= 0 then 90 else math.deg(math.atan(depth / run)) -- constante (angle droit)
	if degrees < T.GorgeMinWallDegrees then
		warn(("TerrainBuilder : parois de %s à %.0f° (< %d°)"):format(name, degrees, T.GorgeMinWallDegrees))
	end
end

local function buildGorges()
	local ape = T.Gorges.ApeCanyon
	checkWalls("Ape Canyon", ape.topWidth, ape.bottomWidth, ape.depth)
	-- resserrement à P05s : la largeur passe de topWidth à narrowWidth sur GorgeNarrowTaperFactor × topWidth
	local narrow = MapConfig.Places[ape.narrowAt]
	local narrowPoint = Vector2.new(narrow.pos.X, narrow.pos.Z)
	local axis = (ape.to - ape.from).Unit
	local narrowT = (narrowPoint - ape.from):Dot(axis)
	local taper = ape.topWidth * T.GorgeNarrowTaperFactor
	-- les hauteurs du bord sont lues avant de creuser (sinon chaque point creuserait sous le précédent)
	local cuts = {}
	local count = math.ceil((ape.to - ape.from).Magnitude / CELL)
	for k = 0, count do
		local p = ape.from:Lerp(ape.to, k / count)
		local along = math.abs((p - ape.from):Dot(axis) - narrowT)
		local w = math.clamp(along / taper, 0, 1)
		local top = ape.narrowWidth + (ape.topWidth - ape.narrowWidth) * w
		table.insert(
			cuts,
			{ at = p, top = top, bottom = math.min(ape.bottomWidth, top), rim = getH(p.X, p.Y), depth = ape.depth }
		)
	end
	local lava = T.Gorges.LavaCanyon
	checkWalls("Lava Canyon", lava.topWidth, lava.bottomWidth, lava.depth)
	for _, p in samplePath(MapConfig.Paths[lava.path], CELL) do
		if p.Y >= lava.fromZ and p.Y <= lava.toZ then
			table.insert(
				cuts,
				{ at = p, top = lava.topWidth, bottom = lava.bottomWidth, rim = getH(p.X, p.Y), depth = lava.depth }
			)
		end
	end
	for _, c in cuts do
		carveGorge(c.at, c.top, c.bottom, c.rim, c.depth, T.Materials.GorgeCliff)
	end
end

-- 5. aplanir chaque lieu sur son rayon, raccordé sur 1,5 fois le rayon
local function flattenPlaces()
	for _, place in MapConfig.Places do
		if place.pos and place.radius and not place.outOfBounds and not place.underground then
			local center = Vector2.new(place.pos.X, place.pos.Z)
			stamp(center, place.radius, place.radius * (T.FlattenBlendFactor - 1), place.pos.Y)
		end
	end
end

-- 3. rivières : lit de profondeur 0,35 × largeur + 4, raccord 3 × largeur, fond toujours descendant
local function buildRivers()
	for _, path in MapConfig.Paths do
		if path.kind == "River" then
			local samples = samplePath(path, CELL)
			local bed = math.huge
			for k, p in samples do
				local w = widthAt(path, (k - 1) / math.max(1, #samples - 1))
				local depth = T.RiverDepthFactor * w + T.RiverDepthBase
				bed = math.min(bed, getH(p.X, p.Y) - depth)
				stamp(p, w / 2, w * T.RiverBlendFactor, bed, "Ground")
				for i = toCell(p.X - w / 2), toCell(p.X + w / 2) do
					for j = toCell(p.Y - w / 2), toCell(p.Y + w / 2) do
						water[i][j] = bed + depth -- 8. eau du terrain
					end
				end
			end
		end
	end
end

-- 6. routes et sentiers : pente maximale 8 % (routes) et 15 % (sentiers) ; les lacets à part (C42)
local function buildRoads()
	for _, path in MapConfig.Paths do
		if path.kind ~= "River" and path.kind ~= "Switchbacks" and (path.width or 0) > 0 then
			local maxSlope = if path.kind == "Road" then T.MaxRoadSlope else T.MaxTrailSlope
			local mat = if path.surface == "Asphalt"
				then T.Materials.Road
				elseif path.surface == "Gravel" then T.Materials.Gravel
				else T.Materials.Trail
			local samples = samplePath(path, CELL)
			local previous = nil
			for _, p in samples do
				local target = getH(p.X, p.Y)
				if previous then
					target = math.clamp(target, previous - maxSlope * CELL, previous + maxSlope * CELL)
				end
				previous = target
				stamp(p, path.width / 2, path.width, target, mat)
			end
		end
	end
end

-- F01 : falaise de la Crête, marche de 40 le long de Z = −800 (X de −507 à 1 800), sauf le passage X −100 à +100
local function buildCliff()
	local f = MapConfig.Places.F01
	for i = toCell(f.line.fromX), toCell(f.line.toX) do
		local x = toWorld(i)
		if x < f.passMinX or x > f.passMaxX then
			local north = toCell(f.line.z - CELL)
			local top = height[i][north]
			for j = toCell(f.line.z), toCell(f.line.z + f.height) do
				height[i][j] = math.min(height[i][j], top - f.height)
				material[i][j] = T.Materials.Cliff
			end
		end
	end
end

-- 19.5 (C42) : lacets de T3 sous F01 — segments droits, hauteur linéaire de fromY à toY sur la longueur
local function buildSwitchbacks()
	for _, path in MapConfig.Paths do
		if path.kind == "Switchbacks" then
			local points = {}
			local total = 0
			for k, p in path.points do
				points[k] = Vector2.new(p[1], p[2])
				if k > 1 then
					total += (points[k] - points[k - 1]).Magnitude
				end
			end
			local done = 0
			for k = 2, #points do
				local a, b = points[k - 1], points[k]
				local length = (b - a).Magnitude
				local count = math.max(1, math.ceil(length / CELL))
				for s = 0, count do
					local t = s / count
					local y = path.fromY + (path.toY - path.fromY) * (done + length * t) / total
					stamp(a:Lerp(b, t), path.width / 2, path.width, y, T.Materials.Trail)
				end
				done += length
			end
		end
	end
end

-- 8. lac P20 et réservoir Swift (décor, 3.8)
local function buildLakes()
	local lake = MapConfig.Places.P20
	for i = toCell(lake.pos.X - lake.ellipse.X), toCell(lake.pos.X + lake.ellipse.X) do
		for j = toCell(lake.pos.Z - lake.ellipse.Y), toCell(lake.pos.Z + lake.ellipse.Y) do
			local dx = (toWorld(i) - lake.pos.X) / lake.ellipse.X
			local dz = (toWorld(j) - lake.pos.Z) / lake.ellipse.Y
			if dx * dx + dz * dz <= 1 then
				water[i][j] = lake.pos.Y
			end
		end
	end
	for i = 1, N do
		for j = toCell(T.SwiftReservoirZ), N do
			water[i][j] = T.ReservoirLevel
			height[i][j] = math.min(height[i][j], T.ReservoirLevel - CELL)
		end
	end
end

-- 7. matériau d'une colonne : pente > 40° = Rock (Basalt dans les gorges), puis biome (3.6)
local function biomeMaterial(x, z)
	for _, biome in MapConfig.Biomes do
		for _, code in biome.places or {} do
			local place = MapConfig.Places[code]
			if place.zone then
				local zz = place.zone
				if x >= zz.minX and x <= zz.maxX and z >= zz.minZ and z <= zz.maxZ then
					return biome.materials[1]
				end
			elseif place.corridor then
				local c = place.corridor
				local a, b = c.from, c.to
				local p = Vector2.new(x, z)
				local t = math.clamp((p - a):Dot(b - a) / (b - a):Dot(b - a), 0, 1)
				if (p - (a + (b - a) * t)).Magnitude <= c.width / 2 then
					return biome.materials[1]
				end
			elseif
				place.pos
				and place.radius
				and (Vector2.new(x, z) - Vector2.new(place.pos.X, place.pos.Z)).Magnitude <= place.radius
			then
				return biome.materials[1]
			end
		end
	end
	return T.Materials.Default
end

local function columnMaterial(i, j)
	if material[i][j] then
		return material[i][j]
	end
	local h = height[i][j]
	local hx = height[math.min(N, i + 1)][j]
	local hz = height[i][math.min(N, j + 1)]
	local slope = math.deg(math.atan(math.max(math.abs(hx - h), math.abs(hz - h)) / CELL))
	if slope > T.CliffSlopeDegrees then
		return T.Materials.Cliff
	end
	return biomeMaterial(toWorld(i), toWorld(j))
end

-- écriture des voxels, bloc par bloc
local function writeTerrain()
	local terrain = workspace.Terrain
	terrain:SetMaterialColor(Enum.Material.Sand, T.Materials.AshColor) -- Sand recoloré gris cendre (3.6)
	local chunk = T.WriteChunk
	for x0 = -HALF, HALF - 1, chunk do
		for z0 = -HALF, HALF - 1, chunk do
			local minY, maxY = math.huge, -math.huge
			for x = x0, x0 + chunk - 1, CELL do
				for z = z0, z0 + chunk - 1, CELL do
					local i, j = toCell(x), toCell(z)
					minY = math.min(minY, height[i][j])
					maxY = math.max(maxY, height[i][j], water[i][j] or -math.huge)
				end
			end
			local bottom = math.floor((minY - CELL * 2) / VOXEL) * VOXEL
			local top = math.ceil((maxY + VOXEL) / VOXEL) * VOXEL
			local region = Region3.new(Vector3.new(x0, bottom, z0), Vector3.new(x0 + chunk, top, z0 + chunk))
				:ExpandToGrid(VOXEL)
			local size = region.Size / VOXEL
			local mats, occ = {}, {}
			for xi = 1, size.X do
				mats[xi], occ[xi] = {}, {}
				local x = region.CFrame.Position.X - region.Size.X / 2 + (xi - 0.5) * VOXEL
				for yi = 1, size.Y do
					mats[xi][yi], occ[xi][yi] = {}, {}
				end
				for zi = 1, size.Z do
					local z = region.CFrame.Position.Z - region.Size.Z / 2 + (zi - 0.5) * VOXEL
					local i, j = toCell(x), toCell(z)
					local ground = height[i][j]
					local level = water[i][j]
					local mat = Enum.Material[columnMaterial(i, j)] or Enum.Material.Grass
					for yi = 1, size.Y do
						local y = bottom + (yi - 0.5) * VOXEL
						if y <= ground then
							mats[xi][yi][zi] = mat
							occ[xi][yi][zi] = 1
						elseif level and y <= level then
							mats[xi][yi][zi] = Enum.Material.Water
							occ[xi][yi][zi] = 1
						else
							mats[xi][yi][zi] = Enum.Material.Air
							occ[xi][yi][zi] = 0
						end
					end
				end
			end
			terrain:WriteVoxels(region, VOXEL, mats, occ)
			task.wait()
		end
		print(("TerrainBuilder : colonne X = %d écrite"):format(x0))
	end
end

-- J2 : un bloc gris étiqueté par lieu (Workspace/Places/Pxx_<Nom>)
local function placeBlocks()
	local places = workspace:FindFirstChild("Places") or Instance.new("Folder")
	places.Name = "Places"
	places.Parent = workspace
	for code, place in MapConfig.Places do
		if place.pos and not place.outOfBounds then
			local clean = string.gsub(place.name, "[^%w]", "")
			local folder = places:FindFirstChild(code .. "_" .. clean) or Instance.new("Folder")
			folder.Name = code .. "_" .. clean
			folder.Parent = places
			local block = Instance.new("Part")
			block.Name = code
			block.Anchored = true
			block.Size = Vector3.one * T.PlaceBlockSize
			block.Color = Color3.fromRGB(128, 128, 128) -- constante (bloc gris)
			block.Position = place.pos + Vector3.new(0, T.PlaceBlockSize / 2, 0)
			block.Parent = folder
		end
	end
end

-- 3.8 : mur invisible à ±4 000 (le message à ±3 900 est affiché par BoundaryController)
local function walls()
	local folder = Instance.new("Folder")
	folder.Name = "Limits"
	folder.Parent = workspace
	local half = MapConfig.PlayableHalf
	local size = 2 * half
	for _, spec in
		{
			{ Vector3.new(half, 0, 0), Vector3.new(1, T.WallHeight, size) },
			{ Vector3.new(-half, 0, 0), Vector3.new(1, T.WallHeight, size) },
			{ Vector3.new(0, 0, half), Vector3.new(size, T.WallHeight, 1) },
			{ Vector3.new(0, 0, -half), Vector3.new(size, T.WallHeight, 1) },
		}
	do
		local wall = Instance.new("Part")
		wall.Anchored = true
		wall.Transparency = 1
		wall.Position = spec[1] + Vector3.new(0, T.WallHeight / 2, 0)
		wall.Size = spec[2]
		wall.Parent = folder
	end
end

function TerrainBuilder.Build()
	local started = os.clock()
	workspace.Terrain:Clear()
	print("TerrainBuilder : relief")
	buildHeights()
	buildGorges()
	buildRivers()
	flattenPlaces()
	buildRoads()
	buildCliff()
	buildSwitchbacks()
	buildLakes()
	print("TerrainBuilder : écriture du terrain")
	writeTerrain()
	placeBlocks()
	walls()
	print(("TerrainBuilder : terminé en %d s"):format(os.clock() - started))
end

-- 9. végétation : répartition aléatoire (graine 1924), distance minimale, rotation libre, échelle ±15 %,
-- rangée dans Workspace/Vegetation/Chunk_X_Z (blocs de 512) ; plafond global 20 000 ; LOD au-delà de 700 studs.
-- Modèles attendus dans ServerStorage/Vegetation (noms de 13.3, ex. Tree_DouglasFir_A) ; sans eux : rien.
local function groundAt(x, z)
	local top = MapConfig.HighestPlayableY * 2 -- constante (au-dessus du point le plus haut)
	local hit = workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -top * 2, 0))
	return if hit then hit.Position.Y else T.SouthY
end

function TerrainBuilder.Vegetation()
	local source = ServerStorage:FindFirstChild("Vegetation")
	if source == nil then
		warn("TerrainBuilder : ServerStorage/Vegetation absent (modèles de 13.3 à importer en phase B)")
		return
	end
	local random = Random.new(T.Seed)
	local root = workspace:FindFirstChild("Vegetation") or Instance.new("Folder")
	root.Name = "Vegetation"
	root.Parent = workspace
	local count = 0
	local placed = {}
	local half = MapConfig.PlayableHalf
	local areaUnit = 10000 -- constante (3.6 : arbres pour 10 000 studs²)
	local cellArea = MapConfig.Terrain.ChunkSize * MapConfig.Terrain.ChunkSize
	for cx = -half, half - 1, T.ChunkSize do
		for cz = -half, half - 1, T.ChunkSize do
			local folder = Instance.new("Folder")
			folder.Name = ("Chunk_%d_%d"):format(cx // T.ChunkSize, cz // T.ChunkSize)
			folder.Parent = root
			local centerBiome = "MixedForest"
			for name, biome in MapConfig.Biomes do
				if
					biome.materials[1] == biomeMaterial(cx + T.ChunkSize / 2, cz + T.ChunkSize / 2)
					and not biome.default
				then
					centerBiome = name
				end
			end
			local biome = MapConfig.Biomes[centerBiome]
			local trees = biome.trees or {}
			local amount = math.floor(biome.treesPer10k * cellArea / areaUnit)
			for _ = 1, amount do
				if count >= MapConfig.VegetationCap or #trees == 0 then
					break
				end
				local x = cx + random:NextNumber() * T.ChunkSize
				local z = cz + random:NextNumber() * T.ChunkSize
				local ok = true
				for _, p in placed do
					if (p - Vector2.new(x, z)).Magnitude < (biome.minTreeSpacing or 0) then
						ok = false
						break
					end
				end
				local variants = {}
				for _, model in source:GetChildren() do
					if string.find(model.Name, trees[random:NextInteger(1, #trees)], 1, true) then
						table.insert(variants, model)
					end
				end
				if ok and #variants > 0 then
					local tree = variants[random:NextInteger(1, #variants)]:Clone()
					local scale = 1 + (random:NextNumber() * 2 - 1) * T.ScaleJitter
					tree:ScaleTo(scale)
					tree:PivotTo(
						CFrame.new(x, groundAt(x, z), z) * CFrame.Angles(0, random:NextNumber() * 2 * math.pi, 0)
					)
					pcall(function()
						tree.LevelOfDetail = Enum.ModelLevelOfDetail.StreamingMesh -- 3.6 (à vérifier, 19.3)
					end)
					tree.Parent = folder
					table.insert(placed, Vector2.new(x, z))
					count += 1
				end
			end
			task.wait()
		end
	end
	print(("TerrainBuilder : %d modèles de végétation posés"):format(count))
end

return TerrainBuilder
