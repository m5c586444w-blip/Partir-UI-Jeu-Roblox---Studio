      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ActConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/ActConfig
-- Valeurs de la bible, section 5 (déroulé d'une partie). Ne rien ajouter ici sans la bible.
local ActConfig = {}

-- 5 : la nuit du 28 octobre
ActConfig.Date = "28 octobre"

-- 5.1 : horloge. Heures en jeu (h décimales) ; durées réelles en secondes.
-- Dans un acte, l'heure avance linéairement de start à finish sur maxDuration.
ActConfig.Acts = {
	[0] = { name = "Arrivée", start = 18.5, finish = 19, minDuration = 180, maxDuration = 180 },
	[1] = { name = "L'enquête", start = 19, finish = 22, minDuration = 600, maxDuration = 900 },
	[2] = { name = "Le siège", start = 22, finish = 24, minDuration = 480, maxDuration = 840 },
	[3] = { name = "La chasse", start = 0, finish = 5, minDuration = 600, maxDuration = 900 },
	[4] = { name = "L'aube", start = 5, finish = 6, minDuration = 180, maxDuration = 300 },
}
ActConfig.ActTransition = 10 -- l'heure saute au début de l'acte suivant en 10 s (ciel accéléré)
ActConfig.EndHour = 6 -- 06 h 00 : la partie s'arrête, les joueurs encore dans la forêt sont disparus
ActConfig.MaxGameDuration = 55 * 60 -- au plus tard 55 min réelles après le début

-- 5.2 : objectifs affichés (textes de la bible)
ActConfig.Objectives = {
	[0] = "Trouver le camp des géologues",
	[1] = "Trouver le camp des géologues",
	Cabin = "Rejoindre la cabane avant minuit",
	-- TODO(BIBLE): textes d'objectif des actes 3 et 4 (voie d'extraction) ; 6.2 CS_07 n'en donne qu'un exemple
	Extraction = {
		E1 = nil,
		E2 = "La radio de la tour. C'est notre seule chance.", -- exemple de CS_07 (6.2)
		E3 = nil,
		E4 = nil,
	},
}

-- 5.2 : acte 1
ActConfig.Act1 = {
	CluesNeeded = 3, -- 3 des 6 indices tirés
	CampPlace = "P09",
}

-- 5.2 : acte 2, le siège
ActConfig.Siege = {
	CabinPlace = "P05c",
	StartDelayAfterEntry = 60, -- 60 s après l'entrée du premier joueur dans la cabane
	StartHourIfNobody = 23 + 5 / 60, -- ou à 23 h 05
	Openings = { "Door", "Window", "RoofHole" }, -- porte, fenêtre, trou du toit
	PlankTime = 8,
	RolePlankTime = { Athlete = 4 },
	Duration = 6 * 60, -- 6 minutes de bombardement
	PlankImpacts = 4, -- une planche reçoit 4 impacts avant de céder
	SilenceAfter = 20, -- silence total 20 s, puis CS_07
	NotebookPageUnlocked = 2,
	-- TODO(BIBLE): cadence des pierres pendant le siège (impacts par minute) — réglée au jalon J11/J12
	StoneInterval = nil,
}

-- 5.2 : acte 3 — voie principale tirée parmi E1, E2, E3 ; E4 ouverte si DOC_07 a été lu
ActConfig.MainRoutes = { "E1", "E2", "E3" }
ActConfig.SecretRoute = { id = "E4", requiresDocument = "DOC_07" }
ActConfig.Routes = {
	E1 = {
		place = "P01",
		needs = { "ITM_Keys", "ITM_Jack" },
		repairTime = 20,
		roleRepairTime = { Mechanic = 10 },
		cinematic = "CS_10",
		-- TODO(BIBLE): rayon du bruit du « démarrage bruyant » du van (sans valeur : pas de bruit émis)
		startNoise = nil,
	},
	E2 = {
		place = "P11",
		needs = { "ITM_CoaxCable", "ITM_CarBattery" },
		repairTime = 30,
		holdTime = 180,
		cinematic = "CS_11",
	},
	E3 = {
		place = "P10",
		needs = { "ITM_Jerrycan", "ITM_StarterRelay" },
		repairTime = 40,
		driveDistance = 650,
		driveSpeed = 8,
		cinematic = "CS_12",
	},
	E4 = { place = "P07c", needs = { "DOC_07", "Light" }, clearTime = 60, cinematic = "CS_13" },
}

-- 5.2 : acte 4
ActConfig.Dawn = {
	FinalAssaultHour = 5, -- dernier assaut
	CreatureRetreatHour = 5 + 50 / 60, -- aucune attaque après 05 h 50, sauf dans les tunnels
}

-- 5.3 : fins (clés des données 16.4)
ActConfig.Endings = {
	Survie = { cinematics = { E1 = "CS_10", E2 = "CS_11", E3 = "CS_12" } },
	Preuve = { cinematic = "CS_15" },
	Verite = { cinematic = "CS_13", notebookPage = 3 },
	Ordonnance = { cinematic = "CS_14", replaces = "Survie" },
	Silence = { cinematic = "CS_16" },
}

-- 5.4 : difficultés
ActConfig.Difficulties = {
	Normal = {
		creatureDamage = 1.0,
		perception = 1.0,
		creatureHealth = 1.0,
		friendlyFire = false,
		downedTime = 45,
		ammoBox = true,
		objectiveHints = true,
		unlock = "Start",
	},
	Hard = {
		creatureDamage = 1.3,
		perception = 1.15,
		creatureHealth = 1.25,
		friendlyFire = true,
		downedTime = 35,
		ammoBox = true,
		objectiveHints = true,
		unlock = "Start",
	},
	Nightmare = {
		creatureDamage = 1.6,
		perception = 1.3,
		creatureHealth = 1.5,
		friendlyFire = true,
		downedTime = 25,
		ammoBox = false,
		objectiveHints = false,
		unlock = "FirstSurvival",
	},
}

-- 5.5 : taille du groupe
ActConfig.GroupSizes = {
	{ maxPlayers = 3, creatures = { "CRT_Alpha" }, firearms = 1, directorEvents = 0.8 },
	{ maxPlayers = 6, creatures = { "CRT_Alpha", "CRT_Scout1" }, firearms = 2, directorEvents = 1.0 },
	{ maxPlayers = 10, creatures = { "CRT_Alpha", "CRT_Scout1", "CRT_Scout2" }, firearms = 3, directorEvents = 1.2 },
}

-- réglages de la difficulté et de la taille de groupe pour une partie
function ActConfig.difficulty(id)
	return ActConfig.Difficulties[id] or ActConfig.Difficulties.Normal
end

function ActConfig.groupSize(count)
	for _, entry in ActConfig.GroupSizes do
		if count <= entry.maxPlayers then
			return entry
		end
	end
	return ActConfig.GroupSizes[#ActConfig.GroupSizes]
end

return ActConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">AmbienceConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/AmbienceConfig
-- Valeurs de la bible, sections 12.1 à 12.4. Ne rien ajouter ici sans la bible.
-- Réglage à l'œil prévu en phase B2 (J4) : ces valeurs sont les réglages de départ.
local AmbienceConfig = {}

AmbienceConfig.Technology = "Future" -- 12.1 : Lighting.Technology

-- 12.1 : lumière par moment. clock = ClockTime (début → fin) ; couleurs en RGB 0–255
AmbienceConfig.Moments = {
	{
		name = "Arrivée",
		clockFrom = 18.5,
		clockTo = 19,
		brightness = 1.2,
		outdoorAmbient = { 60, 65, 80 },
		ambient = { 40, 45, 55 },
		exposure = 0,
	},
	{
		name = "Fin d'enquête",
		clockFrom = 21,
		clockTo = 21,
		brightness = 0.15,
		outdoorAmbient = { 20, 24, 32 },
		ambient = { 12, 14, 18 },
		exposure = 0,
	},
	{
		name = "Siège",
		clockFrom = 22,
		clockTo = 24,
		brightness = 0.05,
		outdoorAmbient = { 12, 14, 20 },
		ambient = { 8, 9, 12 },
		exposure = -0.1,
	},
	{
		name = "Nuit noire",
		clockFrom = 0,
		clockTo = 4,
		brightness = 0,
		outdoorAmbient = { 8, 9, 14 },
		ambient = { 5, 6, 9 },
		exposure = -0.3,
	},
	{
		name = "Aube",
		clockFrom = 5,
		clockTo = 6,
		brightness = 0.6,
		outdoorAmbient = { 45, 55, 75 },
		ambient = { 25, 30, 40 },
		exposure = 0,
	},
}

-- 12.1 : effets
AmbienceConfig.ColorCorrection = { Saturation = -0.25, Contrast = 0.1, TintColor = { 220, 230, 255 } }
AmbienceConfig.Bloom = { Intensity = 0.3 }
AmbienceConfig.DepthOfField = { FarIntensity = 0.15, presetOnly = "High" } -- réglage Élevé seulement
-- 12.1 : lune par nuit claire : les nuages s'ouvrent 20 s toutes les 3 à 5 min
AmbienceConfig.Moon = { OpenDuration = 20, IntervalMin = 180, IntervalMax = 300, SilhouetteRange = 80 }
-- 12.1 : lampes : SpotLight avec ombres, angle 45° ; clignotement aléatoire sous 15 % de pile
AmbienceConfig.Lamp = { Angle = 45, Shadows = true, FlickerBelow = 0.15, EngineMaxRange = 60 } -- 60 : limite Roblox de Light.Range

-- 12.2 : brouillard par zone (Atmosphere). Couleurs RGB 0–255.
AmbienceConfig.Fog = {
	Forest = { density = 0.35, haze = 1.5, color = { 190, 200, 215 } },
	Gorges = { places = { "P03", "P05" }, density = 0.45, haze = 2.0, color = { 180, 190, 205 } },
	ForbiddenZone = { places = { "P08" }, density = 0.20, haze = 0.5, color = { 170, 170, 175 }, ashParticles = true },
	Plateau = { places = { "P06" }, density = 0.25, haze = 1.0, color = { 200, 205, 215 } },
	Tunnels = { places = { "P07a", "P07b", "P07c" }, atmosphereDisabled = true }, -- noir total
}

-- 12.3 : météo (tirée à chaque partie, sauf vote « fixe »). probability en fraction.
AmbienceConfig.Weathers = {
	Clear = { name = "Nuit claire", probability = 0.30, moon = true, creatureSight = 1, noiseFactor = 1 },
	Fog = {
		name = "Brouillard",
		probability = 0.30,
		fogDensityFactor = 1.7,
		creatureSight = 0.5,
		playerSight = 0.5,
		noiseFactor = 1,
	},
	Rain = { name = "Pluie", probability = 0.25, creatureSight = 0.7, noiseFactor = 0.6, wetGround = true },
	Snow = {
		name = "Première neige",
		probability = 0.15,
		snowAboveY = 350,
		footprintDuration = 300,
		staminaFactor = 0.85,
		creatureSight = 1,
		noiseFactor = 1,
	},
}
AmbienceConfig.WeatherOrder = { "Clear", "Fog", "Rain", "Snow" }
-- 12.3 : pendant l'acte 2, une nuit claire ou un brouillard passe en pluie (ou en neige au-dessus de Y = 350)
AmbienceConfig.SiegeWeather = { from = { Clear = true, Fog = true }, to = "Rain", snowAboveY = 350, toAbove = "Snow" }

-- 12.4 : vent (workspace.GlobalWind) et rafales
AmbienceConfig.Wind = {
	Clear = { base = { 6, 0, -3 }, gust = 10, gustIntervalMin = 8, gustIntervalMax = 15 },
	Fog = { base = { 2, 0, -1 }, gust = 0 },
	Rain = { base = { 14, 0, -6 }, gust = 20, sine = true }, -- cycle en sinus comme l'exemple de la doc
	Snow = { base = { 10, 0, -8 }, gust = 12 },
}
-- TODO(BIBLE): période du cycle en sinus des rafales de pluie, et intervalle des rafales de neige
AmbienceConfig.WindSinePeriod = nil
-- TODO(BIBLE): durée d'une rafale. PROVISOIRE : 1 s
AmbienceConfig.GustDuration = 1
AmbienceConfig.TreeWindRange = 120 -- 12.4 : arbres animés par leurs os à moins de 120 studs (réglage Élevé)

-- 12.5 : réverbération par zone (SoundService.AmbientReverb)
AmbienceConfig.Reverb = {
	Forest = "Forest",
	Gorges = "Mountains",
	Tunnels = "Cave",
	Buildings = "Room",
	Plateau = "Plain",
	ForbiddenZone = "Plain",
}

return AmbienceConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">AudioConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/AudioConfig
-- Valeurs de la bible, sections 12.5, 12.6 et 13.7. Ne rien ajouter ici sans la bible.
-- Les sons sont à fournir (13.1 : Freesound CC0 / CC-BY, enregistrements de Gabriel) ;
-- chaque identifiant rbxassetid est vide tant que le son n'est pas importé dans Studio.
-- Un son vide n'est pas joué (avertissement dans la console, jamais d'erreur).
local AudioConfig = {}

-- 12.5 : sons d'ambiance
AudioConfig.Ambience = {
	AMB_Birds = { where = "Forêt", acts = { 0, 4 }, silencedByCreature = true, id = "" },
	AMB_Insects_Owls = { where = "Forêt", acts = { 1, 2, 3 }, silencedByCreature = true, id = "" },
	AMB_Wind_Pines = { where = "Dehors", volumeFromWind = true, id = "" },
	AMB_River = { where = "R1, R2, R3", emitterSpacing = 60, masksNoise = true, id = "" },
	AMB_Waterfall = { where = "P13", masksNoise = true, id = "" },
	AMB_CanyonWind = { where = "P03, P05", id = "" },
	AMB_AshEmpty = { where = "P08", id = "" },
	AMB_TunnelDrips = { where = "P07", id = "" },
}
AudioConfig.FaunaSilenceRadius = 60 -- EVT_01 / 9.6 : la faune se tait sur 60 studs

-- 12.6 : musique
AudioConfig.Music = {
	MUS_Lobby = { when = "Lobby", id = "" },
	MUS_Siege = { when = "Acte 2, pendant le bombardement", id = "" },
	MUS_Chase = { when = "La créature attaque ou charge le joueur local à moins de 60 studs", range = 60, id = "" },
	MUS_Dawn = { when = "Cinématiques d'extraction", id = "" },
}

-- 12.5 : pas des joueurs, 4 variantes par matériau
AudioConfig.FootstepMaterials =
	{ "Grass", "LeafyGrass", "Ground", "Mud", "Pebble", "Rock", "Basalt", "Sand", "Snow", "Water", "Wood", "Metal" }
AudioConfig.FootstepVariants = 4
AudioConfig.Footsteps = {} -- [matériau] = { id1, id2, id3, id4 }

-- 13.7 : sons de la créature, des impacts, des joueurs, des voix, des objets et des lieux.
-- [ID] = rbxassetid ; vide en attendant l'import.
AudioConfig.Sounds = {}

-- 2.7 : enregistrements des documents (cassettes, DOC_14)
AudioConfig.Documents = {}

return AudioConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CinematicConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/CinematicConfig
-- Valeurs et textes de la bible, section 6. Ne rien ajouter ici sans la bible.
-- Plans : Part invisibles Workspace/Cinematics/CS_xx_Shot_n (posées à la main, 6.1), caméra
-- Scriptable, transitions TweenService. Chaque plan dure duration / nombre de plans (DÉFAUT).
-- scope : "Lobby", "Place" (joueurs dans le rayon du lieu), "All" (tous), "Local" (un seul joueur).
local CinematicConfig = {}

-- 6.1 : règles communes
CinematicConfig.MaxInGameDuration = 12 -- en partie, 12 s au plus
CinematicConfig.SafetyAfter = 3 -- invulnérable et retiré des cibles pendant la cinématique, plus 3 s
CinematicConfig.LobbySkipAfter = 10 -- en lobby, bouton « Passer » après 10 s
CinematicConfig.BarAspect = 2.35 -- bandes noires 2.35:1

-- 6.2 : liste
CinematicConfig.Cinematics = {
	CS_00 = {
		trigger = "1re connexion au lobby",
		duration = 70,
		scope = "Local",
		shots = 7,
		fov = 50, -- plan 1 : travelling lent (FOV 50)
		subtitle = "1924. Cinq hommes, une cabane, une nuit de pierres. Les rangers n'ont rien trouvé. En 1969, le comté a quand même voté une loi pour le protéger. En 1980, la montagne a explosé. Et il y a trois semaines, quatre géologues ont cessé de répondre. Cette nuit, on y va.",
		voice = "VO_CS00",
	},
	CS_01 = {
		trigger = "Compte à rebours fini",
		duration = 8,
		scope = "Lobby",
		shots = 2,
		subtitle = "Route forestière 83 — fermée",
	},
	CS_02a = {
		trigger = "Début de partie (S1)",
		duration = 10,
		scope = "All",
		shots = 1,
		subtitle = "OK. On trouve le camp, on filme, on rentre.",
	},
	CS_02b = {
		trigger = "Début de partie (S2)",
		duration = 10,
		scope = "All",
		shots = 1,
		subtitle = "OK. On trouve le camp, on filme, on rentre.",
	},
	CS_02c = {
		trigger = "Début de partie (S3)",
		duration = 10,
		scope = "All",
		shots = 1,
		subtitle = "OK. On trouve le camp, on filme, on rentre.",
	},
	-- CS_03 : pas de coupe, la caméra du joueur est attirée vers une silhouette à 90–120 studs (directeur, A5)
	CS_03 = {
		trigger = "1er aperçu de la créature",
		duration = 4,
		scope = "Local",
		noCut = true,
		silhouetteMin = 90,
		silhouetteMax = 120,
		faunaSilenceBefore = 3,
	},
	CS_04 = {
		trigger = "1re entrée dans P09",
		duration = 9,
		scope = "Place",
		place = "P09",
		shots = 2,
		subtitle = "… Oh non.",
		subtitleNearestPlayer = true,
	},
	-- TODO(BIBLE): CS_05 dure 25 s alors que 6 « en partie, elles durent 12 s au plus » — exception de la vidéo ?
	CS_05 = {
		trigger = "Vidéo de la tablette (DOC_08)",
		duration = 25,
		scope = "Local",
		shots = 6,
		subtitle = "Éteins ça. Éteins ça !",
		screenText = "Point de repli de l'équipe : cabane des mineurs",
		timestamp = "J-17 02:14",
		noMusic = true,
	},
	CS_06 = { trigger = "Début du siège", duration = 6, scope = "Place", place = "P05c", shots = 2 },
	CS_07 = { trigger = "Fin du siège", duration = 10, scope = "Place", place = "P05c", shots = 2, routeText = true },
	CS_08 = { trigger = "Début de l'acte 3", duration = 5, scope = "All", shots = 1, sound = "SFX_Call_Long_02" },
	CS_09 = { trigger = "05 h 00", duration = 6, scope = "All", shots = 1 },
	CS_10 = { trigger = "Extraction E1", duration = 12, scope = "All", shots = 3, music = "MUS_Dawn" },
	CS_11 = { trigger = "Extraction E2", duration = 12, scope = "All", shots = 2, music = "MUS_Dawn" },
	CS_12 = { trigger = "Extraction E3", duration = 12, scope = "All", shots = 2, music = "MUS_Dawn" },
	CS_13 = {
		trigger = "Extraction E4",
		duration = 12,
		scope = "All",
		shots = 2,
		music = "MUS_Dawn",
		subtitle = "On leur avait pris quelqu'un, à eux aussi.",
	},
	CS_14 = {
		trigger = "Alpha tué",
		duration = 12,
		scope = "All",
		shots = 3,
		screenText = "Étudiants inculpés : première application de l'ordonnance 69-01",
	},
	CS_15 = { trigger = "Preuve de classe A sortie", duration = 6, scope = "All", shots = 1 },
	CS_16 = {
		trigger = "Aucun survivant",
		duration = 10,
		scope = "All",
		shots = 2,
		screenText = "Épisode 12 — Cold Trail — durée 00:47",
	},
}

-- 3.3 et 5.2 : cinématique d'arrivée selon le départ tiré
CinematicConfig.StartCinematic = { S1 = "CS_02a", S2 = "CS_02b", S3 = "CS_02c" }

-- TODO(BIBLE): texte du « message radio » entendu par les joueurs hors du rayon d'une cinématique de lieu (6.1)
CinematicConfig.OutOfRangeRadioText = nil

return CinematicConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
