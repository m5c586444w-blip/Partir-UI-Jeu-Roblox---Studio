  <Item class="StarterPlayer" referent="1003">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="1004">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="1005">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[-- StarterPlayer/StarterPlayerScripts/ClientBootstrap (les deux places)
-- DÉFAUT : charge tous les contrôleurs de StarterPlayerScripts/Controllers (16.1, 16.2) :
-- Init() de chacun, puis Start(). Un contrôleur en erreur n'arrête pas les autres.
local controllersFolder = script.Parent:WaitForChild("Controllers")

local controllers = {}
local names = {}
for _, module in controllersFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok then
			controllers[module.Name] = result
			table.insert(names, module.Name)
		else
			warn("ClientBootstrap : échec du chargement de " .. module.Name .. " : " .. tostring(result))
		end
	end
end
table.sort(names)

for _, name in names do
	local controller = controllers[name]
	if controller.Init then
		local ok, err = pcall(controller.Init, controller, controllers)
		if not ok then
			warn("ClientBootstrap : échec de " .. name .. ".Init : " .. tostring(err))
		end
	end
end

for _, name in names do
	local controller = controllers[name]
	if controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start, controller)
			if not ok then
				warn("ClientBootstrap : échec de " .. name .. ".Start : " .. tostring(err))
			end
		end)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="1006">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="1007">
          <Properties>
            <string name="Name">PartyController</string>
            <string name="Source"><![CDATA[-- Controllers/PartyController (Lobby)
-- Sections 4.4 et 15.3 : PartyGui > PartyFrame > Header (Title, Code), MemberList > Template
-- (PlayerName, RoleName, ReadyIcon), Buttons (CreatePublic, CreatePrivate, JoinCode, QuickJoin,
-- Ready, Leave), CodeInput. Lit les attributs publiés par PartyService et RoleService.
-- DÉFAUT : en attendant la ville du lobby (J14), PartyFrame est visible dès l'arrivée.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local PartyController = {}

local player = Players.LocalPlayer
local root = nil
local remotes = {}

local function find(path)
	return Util.findUI(root, "PartyGui/PartyFrame/" .. path)
end

-- membres du groupe du joueur local (même attribut partyId)
function PartyController:Members()
	local partyId = player:GetAttribute("partyId")
	local list = {}
	if partyId == nil then
		return list
	end
	for _, other in Players:GetPlayers() do
		if other:GetAttribute("partyId") == partyId then
			table.insert(list, other)
		end
	end
	table.sort(list, function(a, b)
		return a.UserId < b.UserId
	end)
	return list
end

local function roleTitle(roleId)
	for _, role in PlayerConfig.Roles do
		if role.id == roleId then
			return role.title
		end
	end
	return ""
end

local function refresh()
	if root == nil then
		return
	end
	local inParty = player:GetAttribute("partyId") ~= nil
	for _, name in { "CreatePublic", "CreatePrivate", "JoinCode", "QuickJoin" } do
		local button = find("Buttons/" .. name)
		if button then
			button.Visible = not inParty
		end
	end
	for _, name in { "Ready", "Leave" } do
		local button = find("Buttons/" .. name)
		if button then
			button.Visible = inParty
		end
	end
	local input = find("CodeInput")
	if input then
		input.Visible = not inParty
	end
	local code = find("Header/Code")
	if code then
		code.Text = player:GetAttribute("partyCode") or ""
	end
	local template = find("MemberList/Template")
	if template then
		Util.clearClones(template)
		for i, member in PartyController:Members() do
			local row = Util.cloneTemplate(template, i)
			row:FindFirstChild("PlayerName").Text = member.DisplayName
			row:FindFirstChild("RoleName").Text = roleTitle(member:GetAttribute("partyRole"))
			row:FindFirstChild("ReadyIcon").Visible = member:GetAttribute("isReady") == true
		end
	end
end

local function watch(other)
	for _, name in { "partyId", "partyCode", "partyRole", "isReady" } do
		other:GetAttributeChangedSignal(name):Connect(refresh)
	end
end

function PartyController:Start()
	local gui = Util.waitGui("PartyGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	for _, name in { "RE_PartyCreate", "RE_PartyJoin", "RE_PartyQuickJoin", "RE_PartyLeave", "RE_Ready" } do
		remotes[name] = Util.getRemote(name)
	end
	local actions = {
		CreatePublic = function()
			remotes.RE_PartyCreate:FireServer(false)
		end,
		CreatePrivate = function()
			remotes.RE_PartyCreate:FireServer(true)
		end,
		JoinCode = function()
			local input = find("CodeInput")
			remotes.RE_PartyJoin:FireServer(input and input.Text or "")
		end,
		QuickJoin = function()
			remotes.RE_PartyQuickJoin:FireServer()
		end,
		Ready = function()
			remotes.RE_Ready:FireServer(player:GetAttribute("isReady") ~= true)
		end,
		Leave = function()
			remotes.RE_PartyLeave:FireServer()
		end,
	}
	for name, action in actions do
		local button = find("Buttons/" .. name)
		if button then
			button.Activated:Connect(action)
		end
	end
	local frame = Util.findUI(root, "PartyGui/PartyFrame")
	if frame then
		frame.Visible = true
	end
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function()
		task.defer(refresh)
	end)
	refresh()
end

return PartyController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1008">
          <Properties>
            <string name="Name">ResultsController</string>
            <string name="Source"><![CDATA[-- Controllers/ResultsController (Lobby)
-- Sections 4.4 (étape 8), 5.3 et 15.3 : écran de résultats au retour (fin obtenue, survivants,
-- preuves sorties, XP). ResultsGui > Card > EndingTitle, EndingText, Survivors > Template (Name, Status),
-- Evidence > Template, XPGained, Continue. Les résultats arrivent dans les données de téléportation
-- (affichage seulement).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local ResultsController = {}

local player = Players.LocalPlayer
local ENDING_ORDER = { "Ordonnance", "Survie", "Verite", "Preuve", "Silence" }

local function evidenceName(kind)
	for _, def in ItemConfig.Items do
		if def.evidence and def.evidence.kind == kind then
			return def.name
		end
	end
	return kind
end

function ResultsController:Show(results)
	local gui = Util.waitGui("ResultsGui")
	if gui == nil or type(results) ~= "table" then
		return
	end
	local root = gui.Parent
	local card = Util.findUI(root, "ResultsGui/Card")
	if card == nil then
		return
	end
	local titles, texts = {}, {}
	for _, id in ENDING_ORDER do
		if results.endings and results.endings[id] then
			table.insert(titles, LoreConfig.Endings[id].title)
			if LoreConfig.Endings[id].text ~= "" then
				table.insert(texts, LoreConfig.Endings[id].text)
			end
		end
	end
	card:FindFirstChild("EndingTitle").Text = table.concat(titles, " · ")
	card:FindFirstChild("EndingText").Text = table.concat(texts, "\n")
	local survivor = Util.findUI(root, "ResultsGui/Card/Survivors/Template")
	if survivor then
		Util.clearClones(survivor)
		for i, entry in results.players or {} do
			local row = Util.cloneTemplate(survivor, i)
			row:FindFirstChild("Name").Text = entry.name
			row:FindFirstChild("Status").Text = LoreConfig.Status[entry.status] or ""
		end
	end
	local evidence = Util.findUI(root, "ResultsGui/Card/Evidence/Template")
	if evidence then
		Util.clearClones(evidence)
		for i, e in results.evidence or {} do
			-- DÉFAUT : « A · Carte mémoire · Theo »
			Util.cloneTemplate(evidence, i).Text = ("%s · %s · %s"):format(e.class, evidenceName(e.kind), e.holder)
		end
	end
	local xp = results.xp and results.xp[tostring(player.UserId)] or 0
	-- DÉFAUT : format « +250 XP »
	card:FindFirstChild("XPGained").Text = ("+%d XP"):format(xp)
	card.Visible = true
end

function ResultsController:Start()
	local data = TeleportService:GetLocalPlayerTeleportData()
	if type(data) == "table" and data.results then
		self:Show(data.results)
	end
	local gui = Util.waitGui("ResultsGui")
	local continue = gui and Util.findUI(gui.Parent, "ResultsGui/Card/Continue")
	if continue then
		continue.Activated:Connect(function()
			Util.findUI(gui.Parent, "ResultsGui/Card").Visible = false
		end)
	end
end

return ResultsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1009">
          <Properties>
            <string name="Name">RoleController</string>
            <string name="Source"><![CDATA[-- Controllers/RoleController (Lobby)
-- Sections 4.4 et 15.3 : RoleSelectGui > Grid > RoleCard_<ROLE> (Portrait, CharacterName, RoleTitle,
-- Ability, Weakness, TakenOverlay > TakenBy) ; Confirm. Le portrait est un ViewportFrame qui affiche
-- le modèle Skin_A du rôle (13.5). La grille s'ouvre à l'entrée dans un groupe ; Confirm la ferme.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local RoleController = {}

local player = Players.LocalPlayer
local controllers = nil
local root = nil
local confirmed = false

local PORTRAIT_DISTANCE = PlayerConfig.Interface.PortraitDistance

local function find(path)
	return Util.findUI(root, "RoleSelectGui/" .. path)
end

function RoleController:IsConfirmed()
	return confirmed and player:GetAttribute("partyRole") ~= nil
end

local function setOpen(open)
	local grid, confirm = find("Grid"), find("Confirm")
	if grid then
		grid.Visible = open
	end
	if confirm then
		confirm.Visible = open
	end
end

local function fillPortrait(card, roleId)
	local viewport = card:FindFirstChild("Portrait")
	local folder = ReplicatedStorage:FindFirstChild(PlayerConfig.CharactersFolder)
	local model = folder
		and folder:FindFirstChild(roleId)
		and folder[roleId]:FindFirstChild(PlayerConfig.SkinPrefix .. "A")
	if viewport == nil or model == nil or viewport:FindFirstChildOfClass("Camera") then
		return
	end
	local clone = model:Clone()
	clone.Parent = viewport
	local camera = Instance.new("Camera")
	local pivot = clone:GetPivot()
	camera.CFrame = CFrame.lookAt(pivot.Position + pivot.LookVector * PORTRAIT_DISTANCE, pivot.Position)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
end

local function refresh()
	if root == nil then
		return
	end
	local members = controllers.PartyController and controllers.PartyController:Members() or {}
	for _, role in PlayerConfig.Roles do
		local card = find("Grid/RoleCard_" .. role.id)
		if card then
			local holder = nil
			for _, member in members do
				if member:GetAttribute("partyRole") == role.id and member ~= player then
					holder = member
				end
			end
			local overlay = card:FindFirstChild("TakenOverlay")
			if overlay then
				overlay.Visible = holder ~= nil
				local takenBy = overlay:FindFirstChild("TakenBy")
				if takenBy and holder then
					takenBy.Text = Util.formatMessage(LoreConfig.UI.TakenBy, { player = holder.DisplayName })
				end
			end
		end
	end
	if player:GetAttribute("partyId") == nil then
		confirmed = false
		setOpen(false)
	elseif not confirmed then
		setOpen(true)
	end
end

function RoleController:Init(all)
	controllers = all
end

function RoleController:Start()
	local gui = Util.waitGui("RoleSelectGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	local remote = Util.getRemote("RE_SelectRole")
	for _, role in PlayerConfig.Roles do
		local card = find("Grid/RoleCard_" .. role.id)
		if card then
			fillPortrait(card, role.id)
			card.Activated:Connect(function()
				if remote then
					remote:FireServer(role.id)
				end
			end)
		end
	end
	local confirm = find("Confirm")
	if confirm then
		confirm.Activated:Connect(function()
			if player:GetAttribute("partyRole") then
				confirmed = true
				setOpen(false)
				if controllers.VoteController then
					controllers.VoteController:Refresh()
				end
				if controllers.WeaponBoardController then
					controllers.WeaponBoardController:Refresh()
				end
			end
		end)
	end
	local function watch(other)
		for _, name in { "partyId", "partyRole" } do
			other:GetAttributeChangedSignal(name):Connect(refresh)
		end
	end
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	refresh()
end

return RoleController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1010">
          <Properties>
            <string name="Name">TeleportController</string>
            <string name="Source"><![CDATA[-- Controllers/TeleportController (Lobby)
-- Sections 15.3 et 15.6 : LoadingGui > Background, Tip (astuce tirée au hasard), Spinner, affiché au
-- départ (MSG_Teleporting) et transmis à TeleportService:SetTeleportGui pour l'écran de transition.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local LoreConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LoreConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local TeleportController = {}

local gui = nil

local function show(visible)
	if gui == nil then
		return
	end
	for _, name in { "Background", "Tip", "Spinner" } do
		local element = gui:FindFirstChild(name)
		if element then
			element.Visible = visible
		end
	end
	if visible then
		local tips = LoreConfig.LoadingTips
		gui:FindFirstChild("Tip").Text = tips[math.random(1, #tips)]
		TeleportService:SetTeleportGui(gui)
	end
end

function TeleportController:Start()
	gui = Util.waitGui("LoadingGui")
	local remote = Util.getRemote("RE_Notify")
	if remote then
		remote.OnClientEvent:Connect(function(key)
			if key == "MSG_Teleporting" then
				show(true)
			elseif key == "MSG_TeleportAbort" then
				show(false)
			end
		end)
	end
end

return TeleportController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1011">
          <Properties>
            <string name="Name">VoteController</string>
            <string name="Source"><![CDATA[-- Controllers/VoteController (Lobby)
-- Sections 4.4, 5.4 et 15.3 : VoteGui > Difficulty > Normal, Hard, Nightmare (> Lock) ;
-- Weather > Random, Clear, Fog, Rain, Snow ; Countdown (MSG_Countdown, 4.6).
-- Les scripts ne changent pas les couleurs (15.1) : le nombre de votes s'affiche dans le texte (DÉFAUT).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = ReplicatedStorage:WaitForChild("Config")
local LaunchConfig = require(Config:WaitForChild("LaunchConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local VoteController = {}

local player = Players.LocalPlayer
local controllers = nil
local root = nil
local labels = {} -- [bouton] = texte de départ (15.6)

local function find(path)
	return Util.findUI(root, "VoteGui/" .. path)
end

function VoteController:Refresh()
	if root == nil then
		return
	end
	local members = controllers.PartyController:Members()
	local open = #members > 0 and controllers.RoleController:IsConfirmed()
	for _, name in { "Difficulty", "Weather" } do
		local panel = find(name)
		if panel then
			panel.Visible = open
		end
	end
	local counts = {}
	for _, member in members do
		for _, key in { "voteDifficulty", "voteWeather" } do
			local value = member:GetAttribute(key)
			if value then
				counts[value] = (counts[value] or 0) + 1
			end
		end
	end
	for button, text in labels do
		local n = counts[button.Name] or 0
		button.Text = if n > 0 then ("%s (%d)"):format(text, n) else text
	end
	local lock = find("Difficulty/Nightmare/Lock")
	if lock then
		lock.Visible = player:GetAttribute("nightmareUnlocked") ~= true
	end
end

function VoteController:Init(all)
	controllers = all
end

function VoteController:Start()
	local gui = Util.waitGui("VoteGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	local remote = Util.getRemote("RE_Vote")
	for _, id in LaunchConfig.Votes.Difficulties do
		local button = find("Difficulty/" .. id)
		if button then
			labels[button] = button.Text
			button.Activated:Connect(function()
				remote:FireServer("Difficulty", id)
			end)
		end
	end
	for _, id in LaunchConfig.Votes.Weathers do
		local button = find("Weather/" .. id)
		if button then
			labels[button] = button.Text
			button.Activated:Connect(function()
				remote:FireServer("Weather", id)
			end)
		end
	end
	local function watch(other)
		for _, name in { "partyId", "voteDifficulty", "voteWeather", "nightmareUnlocked" } do
			other:GetAttributeChangedSignal(name):Connect(function()
				self:Refresh()
			end)
		end
	end
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	local countdown = find("Countdown")
	RunService.Heartbeat:Connect(function()
		if countdown == nil then
			return
		end
		local endsAt = player:GetAttribute("partyCountdownEnd")
		countdown.Visible = endsAt ~= nil
		if endsAt then
			local n = math.max(0, math.ceil(endsAt - workspace:GetServerTimeNow()))
			countdown.Text = Util.formatMessage(LoreConfig.Messages.MSG_Countdown, { n = n })
		end
	end)
	self:Refresh()
end

return VoteController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1012">
          <Properties>
            <string name="Name">WeaponBoardController</string>
            <string name="Source"><![CDATA[-- Controllers/WeaponBoardController (Lobby)
-- Sections 4.4, 8.2 et 15.3 : WeaponBoardGui > Board > Slot_Rifle, Slot_Revolver, Slot_Shotgun
-- (Icon, Holder, Take) ; VotePopup > Question, Option_1, Option_2, Timer (conflit : vote en 15 s).
-- Visible une fois le rôle confirmé.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = ReplicatedStorage:WaitForChild("Config")
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local WeaponBoardController = {}

local player = Players.LocalPlayer
local controllers = nil
local root = nil
local SLOTS = { Slot_Rifle = "WPN_Rifle", Slot_Revolver = "WPN_Revolver", Slot_Shotgun = "WPN_Shotgun" }

local function find(path)
	return Util.findUI(root, "WeaponBoardGui/" .. path)
end

local function available(count)
	for _, entry in WeaponConfig.FirearmsByGroupSize do
		if count <= entry.maxPlayers then
			return entry.weapons
		end
	end
	return {}
end

function WeaponBoardController:Refresh()
	if root == nil then
		return
	end
	local members = controllers.PartyController:Members()
	local open = #members > 0 and controllers.RoleController:IsConfirmed()
	local board = find("Board")
	if board then
		board.Visible = open
	end
	local weapons = available(#members)
	for slotName, weaponId in SLOTS do
		local slot = find("Board/" .. slotName)
		if slot then
			slot.Visible = table.find(weapons, weaponId) ~= nil
			local holder = ""
			for _, member in members do
				if member:GetAttribute("partyWeapon") == weaponId then
					holder = member.DisplayName
				end
			end
			slot:FindFirstChild("Holder").Text = holder
			local icon = slot:FindFirstChild("Icon")
			if icon then
				icon.Image = WeaponConfig.Icons[weaponId] or ""
			end
		end
	end
	local vote = Util.decode(player:GetAttribute("weaponVote"), nil)
	local popup = find("VotePopup")
	if popup then
		popup.Visible = open and vote ~= nil
		if vote then
			popup:FindFirstChild("Question").Text = LoreConfig.Messages.MSG_WeaponVote
			for i, userId in { vote.a, vote.b } do
				local other = Players:GetPlayerByUserId(userId)
				popup:FindFirstChild("Option_" .. i).Text = other and other.DisplayName or ""
			end
		end
	end
end

function WeaponBoardController:Init(all)
	controllers = all
end

function WeaponBoardController:Start()
	local gui = Util.waitGui("WeaponBoardGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	local take = Util.getRemote("RE_TakeWeapon")
	local voteRemote = Util.getRemote("RE_Vote")
	for slotName, weaponId in SLOTS do
		local button = find("Board/" .. slotName .. "/Take")
		if button and take then
			button.Activated:Connect(function()
				take:FireServer(weaponId)
			end)
		end
	end
	for i = 1, 2 do
		local option = find("VotePopup/Option_" .. i)
		if option and voteRemote then
			option.Activated:Connect(function()
				local vote = Util.decode(player:GetAttribute("weaponVote"), nil)
				if vote then
					voteRemote:FireServer("Weapon", if i == 1 then vote.a else vote.b)
				end
			end)
		end
	end
	local function watch(other)
		for _, name in { "partyId", "partyWeapon", "weaponVote", "partyRole" } do
			other:GetAttributeChangedSignal(name):Connect(function()
				self:Refresh()
			end)
		end
	end
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	RunService.Heartbeat:Connect(function()
		local vote = Util.decode(player:GetAttribute("weaponVote"), nil)
		local timer = find("VotePopup/Timer")
		if vote and timer then
			timer.Text = tostring(math.max(0, math.ceil(vote.endsAt - workspace:GetServerTimeNow())))
		end
	end)
	self:Refresh()
end

return WeaponBoardController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1013">
          <Properties>
            <string name="Name">AmbienceController</string>
            <string name="Source"><![CDATA[-- Controllers/AmbienceController (les deux places)
-- Sections 12.1, 12.2 et 12.5 : interpole la lumière selon l'heure en jeu (MatchState.clock),
-- le brouillard selon la zone (Atmosphere), la réverbération par zone. Réglage à l'œil en phase B2.
-- Dans le lobby (pas d'horloge), rien n'est changé : la lumière du lobby est réglée dans Studio.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Config = ReplicatedStorage:WaitForChild("Config")
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local AmbienceController = {}

local player = Players.LocalPlayer
local HOURS = 24 -- constante (heures dans une journée)
local START = AmbienceConfig.Moments[1].clockFrom -- l'horloge commence à 18 h 30

local function rgb(t)
	return Color3.fromRGB(table.unpack(t))
end

-- heure → position sur la nuit (0 à 18 h 30, croissante jusqu'à 6 h 00)
local function nightTime(clock)
	return (clock - START) % HOURS
end

-- images clés de 12.1 : début et fin de chaque moment
local keys = {}
for _, moment in AmbienceConfig.Moments do
	table.insert(keys, { t = nightTime(moment.clockFrom), m = moment })
	if moment.clockTo ~= moment.clockFrom then
		table.insert(keys, { t = nightTime(moment.clockTo % HOURS), m = moment })
	end
end
table.sort(keys, function(a, b)
	return a.t < b.t
end)

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function sample(clock)
	local t = nightTime(clock)
	local before, after = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if t >= keys[i].t and t <= keys[i + 1].t then
			before, after = keys[i], keys[i + 1]
			break
		end
	end
	local span = after.t - before.t
	local f = if span > 0 then math.clamp((t - before.t) / span, 0, 1) else 0
	local a, b = before.m, after.m
	return {
		brightness = lerp(a.brightness, b.brightness, f),
		outdoor = rgb(a.outdoorAmbient):Lerp(rgb(b.outdoorAmbient), f),
		ambient = rgb(a.ambient):Lerp(rgb(b.ambient), f),
		exposure = lerp(a.exposure, b.exposure, f),
	}
end

local function zoneOf(position)
	for zoneName, zone in AmbienceConfig.Fog do
		for _, code in zone.places or {} do
			local place = MapConfig.Places[code]
			if place and place.pos and place.radius then
				if
					(Vector2.new(position.X, position.Z) - Vector2.new(place.pos.X, place.pos.Z)).Magnitude
					<= place.radius
				then
					return zoneName
				end
			elseif place and place.zone then
				local z = place.zone
				if position.X >= z.minX and position.X <= z.maxX and position.Z >= z.minZ and position.Z <= z.maxZ then
					return zoneName
				end
			end
		end
	end
	return "Forest"
end

-- 17.2 : décalage de luminosité réglé par le joueur (SettingsController)
AmbienceController.Gamma = 0

function AmbienceController:Start()
	local state = ReplicatedStorage:FindFirstChild("MatchState")
		or ReplicatedStorage:WaitForChild("MatchState", Util.GUI_WAIT_TIMEOUT)
	if state == nil then
		return -- lobby
	end
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	local color = Lighting:FindFirstChild("AmbienceColor") or Instance.new("ColorCorrectionEffect")
	color.Name = "AmbienceColor"
	color.Saturation = AmbienceConfig.ColorCorrection.Saturation
	color.Contrast = AmbienceConfig.ColorCorrection.Contrast
	color.TintColor = rgb(AmbienceConfig.ColorCorrection.TintColor)
	color.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = AmbienceConfig.Bloom.Intensity
	bloom.Parent = Lighting

	RunService.RenderStepped:Connect(function()
		local clock = state:GetAttribute("clock")
		if clock == nil then
			return
		end
		Lighting.ClockTime = clock
		local s = sample(clock)
		Lighting.Brightness = s.brightness
		Lighting.OutdoorAmbient = s.outdoor
		Lighting.Ambient = s.ambient
		Lighting.ExposureCompensation = s.exposure + AmbienceController.Gamma

		local root = Util.characterRoot(player)
		if root == nil then
			return
		end
		local zoneName = zoneOf(root.Position)
		local zone = AmbienceConfig.Fog[zoneName]
		if zone.atmosphereDisabled then
			atmosphere.Density = 0
			atmosphere.Haze = 0
		else
			local weather = AmbienceConfig.Weathers[state:GetAttribute("weather") or "Clear"]
			atmosphere.Density = zone.density * ((weather and weather.fogDensityFactor) or 1)
			atmosphere.Haze = zone.haze
			atmosphere.Color = rgb(zone.color)
		end
		local reverb = AmbienceConfig.Reverb[zoneName] or AmbienceConfig.Reverb.Forest
		local ok, enum = pcall(function()
			return Enum.ReverbType[reverb]
		end)
		if ok and enum then
			SoundService.AmbientReverb = enum
		end
	end)
end

return AmbienceController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1014">
          <Properties>
            <string name="Name">CinematicController</string>
            <string name="Source"><![CDATA[-- Controllers/CinematicController (les deux places)
-- Sections 6.1, 6.2 et 15.5 : caméra Scriptable sur les Part Workspace/Cinematics/CS_xx_Shot_n,
-- transitions TweenService, bandes noires et sous-titres (CinematicGui). Passer : en lobby, bouton
-- après 10 s ; en partie, vote (RE_CinematicSkipVote). CS_00 joue à la première connexion au lobby
-- (attribut plays = 0, DÉFAUT : la bible ne prévoit pas de drapeau « déjà vue »).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = ReplicatedStorage:WaitForChild("Config")
local CinematicConfig = require(Config:WaitForChild("CinematicConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local CinematicController = {}

local player = Players.LocalPlayer
local root = nil
local playing = nil -- { id, token }
local isLobby = false
local skipRemote = nil

local function find(path)
	return Util.findUI(root, "CinematicGui/" .. path)
end

local function setVisible(visible)
	for _, name in { "BarTop", "BarBottom", "Subtitle", "Skip" } do
		local element = find(name)
		if element then
			element.Visible = visible
		end
	end
end

function CinematicController:IsPlaying()
	return playing ~= nil
end

local function stop()
	playing = nil
	setVisible(false)
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

function CinematicController:Play(id, extra)
	local def = CinematicConfig.Cinematics[id]
	if def == nil or root == nil then
		return
	end
	local token = {}
	playing = { id = id, token = token }
	setVisible(true)
	local subtitle = find("Subtitle")
	if subtitle then
		subtitle.Text = (extra and extra.text) or def.subtitle or def.screenText or ""
	end
	local skip = find("Skip")
	local votes = find("Skip/Votes")
	if votes then
		votes.Text = ""
	end
	if skip then
		skip.Visible = not isLobby -- en lobby, le bouton apparaît après 10 s
		if isLobby then
			task.delay(CinematicConfig.LobbySkipAfter, function()
				if playing and playing.token == token then
					skip.Visible = true
				end
			end)
		end
	end
	-- plans : Part invisibles CS_xx_Shot_n (6.1) ; sans plans posés, seules les bandes et le texte s'affichent
	local folder = workspace:FindFirstChild("Cinematics")
	local shots = {}
	for n = 1, def.shots or 0 do
		local shot = folder and folder:FindFirstChild(("%s_Shot_%d"):format(id, n))
		if shot and shot:IsA("BasePart") then
			table.insert(shots, shot)
		end
	end
	local camera = workspace.CurrentCamera
	if #shots > 0 and not def.noCut then
		camera.CameraType = Enum.CameraType.Scriptable
		if def.fov then
			camera.FieldOfView = def.fov
		end
		camera.CFrame = shots[1].CFrame
		local perShot = def.duration / #shots
		task.spawn(function()
			for i = 2, #shots do
				if not (playing and playing.token == token) then
					return
				end
				TweenService:Create(camera, TweenInfo.new(perShot, Enum.EasingStyle.Sine), { CFrame = shots[i].CFrame })
					:Play()
				task.wait(perShot)
			end
		end)
	elseif #shots == 0 and not def.noCut then
		warn(("CinematicController : aucun plan %s_Shot_n dans Workspace/Cinematics"):format(id))
	end
	task.delay(def.duration, function()
		if playing and playing.token == token then
			stop()
		end
	end)
end

function CinematicController:Start()
	-- la place Partie a Workspace/Places (16.1) ; le lobby non
	isLobby = workspace:FindFirstChild("Places") == nil
	local gui = Util.waitGui("CinematicGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	skipRemote = Util.getRemote("RE_CinematicSkipVote")
	local skip = find("Skip")
	if skip then
		skip.Activated:Connect(function()
			if isLobby then
				stop()
			elseif skipRemote then
				skipRemote:FireServer()
			end
		end)
	end
	local remote = Util.getRemote("RE_PlayCinematic")
	if remote then
		remote.OnClientEvent:Connect(function(action, a, b)
			if action == "Play" then
				self:Play(a, b)
			elseif action == "Stop" then
				stop()
			elseif action == "SkipVotes" then
				local votes = find("Skip/Votes")
				if votes then
					votes.Text = ("%d/%d"):format(a, b)
				end
			end
		end)
	end
	-- 6.2 : CS_00 à la première connexion au lobby
	if isLobby then
		while player:GetAttribute("dataLoaded") == nil do
			task.wait(CinematicConfig.SafetyAfter)
		end
		if (player:GetAttribute("plays") or 0) == 0 then
			self:Play("CS_00")
		end
	end
end

return CinematicController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1015">
          <Properties>
            <string name="Name">NotificationController</string>
            <string name="Source"><![CDATA[-- Controllers/NotificationController (les deux places)
-- Sections 4.6 et 15.5 : affiche les messages système (RE_Notify : clé, paramètres) dans
-- NotificationGui > Stack > Template (Text). {player} et {n} sont remplacés.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local NotificationController = {}

local template = nil
local shown = {}
local order = 0

-- affiche un texte déjà rédigé (tiré de la bible)
function NotificationController:Show(text)
	if template == nil or text == nil or text == "" then
		return
	end
	order += 1
	local item = Util.cloneTemplate(template, order)
	local label = item:FindFirstChild("Text")
	if label then
		label.Text = text
	end
	table.insert(shown, item)
	while #shown > PlayerConfig.Interface.NotificationMax do
		table.remove(shown, 1):Destroy()
	end
	task.delay(PlayerConfig.Interface.NotificationDuration, function()
		local index = table.find(shown, item)
		if index then
			table.remove(shown, index)
		end
		item:Destroy()
	end)
end

function NotificationController:ShowMessage(key, params)
	local text = LoreConfig.Messages[key]
	if text == nil then
		warn("NotificationController : message inconnu " .. tostring(key))
		return
	end
	self:Show(Util.formatMessage(text, params))
end

function NotificationController:Start()
	local gui = Util.waitGui("NotificationGui")
	template = gui and Util.findUI(gui.Parent, "NotificationGui/Stack/Template")
	local remote = Util.getRemote("RE_Notify")
	if remote then
		remote.OnClientEvent:Connect(function(key, params)
			self:ShowMessage(key, params)
		end)
	end
end

return NotificationController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>