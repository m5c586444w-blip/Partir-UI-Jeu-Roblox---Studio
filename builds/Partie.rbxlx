      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ProgressionConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/ProgressionConfig
-- Valeurs de la bible, section 16.4 (données, XP) et 16.2 (DataService).
-- Ne rien ajouter ici sans la bible.
-- Les règles de déblocage des skins (7.1) et de Cauchemar (5.4) sont ajoutées au jalon J14.
local ProgressionConfig = {}

-- 16.4 : DataStore PisteFroide_v1, clé player_<UserId>
ProgressionConfig.DataStoreName = "PisteFroide_v1"
ProgressionConfig.KeyPrefix = "player_"

-- 16.4 : champ « version » des données
ProgressionConfig.DataVersion = 1

-- 16.2 : sauvegarde toutes les 120 s et à la fermeture
ProgressionConfig.AutosaveInterval = 120

-- 16.4 : liste des preuves, 200 au plus
ProgressionConfig.MaxEvidence = 200

-- 16.4 : clés des fins (5.3)
ProgressionConfig.EndingIds = { "Survie", "Preuve", "Verite", "Ordonnance", "Silence" }

-- 16.4 et 4.3 : panneaux du musée M1 à M8
ProgressionConfig.MuseumPanelIds = { "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8" }

-- 16.4 : pages du carnet Halvorsen (DOC_12) ; la page 1 est débloquée au départ
ProgressionConfig.DefaultNotebookPages = { true, false, false }

-- 7.1 : 3 skins par personnage, A dès le début
ProgressionConfig.SkinIds = { "A", "B", "C" }
ProgressionConfig.DefaultSkin = "A"

-- 16.4 : niveau = partie entière de la racine de (XP ÷ 100)
ProgressionConfig.XPPerLevelDivisor = 100

-- 16.4 : gains d'XP ; preuves selon 8.4
ProgressionConfig.XPGains = {
	MuseumPanel = 5, -- panneau de musée lu (première fois, 4.2)
	GamePlayed = 50, -- partie jouée
	Survival = 200, -- survie
	EvidenceA = 500, -- 8.4 : vidéo du Caméraman
	EvidenceB = 150, -- 8.4 : moulage, cri, poils, photo
	EvidenceC = 50, -- 8.4 : document, photo du charnier
}

-- 16.2 : verrouillage de session (valeurs techniques acceptées le 4 novembre 2026, 16.4)
ProgressionConfig.SessionLock = {
	-- un verrou non rafraîchi depuis 360 s (3 sauvegardes manquées) est considéré abandonné
	StaleAfter = 360,
	-- nombre d'essais de chargement si une autre place tient encore le verrou (téléportation)
	LoadAttempts = 6,
	-- secondes entre deux essais de chargement
	LoadRetryDelay = 5,
}

return ProgressionConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">WeaponConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/WeaponConfig
-- Valeurs de la bible, section 8.2 (et 16.3 pour la validation). Ne rien ajouter ici sans la bible.
local WeaponConfig = {}

-- « Toute la carte » : la diagonale de la carte de 8 000 × 8 000 studs (section 0)
local WHOLE_MAP = math.ceil(8000 * math.sqrt(2))

-- 8.2 : armes. fireInterval = 1 tir toutes les n s ; reload = s par munition
WeaponConfig.Weapons = {
	WPN_Rifle = {
		name = "Fusil à verrou",
		ammo = 5,
		fireInterval = 1.4,
		reloadPerRound = 1.2,
		damageBody = 180,
		damageHead = 400,
		friendlyTorso = 120,
		noise = WHOLE_MAP,
	},
	WPN_Revolver = {
		name = "Revolver",
		ammo = 6,
		fireInterval = 0.6,
		reloadPerRound = 0.8,
		damageBody = 70,
		damageHead = 160,
		friendlyTorso = 60,
		noise = 2500,
	},
	WPN_Shotgun = {
		name = "Fusil à pompe",
		ammo = 4,
		fireInterval = 1.0,
		reloadPerRound = 0.9,
		pellets = 8,
		damagePerPellet = 18, -- jusqu'à 15 studs, puis −70 % à 40 studs
		fullDamageRange = 15,
		reducedRange = 40,
		reducedFactor = 0.3,
		-- TODO(BIBLE): forme de la baisse entre 15 et 40 studs (linéaire en attendant) et portée au-delà de 40
		friendlyPerPellet = 15,
		noise = WHOLE_MAP,
		-- TODO(BIBLE): écart des plombs (degrés). PROVISOIRE : 0 = tous dans l'axe
		spreadDegrees = 0,
	},
	WPN_FlareGun = {
		name = "Pistolet lance-fusées",
		owner = "Pyrotechnician",
		ammo = 3,
		reloadTime = 2,
		damage = 20,
		blindDuration = 3,
		creatureFleeDuration = 8,
		friendlyDamage = 30, -- + brûlure
		noise = 1200,
		-- TODO(BIBLE): cadence du pistolet lance-fusées (« — » dans 8.2) et effet de la brûlure sur un coéquipier
	},
	MEL_Axe = {
		name = "Hache",
		owner = "Athlete",
		melee = true,
		fireInterval = 1.1,
		damage = 25,
		grabReleaseHits = 1, -- un coup sur le bras qui saisit = lâcher
		friendlyDamage = 30,
		noise = 40,
	},
	MEL_Machete = {
		name = "Machette",
		melee = true,
		fireInterval = 0.8,
		damage = 18,
		grabReleaseHits = 2, -- deux coups = lâcher
		friendlyDamage = 20,
		noise = 30,
		-- TODO(BIBLE): qui porte la machette au départ, ou où se trouve-t-elle ?
	},
}

-- TODO(BIBLE): portée des armes de mêlée (studs). PROVISOIRE : 7, la portée du coup de la créature (9.10)
WeaponConfig.MeleeRange = 7

-- 8.2 : armes à feu selon la taille du groupe (1–3, 4–6, 7–10)
WeaponConfig.FirearmsByGroupSize = {
	{ maxPlayers = 3, weapons = { "WPN_Rifle" } },
	{ maxPlayers = 6, weapons = { "WPN_Rifle", "WPN_Revolver" } },
	{ maxPlayers = 10, weapons = { "WPN_Rifle", "WPN_Revolver", "WPN_Shotgun" } },
}
WeaponConfig.RifleToRole = "Tracker" -- le fusil revient d'office au Pisteur s'il est présent
WeaponConfig.NoFirearmRole = "RadioOperator" -- l'Opératrice ne peut pas en porter

-- 8.2 : boîte de munitions de secours (A1–A5, une seule ; absente en Cauchemar)
WeaponConfig.AmmoBox = { WPN_Rifle = 5, WPN_Revolver = 6, WPN_Shotgun = 4 }

-- 16.3 : RE_FireWeapon — origine à moins de 5 studs de la tête
WeaponConfig.MaxOriginOffset = 5

-- 4.4 : conflit au tableau des armes : vote à la majorité en 15 s, sinon tirage
WeaponConfig.ConflictVoteDuration = 15

-- 13.5 : icônes Icon_<ID> ; identifiants rbxassetid à renseigner après import (DÉFAUT : vide)
WeaponConfig.Icons = {}

return WeaponConfig
]]></string>
