  <Item class="ServerScriptService" referent="150">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="151">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ServerScriptService/Bootstrap (Lobby)
-- Section 16.1 : charge les services dans l'ordre. Chaque service reçoit Init(services)
-- (références entre services, aucune attente), puis Start() une fois tous initialisés.
local ServerScriptService = game:GetService("ServerScriptService")

local servicesFolder = ServerScriptService:WaitForChild("Services")

-- ordre de chargement : DataService d'abord, les autres en dépendent
local ORDER = {
	"DataService",
	"MatchmakingService",
	"LaunchService",
	"PartyService",
	"RoleService",
	"WeaponBoardService",
	"VoteService",
}

local services = {}
for _, name in ORDER do
	local module = servicesFolder:FindFirstChild(name)
	if module == nil then
		warn("Bootstrap : service manquant : Services/" .. name)
	else
		services[name] = require(module)
	end
end

for _, name in ORDER do
	local service = services[name]
	if service ~= nil and service.Init ~= nil then
		local ok, err = pcall(service.Init, service, services)
		if not ok then
			warn("Bootstrap : échec de " .. name .. ".Init : " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service ~= nil and service.Start ~= nil then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn("Bootstrap : échec de " .. name .. ".Start : " .. tostring(err))
		end
	end
end

print("Bootstrap (Lobby) : services démarrés")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="152">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="153">
        <Properties>
          <string name="Name">LaunchService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/LaunchService (Lobby)
-- Sections 4.4 et 16.2 : écrit la configuration de partie dans MemoryStore, réserve un
-- serveur de la place « Partie », téléporte le groupe.
-- Données transmises (4.4, 16.4) : joueurs, rôles, armes, difficulté, météo, départ tiré, graine.
local MemoryStoreService = game:GetService("MemoryStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local LaunchConfig = require(Config:WaitForChild("LaunchConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(Shared:WaitForChild("Util"))
local Version = require(Shared:WaitForChild("Version"))

local LaunchService = {}

local services = nil
local memory = LaunchConfig.MemoryStore
local launchMap = nil

local function buildLaunchData(party, members)
	-- 3.4 : graine = os.time(), écrite dans la console pour rejouer un bug.
	-- La bible dit « au lancement du serveur » ; elle est tirée ici, au départ du groupe,
	-- puisque 16.4 la range dans la configuration transmise.
	local seed = os.time()
	local random = Random.new(seed)

	-- 4.4 : départ tiré parmi S1, S2, S3, une chance sur trois chacun
	local starts = Util.sortedKeys(MapConfig.Spawns)
	local start = starts[random:NextInteger(1, #starts)]

	local playersData = {}
	for _, member in members do
		table.insert(playersData, {
			userId = member.UserId,
			name = member.DisplayName, -- pour MSG_PlayerMissing (4.6) dans la Partie
			role = party.roles and party.roles[member] or nil, -- RoleService (J9)
			weapon = party.weapons and party.weapons[member] or nil, -- WeaponBoardService (J9)
		})
	end

	return {
		version = Version.Number,
		players = playersData,
		-- 5.4 : sans vote, difficulté Normal et météo aléatoire (résultat de VoteService)
		difficulty = party.difficulty or LaunchConfig.Votes.DefaultDifficulty,
		weather = party.weather or LaunchConfig.Votes.DefaultWeather,
		start = start,
		seed = seed,
	}
end

-- une tentative de départ ; renvoie true si la téléportation est lancée
local function tryLaunch(party, placeId)
	local members = {}
	for _, member in party.members do
		if member.Parent ~= nil then
			table.insert(members, member)
		end
	end
	if #members < LaunchConfig.Party.MinSize then
		return false
	end

	-- réserve le serveur : ReserveServer renvoie le code d'accès et le PrivateServerId
	local okReserve, accessCode, privateServerId = pcall(function()
		return TeleportService:ReserveServer(placeId)
	end)
	if not okReserve then
		warn("LaunchService : réservation impossible (normal en Studio) : " .. tostring(accessCode))
		return false
	end

	-- 16.4 : clé Launch_<PrivateServerId>, 600 s (la Partie lit game.PrivateServerId)
	local launchData = buildLaunchData(party, members)
	local key = memory.LaunchKeyPrefix .. privateServerId
	local okWrite, writeErr = Util.retry(memory.Attempts, memory.RetryDelay, function()
		launchMap:SetAsync(key, launchData, memory.LaunchTTL)
	end)
	if not okWrite then
		warn("LaunchService : écriture de la configuration impossible : " .. tostring(writeErr))
		return false
	end
	print(("LaunchService : départ %s, graine %d, %d joueur(s)"):format(launchData.start, launchData.seed, #members))

	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = accessCode
	local okTeleport, teleportErr = pcall(function()
		return TeleportService:TeleportAsync(placeId, members, options)
	end)
	if not okTeleport then
		warn("LaunchService : téléportation impossible : " .. tostring(teleportErr))
		return false
	end
	return true
end

-- lance la partie pour le groupe, avec nouvel essai (MSG_TeleportRetry, 4.6) ;
-- renvoie false si tous les essais ont échoué (PartyService envoie alors MSG_TeleportAbort)
function LaunchService:Launch(party)
	local placeId = LaunchConfig.PlaceIds.Partie
	if launchMap == nil then
		warn("LaunchService : MemoryStore inaccessible, départ impossible")
		return false
	end

	for _, member in party.members do
		Util.notify(member, "MSG_Teleporting")
	end

	local teleport = LaunchConfig.Teleport
	for attempt = 1, teleport.Attempts do
		if tryLaunch(party, placeId) then
			return true
		end
		if attempt < teleport.Attempts then
			for _, member in party.members do
				Util.notify(member, "MSG_TeleportRetry")
			end
			task.wait(teleport.RetryDelay)
		end
	end
	return false
end

function LaunchService:Init(allServices)
	services = allServices
	local ok, result = pcall(function()
		return MemoryStoreService:GetHashMap(memory.LaunchMapName)
	end)
	if ok then
		launchMap = result
	else
		warn("LaunchService : MemoryStore inaccessible : " .. tostring(result))
	end
end

function LaunchService:Start()
	-- échec de téléportation signalé après coup : le groupe redevient ouvert
	TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
		warn(
			("LaunchService : téléportation échouée pour %s (%s) : %s"):format(
				player.Name,
				tostring(teleportResult),
				tostring(errorMessage)
			)
		)
		local party = services.PartyService:GetParty(player)
		if party ~= nil then
			services.PartyService:LaunchFailed(party)
		end
	end)
end

return LaunchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="154">
        <Properties>
          <string name="Name">MatchmakingService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/MatchmakingService (Lobby)
-- Sections 4.4 et 16.4 : file « Rejoindre un groupe » ; les groupes publics incomplets
-- sont publiés dans la carte triée MemoryStore « Parties » (durée de vie 900 s).
local MemoryStoreService = game:GetService("MemoryStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local MatchmakingService = {}

local memory = LaunchConfig.MemoryStore
local partiesMap = nil

local function call(fn)
	if partiesMap == nil then
		return false, "carte MemoryStore indisponible"
	end
	return Util.retry(memory.Attempts, memory.RetryDelay, fn)
end

-- publie (ou retire) un groupe selon son état : seul un groupe public, incomplet et
-- pas en cours de départ reste dans la file
function MatchmakingService:Publish(party)
	local listed = not party.isPrivate and not party.launching and #party.members < LaunchConfig.Party.MaxSize
	local ok, err
	if listed then
		local entry = {
			jobId = game.JobId,
			count = #party.members,
		}
		ok, err = call(function()
			partiesMap:SetAsync(party.id, entry, memory.PartiesTTL)
		end)
	else
		ok, err = call(function()
			partiesMap:RemoveAsync(party.id)
		end)
	end
	if not ok then
		warn("MatchmakingService : publication du groupe impossible : " .. tostring(err))
	end
end

function MatchmakingService:Remove(partyId)
	local ok, err = call(function()
		partiesMap:RemoveAsync(partyId)
	end)
	if not ok then
		warn("MatchmakingService : retrait du groupe impossible : " .. tostring(err))
	end
end

-- id d'un groupe public incomplet de CE serveur, ou nil
function MatchmakingService:FindPublicParty(isLocalJoinable)
	local ok, entries = call(function()
		return partiesMap:GetRangeAsync(Enum.SortDirection.Ascending, memory.PartiesScanCount)
	end)
	if not ok then
		warn("MatchmakingService : lecture de la file impossible : " .. tostring(entries))
		return nil
	end
	for _, item in entries do
		local entry = item.value
		if type(entry) == "table" and entry.jobId == game.JobId and isLocalJoinable(item.key) then
			return item.key
		end
		-- DÉFAUT : un groupe public ouvert sur un AUTRE serveur du lobby est ignoré
		-- (le rejoindre demanderait de téléporter le joueur vers ce serveur)
	end
	return nil
end

function MatchmakingService:Init()
	local ok, result = pcall(function()
		return MemoryStoreService:GetSortedMap(memory.PartiesMapName)
	end)
	if ok then
		partiesMap = result
	else
		warn("MatchmakingService : MemoryStore inaccessible : " .. tostring(result))
	end
end

function MatchmakingService:Start() end

return MatchmakingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="155">
        <Properties>
          <string name="Name">PartyService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/PartyService (Lobby)
-- Section 4.4 : créer un groupe public ou privé (code à 4 chiffres), le rejoindre par code
-- ou par la file rapide, le quitter, se déclarer prêt. Tous « Prêt » → compte à rebours
-- de 10 s → départ (LaunchService). Messages : section 4.6.
-- Jalon J1 : le groupe et le départ. Rôles, armes et votes viennent au jalon J9.
--
-- L'état du groupe est publié en attributs du joueur (répliqués automatiquement, 16.3) :
--   partyId (string), partyCode (string, groupe privé), partyHostId (number : UserId du créateur),
--   isReady (bool), partyCountdownEnd (number : heure serveur de fin du compte à rebours,
--   comparable à workspace:GetServerTimeNow()).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))
local Signal = require(Shared:WaitForChild("Signal"))
local CinematicConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("CinematicConfig"))

local PartyService = {}

PartyService.MembersChanged = Signal.new() -- (party) : arrivée, départ, rôle
PartyService.MemberLeft = Signal.new() -- (party, player)

local services = nil
local parties = {} -- [partyId] = party
local partyOf = {} -- [Player] = partyId
local random = Random.new()

local function notifyParty(party, messageKey, params)
	for _, member in party.members do
		Util.notify(member, messageKey, params)
	end
end

local function findByCode(code)
	for _, party in parties do
		if party.code == code then
			return party
		end
	end
	return nil
end

-- code privé unique sur ce serveur, à PrivateCodeDigits chiffres
local function newCode()
	local digits = LaunchConfig.Party.PrivateCodeDigits
	local maxValue = 10 ^ digits - 1
	local format = "%0" .. tostring(digits) .. "d"
	local code
	repeat
		code = string.format(format, random:NextInteger(0, maxValue))
	until findByCode(code) == nil
	return code
end

local function setAttributes(player, party)
	player:SetAttribute("partyId", if party then party.id else nil)
	player:SetAttribute("partyCode", if party then party.code else nil)
	player:SetAttribute("partyHostId", if party and party.host then party.host.UserId else nil)
	player:SetAttribute("isReady", if party then party.ready[player] == true else nil)
	player:SetAttribute("partyCountdownEnd", if party then party.countdownEnd else nil)
end

local function refreshAll(party)
	for _, member in party.members do
		setAttributes(member, party)
	end
end

local function publish(party)
	task.spawn(services.MatchmakingService.Publish, services.MatchmakingService, party)
end

local function notReadyCount(party)
	local count = 0
	for _, member in party.members do
		if party.ready[member] ~= true then
			count += 1
		end
	end
	return count
end

local function allReady(party)
	return #party.members >= LaunchConfig.Party.MinSize and notReadyCount(party) == 0
end

-- arrête le compte à rebours en cours ; MSG_CountdownCancelled aux membres restants
local function cancelCountdown(party)
	if party.countdownThread == nil then
		return
	end
	task.cancel(party.countdownThread)
	party.countdownThread = nil
	party.countdownEnd = nil
	notifyParty(party, "MSG_CountdownCancelled")
end

local function launch(party)
	party.countdownThread = nil
	party.countdownEnd = nil
	if not allReady(party) then
		refreshAll(party)
		return
	end
	party.launching = true
	refreshAll(party)
	publish(party)
	-- 4.4 : votes résolus (5.4 : sans vote Normal / aléatoire ; égalité : la plus basse / aléatoire)
	services.VoteService:Resolve(party)
	-- 4.4, étape 6 : cinématique CS_01 (les joueurs montent dans le van), puis téléportation
	local cinematic = Util.getRemote("RE_PlayCinematic")
	if cinematic then
		for _, member in party.members do
			cinematic:FireClient(member, "Play", "CS_01")
		end
	end
	task.wait(CinematicConfig.Cinematics.CS_01.duration)
	local ok = services.LaunchService:Launch(party)
	if not ok then
		PartyService:LaunchFailed(party)
	end
end

-- relance ou annule le compte à rebours selon l'état du groupe
local function updateCountdown(party)
	if party.launching then
		return
	end
	if allReady(party) then
		if party.countdownThread == nil then
			local duration = LaunchConfig.Party.ReadyCountdown
			party.countdownEnd = workspace:GetServerTimeNow() + duration
			party.countdownThread = task.delay(duration, launch, party)
			notifyParty(party, "MSG_Countdown", { n = duration })
		end
	else
		cancelCountdown(party)
	end
	refreshAll(party)
end

local function addMember(party, player)
	table.insert(party.members, player)
	partyOf[player] = party.id
	PartyService.MembersChanged:Fire(party)
	-- un nouveau membre n'est pas prêt : le compte à rebours s'arrête
	updateCountdown(party)
	publish(party)
end

local function removeMember(player)
	local partyId = partyOf[player]
	local party = partyId and parties[partyId]
	partyOf[player] = nil
	if player.Parent ~= nil then
		setAttributes(player, nil)
	end
	if party == nil then
		return
	end
	local index = table.find(party.members, player)
	if index then
		table.remove(party.members, index)
	end
	party.ready[player] = nil
	PartyService.MemberLeft:Fire(party, player)
	PartyService.MembersChanged:Fire(party)
	if #party.members == 0 then
		if party.countdownThread ~= nil then
			task.cancel(party.countdownThread)
			party.countdownThread = nil
		end
		parties[party.id] = nil
		task.spawn(services.MatchmakingService.Remove, services.MatchmakingService, party.id)
		return
	end
	if party.host == player then
		-- DÉFAUT : le plus ancien membre restant devient créateur du groupe
		party.host = party.members[1]
		notifyParty(party, "MSG_HostLeft", { player = party.host.DisplayName })
	end
	updateCountdown(party)
	publish(party)
end

local function canJoin(party)
	return party ~= nil and not party.launching and #party.members < LaunchConfig.Party.MaxSize
end

-- DÉFAUT : un joueur déjà dans un groupe ne peut ni créer ni rejoindre ; la demande est ignorée
-- (l'interface masque ces boutons quand il a un groupe)

local function onCreate(player, isPrivate)
	if type(isPrivate) ~= "boolean" or partyOf[player] ~= nil then
		return
	end
	local party = {
		id = HttpService:GenerateGUID(false),
		isPrivate = isPrivate,
		-- DÉFAUT : seul le groupe privé a un code (4.4)
		code = if isPrivate then newCode() else nil,
		host = player,
		members = {},
		ready = {},
		roles = {}, -- [Player] = id de rôle (RoleService)
		weapons = {}, -- [Player] = id d'arme (WeaponBoardService)
		votes = {}, -- [Player] = { difficulty, weather } (VoteService)
		launching = false,
		countdownThread = nil,
		countdownEnd = nil,
	}
	parties[party.id] = party
	addMember(party, player)
end

local function onJoin(player, code)
	if type(code) ~= "string" or partyOf[player] ~= nil then
		return
	end
	if #code ~= LaunchConfig.Party.PrivateCodeDigits or code:match("^%d+$") == nil then
		Util.notify(player, "MSG_CodeInvalid")
		return
	end
	-- DÉFAUT : un code ne trouve que les groupes de ce serveur du lobby
	local party = findByCode(code)
	if party == nil then
		Util.notify(player, "MSG_CodeInvalid")
		return
	end
	if not canJoin(party) then
		Util.notify(player, "MSG_PartyFull")
		return
	end
	addMember(party, player)
end

local function onQuickJoin(player)
	if partyOf[player] ~= nil then
		return
	end
	local partyId = services.MatchmakingService:FindPublicParty(function(candidateId)
		local candidate = parties[candidateId]
		return candidate ~= nil and not candidate.isPrivate and canJoin(candidate)
	end)
	-- le joueur a pu rejoindre un groupe ou partir pendant la lecture MemoryStore
	if player.Parent == nil or partyOf[player] ~= nil then
		return
	end
	local party = partyId and parties[partyId]
	if party == nil or not canJoin(party) then
		Util.notify(player, "MSG_QuickJoinNone")
		return
	end
	addMember(party, player)
end

local function onLeave(player)
	local party = parties[partyOf[player] or ""]
	if party == nil or party.launching then
		return
	end
	removeMember(player)
	Util.notify(player, "MSG_PartyLeft")
end

local function onReady(player, isReady)
	if type(isReady) ~= "boolean" then
		return
	end
	local party = parties[partyOf[player] or ""]
	if party == nil or party.launching then
		return
	end
	-- 4.6 : un rôle est obligatoire avant d'être prêt
	if isReady and (party.roles == nil or party.roles[player] == nil) then
		Util.notify(player, "MSG_RoleRequired")
		return
	end
	party.ready[player] = if isReady then true else nil
	updateCountdown(party)
	local waiting = notReadyCount(party)
	if waiting > 0 then
		notifyParty(party, "MSG_WaitingReady", { n = waiting })
	end
end

-- départ raté après tous les essais : le groupe reste ouvert, chacun doit se redéclarer prêt
function PartyService:LaunchFailed(party)
	if parties[party.id] ~= party or not party.launching then
		return
	end
	party.launching = false
	for _, member in party.members do
		party.ready[member] = nil
	end
	notifyParty(party, "MSG_TeleportAbort")
	refreshAll(party)
	publish(party)
end

-- groupe d'un joueur (lecture seule pour les autres services)
function PartyService:GetParty(player)
	local partyId = partyOf[player]
	return partyId and parties[partyId] or nil
end

function PartyService:Init(allServices)
	services = allServices
end

function PartyService:Start()
	local handlers = {
		RE_PartyCreate = onCreate,
		RE_PartyJoin = onJoin,
		RE_PartyQuickJoin = onQuickJoin,
		RE_PartyLeave = onLeave,
		RE_Ready = onReady,
	}
	for remoteName, handler in handlers do
		local remote = Util.getRemote(remoteName)
		if remote ~= nil then
			RateLimiter.connect(remote, handler)
		end
	end

	Players.PlayerRemoving:Connect(removeMember)
end

return PartyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="156">
        <Properties>
          <string name="Name">RoleService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/RoleService (Lobby)
-- Section 4.4 : chaque joueur choisit un rôle libre parmi les 10 (unique dans le groupe).
-- RE_SelectRole (C → S) : (roleId). Attribut du joueur : partyRole.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))

local RoleService = {}

local services = nil

local function validRole(roleId)
	for _, role in PlayerConfig.Roles do
		if role.id == roleId then
			return true
		end
	end
	return false
end

local function holderOf(party, roleId)
	for member, role in party.roles do
		if role == roleId and member.Parent then
			return member
		end
	end
	return nil
end

local function onSelect(player, roleId)
	if type(roleId) ~= "string" or not validRole(roleId) then
		return
	end
	local party = services.PartyService:GetParty(player)
	if party == nil or party.launching then
		return
	end
	local holder = holderOf(party, roleId)
	if holder and holder ~= player then
		Util.notify(player, "MSG_RoleTaken", { player = holder.DisplayName })
		return
	end
	party.roles[player] = roleId
	player:SetAttribute("partyRole", roleId)
	services.PartyService.MembersChanged:Fire(party)
end

function RoleService:Init(allServices)
	services = allServices
end

function RoleService:Start()
	local remote = Util.getRemote("RE_SelectRole")
	if remote then
		RateLimiter.connect(remote, onSelect)
	end
	services.PartyService.MemberLeft:Connect(function(party, player)
		party.roles[player] = nil
		if player.Parent then
			player:SetAttribute("partyRole", nil)
		end
	end)
end

return RoleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="157">
        <Properties>
          <string name="Name">VoteService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/VoteService (Lobby)
-- Sections 4.4 et 5.4 : votes de difficulté (Normal, Difficile, Cauchemar si débloquée) et de météo
-- (aléatoire ou fixe). Sans vote : Normal, aléatoire. Égalité : la difficulté la plus basse ; météo
-- aléatoire. RE_Vote (C → S) : ("Difficulty", id) / ("Weather", id) / ("Weapon", userId).
-- Attributs du joueur : voteDifficulty, voteWeather.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))

local VoteService = {}

local services = nil
local Votes = LaunchConfig.Votes

local function onVote(player, kind, value)
	if kind == "Weapon" then
		if type(value) == "number" then
			services.WeaponBoardService:Vote(player, value)
		end
		return
	end
	local party = services.PartyService:GetParty(player)
	if party == nil or party.launching or type(value) ~= "string" then
		return
	end
	party.votes[player] = party.votes[player] or {}
	if kind == "Difficulty" and table.find(Votes.Difficulties, value) then
		-- 5.4 : Cauchemar se débloque après une première survie
		if value == "Nightmare" then
			local data = services.DataService:GetData(player)
			if not (data and data.nightmareUnlocked) then
				Util.notify(player, "MSG_NightmareLocked")
				return
			end
		end
		party.votes[player].difficulty = value
		player:SetAttribute("voteDifficulty", value)
	elseif kind == "Weather" and table.find(Votes.Weathers, value) then
		party.votes[player].weather = value
		player:SetAttribute("voteWeather", value)
	end
end

local function tally(party, key, options, default, tie)
	local counts = {}
	for member, vote in party.votes do
		if member.Parent and vote[key] then
			counts[vote[key]] = (counts[vote[key]] or 0) + 1
		end
	end
	local best, bestCount, tied = nil, 0, false
	for _, option in options do -- dans l'ordre : de la plus basse à la plus haute
		local count = counts[option] or 0
		if count > bestCount then
			best, bestCount, tied = option, count, false
		elseif count == bestCount and count > 0 then
			tied = true
		end
	end
	if best == nil then
		return default
	end
	if tied then
		-- difficulté : la plus basse l'emporte (la première rencontrée) ; météo : aléatoire
		return if tie == "Lowest" then best else tie
	end
	return best
end

-- résultat des votes, écrit dans le groupe (lu par LaunchService)
function VoteService:Resolve(party)
	party.difficulty = tally(party, "difficulty", Votes.Difficulties, Votes.DefaultDifficulty, "Lowest")
	party.weather = tally(party, "weather", Votes.Weathers, Votes.DefaultWeather, Votes.TieWeather)
end

function VoteService:Init(allServices)
	services = allServices
end

function VoteService:Start()
	local remote = Util.getRemote("RE_Vote")
	if remote then
		RateLimiter.connect(remote, onVote)
	end
	services.PartyService.MemberLeft:Connect(function(party, player)
		party.votes[player] = nil
		if player.Parent then
			player:SetAttribute("voteDifficulty", nil)
			player:SetAttribute("voteWeather", nil)
		end
	end)
end

return VoteService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="158">
        <Properties>
          <string name="Name">WeaponBoardService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/WeaponBoardService (Lobby)
-- Sections 4.4 et 8.2 : le tableau du van affiche les armes disponibles selon la taille du groupe
-- (1–3 : fusil ; 4–6 : + revolver ; 7–10 : + fusil à pompe). Un joueur clique pour en prendre une ;
-- en cas de conflit, vote à la majorité en 15 s, sinon tirage. Le fusil revient d'office au Pisteur
-- s'il est présent ; l'Opératrice ne peut pas porter d'arme à feu.
-- RE_TakeWeapon (C → S) : (weaponId). Votes : RE_Vote ("Weapon", userId du candidat), via VoteService.
-- Attributs : partyWeapon (joueur) ; weaponVote (JSON { weapon, a, b, endsAt }) sur chaque membre.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("WeaponConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))

local WeaponBoardService = {}

local services = nil
local random = Random.new()

function WeaponBoardService:Available(party)
	local count = #party.members
	for _, entry in WeaponConfig.FirearmsByGroupSize do
		if count <= entry.maxPlayers then
			return entry.weapons
		end
	end
	return {}
end

local function holderOf(party, weaponId)
	for member, weapon in party.weapons do
		if weapon == weaponId and member.Parent then
			return member
		end
	end
	return nil
end

local function trackerOf(party)
	for member, role in party.roles do
		if role == WeaponConfig.RifleToRole and member.Parent then
			return member
		end
	end
	return nil
end

local function publish(party)
	for _, member in party.members do
		member:SetAttribute("partyWeapon", party.weapons[member])
		member:SetAttribute("weaponVote", if party.weaponVote then Util.encode(party.weaponVote.public) else nil)
	end
end

local function assign(party, player, weaponId)
	for member, weapon in party.weapons do
		if weapon == weaponId then
			party.weapons[member] = nil
		end
	end
	party.weapons[player] = weaponId
end

-- règles qui dépendent du groupe : armes disponibles, fusil au Pisteur, Opératrice sans arme
function WeaponBoardService:Refresh(party)
	local available = self:Available(party)
	for member, weapon in party.weapons do
		if
			not table.find(available, weapon)
			or party.roles[member] == WeaponConfig.NoFirearmRole
			or member.Parent == nil
		then
			party.weapons[member] = nil
		end
	end
	local tracker = trackerOf(party)
	if tracker and table.find(available, "WPN_Rifle") then
		assign(party, tracker, "WPN_Rifle")
	end
	publish(party)
end

local function finishVote(party)
	local vote = party.weaponVote
	if vote == nil then
		return
	end
	party.weaponVote = nil
	local a, b = 0, 0
	for _, choice in vote.votes do
		if choice == vote.public.a then
			a += 1
		elseif choice == vote.public.b then
			b += 1
		end
	end
	local winnerId
	if a > b then
		winnerId = vote.public.a
	elseif b > a then
		winnerId = vote.public.b
	else
		winnerId = if random:NextInteger(1, 2) == 1 then vote.public.a else vote.public.b -- sinon tirage
	end
	for _, member in party.members do
		if member.UserId == winnerId then
			assign(party, member, vote.public.weapon)
		end
	end
	publish(party)
end

local function onTake(player, weaponId)
	local party = services.PartyService:GetParty(player)
	if party == nil or party.launching or type(weaponId) ~= "string" then
		return
	end
	if not table.find(WeaponBoardService:Available(party), weaponId) then
		return
	end
	if party.roles[player] == WeaponConfig.NoFirearmRole then
		Util.notify(player, "MSG_WeaponNotAllowed")
		return
	end
	local holder = holderOf(party, weaponId)
	if holder == player then
		return
	end
	local tracker = trackerOf(party)
	if weaponId == "WPN_Rifle" and tracker and tracker ~= player then
		Util.notify(player, "MSG_WeaponTaken", { player = tracker.DisplayName })
		return
	end
	if holder == nil then
		assign(party, player, weaponId)
		publish(party)
		return
	end
	-- conflit : vote à la majorité en 15 s, sinon tirage
	if party.weaponVote then
		Util.notify(player, "MSG_WeaponTaken", { player = holder.DisplayName })
		return
	end
	party.weaponVote = {
		votes = {},
		public = {
			weapon = weaponId,
			a = holder.UserId,
			b = player.UserId,
			endsAt = workspace:GetServerTimeNow() + WeaponConfig.ConflictVoteDuration,
		},
	}
	for _, member in party.members do
		Util.notify(member, "MSG_WeaponVote")
	end
	publish(party)
	task.delay(WeaponConfig.ConflictVoteDuration, finishVote, party)
end

-- RE_Vote ("Weapon", userId) transmis par VoteService
function WeaponBoardService:Vote(player, candidateId)
	local party = services.PartyService:GetParty(player)
	local vote = party and party.weaponVote
	if vote and (candidateId == vote.public.a or candidateId == vote.public.b) then
		vote.votes[player] = candidateId
	end
end

function WeaponBoardService:Init(allServices)
	services = allServices
end

function WeaponBoardService:Start()
	local remote = Util.getRemote("RE_TakeWeapon")
	if remote then
		RateLimiter.connect(remote, onTake)
	end
	services.PartyService.MembersChanged:Connect(function(party)
		self:Refresh(party)
	end)
	services.PartyService.MemberLeft:Connect(function(party, player)
		party.weapons[player] = nil
		if player.Parent then
			player:SetAttribute("partyWeapon", nil)
			player:SetAttribute("weaponVote", nil)
		end
	end)
end

return WeaponBoardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="159">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/DataService (les deux places)
-- Section 16.2 et 16.4 : DataStore PisteFroide_v1, clé player_<UserId>,
-- verrouillage de session, sauvegarde toutes les 120 s et à la fermeture.
-- Le verrou est rangé dans les métadonnées de la clé : la valeur garde exactement le format de 16.4.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

-- (player, data) : données chargées et prêtes
DataService.Loaded = Signal.new()

local store = nil -- nil si les API DataStore sont inaccessibles (Studio sans accès)
local sessions = {} -- [Player] = { data = table, released = bool }

local function keyFor(userId)
	return ProgressionConfig.KeyPrefix .. tostring(userId)
end

-- données par défaut d'un nouveau joueur (16.4)
local function buildDefaultData()
	local endings = {}
	for _, endingId in ProgressionConfig.EndingIds do
		endings[endingId] = false
	end

	local skins = {}
	local equipped = {}
	for _, role in PlayerConfig.Roles do
		-- un rôle sans identifiant n'a pas de clé de données
		if role.id ~= nil then
			local owned = {}
			for _, skinId in ProgressionConfig.SkinIds do
				owned[skinId] = skinId == ProgressionConfig.DefaultSkin
			end
			skins[role.id] = owned
			equipped[role.id] = ProgressionConfig.DefaultSkin
		end
	end

	local museumRead = {}
	for _, panelId in ProgressionConfig.MuseumPanelIds do
		museumRead[panelId] = false
	end

	return {
		version = ProgressionConfig.DataVersion,
		xp = 0,
		plays = 0,
		survivals = 0,
		endings = endings,
		evidence = {},
		skins = skins,
		equipped = equipped,
		notebookPages = Util.deepCopy(ProgressionConfig.DefaultNotebookPages),
		museumRead = museumRead,
		nightmareUnlocked = false,
		-- TODO(J15): valeurs par défaut des réglages de la section 17.2 (Défaut PC / mobile)
		settings = {},
	}
end

-- vrai si une autre session (autre serveur) tient un verrou encore frais
local function isLockedByOther(metadata)
	if metadata == nil or metadata.lockJobId == nil then
		return false
	end
	if metadata.lockJobId == game.JobId then
		return false
	end
	local age = os.time() - (metadata.lockTime or 0)
	return age < ProgressionConfig.SessionLock.StaleAfter
end

local function lockMetadata()
	return { lockJobId = game.JobId, lockTime = os.time() }
end

-- une tentative : prend le verrou et lit les données.
-- Renvoie "ok" + données, ou "locked" si une autre session tient le verrou.
local function tryAcquire(userId)
	local status = "ok"
	local loaded = nil
	store:UpdateAsync(keyFor(userId), function(current, keyInfo)
		local metadata = keyInfo and keyInfo:GetMetadata() or nil
		if isLockedByOther(metadata) then
			status = "locked"
			return nil -- annule l'écriture
		end
		status = "ok"
		loaded = current or buildDefaultData()
		return loaded, { userId }, lockMetadata()
	end)
	return status, loaded
end

-- écrit les données ; `release` libère le verrou (départ du joueur, fermeture)
local function writeSession(player, session, release)
	if store == nil then
		return
	end
	local userId = player.UserId
	local stolen = false
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(userId), function(_current, keyInfo)
			local metadata = keyInfo and keyInfo:GetMetadata() or nil
			if isLockedByOther(metadata) then
				stolen = true
				return nil -- une autre session a repris la clé : ne pas l'écraser
			end
			stolen = false
			local newMetadata = if release then {} else lockMetadata()
			return session.data, { userId }, newMetadata
		end)
	end)
	if not ok then
		warn(("DataService : échec de sauvegarde pour %d : %s"):format(userId, tostring(err)))
	elseif stolen then
		warn(("DataService : verrou repris par une autre session pour %d, sauvegarde annulée"):format(userId))
	end
end

-- DÉFAUT : quelques compteurs publiés en attributs pour l'interface (lecture seule côté client)
local PUBLISHED = { "xp", "plays", "survivals", "nightmareUnlocked" }
local function publishAttributes(player, data)
	for _, key in PUBLISHED do
		player:SetAttribute(key, data[key])
	end
end

local function onPlayerAdded(player)
	if sessions[player] ~= nil then
		return
	end

	if store == nil then
		-- Studio sans accès aux API : données par défaut, jamais sauvegardées
		sessions[player] = { data = buildDefaultData(), released = true }
		player:SetAttribute("dataLoaded", true)
		DataService.Loaded:Fire(player, sessions[player].data)
		return
	end

	local lock = ProgressionConfig.SessionLock
	for attempt = 1, lock.LoadAttempts do
		if player.Parent == nil then
			return -- le joueur est parti pendant le chargement
		end
		local ok, status, data = pcall(tryAcquire, player.UserId)
		if ok and status == "ok" then
			local session = { data = Util.reconcile(data, buildDefaultData()), released = false }
			if player.Parent == nil then
				-- parti entre-temps : on rend le verrou tout de suite
				writeSession(player, session, true)
				return
			end
			sessions[player] = session
			publishAttributes(player, session.data)
			player:SetAttribute("dataLoaded", true)
			DataService.Loaded:Fire(player, session.data)
			return
		end
		if not ok then
			warn(
				("DataService : échec de chargement pour %d (essai %d) : %s"):format(
					player.UserId,
					attempt,
					tostring(status)
				)
			)
		end
		if attempt < lock.LoadAttempts then
			task.wait(lock.LoadRetryDelay)
		end
	end

	-- 4.6 : le joueur joue sans données, rien n'est sauvegardé pour lui (MSG_DataLoadFailed)
	warn(
		("DataService : données indisponibles pour %d, aucune sauvegarde pendant cette session"):format(player.UserId)
	)
	Util.notify(player, "MSG_DataLoadFailed")
	player:SetAttribute("dataLoaded", false)
end

local function releaseSession(player)
	local session = sessions[player]
	if session == nil then
		return
	end
	sessions[player] = nil
	if session.released then
		return
	end
	session.released = true
	writeSession(player, session, true)
end

-- données du joueur, ou nil si pas (encore) chargées
function DataService:GetData(player)
	local session = sessions[player]
	return session and session.data or nil
end

function DataService:IsLoaded(player)
	return sessions[player] ~= nil
end

-- attend les données du joueur ; nil si le joueur part ou si le chargement échoue
function DataService:WaitForData(player)
	while player.Parent ~= nil and sessions[player] == nil and player:GetAttribute("dataLoaded") ~= false do
		task.wait()
	end
	return self:GetData(player)
end

-- sauvegarde immédiate en gardant le verrou
function DataService:Save(player)
	local session = sessions[player]
	if session ~= nil and not session.released then
		publishAttributes(player, session.data)
		writeSession(player, session, false)
	end
end

function DataService:Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(ProgressionConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn(
			"DataService : DataStore inaccessible (en Studio : activer l'accès aux API). Données non sauvegardées. "
				.. tostring(result)
		)
	end
end

function DataService:Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(releaseSession)

	-- sauvegarde périodique (16.2 : toutes les 120 s)
	task.spawn(function()
		while true do
			task.wait(ProgressionConfig.AutosaveInterval)
			for player in table.clone(sessions) do
				task.spawn(DataService.Save, DataService, player)
			end
		end
	end)

	-- sauvegarde à la fermeture du serveur
	game:BindToClose(function()
		local pending = 0
		for player in table.clone(sessions) do
			pending += 1
			task.spawn(function()
				releaseSession(player)
				pending -= 1
			end)
		end
		while pending > 0 do
			task.wait()
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
