          <string name="Name">ActConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/ActConfig
-- Valeurs de la bible, section 5 (déroulé d'une partie). Ne rien ajouter ici sans la bible.
local ActConfig = {}

-- 5 : la nuit du 28 octobre
ActConfig.Date = "28 octobre"

-- 5.1 : horloge. Heures en jeu (h décimales) ; durées réelles en secondes.
-- Dans un acte, l'heure avance linéairement de start à finish sur maxDuration.
ActConfig.Acts = {
	[0] = { name = "Arrivée", start = 18.5, finish = 19, minDuration = 180, maxDuration = 180 },
	[1] = { name = "L'enquête", start = 19, finish = 22, minDuration = 600, maxDuration = 900 },
	[2] = { name = "Le siège", start = 22, finish = 24, minDuration = 480, maxDuration = 840 },
	[3] = { name = "La chasse", start = 0, finish = 5, minDuration = 600, maxDuration = 900 },
	[4] = { name = "L'aube", start = 5, finish = 6, minDuration = 180, maxDuration = 300 },
}
ActConfig.ActTransition = 10 -- l'heure saute au début de l'acte suivant en 10 s (ciel accéléré)
ActConfig.EndHour = 6 -- 06 h 00 : la partie s'arrête, les joueurs encore dans la forêt sont disparus
ActConfig.MaxGameDuration = 55 * 60 -- au plus tard 55 min réelles après le début

-- 5.2 : objectifs affichés (textes de la bible)
ActConfig.Objectives = {
	[0] = "Trouver le camp des géologues",
	[1] = "Trouver le camp des géologues",
	Cabin = "Rejoindre la cabane avant minuit",
	-- TODO(BIBLE): textes d'objectif des actes 3 et 4 (voie d'extraction) ; 6.2 CS_07 n'en donne qu'un exemple
	Extraction = {
		E1 = nil,
		E2 = "La radio de la tour. C'est notre seule chance.", -- exemple de CS_07 (6.2)
		E3 = nil,
		E4 = nil,
	},
}

-- 5.2 : acte 1
ActConfig.Act1 = {
	CluesNeeded = 3, -- 3 des 6 indices tirés
	CampPlace = "P09",
}

-- 5.2 : acte 2, le siège
ActConfig.Siege = {
	CabinPlace = "P05c",
	StartDelayAfterEntry = 60, -- 60 s après l'entrée du premier joueur dans la cabane
	StartHourIfNobody = 23 + 5 / 60, -- ou à 23 h 05
	Openings = { "Door", "Window", "RoofHole" }, -- porte, fenêtre, trou du toit
	PlankTime = 8,
	RolePlankTime = { Athlete = 4 },
	Duration = 6 * 60, -- 6 minutes de bombardement
	PlankImpacts = 4, -- une planche reçoit 4 impacts avant de céder
	SilenceAfter = 20, -- silence total 20 s, puis CS_07
	NotebookPageUnlocked = 2,
	-- TODO(BIBLE): cadence des pierres pendant le siège. PROVISOIRE : une pierre toutes les 4 s par créature
	StoneInterval = 4,
}

-- 5.2 : acte 3 — voie principale tirée parmi E1, E2, E3 ; E4 ouverte si DOC_07 a été lu
ActConfig.MainRoutes = { "E1", "E2", "E3" }
ActConfig.SecretRoute = { id = "E4", requiresDocument = "DOC_07" }
ActConfig.Routes = {
	E1 = {
		place = "P01",
		needs = { "ITM_Keys", "ITM_Jack" },
		repairTime = 20,
		roleRepairTime = { Mechanic = 10 },
		cinematic = "CS_10",
		-- TODO(BIBLE): rayon du bruit du « démarrage bruyant » du van (sans valeur : pas de bruit émis)
		startNoise = nil,
	},
	E2 = {
		place = "P11",
		needs = { "ITM_CoaxCable", "ITM_CarBattery" },
		repairTime = 30,
		holdTime = 180,
		cinematic = "CS_11",
	},
	E3 = {
		place = "P10",
		needs = { "ITM_Jerrycan", "ITM_StarterRelay" },
		repairTime = 40,
		driveDistance = 650,
		driveSpeed = 8,
		cinematic = "CS_12",
	},
	E4 = { place = "P07c", needs = { "DOC_07", "Light" }, clearTime = 60, cinematic = "CS_13" },
}

-- 5.2 : acte 4
ActConfig.Dawn = {
	FinalAssaultHour = 5, -- dernier assaut
	CreatureRetreatHour = 5 + 50 / 60, -- aucune attaque après 05 h 50, sauf dans les tunnels
}

-- 5.3 : fins (clés des données 16.4)
ActConfig.Endings = {
	Survie = { cinematics = { E1 = "CS_10", E2 = "CS_11", E3 = "CS_12" } },
	Preuve = { cinematic = "CS_15" },
	Verite = { cinematic = "CS_13", notebookPage = 3 },
	Ordonnance = { cinematic = "CS_14", replaces = "Survie" },
	Silence = { cinematic = "CS_16" },
}

-- 5.4 : difficultés
ActConfig.Difficulties = {
	Normal = {
		creatureDamage = 1.0,
		perception = 1.0,
		creatureHealth = 1.0,
		friendlyFire = false,
		downedTime = 45,
		ammoBox = true,
		objectiveHints = true,
		unlock = "Start",
	},
	Hard = {
		creatureDamage = 1.3,
		perception = 1.15,
		creatureHealth = 1.25,
		friendlyFire = true,
		downedTime = 35,
		ammoBox = true,
		objectiveHints = true,
		unlock = "Start",
	},
	Nightmare = {
		creatureDamage = 1.6,
		perception = 1.3,
		creatureHealth = 1.5,
		friendlyFire = true,
		downedTime = 25,
		ammoBox = false,
		objectiveHints = false,
		unlock = "FirstSurvival",
	},
}

-- 5.5 : taille du groupe
ActConfig.GroupSizes = {
	{ maxPlayers = 3, creatures = { "CRT_Alpha" }, firearms = 1, directorEvents = 0.8 },
	{ maxPlayers = 6, creatures = { "CRT_Alpha", "CRT_Scout1" }, firearms = 2, directorEvents = 1.0 },
	{ maxPlayers = 10, creatures = { "CRT_Alpha", "CRT_Scout1", "CRT_Scout2" }, firearms = 3, directorEvents = 1.2 },
}

-- réglages de la difficulté et de la taille de groupe pour une partie
function ActConfig.difficulty(id)
	return ActConfig.Difficulties[id] or ActConfig.Difficulties.Normal
end

function ActConfig.groupSize(count)
	for _, entry in ActConfig.GroupSizes do
		if count <= entry.maxPlayers then
			return entry
		end
	end
	return ActConfig.GroupSizes[#ActConfig.GroupSizes]
end

return ActConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">AmbienceConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/AmbienceConfig
-- Valeurs de la bible, sections 12.1 à 12.4. Ne rien ajouter ici sans la bible.
-- Réglage à l'œil prévu en phase B2 (J4) : ces valeurs sont les réglages de départ.
local AmbienceConfig = {}

AmbienceConfig.Technology = "Future" -- 12.1 : Lighting.Technology

-- 12.1 : lumière par moment. clock = ClockTime (début → fin) ; couleurs en RGB 0–255
AmbienceConfig.Moments = {
	{
		name = "Arrivée",
		clockFrom = 18.5,
		clockTo = 19,
		brightness = 1.2,
		outdoorAmbient = { 60, 65, 80 },
		ambient = { 40, 45, 55 },
		exposure = 0,
	},
	{
		name = "Fin d'enquête",
		clockFrom = 21,
		clockTo = 21,
		brightness = 0.15,
		outdoorAmbient = { 20, 24, 32 },
		ambient = { 12, 14, 18 },
		exposure = 0,
	},
	{
		name = "Siège",
		clockFrom = 22,
		clockTo = 24,
		brightness = 0.05,
		outdoorAmbient = { 12, 14, 20 },
		ambient = { 8, 9, 12 },
		exposure = -0.1,
	},
	{
		name = "Nuit noire",
		clockFrom = 0,
		clockTo = 4,
		brightness = 0,
		outdoorAmbient = { 8, 9, 14 },
		ambient = { 5, 6, 9 },
		exposure = -0.3,
	},
	{
		name = "Aube",
		clockFrom = 5,
		clockTo = 6,
		brightness = 0.6,
		outdoorAmbient = { 45, 55, 75 },
		ambient = { 25, 30, 40 },
		exposure = 0,
	},
}

-- 12.1 : effets
AmbienceConfig.ColorCorrection = { Saturation = -0.25, Contrast = 0.1, TintColor = { 220, 230, 255 } }
AmbienceConfig.Bloom = { Intensity = 0.3 }
AmbienceConfig.DepthOfField = { FarIntensity = 0.15, presetOnly = "High" } -- réglage Élevé seulement
-- 12.1 : lune par nuit claire : les nuages s'ouvrent 20 s toutes les 3 à 5 min
AmbienceConfig.Moon = { OpenDuration = 20, IntervalMin = 180, IntervalMax = 300, SilhouetteRange = 80 }
-- 12.1 : lampes : SpotLight avec ombres, angle 45° ; clignotement aléatoire sous 15 % de pile
AmbienceConfig.Lamp = { Angle = 45, Shadows = true, FlickerBelow = 0.15, EngineMaxRange = 60 } -- 60 : limite Roblox de Light.Range

-- 12.2 : brouillard par zone (Atmosphere). Couleurs RGB 0–255.
AmbienceConfig.Fog = {
	Forest = { density = 0.35, haze = 1.5, color = { 190, 200, 215 } },
	Gorges = { places = { "P03", "P05" }, density = 0.45, haze = 2.0, color = { 180, 190, 205 } },
	ForbiddenZone = { places = { "P08" }, density = 0.20, haze = 0.5, color = { 170, 170, 175 }, ashParticles = true },
	Plateau = { places = { "P06" }, density = 0.25, haze = 1.0, color = { 200, 205, 215 } },
	Tunnels = { places = { "P07a", "P07b", "P07c" }, atmosphereDisabled = true }, -- noir total
}

-- 12.3 : météo (tirée à chaque partie, sauf vote « fixe »). probability en fraction.
AmbienceConfig.Weathers = {
	Clear = { name = "Nuit claire", probability = 0.30, moon = true, creatureSight = 1, noiseFactor = 1 },
	Fog = {
		name = "Brouillard",
		probability = 0.30,
		fogDensityFactor = 1.7,
		creatureSight = 0.5,
		playerSight = 0.5,
		noiseFactor = 1,
	},
	Rain = { name = "Pluie", probability = 0.25, creatureSight = 0.7, noiseFactor = 0.6, wetGround = true },
	Snow = {
		name = "Première neige",
		probability = 0.15,
		snowAboveY = 350,
		footprintDuration = 300,
		staminaFactor = 0.85,
		creatureSight = 1,
		noiseFactor = 1,
	},
}
AmbienceConfig.WeatherOrder = { "Clear", "Fog", "Rain", "Snow" }
-- 12.3 : pendant l'acte 2, une nuit claire ou un brouillard passe en pluie (ou en neige au-dessus de Y = 350)
AmbienceConfig.SiegeWeather = { from = { Clear = true, Fog = true }, to = "Rain", snowAboveY = 350, toAbove = "Snow" }

-- 12.4 : vent (workspace.GlobalWind) et rafales
AmbienceConfig.Wind = {
	Clear = { base = { 6, 0, -3 }, gust = 10, gustIntervalMin = 8, gustIntervalMax = 15 },
	Fog = { base = { 2, 0, -1 }, gust = 0 },
	Rain = { base = { 14, 0, -6 }, gust = 20, sine = true }, -- cycle en sinus comme l'exemple de la doc
	Snow = { base = { 10, 0, -8 }, gust = 12 },
}
-- TODO(BIBLE): période du cycle en sinus des rafales de pluie, et intervalle des rafales de neige
AmbienceConfig.WindSinePeriod = nil
-- TODO(BIBLE): durée d'une rafale. PROVISOIRE : 1 s
AmbienceConfig.GustDuration = 1
AmbienceConfig.TreeWindRange = 120 -- 12.4 : arbres animés par leurs os à moins de 120 studs (réglage Élevé)

-- 12.5 : réverbération par zone (SoundService.AmbientReverb)
AmbienceConfig.Reverb = {
	Forest = "Forest",
	Gorges = "Mountains",
	Tunnels = "Cave",
	Buildings = "Room",
	Plateau = "Plain",
	ForbiddenZone = "Plain",
}

return AmbienceConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="105">
        <Properties>
          <string name="Name">AudioConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/AudioConfig
-- Valeurs de la bible, sections 12.5, 12.6 et 13.7. Ne rien ajouter ici sans la bible.
-- Les sons sont à fournir (13.1 : Freesound CC0 / CC-BY, enregistrements de Gabriel) ;
-- chaque identifiant rbxassetid est vide tant que le son n'est pas importé dans Studio.
-- Un son vide n'est pas joué (avertissement dans la console, jamais d'erreur).
local AudioConfig = {}

-- 12.5 : sons d'ambiance
AudioConfig.Ambience = {
	AMB_Birds = { where = "Forêt", acts = { 0, 4 }, silencedByCreature = true, id = "" },
	AMB_Insects_Owls = { where = "Forêt", acts = { 1, 2, 3 }, silencedByCreature = true, id = "" },
	AMB_Wind_Pines = { where = "Dehors", volumeFromWind = true, id = "" },
	AMB_River = { where = "R1, R2, R3", emitterSpacing = 60, masksNoise = true, id = "" },
	AMB_Waterfall = { where = "P13", masksNoise = true, id = "" },
	AMB_CanyonWind = { where = "P03, P05", id = "" },
	AMB_AshEmpty = { where = "P08", id = "" },
	AMB_TunnelDrips = { where = "P07", id = "" },
}
AudioConfig.FaunaSilenceRadius = 60 -- EVT_01 / 9.6 : la faune se tait sur 60 studs

-- 12.6 : musique
AudioConfig.Music = {
	MUS_Lobby = { when = "Lobby", id = "" },
	MUS_Siege = { when = "Acte 2, pendant le bombardement", id = "" },
	MUS_Chase = { when = "La créature attaque ou charge le joueur local à moins de 60 studs", range = 60, id = "" },
	MUS_Dawn = { when = "Cinématiques d'extraction", id = "" },
}

-- 12.5 : pas des joueurs, 4 variantes par matériau
AudioConfig.FootstepMaterials =
	{ "Grass", "LeafyGrass", "Ground", "Mud", "Pebble", "Rock", "Basalt", "Sand", "Snow", "Water", "Wood", "Metal" }
AudioConfig.FootstepVariants = 4
AudioConfig.Footsteps = {} -- [matériau] = { id1, id2, id3, id4 }

-- 13.7 : sons de la créature, des impacts, des joueurs, des voix, des objets et des lieux.
-- [ID] = rbxassetid ; vide en attendant l'import.
AudioConfig.Sounds = {}

-- 2.7 : enregistrements des documents (cassettes, DOC_14)
AudioConfig.Documents = {}

return AudioConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="106">
        <Properties>
          <string name="Name">CinematicConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/CinematicConfig
-- Valeurs et textes de la bible, section 6. Ne rien ajouter ici sans la bible.
-- Plans : Part invisibles Workspace/Cinematics/CS_xx_Shot_n (posées à la main, 6.1), caméra
-- Scriptable, transitions TweenService. Chaque plan dure duration / nombre de plans (DÉFAUT).
-- scope : "Lobby", "Place" (joueurs dans le rayon du lieu), "All" (tous), "Local" (un seul joueur).
local CinematicConfig = {}

-- 6.1 : règles communes
CinematicConfig.MaxInGameDuration = 12 -- en partie, 12 s au plus
CinematicConfig.SafetyAfter = 3 -- invulnérable et retiré des cibles pendant la cinématique, plus 3 s
CinematicConfig.LobbySkipAfter = 10 -- en lobby, bouton « Passer » après 10 s
CinematicConfig.BarAspect = 2.35 -- bandes noires 2.35:1

-- 6.2 : liste
CinematicConfig.Cinematics = {
	CS_00 = {
		trigger = "1re connexion au lobby",
		duration = 70,
		scope = "Local",
		shots = 7,
		fov = 50, -- plan 1 : travelling lent (FOV 50)
		subtitle = "1924. Cinq hommes, une cabane, une nuit de pierres. Les rangers n'ont rien trouvé. En 1969, le comté a quand même voté une loi pour le protéger. En 1980, la montagne a explosé. Et il y a trois semaines, quatre géologues ont cessé de répondre. Cette nuit, on y va.",
		voice = "VO_CS00",
	},
	CS_01 = {
		trigger = "Compte à rebours fini",
		duration = 8,
		scope = "Lobby",
		shots = 2,
		subtitle = "Route forestière 83 — fermée",
	},
	CS_02a = {
		trigger = "Début de partie (S1)",
		duration = 10,
		scope = "All",
		shots = 1,
		subtitle = "OK. On trouve le camp, on filme, on rentre.",
	},
	CS_02b = {
		trigger = "Début de partie (S2)",
		duration = 10,
		scope = "All",
		shots = 1,
		subtitle = "OK. On trouve le camp, on filme, on rentre.",
	},
	CS_02c = {
		trigger = "Début de partie (S3)",
		duration = 10,
		scope = "All",
		shots = 1,
		subtitle = "OK. On trouve le camp, on filme, on rentre.",
	},
	-- CS_03 : pas de coupe, la caméra du joueur est attirée vers une silhouette à 90–120 studs (directeur, A5)
	CS_03 = {
		trigger = "1er aperçu de la créature",
		duration = 4,
		scope = "Local",
		noCut = true,
		silhouetteMin = 90,
		silhouetteMax = 120,
		faunaSilenceBefore = 3,
	},
	CS_04 = {
		trigger = "1re entrée dans P09",
		duration = 9,
		scope = "Place",
		place = "P09",
		shots = 2,
		subtitle = "… Oh non.",
		subtitleNearestPlayer = true,
	},
	-- TODO(BIBLE): CS_05 dure 25 s alors que 6 « en partie, elles durent 12 s au plus » — exception de la vidéo ?
	CS_05 = {
		trigger = "Vidéo de la tablette (DOC_08)",
		duration = 25,
		scope = "Local",
		shots = 6,
		subtitle = "Éteins ça. Éteins ça !",
		screenText = "Point de repli de l'équipe : cabane des mineurs",
		timestamp = "J-17 02:14",
		noMusic = true,
	},
	CS_06 = { trigger = "Début du siège", duration = 6, scope = "Place", place = "P05c", shots = 2 },
	CS_07 = { trigger = "Fin du siège", duration = 10, scope = "Place", place = "P05c", shots = 2, routeText = true },
	CS_08 = { trigger = "Début de l'acte 3", duration = 5, scope = "All", shots = 1, sound = "SFX_Call_Long_02" },
	CS_09 = { trigger = "05 h 00", duration = 6, scope = "All", shots = 1 },
	CS_10 = { trigger = "Extraction E1", duration = 12, scope = "All", shots = 3, music = "MUS_Dawn" },
	CS_11 = { trigger = "Extraction E2", duration = 12, scope = "All", shots = 2, music = "MUS_Dawn" },
	CS_12 = { trigger = "Extraction E3", duration = 12, scope = "All", shots = 2, music = "MUS_Dawn" },
	CS_13 = {
		trigger = "Extraction E4",
		duration = 12,
		scope = "All",
		shots = 2,
		music = "MUS_Dawn",
		subtitle = "On leur avait pris quelqu'un, à eux aussi.",
	},
	CS_14 = {
		trigger = "Alpha tué",
		duration = 12,
		scope = "All",
		shots = 3,
		screenText = "Étudiants inculpés : première application de l'ordonnance 69-01",
	},
	CS_15 = { trigger = "Preuve de classe A sortie", duration = 6, scope = "All", shots = 1 },
	CS_16 = {
		trigger = "Aucun survivant",
		duration = 10,
		scope = "All",
		shots = 2,
		screenText = "Épisode 12 — Cold Trail — durée 00:47",
	},
}

-- 3.3 et 5.2 : cinématique d'arrivée selon le départ tiré
CinematicConfig.StartCinematic = { S1 = "CS_02a", S2 = "CS_02b", S3 = "CS_02c" }

-- TODO(BIBLE): texte du « message radio » entendu par les joueurs hors du rayon d'une cinématique de lieu (6.1)
CinematicConfig.OutOfRangeRadioText = nil

return CinematicConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">CreatureConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/CreatureConfig
-- Valeurs de la bible, section 9 (et 5.5 pour la présence). Ne rien ajouter ici sans la bible.
local CreatureConfig = {}

-- 9.2 : la famille. height en studs ; modèles dans ServerStorage/Creatures (16.1).
-- Modèle absent : capsule de la taille donnée (J10 : « capsule de 10 studs puis modèle »).
CreatureConfig.Family = {
	CRT_Alpha = { model = "CRT_Alpha", height = 10, health = 1000, presence = "Always", hearing = 1.0, role = "Hunter" },
	CRT_Scout1 = {
		model = "CRT_Scout",
		height = 8,
		health = 500,
		presence = "GroupSize",
		hearing = 1.2,
		role = "Scout",
	},
	CRT_Scout2 = {
		model = "CRT_Scout",
		height = 8,
		health = 500,
		presence = "GroupSize",
		hearing = 1.2,
		role = "Scout",
	},
	CRT_Female = { model = "CRT_Female", height = 9, health = 800, presence = "Tunnels", hearing = 1.0, role = "Guard" },
}
CreatureConfig.JuvenileBones = "Juvenile_Bones" -- os gardés par la femelle en P07b
CreatureConfig.LairPlace = "P07b"

-- 9.2 : régénération hors combat, jusqu'à 70 % du maximum
CreatureConfig.Regen = { PerSecond = 2, MaxFraction = 0.7 }
-- TODO(BIBLE): « hors combat » = combien de secondes sans dégâts ni attaque ? PROVISOIRE : 10 s (fenêtre de BHV_Retreat)
CreatureConfig.OutOfCombatAfter = 10

-- 9.2 : allures (studs/s) et bruit
CreatureConfig.Gaits = {
	Sneak = { speed = 6, noise = 8 },
	Walk = { speed = 10, noise = 30 },
	Run = { speed = 22, noise = 80 },
	Sprint = { speed = 30, duration = 6, recovery = 20 }, -- à quatre pattes
	Climb = { speed = 5 }, -- seulement entre deux ClimbPoint
}

-- 9.3 : architecture et fréquences (fois par seconde)
CreatureConfig.Rates = {
	Director = 1,
	Family = 2,
	Brain = 5,
	PerceptionNear = 10, -- à moins de 150 studs
	PerceptionFar = 2,
	PerceptionNearRange = 150,
}
-- 9.3 : simulation à distance
CreatureConfig.Simulation = {
	BodyRange = 600, -- aucun joueur à moins de 600 studs : plus de corps physique
	NodeSpacing = 200, -- CreatureNav : un nœud tous les 200 studs, plus un par lieu
}

-- 9.4 : perception
CreatureConfig.Vision = {
	RangeNight = 180,
	RangeDawn = 300,
	WeatherFactor = { Fog = 0.5, Rain = 0.7 },
	Cone = 120, -- degrés
	Peripheral = 200, -- jusqu'à 200° avec ×0,4
	PeripheralFactor = 0.4,
	GainRate = 1.5, -- +1,5 × (1 − d / Rv) × visibilité par seconde
	DecayRate = 0.1, -- −0,1 par seconde
	TurnHeadAt = 0.3,
	KnowsPositionAt = 0.7,
	TargetAt = 1.0,
}
CreatureConfig.Hearing = {
	Attenuation = { Rain = 0.6, Stream = 0.4, Waterfall = 0.2, CabinWalls = 0.7 },
	StreamRange = 30, -- à moins de 30 studs d'un ruisseau
	WaterfallPlace = "P13",
	CabinPlace = "P05c",
	PositionError = 0.1, -- l'endroit retenu est faux de 10 % de la distance
}
CreatureConfig.Smell = {
	Upwind = 80, -- le vent va du joueur vers elle
	Crosswind = 30,
	Downwind = 10,
	TrailSpacing = 4, -- un point de piste tous les 4 studs
	TrailLifetime = 300, -- actif 300 s ; la créature le suit au pas
}

-- 9.5 : comportements (durée min en s ; score fixe éventuel)
CreatureConfig.Behaviors = {
	BHV_Roam = { minDuration = 20, fixedScore = 0.2 },
	BHV_Feed = { minDuration = 40, hungerAbove = 0.7, hungerPerMinute = 0.01, places = { "P19" } },
	BHV_Mark = { baseScore = 0.3, minDuration = 15, branchHeight = 3 }, -- casse une branche à 3 m
	BHV_Observe = { baseScore = 0.5, minDuration = 30, minDistance = 40, maxDistance = 90, fleeIfApproached = 25 },
	BHV_Intimidate = { baseScore = 0.55, minDuration = 0 }, -- une marche de l'échelle
	BHV_Stalk = { baseScore = 0.45, minDuration = 45, minDistance = 50, maxDistance = 80 },
	BHV_Ambush = { baseScore = 0.4, maxDuration = 90, minDistance = 20, maxDistance = 30 },
	BHV_Attack = { baseScore = 0.9, minDuration = 0 },
	BHV_Throw = { baseScore = 0.5, minDuration = 20, minDistance = 20, maxDistance = 120 },
	BHV_Sabotage = { baseScore = 0.6, minDuration = 30, tightGroupFor = 120 },
	BHV_Drag = { baseScore = 0.8, reserves = { "P20", "P04", "P07b" } }, -- rive du lac, sous les troncs, repaire
	BHV_Retreat = { baseScore = 0.6, minDuration = 30, maxDuration = 60, healthLost = 0.15, window = 10 },
	BHV_Siege = { minRadius = 25, maxRadius = 40 },
	BHV_Guard = { range = 40 },
	BHV_Mimic = { baseScore = 0.5, minDuration = 10 },
	BHV_Avoid = { fireRange = 40 },
}
-- DÉFAUT d'interprétation : baseScore = score quand la condition de 9.5 est pleinement remplie
-- (la bible ne donne que des conditions) ; à régler en phase B3.
CreatureConfig.SwitchFactor = 1.25 -- garde le comportement sauf si un autre dépasse son score ×1,25
-- TODO(BIBLE): 9.1 : position des 3 « arbres à pierres » fixes. Sans eux, BHV_Mark utilise les Part
-- taguées « StoneTree » posées à la main.
CreatureConfig.StoneTreeTag = "StoneTree"

-- 9.6 : échelle d'intimidation (8 crans)
CreatureConfig.Intimidation = {
	Steps = {
		"FaunaSilence", -- 1. silence de la faune (60 studs)
		"WoodKnock", -- 2. coups sur un tronc
		"Call", -- 3. cri long à distance ou grognement proche
		"NearThrow", -- 4. branche ou pierre qui tombe à côté du joueur
		"BranchSnap", -- 5. branche cassée tout près, hors de vue
		"ChestBeat", -- 6. apparition debout, martellement (Alpha)
		"FakeCharge", -- 7. fausse charge
		"Attack", -- 8. vraie attaque
	},
	FaunaSilenceRadius = 60,
	StepWithin = 5 * 60, -- chaque cran attend le précédent (moins de 5 min avant)
	DecayEvery = 3 * 60, -- redescend d'un cran toutes les 3 min sans contact
	FakeChargeStopMin = 4,
	FakeChargeStopMax = 8,
	FakeChargeChance = 0.6, -- si le joueur ne fuit pas et n'éclaire pas
}

-- 9.7 : choix de la cible
CreatureConfig.Target = {
	Weights = { I = 3.0, B = 1.5, N = 1.0, L = 1.2, R = 2.0, P = 0.8, C = 0.5 },
	Interval = 2,
	IsolationDistance = 60,
	BleedBonus = 0.3,
	NoiseWindow = 10,
	NoiseDivisor = 100,
	LampOn = 1,
	TabletOpen = 0.5,
	GrudgeDamageDivisor = 200,
	GrudgePerFlare = 0.3,
	GrudgeFilmed = 0.5,
	GrudgeFilmedDistance = 30,
	TrackerShotFactor = 2,
	ProximityDistance = 300,
	SwitchMargin = 0.2, -- change seulement si un autre dépasse de 20 %
}

-- 9.8 : mémoire
CreatureConfig.Memory = {
	PathCell = 64,
	ShotsToAdapt = 2, -- 2 tirs reçus
	OpenGroundDistance = 60, -- reste à plus de 60 studs à découvert
	LitToAdapt = 3, -- éclairée 3 fois
	FlareFleeFirst = 8, -- fuite de 8 s…
	FlareFleeLater = 4, -- …réduite à 4 s à partir de la 2e fusée
	TightGroupRadius = 25,
	TightGroupFor = 120,
	-- TODO(BIBLE): « lance plus » après 2 tirs reçus : de combien ? PROVISOIRE : ×1,5
	ThrowMoreFactor = 1.5,
}
-- 9.8 : imitation (éclaireurs) — sons préenregistrés uniquement
CreatureConfig.MimicSounds = { "SFX_Whistle_01", "SFX_Whistle_02", "SFX_Whistle_03", "VO_<ROLE>_Hey", "VO_<ROLE>_Help" }

-- 9.8 : personnalité de l'Alpha (tirée à chaque partie)
CreatureConfig.Personalities = {
	Patient = { stalkDuration = 1.5, attackFrequency = 0.8, prefersIsolated = true },
	Territorial = { intimidation = 1.4, attackFrequency = 1.3, territoryPlace = "P05", territoryRadius = 800 },
	Playful = { mimic = 1.6, stones = 1.6, moreFakeCharges = true, noKillAct1 = true },
}
CreatureConfig.PersonalityOrder = { "Patient", "Territorial", "Playful" }

-- 9.9 : coordination
CreatureConfig.MaxVisiblePerPlayer = 2 -- jamais plus de 2 créatures visibles en même temps
CreatureConfig.AlphaInTunnelsFromAct = 4

-- 9.10 : attaques (signal en s avant les dégâts)
CreatureConfig.Attacks = {
	ATK_Strike = { range = 7, signal = 0.6, damage = 35, knockback = true, sound = "SFX_Growl_Close" },
	ATK_Charge = { minRange = 15, maxRange = 40, signal = 0.8, damage = 40, knockdown = 2, sound = "SFX_Call_Long" },
	ATK_Grab = { range = 6, signal = 0.4, damagePerSecond = 10, dragAfter = 3 },
	ATK_Throw = { minRange = 20, maxRange = 120, damageMin = 15, damageMax = 30, sound = "SFX_StoneWhoosh" },
	ATK_Slam = { range = 5, signal = 1.0, damage = 60 },
	ATK_ReachThrough = { range = 5, signal = 0.5 },
	ATK_Execution = { range = 3, signal = 1.5, profile = "Restricted", creature = "CRT_Alpha" },
}
-- TODO(BIBLE): vitesse d'une pierre lancée et force du recul de ATK_Strike. PROVISOIRE : 80 studs/s, 40.
CreatureConfig.StoneSpeed = 80
CreatureConfig.KnockbackForce = 40

-- 7.3 : la créature traîne un joueur à terre à 10 studs/s vers une réserve
CreatureConfig.DragSpeed = 10

-- 9.11 : déplacement
CreatureConfig.Path = {
	AgentRadius = 3,
	AgentHeight = 10,
	AgentCanJump = true,
	Costs = { Water = 5, Sand = 3, Pebble = 2, Rock = 2, Grass = 1, LeafyGrass = 0.8 },
	Modifiers = { Cover = 0.6, Trail = 1.5, Forbidden = 10, ForbiddenWhileHunting = 1 },
	ForbiddenPlace = "P08",
	DirectRange = 30, -- près de la cible : déplacement direct avec évitement par rayons
	ClimbTag = "ClimbPoint",
}

-- 9.12 : directeur de tension (voir DirectorConfig)

-- 8.1, 8.2 : effets des objets sur la créature
CreatureConfig.Repellents = {
	FlareKeepAway = 40, -- reste à plus de 40 studs sauf si enragée
	PowerLightBlind = 1, -- éblouie 1 s si elle fixe la lampe puissante à moins de 20 studs
	PowerLightRange = 20,
	BearSprayRecoil = 4, -- lâche sa prise et recule 4 s
	FlareGunFlee = 8,
}

-- Empreintes (EVT_05, 7.7 Pisteur, 8.4 moulage) : Part taguées « Footprint » (Decal_Footprint_Big, 13.5)
-- DÉFAUT (affichage) : une empreinte tous les 6 studs ; retirée après 300 s (12.3 : durée sous la neige)
CreatureConfig.Footprints = { Spacing = 6, Lifetime = 300, Size = Vector3.new(1.5, 0.05, 1.5) } -- 41 cm ≈ 1,5 stud (13.5)

-- DÉFAUT (technique et affichage) : capsule de remplacement, recalcul de chemin, cadences internes
CreatureConfig.Technical = {
	RepathDistance = 8, -- un nouveau chemin si le but bouge de plus de 8 studs
	CapsuleWidth = 3, -- AgentRadius (9.11)
	CapsuleColor = Color3.fromRGB(40, 34, 30),
	MimicCooldownFactor = 3, -- BHV_Mimic : 3 durées minimales entre deux imitations
	TabletBarDuration = 3, -- EVT_21 : la barre de réseau reste 3 s
	DragOffset = 0.25, -- BHV_Drag : le corps traîné derrière la créature (× sa taille)
}

-- 9.1 et 5.2 : se retire à l'aube (05 h 50)
CreatureConfig.DawnRetreatHour = 5 + 50 / 60

return CreatureConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="108">
        <Properties>
          <string name="Name">DirectorConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/DirectorConfig
-- Valeurs de la bible, sections 9.12 et 10. Ne rien ajouter ici sans la bible.
local DirectorConfig = {}

-- 9.12 : T = 0,5 × peur + 0,3 × (100 − santé moyenne) + 20 × e^(−t/30)
DirectorConfig.Tension = { FearWeight = 0.5, HealthWeight = 0.3, EventWeight = 20, EventDecay = 30, Max = 100 }

-- 9.12 : règles
DirectorConfig.Rise = { Below = 25, For = 120 } -- intensité < 25 pendant 120 s : un événement « bas »
DirectorConfig.Peak = { Above = 75, For = 90, PauseMin = 60, PauseMax = 90 } -- pause imposée
DirectorConfig.Act1 = { IsolatedDistance = 200, IsolatedFor = 60, GuaranteedSightings = 1, GuaranteedSigns = 2 }
DirectorConfig.Act2MaxDeaths = { Normal = 1, Hard = 2, Nightmare = math.huge }
DirectorConfig.Act3 = { MinAttackAttempts = 2, MaxDeathsPer = 1, Window = 3 * 60 }
DirectorConfig.Act4 = { AllCreatures = true, NoPause = true }

-- 10.1 : règles de mise en scène
DirectorConfig.Staging = {
	OutOfViewOrBeyond = 80, -- hors du champ de tous les joueurs, ou à plus de 80 studs
	PerPlayerInterval = 45, -- 1 événement au plus toutes les 45 s par joueur
	NoRepeatFor = 10 * 60, -- le même événement jamais deux fois en 10 min
	JumpMusicOncePerGame = true, -- seule exception : premier vrai contact de l'acte 2
}

-- 10.2 : catalogue (acts = actes où l'événement peut arriver ; asset = son ou modèle)
DirectorConfig.Events = {
	EVT_01 = {
		name = "La faune se tait d'un coup autour du joueur",
		acts = { 0, 4 },
		kind = "FaunaSilence",
		radius = 60,
	},
	EVT_02 = {
		name = "Trois coups sur un tronc au loin, puis trois de l'autre côté",
		acts = { 1, 3 },
		kind = "Sound",
		sounds = { "SFX_WoodKnock_01", "SFX_WoodKnock_06" },
		pair = true,
	},
	EVT_03 = {
		name = "Structure de branches entrelacées sur un sentier déjà pris",
		acts = { 1, 3 },
		kind = "Prop",
		props = { "Prop_StickStructure_A", "Prop_StickStructure_B", "Prop_StickStructure_C" },
		tag = "StickStructure",
	},
	EVT_04 = {
		name = "Tas de pierres au pied d'un arbre, plus haut qu'au passage précédent",
		acts = { 1, 3 },
		kind = "Prop",
		props = { "Prop_StonePile_A", "Prop_StonePile_B", "Prop_StonePile_C" },
	},
	EVT_05 = {
		name = "Empreintes fraîches autour du van ou des tentes",
		acts = { 1, 3 },
		kind = "Footprints",
		places = { "P01", "P09" },
		decal = "Decal_Footprint_Big",
	},
	EVT_06 = {
		name = "Bâtons enfoncés dans la toile d'une tente",
		acts = { 1, 1 },
		kind = "Prop",
		props = { "Prop_TentSticks" },
		places = { "P09" },
	},
	EVT_07 = {
		name = "Sifflement humain dans le noir",
		acts = { 1, 4 },
		kind = "Sound",
		sounds = { "SFX_Whistle_01", "SFX_Whistle_02", "SFX_Whistle_03" },
	},
	EVT_08 = { name = "Un « Hey ! » avec la voix d'un coéquipier", acts = { 2, 4 }, kind = "Mimic" },
	EVT_09 = {
		name = "Lampe abandonnée, allumée, sur le sentier, tournée vers la forêt",
		acts = { 1, 1 },
		kind = "Prop",
		props = { "Prop_DroppedFlashlight" },
		light = true,
	},
	EVT_10 = {
		name = "La porte du poste des rangers est ouverte, alors qu'elle était fermée",
		acts = { 1, 3 },
		kind = "Door",
		places = { "P17" },
		sounds = { "SFX_DoorCreak_02" },
	},
	EVT_11 = {
		name = "Une pierre tombe sur le toit du van",
		acts = { 0, 1 },
		kind = "Sound",
		sounds = { "SFX_StoneOnMetal_01" },
		places = { "P01" },
	},
	EVT_12 = {
		name = "Odeur forte (vignettage vert très léger, réplique « Vous sentez ça ? »)",
		acts = { 1, 4 },
		kind = "Smell",
		voice = "VO_<ROLE>_Smell",
	},
	EVT_13 = {
		name = "Deux yeux reflètent la lampe à 60 studs, puis disparaissent",
		acts = { 1, 3 },
		kind = "EyeShine",
		distance = 60,
		effect = "FX_EyeShine",
		duration = 4,
	},
	EVT_14 = {
		name = "Respiration lente sur le canal radio",
		acts = { 2, 4 },
		kind = "Radio",
		sounds = { "SFX_RadioBreath_01" },
	},
	EVT_15 = {
		name = "Le corps de Leah Brandt a bougé entre deux passages",
		acts = { 1, 3 },
		kind = "MoveBody",
		zone = "B6",
	},
	EVT_16 = {
		name = "Arbre cassé net à 3 m de haut, cassure fraîche",
		acts = { 1, 4 },
		kind = "Prop",
		props = { "Prop_SnappedTree_A" },
	},
	EVT_17 = {
		name = "Des pas qui s'arrêtent une demi-seconde après ceux du joueur",
		acts = { 1, 3 },
		kind = "EchoSteps",
		sounds = { "SFX_Steps_Heavy_Delay" },
		delay = 0.5,
	},
	EVT_18 = {
		name = "Un cri long au loin, auquel un autre répond à l'opposé",
		acts = { 1, 4 },
		kind = "Sound",
		sounds = { "SFX_Call_Long_01", "SFX_Call_Long_04" },
		pair = true,
	},
	EVT_19 = { name = "Les objets d'un sac posé sont alignés à côté", acts = { 2, 4 }, kind = "AlignBag" },
	EVT_20 = {
		name = "Un caillou tombe dans l'eau à côté du joueur",
		acts = { 1, 4 },
		kind = "Sound",
		sounds = { "SFX_Splash_Small" },
		nearWater = true,
	},
	EVT_21 = { name = "La tablette affiche une barre de réseau, puis plus rien", acts = { 1, 3 }, kind = "TabletBar" },
	EVT_22 = {
		name = "Une silhouette debout sur les troncs flottants du lac",
		acts = { 1, 3 },
		kind = "Silhouette",
		places = { "P20" },
		duration = 4,
	},
}
-- 10 : le directeur tire les événements du catalogue « bas »
-- TODO(BIBLE): quels événements forment le catalogue « bas » ? PROVISOIRE : tous ceux de 10.2.
DirectorConfig.LowCatalog = nil
-- TODO(BIBLE): distance d'un « au loin » (coups, cris) et d'un « tout près » (pas en écho, caillou). PROVISOIRE : 150 et 15 studs.
DirectorConfig.FarDistance = 150
DirectorConfig.NearDistance = 15

-- 10.3 : ce que le joueur ne doit jamais avoir (rappel, appliqué par le code)
DirectorConfig.Never = { "DangerGauge", "CreatureArrow", "SourcelessCreatureSound", "DeathWithoutSignal" }

return DirectorConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">GoreConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/GoreConfig
-- Valeurs de la bible, section 11. Ne rien ajouter ici sans la bible.
-- Jalon J6 : seulement le ragdoll de la mort (7.3, 11.5). Les deux profils sont ajoutés au jalon J13.
local GoreConfig = {}

-- 11.5 : ragdoll : BallSocketConstraint sur les articulations à la mort ;
-- le corps passe ancré après 10 s immobile, pour économiser la physique
GoreConfig.Ragdoll = { AnchorAfterStill = 10 }

return GoreConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">ItemConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/ItemConfig
-- Valeurs de la bible, sections 8 (intro), 8.1, 8.3 et 8.4. Ne rien ajouter ici sans la bible.
local ItemConfig = {}

-- 8 : inventaire
ItemConfig.QuickSlots = 4 -- 3 pour la Mécanicienne (PlayerConfig.Abilities.Mechanic)
ItemConfig.BagMaxWeight = 12 -- kg
ItemConfig.HeavyAbove = 5 -- kg : à deux mains, pas de course, pas d'arme

-- 16.3 : RE_PickupItem, distance ≤ 10 studs
ItemConfig.PickupDistance = 10

-- 8.1 : objets. weight en kg ; stack = pile ; uses = usages ; noise = rayon (studs)
-- duration = durée d'utilisation (s). Les effets sont appliqués par InventoryService.
ItemConfig.Items = {
	ITM_Flashlight = {
		name = "Lampe torche",
		weight = 0.4,
		stack = 1,
		noise = 8,
		light = { angle = 45, range = 120, batteryMinutes = 8, flickerBelow = 0.15 },
	},
	ITM_Headlamp = {
		name = "Lampe frontale",
		weight = 0.2,
		stack = 1,
		noise = 8,
		light = { angle = 45, range = 70, batteryMinutes = 10, handsFree = true, flickerBelow = 0.15 },
	},
	ITM_PowerLight = {
		name = "Lampe puissante",
		weight = 0.8,
		stack = 1,
		noise = 8,
		light = { angle = 45, range = 220, batteryMinutes = 6, flickerBelow = 0.15, blindDuration = 1, blindRange = 20 },
	},
	ITM_Battery = { name = "Pile", weight = 0.1, stack = 6, duration = 3, effect = "RechargeLight" },
	ITM_Bandage = { name = "Bandage", weight = 0.1, stack = 5, duration = 4, noise = 10, effect = "Bandage", heal = 10 },
	ITM_Splint = { name = "Attelle", weight = 0.3, stack = 2, duration = 6, noise = 10, effect = "Splint" },
	ITM_Medkit = {
		name = "Trousse complète",
		weight = 1.5,
		stack = 1,
		uses = 5,
		duration = 8,
		noise = 10,
		effect = "Medkit",
		heal = 40,
	},
	ITM_Flare = {
		name = "Fusée à main",
		weight = 0.3,
		stack = 3,
		noise = 300,
		effect = "Flare",
		burn = 60,
		lightRadius = 60,
		fearPerSecond = -3,
		creatureKeepAway = 40,
	},
	ITM_Matches = {
		name = "Allumettes",
		weight = 0.05,
		stack = 1,
		noise = 20,
		effect = "Campfire",
		branchesNeeded = 3,
		burn = 180,
		visibleRange = 800,
	},
	ITM_Branch = { name = "Branche morte", weight = 0.5, stack = 3, breakNoise = 45, throwable = true },
	ITM_Stone = { name = "Pierre", weight = 0.3, stack = 3, impactNoise = 50, throwable = true },
	ITM_Rope = { name = "Corde", weight = 1.0, stack = 1 },
	ITM_Plank = { name = "Planche", weight = 2.0, stack = 1, nailNoise = 120 },
	ITM_BearSpray = {
		name = "Bombe anti-ours",
		weight = 0.4,
		stack = 1,
		uses = 3,
		noise = 40,
		effect = "BearSpray",
		cone = 6,
		creatureRecoil = 4,
	},
	ITM_ToolBox = { name = "Caisse à outils", weight = 3.0, stack = 1, openNoise = 30, withoutFactor = 2 },
	ITM_Compass = { name = "Boussole", weight = 0.1, stack = 1 },
	ITM_RadioScanner = { name = "Scanner radio", weight = 0.6, stack = 1, noise = 15 },
	ITM_Walkie = { name = "Talkie-walkie", weight = 0.3, stack = 1, beepNoise = 20, range = 1500 },
	ITM_TinCan = { name = "Boîte de conserve", weight = 0.1, stack = 3 },
	ITM_DuctTape = { name = "Ruban", weight = 0.1, stack = 3 },
	ITM_Notebook = { name = "Carnet Halvorsen", weight = 0.2, stack = 1, document = "DOC_12" },
	ITM_Keys = { name = "Clés du van", weight = 0.1, stack = 1 },
	ITM_Jack = { name = "Cric", weight = 4.0, stack = 1 },
	ITM_CoaxCable = { name = "Câble d'antenne", weight = 1.0, stack = 1 },
	ITM_CarBattery = { name = "Batterie de voiture", weight = 8.0, stack = 1, dropNoise = 30, twoHands = true },
	ITM_Jerrycan = { name = "Jerrican", weight = 6.0, stack = 1, noise = 15, twoHands = true },
	ITM_StarterRelay = { name = "Relais de démarreur", weight = 0.5, stack = 1 },
	ITM_PlasterKit = {
		name = "Kit de moulage",
		weight = 1.2,
		stack = 1,
		uses = 2,
		duration = 30,
		noise = 10,
		effect = "PlasterCast",
	},
	ITM_AudioRecorder = { name = "Enregistreur", weight = 0.3, stack = 1, effect = "RecordCall", range = 150 },
	ITM_SampleBag = { name = "Sachet à échantillon", weight = 0.05, stack = 3, effect = "CollectHair" },
	ITM_Camcorder = {
		name = "Caméscope vision nocturne",
		weight = 0.9,
		stack = 1,
		noise = 10,
		effect = "Film",
		recordMinutes = 6,
		nightVision = true,
	},
	ITM_PhotoCamera = {
		name = "Appareil photo",
		weight = 0.5,
		stack = 1,
		uses = 12,
		noise = 15,
		effect = "Photo",
		flashLightFactor = 3,
		flashDuration = 0.2,
	},
	ITM_TabletField = { name = "Tablette de terrain", weight = 0.7, stack = 1, effect = "Tablet" },
	ITM_TabletGeo = { name = "Tablette des géologues", weight = 0.7, stack = 1, documents = { "DOC_07", "DOC_08" } },
	-- 8.4 : carte mémoire créée après une vidéo de classe A = preuve A
	ITM_SDCard = { name = "Carte mémoire", weight = 0, stack = 1, evidence = { class = "A", kind = "Video" } },
	-- 8.4 : preuves B et C (objets d'inventaire ; noms du tableau 8.4)
	EVD_Cast = { name = "Moulage d'empreinte", weight = 0, stack = 1, evidence = { class = "B", kind = "Cast" } },
	EVD_Call = { name = "Enregistrement d'un cri", weight = 0, stack = 1, evidence = { class = "B", kind = "Call" } },
	EVD_Hair = { name = "Poils", weight = 0, stack = 1, evidence = { class = "B", kind = "Hair" } },
	EVD_PhotoCreature = {
		name = "Photo de la créature",
		weight = 0,
		stack = 1,
		evidence = { class = "B", kind = "Photo" },
	},
	EVD_Document = { name = "Document", weight = 0, stack = 1, evidence = { class = "C", kind = "Document" } },
	EVD_PhotoCharnier = {
		name = "Photo du charnier P19",
		weight = 0,
		stack = 1,
		evidence = { class = "C", kind = "PhotoP19" },
	},
	-- 3.4 et 8.2 : munitions de réserve (boîte A1–A5)
	AMMO_WPN_Rifle = { name = "Balles de fusil", weight = 0, stack = 99, ammoFor = "WPN_Rifle" },
	AMMO_WPN_Revolver = { name = "Balles de revolver", weight = 0, stack = 99, ammoFor = "WPN_Revolver" },
	AMMO_WPN_Shotgun = { name = "Cartouches", weight = 0, stack = 99, ammoFor = "WPN_Shotgun" },
}
-- TODO(BIBLE): poids des preuves (carte mémoire, moulage, etc.) et des munitions. PROVISOIRE : 0 kg.
-- DÉFAUT : pile de 99 munitions (valeur technique de rangement).

-- 8.1, colonne « Où » : objets de départ par rôle (quantité = nombre d'unités)
ItemConfig.StartingItems = {
	All = { ITM_Walkie = 1, ITM_Bandage = 2 },
	-- lampe torche : tous sauf Descendante et Géologue
	Flashlight = { item = "ITM_Flashlight", exceptRoles = { Descendant = true, Geologist = true } },
	Roles = {
		Leader = { ITM_TabletField = 1 },
		Medic = { ITM_Medkit = 1 },
		Tracker = { ITM_PlasterKit = 1 },
		Cameraman = { ITM_Camcorder = 1 },
		Mechanic = { ITM_ToolBox = 1 },
		Descendant = { ITM_Headlamp = 1, ITM_Notebook = 1 },
		Geologist = { ITM_PowerLight = 1, ITM_Compass = 1 },
		RadioOperator = { ITM_RadioScanner = 1, ITM_AudioRecorder = 1 },
		-- TODO(BIBLE): combien de fusées à main pour le Pyrotechnicien au départ ? (1 en attendant)
		Pyrotechnician = { ITM_Flare = 1 },
	},
}

-- 8.3 : tablette de terrain
ItemConfig.Tablet = {
	BatteryMinutes = 30, -- d'écran allumé pour la nuit
	VisibilityFactor = 1.5,
	GpsError = 30, -- ±30 studs
	GpsInterval = 10,
	DenseForestNoSignalChance = 0.5,
	MaxMarkers = 8,
	-- Réseau : une barre au sommet de P11 et à P23
	NetworkPlaces = { "P11", "P23" },
}

-- 8.4 : preuves (XP dans ProgressionConfig.XPGains)
ItemConfig.Evidence = {
	VideoA = { minVisibleFraction = 0.6, maxDistance = 30, minDuration = 2 },
	PlasterB = { footprintMaxAge = 120, workTime = 30 },
	CallB = { maxDistance = 150 },
	HairB = { places = { "StickStructure", "P05" } }, -- structure de branches ou bord d'Ape Canyon
	PhotoB = { maxDistance = 40 },
	DocumentC = { "DOC_03", "DOC_04", "DOC_05", "DOC_06", "DOC_07", "DOC_08", "DOC_09", "DOC_10" },
	PhotoC = { place = "P19" }, -- photo du charnier
}

-- 13.5 : icônes Icon_<ID> (assets/ui/png). Identifiants rbxassetid à renseigner après import dans Studio.
-- DÉFAUT : chaîne vide = pas d'icône affichée.
ItemConfig.Icons = {}

-- DÉFAUT (technique) : bloc gris MANQUANT_ et pose au sol
ItemConfig.PlaceholderSize = Vector3.new(1, 1, 1)
ItemConfig.PlaceholderColor = Color3.fromRGB(128, 128, 128)
ItemConfig.SpawnLift = 0.5
ItemConfig.ClueItemSpacing = 1.5 -- écart entre deux objets posés sur le même point
ItemConfig.DocumentOffset = Vector3.new(0, 0, 3) -- document posé à côté du centre du lieu
-- DÉFAUT (affichage) : fusée et feu de camp posés au sol
ItemConfig.FireVisuals = {
	Size = Vector3.new(0.4, 0.4, 0.4),
	FlareColor = Color3.fromRGB(255, 40, 30),
	CampfireColor = Color3.fromRGB(255, 150, 60),
	GroundOffset = 2.5, -- sous le HumanoidRootPart
	CampfireAhead = 3, -- devant le joueur
}

-- TODO(BIBLE): distance et vitesse d'un lancer (pierre, branche). PROVISOIRE : 40 studs/s, 1 s de vol.
ItemConfig.Throw = { Speed = 40, Flight = 1 }
-- TODO(BIBLE): bruit du piège à bruit du Pyrotechnicien (boîte de conserve + corde). Sans valeur : pas de piège.
ItemConfig.NoiseTrapRadius = nil

-- 13.3 : modèles d'objets dans ReplicatedStorage/Items (Item_<Nom>) ; absent → bloc gris MANQUANT_<ID>
ItemConfig.ModelsFolder = "Items"

return ItemConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="111">
        <Properties>
          <string name="Name">LaunchConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/LaunchConfig
-- Groupe, lancement et téléportation Lobby ↔ Partie : bible, sections 4.4, 16.1, 16.3 et 16.4.
-- Ne rien ajouter ici sans la bible.
local LaunchConfig = {}

-- 16.4 : expérience « PISTE FROIDE (test) » (relevés le 22 octobre 2026 ;
-- à reconfirmer dans le Creator Dashboard si l'expérience a été recréée)
LaunchConfig.PlaceIds = {
	Lobby = 77677833738174,
	Partie = 103506696801797,
}

-- 4.4 : groupe
LaunchConfig.Party = {
	MinSize = 1, -- capacité 1 à 10
	MaxSize = 10,
	PrivateCodeDigits = 4, -- groupe privé : code à 4 chiffres
	ReadyCountdown = 10, -- tous « Prêt » → compte à rebours de 10 s
}

-- 16.4 : MemoryStore
LaunchConfig.MemoryStore = {
	-- « Parties » : carte triée des groupes du lobby, durée de vie 900 s
	PartiesMapName = "Parties",
	PartiesTTL = 900,
	-- limite de l'API Roblox (MemoryStoreSortedMap:GetRangeAsync lit 200 entrées au plus)
	PartiesScanCount = 200,
	-- « Launch_<PrivateServerId> » : configuration de partie lue par la Partie, durée de vie 600 s
	LaunchMapName = "Launch", -- DÉFAUT : carte de hachage qui contient les clés Launch_
	LaunchKeyPrefix = "Launch_",
	LaunchTTL = 600,
	-- valeurs techniques acceptées le 4 novembre 2026 (16.4) : essais et délai (s) par appel MemoryStore
	Attempts = 3,
	RetryDelay = 2,
}

-- DÉFAUT (valeurs techniques) : essais et délai (s) d'une téléportation ratée
-- (départ : MSG_TeleportRetry puis MSG_TeleportAbort, 4.6 ; retour au Lobby)
LaunchConfig.Teleport = {
	Attempts = 3,
	RetryDelay = 5,
}

-- 4.4 et 5.4 : votes. Sans vote : Normal, météo aléatoire. Égalité : la difficulté la plus basse
-- l'emporte ; pour la météo, aléatoire.
LaunchConfig.Votes = {
	Difficulties = { "Normal", "Hard", "Nightmare" }, -- de la plus basse à la plus haute
	Weathers = { "Random", "Clear", "Fog", "Rain", "Snow" }, -- « Random » = tirage de 12.3
	DefaultDifficulty = "Normal",
	DefaultWeather = "Random",
	TieWeather = "Random",
}

-- 16.2 : PartyLoaderService attend les joueurs 60 s au plus
LaunchConfig.ArrivalTimeout = 60

-- 16.3 : toutes les remotes client → serveur sont limitées à 10 appels par seconde ;
-- RE_Ping : 1 toutes les 2 s
LaunchConfig.RateLimits = {
	Default = { calls = 10, per = 1 },
	RE_Ping = { calls = 1, per = 2 },
}

return LaunchConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="112">
        <Properties>
          <string name="Name">LoreConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/LoreConfig
-- Textes de la bible : documents DOC_xx (2.7), panneaux M1-M8 (4.3), dialogues (4.2),
-- messages système (4.6). Claude Code recopie ces textes, il n'en rédige pas d'autre (section 2).
-- Les documents sont recopiés au jalon J7, le musée et les dialogues au jalon J14.
local LoreConfig = {}

-- 4.6 : messages système, affichés par NotificationGui.
-- Le serveur envoie la clé avec RE_Notify ; {player} et {n} sont remplacés par le code.
LoreConfig.Messages = {
	MSG_PartyFull = "Ce groupe est complet (10 joueurs).",
	MSG_CodeInvalid = "Aucun groupe ne correspond à ce code.",
	MSG_QuickJoinNone = "Aucun groupe public disponible. Crée le tien.",
	MSG_PartyLeft = "Tu as quitté le groupe.",
	MSG_HostLeft = "Le créateur du groupe est parti. {player} prend sa place.",
	MSG_RoleTaken = "Ce rôle est déjà pris par {player}.",
	MSG_RoleRequired = "Choisis un rôle avant d'être prêt.",
	MSG_WeaponTaken = "Cette arme est déjà attribuée à {player}.",
	MSG_WeaponNotAllowed = "L'opératrice radio ne peut pas porter d'arme à feu.",
	MSG_WeaponVote = "Deux joueurs veulent la même arme. Votez : 15 secondes.",
	MSG_NightmareLocked = "Cauchemar se débloque après une première survie.",
	MSG_WaitingReady = "En attente : {n} joueur(s) pas encore prêt(s).",
	MSG_Countdown = "Départ dans {n} s.",
	MSG_CountdownCancelled = "Départ annulé : un joueur n'est plus prêt.",
	MSG_Teleporting = "En route vers la forêt…",
	MSG_TeleportRetry = "Le départ a échoué. Nouvel essai…",
	MSG_TeleportAbort = "Impossible de partir pour l'instant. Réessayez dans un moment.",
	MSG_WaitingPlayers = "En attente des autres membres du groupe…",
	MSG_PlayerMissing = "{player} n'a pas rejoint la forêt.",
	MSG_VersionMismatch = "Une mise à jour est en cours. Retour en ville.",
	MSG_ReturnToLobby = "Retour en ville…",
	MSG_DataLoadFailed = "Ta progression n'a pas pu être chargée. Elle ne sera pas sauvegardée pendant cette session.",
	MSG_LaunchConfigMissing = "La partie n'a pas pu être préparée. Retour en ville.",
}

-- 15.6 : textes d'interface remplis par les scripts ({player} remplacé par le code)
LoreConfig.UI = {
	TakenBy = "Pris par {player}",
	Watching = "Tu regardes {player}",
	Lock = "Verrouillé",
}

-- 2.7 : documents trouvables (texte définitif). title = colonne « Type » ; body = texte affiché.
-- kind : "Paper" (papier), "Tape" (cassette / audio), "Image" (image + légende), "Video", "Map".
-- image / audio : assets à créer (13.5, 13.7), vides en attendant.
LoreConfig.Documents = {
	DOC_01 = {
		title = "Avis de recherche",
		kind = "Paper",
		body = "DISPARUS depuis le 7 octobre : Dr A. Whitcombe, S. Ito, B. Castillo, L. Brandt. Recherches suspendues. Toute information : Skamania County Sheriff.",
	},
	DOC_02 = {
		title = "Permis de recherche",
		kind = "Paper",
		body = "Pacific Cascades University — relevé géophysique des tubes de lave, secteur sud. Autorisation 30 jours. Interdiction d'entrer dans la zone fermée.",
	},
	DOC_03 = {
		title = "Cassette 1 (Ito)",
		kind = "Tape",
		body = "Jour 9. Encore des cailloux sur la bâche cette nuit. Alan dit que c'est le vent. Le vent ne vise pas.",
	},
	DOC_04 = {
		title = "Carnet de terrain (Castillo)",
		kind = "Paper",
		body = "Trois coups sur un tronc, au nord. Puis trois coups au sud. Ils se répondent.",
	},
	DOC_05 = {
		title = "Cassette 2 (Whitcombe)",
		kind = "Tape",
		body = "Il était petit. Il s'est approché du camp. J'ai tiré. Personne ne doit savoir. On part dans deux jours.",
	},
	DOC_06 = {
		title = "Photo d'empreinte",
		kind = "Image",
		body = "41 cm. Deux tailles différentes sur la même piste.",
		image = "Img_DOC06",
	},
	DOC_07 = { title = "Carte des tunnels", kind = "Map", body = "", image = "Img_TabletMap_Tunnels", unlocks = "E4" },
	DOC_08 = { title = "Vidéo de la tablette", kind = "Video", body = "", cinematic = "CS_05" },
	DOC_09 = {
		title = "Message radio (Ito)",
		kind = "Tape",
		body = "Ici Ito, tour de guet. Alan est descendu. Il dit qu'il va leur rendre. Si quelqu'un entend… ne dormez pas près de l'eau.",
	},
	DOC_10 = {
		title = "Dernier carnet (Ito)",
		kind = "Paper",
		body = "Ils ne mangent pas les morts tout de suite. Ils les rangent. Comme des réserves. Ou comme des avertissements.",
	},
	-- DOC_11 : résumé de l'enquête au musée (texte du panneau M2, 4.3) — rempli au jalon J14
	DOC_12 = {
		title = "Carnet de la famille Halvorsen",
		kind = "Paper",
		pages = {
			"Il n'a jamais voulu en parler. Il disait seulement : ne tire pas le premier.",
			"Ils frappaient les arbres avant les pierres.", -- débloquée au siège
			"On leur avait pris quelqu'un, à eux aussi.", -- fin « La vérité »
		},
	},
	DOC_13 = {
		title = "Note du ranger Hollis",
		kind = "Paper",
		body = "Zone fermée. Officiellement le sol. Officieusement, on retrouve des wapitis sans tête. Ne restez pas après la nuit tombée.",
	},
	DOC_14 = { title = "Enregistrement météo", kind = "Tape", body = "", audio = "SFX_Call_Long_01" }, -- 40 s de vent, puis un cri long
	DOC_15 = {
		title = "Panneau « Sasquatch Refuge »",
		kind = "Sign",
		body = "SKAMANIA COUNTY — SASQUATCH REFUGE — Ord. 69-01",
	},
	DOC_16 = { title = "Photo de groupe des géologues", kind = "Image", body = "", image = "Img_DOC16" },
}

-- 8.3 : tablette, appli Réseau
LoreConfig.Tablet = {
	NoNetwork = "Aucun réseau",
	NoGps = "Pas de signal GPS",
	HollisReply = "Restez groupés. Personne ne monte avant l'aube.",
}

-- Textes des invites ProximityPrompt (InteractGui > ActionText).
-- 15.6 : libellés courts absents du tableau → proposition de Claude Code, marquée DÉFAUT.
LoreConfig.Prompts = {
	Pickup = "Ramasser", -- DÉFAUT
	Revive = "Relever", -- DÉFAUT (7.3 : « Relever »)
	Barricade = "Barricader", -- DÉFAUT (5.2 : « Barricader 3 ouvertures »)
	Repair = "Réparer", -- DÉFAUT (5.2 : « réparer »)
	ChangeWheel = "Changer la roue", -- DÉFAUT (5.2 : « changer la roue lacérée »)
	Call = "Appeler", -- DÉFAUT (5.2 : « appel »)
	Drive = "Conduire", -- DÉFAUT (5.2 : « conduire »)
	ClearPlug = "Dégager le bouchon", -- DÉFAUT (5.2)
	Read = "Lire", -- 15.6 (Play : Lire)
	Open = "Ouvrir", -- DÉFAUT (sac d'un mort)
}

-- 5.3 : fins (titres de la colonne « Fin » ; texte : colonne « Récompense » quand elle est rédigée)
-- TODO(BIBLE): textes de fin affichés dans ResultsGui > EndingText (seul « Silence » en a un)
LoreConfig.Endings = {
	Survie = { title = "Survie", text = "" },
	Preuve = { title = "Preuve", text = "" },
	Verite = { title = "La vérité", text = "" },
	Ordonnance = { title = "Ordonnance 69-01", text = "" },
	Silence = { title = "Silence", text = "Le podcast est publié… incomplet" },
}

-- 15.6 : libellés courts absents du tableau → DÉFAUT (statuts de ResultsGui > Survivors)
LoreConfig.Status = {
	Extracted = "Extrait", -- DÉFAUT
	Dead = "Mort", -- DÉFAUT
	Missing = "Disparu", -- 5.1 : « disparus »
}

-- 15.6 : astuces de LoadingGui > Tip, tirées au hasard
LoreConfig.LoadingTips = {
	"Une lampe allumée se voit de très loin.",
	"Le bruit de l'eau couvre tes pas.",
	"Seul, tu es discret. Seul, tu es une proie.",
}

return LoreConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="113">
        <Properties>
          <string name="Name">MapConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/MapConfig
-- Toutes les positions viennent de la section 3 de la bible. Ne rien ajouter ici sans la bible.
-- Repère (3.1) : X vers l'est, Z vers le sud (nord = −Z), Y = altitude du sol.
local MapConfig = {}

-- 3.1 : zone jouable et bande décorative
MapConfig.Size = 8000
MapConfig.PlayableHalf = 4000
MapConfig.DecorHalf = 4600
MapConfig.WarnHalf = 3900 -- message « Tu t'éloignes trop du groupe »
MapConfig.WarnText = "Tu t'éloignes trop du groupe" -- 3.8
MapConfig.HighestPlayableY = 560

-- 3.2 : lieux. pos = (X, Y du sol, Z) ; radius en studs.
-- Pour les zones et couloirs : from / to (X, Z), Y bas → haut.
MapConfig.Places = {
	P01 = { name = "Parking du sentier d'Ape Canyon", pos = Vector3.new(2800, 120, 3200), radius = 60 },
	P02 = {
		name = "Coulée de lahar",
		corridor = { from = Vector2.new(1800, -1500), to = Vector2.new(2400, 3600), width = 600 },
		yLow = 110,
		yHigh = 380,
	},
	P03 = {
		name = "Lava Canyon (fond de gorge)",
		pos = Vector3.new(3200, 40, 2200),
		radius = 120,
		rimY = 110,
		floorY = 40,
	},
	P04 = {
		name = "Forêt ancienne",
		zone = { minX = 507, maxX = 1800, minZ = -507, maxZ = 2507 },
		yLow = 150,
		yHigh = 330,
	},
	P05 = { name = "Ape Canyon", pos = Vector3.new(2600, 250, -1400), radius = 300, rimY = 400, floorY = 250 },
	P05c = { name = "Ruine de la cabane de 1924", pos = Vector3.new(2550, 300, -1300), radius = 25 },
	P05s = { name = "« Étroit » du canyon", pos = Vector3.new(2700, 330, -1650), width = 9 },
	P06 = { name = "Plateau de cendres", pos = Vector3.new(1200, 480, -2600), radius = 900 },
	P07a = { name = "Ape Cave, entrée principale", pos = Vector3.new(-2507, 60, 2400), radius = 20, tubeY = 5 },
	P07b = { name = "Salle du repaire", pos = Vector3.new(-2900, 30, 1700), radius = 45, underground = true },
	P07c = { name = "Sortie basse bouchée par le lahar", pos = Vector3.new(-2300, 20, 3600), radius = 6 },
	P08 = {
		name = "Zone interdite (forêt soufflée)",
		zone = { minX = -3707, maxX = -507, minZ = -3707, maxZ = -800 },
		yLow = 300,
		yHigh = 430,
	},
	P09 = { name = "Camp des géologues", pos = Vector3.new(-800, 230, 600), radius = 50 },
	P10 = { name = "Chantier forestier abandonné", pos = Vector3.new(-1400, 70, 3307), radius = 80 },
	P11 = { name = "Tour de guet centrale", pos = Vector3.new(0, 420, -1600), radius = 15, cabinOffset = 60 },
	P12 = { name = "Prairie et clairières", pos = Vector3.new(-2200, 200, 200), radius = 350 },
	P13 = { name = "Cascade et bassin", pos = Vector3.new(-1800, 150, 1200), radius = 40, topY = 210, poolY = 150 },
	P14 = { name = "Volcan (décor)", pos = Vector3.new(-500, 2600, -10000), outOfBounds = true },
	P15 = { name = "Mine abandonnée", pos = Vector3.new(3333, 390, -667), radius = 30 },
	P16 = {
		name = "Pont sur le ruisseau de Lava Canyon",
		pos = Vector3.new(3467, 150, 1600),
		length = 30,
		waterY = 100,
	},
	P17 = { name = "Poste des rangers fermé", pos = Vector3.new(800, 110, 3067), radius = 25 },
	P18 = { name = "Barrière de la zone interdite", pos = Vector3.new(-400, 300, -667), radius = 10 },
	P19 = { name = "Charnier de wapitis", pos = Vector3.new(-2933, 380, -2667), radius = 40 },
	P20 = { name = "Lac aux troncs flottants", pos = Vector3.new(-1667, 330, -1733), ellipse = Vector2.new(600, 320) },
	P21 = { name = "Tunnel effondré (puits)", pos = Vector3.new(-3200, 140, 933), radius = 15, tubeY = 85 },
	P22 = { name = "Épave de voiture", pos = Vector3.new(533, 100, 3733), radius = 10 },
	P23 = { name = "Station météo", pos = Vector3.new(2400, 560, -3467), radius = 12 },
	P24 = { name = "Tour est", pos = Vector3.new(3800, 300, 667), radius = 12, cabinOffset = 60 },
	P25 = { name = "Tour nord", pos = Vector3.new(-200, 470, -3067), radius = 12, cabinOffset = 60 },
	P26 = { name = "Tour ouest", pos = Vector3.new(-3600, 260, -667), radius = 12, cabinOffset = 60 },
	F01 = {
		name = "Falaise de la Crête",
		line = { fromX = -507, toX = 1800, z = -800 },
		height = 40,
		passMinX = -100,
		passMaxX = 100,
	},
}

-- 3.3 : départs (10 points espacés de 6 studs autour de S1)
MapConfig.Spawns = {
	S1 = Vector3.new(2780, 120, 3220),
	S2 = Vector3.new(-1380, 70, 3290),
	S3 = Vector3.new(-820, 230, 640),
}
MapConfig.SpawnPointCount = 10
MapConfig.SpawnPointSpacing = 6

-- 3.3 : extractions
MapConfig.Extractions = {
	E1 = { name = "Extraction van", pos = Vector3.new(2800, 120, 3200), exitX = 4000 },
	E2 = { name = "Extraction hélicoptère", pos = Vector3.new(-150, 425, -1750), area = Vector2.new(60, 60) },
	E3 = { name = "Extraction bulldozer", pos = Vector3.new(-1400, 70, 3950) }, -- barrière
	E4 = { name = "Extraction tunnels", place = "P07c" },
}

-- 3.3 : zones de la créature
MapConfig.CreatureZones = {
	B1 = { name = "Siège", places = { "P05" } },
	B2 = { name = "Repaire", places = { "P07a", "P07b", "P07c" } },
	B3 = { name = "Chasse", places = { "P08" } },
	B4 = { name = "Traque", places = { "P04" } },
	B5 = { name = "Embuscade", places = { "P02" } },
	B6 = { name = "Mise en scène", places = { "P09" } },
}

-- 3.4 : points tirés au hasard (6 points d'indice sur 12)
MapConfig.CluePointsDrawn = 6
MapConfig.CluePoints = {
	C01 = { name = "Camp, tente nord", pos = Vector3.new(-780, 232, 560), contents = { "DOC_03", "DOC_04" } },
	C02 = { name = "Camp, glacière", pos = Vector3.new(-840, 230, 640), contents = { "DOC_03", "DOC_04" } },
	C03 = { name = "Prairie, souche", pos = Vector3.new(-2150, 200, 260), contents = { "DOC_03", "DOC_04", "DOC_06" } },
	C04 = { name = "Cascade, rocher", pos = Vector3.new(-1760, 152, 1240), contents = { "DOC_03", "DOC_04", "DOC_06" } },
	C05 = {
		name = "Forêt, arbre creux",
		pos = Vector3.new(1100, 240, 900),
		contents = { "DOC_04", "DOC_05", "DOC_06" },
	},
	C06 = {
		name = "Épave, boîte à gants",
		pos = Vector3.new(533, 100, 3733),
		contents = { "DOC_04", "DOC_05", "DOC_06" },
	},
	C07 = { name = "Poste des rangers, bureau", pos = Vector3.new(800, 112, 3067), contents = { "DOC_05", "DOC_06" } },
	C08 = { name = "Mine, entrée", pos = Vector3.new(3300, 390, -640), contents = { "DOC_05", "DOC_06" } },
	C09 = {
		name = "Pied de la tour P11",
		pos = Vector3.new(20, 420, -1580),
		contents = { "ITM_Battery", "ITM_Bandage" },
	},
	C10 = { name = "Lahar, gros bloc", pos = Vector3.new(2100, 260, 400), contents = { "ITM_Battery", "ITM_Flare" } },
	C11 = { name = "Pont, culée", pos = Vector3.new(3440, 150, 1620), contents = { "ITM_Bandage", "ITM_Rope" } },
	C12 = {
		name = "Tour ouest, cabine",
		pos = Vector3.new(-3580, 320, -650),
		contents = { "ITM_Battery", "ITM_Splint" },
	},
}
-- TODO(BIBLE): quantité de chaque objet sur les points C09 à C12. PROVISOIRE : 1 de chaque.
MapConfig.ClueItemQuantity = 1

-- 3.4 : objets clés (un emplacement tiré par objet ; R3 et R7 fixes).
-- Un emplacement donné par un lieu seul (« P26 cabine », « P22 coffre ») utilise la position du lieu.
MapConfig.KeyItems = {
	Keys = {
		item = "ITM_Keys",
		spots = { Vector3.new(-760, 230, 610), Vector3.new(-900, 229, 700), Vector3.new(-1500, 215, 420) },
	},
	AmmoBox = {
		item = "AmmoBox",
		spots = {
			Vector3.new(820, 112, 3050),
			Vector3.new(3360, 390, -700),
			"P26",
			Vector3.new(-1380, 72, 3280),
			Vector3.new(-2800, 380, -2550),
		},
	},
	Jack = { item = "ITM_Jack", spots = { "P22", "P17" } },
	CoaxCable = { item = "ITM_CoaxCable", spots = { "P23", "P17" } },
	CarBattery = { item = "ITM_CarBattery", spots = { "P22" } },
	Jerrycan = { item = "ITM_Jerrycan", spots = { "P17", "P22", "P15" } },
	StarterRelay = { item = "ITM_StarterRelay", spots = { "P17" } },
}

-- 8.1, colonne « Où » : objets posés à un lieu fixe (un exemplaire par lieu cité)
-- TODO(BIBLE): quantités aux lieux fixes. PROVISOIRE : 1 par lieu (6 planches dans la cabane : donné par 8.1).
MapConfig.FixedItems = {
	{ item = "ITM_Splint", places = { "P17" } },
	{ item = "ITM_Matches", places = { "P17", "P10" } },
	{ item = "ITM_Rope", places = { "P15" } },
	{ item = "ITM_Plank", places = { "P05c" }, count = 6 },
	{ item = "ITM_BearSpray", places = { "P17", "P01" } },
	{ item = "ITM_TinCan", places = { "P09", "P10" } },
	{ item = "ITM_DuctTape", places = { "P09", "P10" } },
	{ item = "ITM_PlasterKit", places = { "P17" } },
	{ item = "ITM_AudioRecorder", places = { "P23" } },
	{ item = "ITM_SampleBag", places = { "P09" } },
	{ item = "ITM_PhotoCamera", places = { "P09" } },
	{ item = "ITM_TabletGeo", places = { "P09" } }, -- tente de Leah Brandt
}
MapConfig.PhotoCameraCluePoints = { "C03", "C04", "C05", "C06" } -- 8.1 : appareil photo aussi en C03–C06

-- 2.7 : documents à emplacement fixe
MapConfig.FixedDocuments = {
	DOC_02 = "P09",
	DOC_09 = "P11", -- rejoué si la radio est réparée
	DOC_10 = "P15",
	DOC_13 = "P17",
	DOC_14 = "P23",
	DOC_16 = "P09",
}

-- 3.5 : eau, routes et sentiers. Points (X, Z) ; c = point de contrôle d'une Bézier cubique.
-- Chaque tracé est une suite d'ancres ; entre deux ancres, 0 ou 2 contrôles.
MapConfig.Paths = {
	R1 = {
		kind = "River",
		widths = { 6, 14, 24, 30 },
		points = {
			{ 533, -3067 },
			{ c = { -133, -1600 } },
			{ c = { -1067, -267 } },
			{ -1800, 1200 },
			{ c = { -2200, 2133 } },
			{ c = { -2800, 3067 } },
			{ -3067, 4000 },
		},
	},
	R2 = {
		kind = "River",
		widths = { 8, 16, 22 },
		points = {
			{ 3067, -1600 },
			{ c = { 3467, 0 } },
			{ c = { 3067, 1200 } },
			{ 3467, 2400 },
			{ c = { 3667, 3067 } },
			{ c = { 3600, 3600 } },
			{ 3733, 4000 },
		},
	},
	R3 = {
		kind = "River",
		widths = { 5, 8 },
		points = {
			{ -1067, -1733 },
			{ c = { -667, -1067 } },
			{ c = { -533, -533 } },
			{ -700, -100 },
		},
	},
	RD1 = { kind = "Road", width = 18, surface = "Asphalt", points = { { 4000, 3467 }, "P01", { 3200, 2200 } } },
	RD2 = { kind = "Road", width = 14, surface = "Gravel", points = { { -1400, 4000 }, "P10", "P07a" } },
	T1 = { kind = "Trail", width = 6, points = { "P01", { 2400, 1867 }, { 2200, 267 }, "P05", "P06" } },
	T2 = {
		kind = "Trail",
		width = 5,
		points = { "P01", { c = { 933, 2400 } }, { c = { 0, 1200 } }, "P09", "P12", "P07a" },
	},
	T3 = { kind = "Trail", width = 5, points = { "P09", { 0, -800 }, "P11", "P06" }, switchbacks = true },
	T4 = { kind = "Trail", width = 4, points = { "P16", "P15", "P05" } },
	T5 = { kind = "GameTrail", width = 0, points = { "P12", { -1500, -1000 }, { -900, -2300 }, "P25", "P06" } },
}

-- 3.6 : biomes (matériaux Roblox, arbres pour 10 000 studs²)
MapConfig.Biomes = {
	OldForest = {
		places = { "P04" },
		alongTrails = { "T2" },
		materials = { "LeafyGrass", "Ground" },
		treesPer10k = 9,
		trees = { "Tree_DouglasFir", "Tree_Hemlock" },
		minTreeSpacing = 11,
		undergrowth = { "Fern", "Trunk_Dead" },
	},
	MixedForest = {
		default = true,
		materials = { "Grass", "Ground" },
		treesPer10k = 6,
		trees = { "Tree_DouglasFir" },
		undergrowth = { "Fern", "Shrub" },
	},
	Meadow = { places = { "P12" }, materials = { "Grass" }, treesPer10k = 0.3, undergrowth = { "Weed" } },
	Lahar = {
		places = { "P02" },
		materials = { "Pebble", "Rock" },
		treesPer10k = 0,
		undergrowth = { "Rock_Boulder", "Rock_Small" },
	},
	Gorges = {
		places = { "P03", "P05" },
		materials = { "Basalt", "Rock" },
		treesPer10k = 1,
		rimOnly = true,
		undergrowth = { "Moss", "Rock_Small" },
	},
	Plateau = {
		places = { "P06", "P23" },
		materials = { "Sand", "Pebble" },
		sandColor = Color3.fromHex("#7A7670"),
		treesPer10k = 0.2,
		trees = { "Tree_Pine" },
	},
	ForbiddenZone = {
		places = { "P08" },
		materials = { "Sand", "Ground" },
		treesPer10k = 0,
		snagsPer10k = 4,
		fallenPer10k = 6,
		fallenOrientation = "NorthSouth",
		trees = { "Tree_Snag" },
		fallen = { "Tree_Fallen" },
	},
}
MapConfig.VegetationCap = 20000 -- modèles de végétation et rochers
MapConfig.TreeLodDistance = 700 -- au-delà : Model.LevelOfDetail = StreamingMesh

-- 3.7 : génération procédurale (TerrainBuilder)
MapConfig.Terrain = {
	Seed = 1924,
	SouthY = 40, -- pente douce du sud (Y ≈ 40) vers le nord (Y ≈ 420)
	NorthY = 420,
	Noise = { octaves = 5, period = 1600, amplitude = 60, ridgeAmplitude = 40 },
	RiverDepthFactor = 0.35, -- profondeur = 0,35 × largeur + 4
	RiverDepthBase = 4,
	RiverBlendFactor = 3, -- raccord sur 3 × la largeur
	Gorges = {
		ApeCanyon = { depth = 150, from = Vector2.new(2300, -600), to = Vector2.new(3000, -2200) },
		LavaCanyon = { depth = 70, path = "R2", fromZ = 1600, toZ = 2600 },
	},
	FlattenBlendFactor = 1.5, -- raccord sur 1,5 fois le rayon
	MaxRoadSlope = 0.08,
	MaxTrailSlope = 0.15,
	CliffSlopeDegrees = 40, -- pente > 40° = Rock ou Basalt
	ScaleJitter = 0.15, -- échelle ±15 %
	ChunkSize = 512, -- Workspace/Vegetation/Chunk_X_Z
	Anchors = {
		{ name = "Dôme du plateau", pos = Vector2.new(1200, -2733), height = 520, radius = Vector2.new(1470, 800) },
		{ name = "Crête de la tour", pos = Vector2.new(200, -1573), height = 430, radius = Vector2.new(800, 373) },
		{ name = "Crête est", pos = Vector2.new(3200, -800), height = 400, radius = Vector2.new(667, 933) },
		{ name = "Colline ouest", pos = Vector2.new(-3067, 1200), height = 220, radius = Vector2.new(733, 533) },
		{
			name = "Cuvette du lac",
			pos = Vector2.new(-1667, -1733),
			height = 320,
			radius = Vector2.new(700, 420),
			hollow = true,
		},
	},
	SwiftReservoirZ = 4600, -- 3.8 : plan d'eau décoratif au-delà
}

-- 8.3 : P11 et P23, une barre de réseau
MapConfig.NetworkPlaces = { "P11", "P23" }

-- position (Vector3) d'une entrée de lieu ou d'un Vector3 direct ; nil si inconnue
function MapConfig.resolve(spot)
	if typeof(spot) == "Vector3" then
		return spot
	end
	local place = MapConfig.Places[spot]
	return place and place.pos or nil
end

return MapConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="114">
        <Properties>
          <string name="Name">PlayerConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/PlayerConfig
-- Valeurs de la bible, sections 2.5, 6.3 et 7. Ne rien ajouter ici sans la bible.
local PlayerConfig = {}

-- 2.5 : les 10 rôles jouables. id = identifiant de code (RoleCard_<ROLE>, Characters/<ROLE>, VO_<ROLE>_*)
PlayerConfig.Roles = {
	{ id = "Leader", title = "Meneur", character = "Caleb Marsh" },
	{ id = "Medic", title = "Médecin", character = "Priya Natarajan" },
	{ id = "Tracker", title = "Pisteur", character = "Wyatt Dunn" },
	{ id = "Cameraman", title = "Caméraman", character = "Theo Lindqvist" },
	{ id = "Mechanic", title = "Mécanicienne", character = "Rosa Delgado" },
	{ id = "Descendant", title = "Descendante", character = "Nora Halvorsen" },
	{ id = "Geologist", title = "Géologue", character = "Malik Okafor" },
	{ id = "Athlete", title = "Sportif", character = "Jake Kowalski" },
	{ id = "RadioOperator", title = "Opératrice radio", character = "Mei Tanaka" },
	{ id = "Pyrotechnician", title = "Pyrotechnicien", character = "Dylan Croft" },
}

-- 7.1 : modèle du rôle dans ReplicatedStorage/Characters/<ROLE>/Skin_<n>
PlayerConfig.CharactersFolder = "Characters"
PlayerConfig.SkinPrefix = "Skin_"

-- 7.2 : déplacement (studs/s) et bruit (rayon entendu, studs)
PlayerConfig.Movement = {
	Walk = { speed = 12, noise = 25 },
	Run = { speed = 20, noise = 60 },
	Crouch = { speed = 6, noise = 6 },
	Prone = { speed = 2.5, noise = 0 },
	Carry = { speed = 8, noise = 40 }, -- porter un blessé
	JumpLandNoise = 30, -- saut (réception)
	LimpThreshold = 0.3, -- boiter : jambe < 30 %
	LimpSpeedFactor = 0.6,
	LimpNoiseBonus = 10,
	-- eau aux genoux / cendre / neige
	TerrainSpeedFactor = { Water = 0.7, Ash = 0.9, Snow = 0.85 },
	WaterNoiseFactor = 2,
	-- exceptions des rôles (7.2, 7.7)
	RoleRunSpeed = { Medic = 18 },
	RoleCarrySpeed = { Athlete = 12 }, -- le Sportif peut courir en portant
	RoleCanRunCarrying = { Athlete = true },
	RoleRunNoise = { Athlete = 75 }, -- respiration : bruit de course 75
}

-- 7.2 : caméra
PlayerConfig.Camera = {
	FieldOfView = 70,
	RunFieldOfView = 76,
	FirstPersonLocked = true,
	CrosshairOnlyWhenAiming = true,
}

-- 7.3 : points de vie par membre
PlayerConfig.Limbs = { "Head", "Torso", "ArmL", "ArmR", "LegL", "LegR" }
PlayerConfig.LimbHealth = { Head = 30, Torso = 100, ArmL = 50, ArmR = 50, LegL = 60, LegR = 60 }
PlayerConfig.RoleLimbHealth = { Pyrotechnician = { Torso = 80 } } -- 7.7 : torse 80 PV
PlayerConfig.LowLimbThreshold = 0.3 -- effets sous 30 %
PlayerConfig.LowArmReloadFactor = 1.5 -- bras sous 30 % : recharge ×1,5 plus lente
PlayerConfig.LowTorsoStaminaFactor = 0.5 -- torse sous 30 % : endurance max ÷ 2

-- 7.3 : sang
PlayerConfig.Blood = {
	Max = 100,
	LightBleedPerSecond = 0.5,
	HeavyBleedPerSecond = 2,
	DesaturateBelow = 40,
	DownedBelow = 20,
}

-- 7.3 : à terre (durée selon la difficulté : ActConfig.Difficulties)
PlayerConfig.Downed = {
	CrawlSpeed = 1.5,
	ReviveTime = 6,
	RoleReviveTime = { Medic = 3 },
	ReviveLimbFraction = 0.2, -- le joueur revient avec 20 % sur le membre touché
}

-- 6.3 : caméra de mort (sans coupe), puis spectateur
PlayerConfig.DeathCamera = { Duration = 4, TiltDegrees = 10, Height = 3 } -- Height : DÉFAUT (studs au-dessus du corps)

-- 7.4 : endurance
PlayerConfig.Stamina = {
	Max = 100,
	RoleMax = { Geologist = 80 },
	RunCostPerSecond = 12,
	JumpCost = 10,
	CarryCostPerSecond = 6,
	RegenWalkingPerSecond = 15,
	RegenIdlePerSecond = 25,
	RegenDelay = 1.5,
	ExhaustedDuration = 4,
	ExhaustedPantNoise = 35, -- halètement audible à 35 studs
}

-- 7.5 : peur (0 à 100), jamais affichée en chiffre
PlayerConfig.Fear = {
	Max = 100,
	NoLightRadius = 10, -- aucune lumière à 10 studs : +1/s
	NoLightPerSecond = 1,
	AloneRadius = 40, -- aucun coéquipier à 40 studs : +1,5/s
	AlonePerSecond = 1.5,
	SeeBody = 15, -- une fois par corps
	SeeCreatureMin = 20, -- +20 à +35, plus si proche
	SeeCreatureMax = 35,
	ScreamRadius = 100, -- cri à moins de 100 studs : +10
	Scream = 10,
	WoodKnock = 4, -- coup sur tronc entendu
	TeammateRadius = 15, -- coéquipier à 15 studs : −2/s
	TeammatePerSecond = -2,
	InLightPerSecond = -1,
	NearFirePerSecond = -3, -- près d'un feu ou d'une fusée
	LeaderOrder = -20, -- recharge 90 s (7.7)
	RoleFactor = { Descendant = 1.25 },
	-- seuils et effets
	HeartbeatAt = 40,
	ShakyAimAt = 60,
	ShakyAimFactor = 1.5,
	BreathingAt = 60,
	BreathingNoise = 20,
	MisplacedSoundsAt = 80,
	MisplacedSoundsDuration = 2,
	StaminaRegenFactorAt80 = 0.7,
	InvoluntaryScreamAt = 100,
	InvoluntaryScreamNoise = 200,
	InvoluntaryScreamCooldown = 60,
	-- TODO(BIBLE): distance à laquelle un joueur « voit » un corps (+15) et la créature (+20 à +35).
	-- Tant qu'elles valent nil, ces hausses ne sont pas appliquées.
	SeeBodyRange = nil,
	SeeCreatureRange = nil,
}

-- 7.6 : visibilité pour la créature (coefficient multiplié à sa portée de vue)
PlayerConfig.Visibility = {
	StandingOpen = 1.0,
	StandingForest = 0.6,
	CrouchFactor = 0.6,
	ProneInFernsFactor = 0.1,
	ProneInFernsMaxDistance = 10, -- invisible au-delà de 10 studs
	LightOnFactor = 3,
	LightOnMaxDistance = 600,
	RainOrFogFactor = 0.6,
	TabletOpenFactor = 1.5, -- 8.3
}

-- 7.7 : capacités des rôles
PlayerConfig.Abilities = {
	Leader = { OutlineRange = 30, OrderFear = -20, OrderRange = 15, OrderCooldown = 90 },
	Medic = { HealFactor = 2, ReviveTime = 3 },
	Tracker = {
		FootprintMaxAge = 120,
		DirectionErrorDegrees = 45,
		DirectionCooldown = 60,
		GrudgeShotFactor = 2,
	},
	Cameraman = { BatteryMinutes = 6 },
	Mechanic = { RepairFactor = 2, QuickSlots = 3 },
	Descendant = { HiddenClueRange = 8, FearFactor = 1.25 },
	Geologist = { StaminaMax = 80 },
	Athlete = { CarrySpeed = 12, PlankTime = 4, RunNoise = 75 },
	RadioOperator = { MimicHearRange = 150, NoFirearm = true },
	Pyrotechnician = {
		FlareRecipe = { ITM_Battery = 2, ITM_DuctTape = 1 },
		NoiseTrapRecipe = { ITM_TinCan = 1, ITM_Rope = 1 },
		TorsoHealth = 80,
	},
}

-- 7.8 : communication
PlayerConfig.Communication = {
	VoiceNoiseMax = 80,
	WalkieRange = 1500,
	WalkieBeepNoise = 20,
	PingDuration = 10,
	PingRayLength = 1000, -- DÉFAUT : portée du rayon qui pose un repère (studs)
}

-- 7.2 : posture → réglage de mouvement (RE_SetStance)
PlayerConfig.Stances = { Stand = "Walk", Crouch = "Crouch", Prone = "Prone", Run = "Run" }

-- Interface : 15.2 (HUD) et réglages d'affichage DÉFAUT (ni texte, ni gameplay)
PlayerConfig.Interface = {
	HudFadeAfter = 4, -- 15.2 : le HUD s'efface après 4 s sans changement
	FearVignetteMinTransparency = 0.4, -- DÉFAUT : « léger vignettage » (7.5) à peur 100
	NotificationDuration = 5, -- DÉFAUT : s d'affichage d'un message système
	NotificationMax = 4, -- DÉFAUT : messages affichés en même temps
	LeanOffset = 1.5, -- DÉFAUT : décalage de caméra en se penchant (studs)
	BobAmplitude = 0.08, -- DÉFAUT : balancement de marche (studs)
	BobFrequency = 8, -- DÉFAUT : fréquence du balancement à la vitesse de marche (rad/s)
	AimSway = 0.2, -- DÉFAUT : balancement de visée de base (degrés), ×1,5 par la peur ≥ 60 (7.5)
	LowBloodSaturation = -1, -- DÉFAUT : saturation à sang 0 (désaturation progressive sous 40)
	LowHeadBlur = 8, -- DÉFAUT : flou (BlurEffect.Size) tête sous 30 %
	LampFlickerChance = 0.15, -- DÉFAUT : chance par image qu'une lampe faible s'éteigne
	PortraitDistance = 6, -- DÉFAUT : distance de la caméra du portrait (RoleSelectGui, studs)
}

-- DÉFAUT : touches (clavier, positions physiques : Q = A sur un clavier AZERTY, 7.2 « A/E »)
PlayerConfig.Keys = {
	Sprint = Enum.KeyCode.LeftShift,
	Crouch = Enum.KeyCode.C,
	Prone = Enum.KeyCode.X,
	LeanL = Enum.KeyCode.Q,
	LeanR = Enum.KeyCode.E,
	Light = Enum.KeyCode.T,
	Reload = Enum.KeyCode.R,
	Tablet = Enum.KeyCode.Tab,
	Ping = Enum.KeyCode.G,
	Bag = Enum.KeyCode.B,
	Ability = Enum.KeyCode.V,
	Slots = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four },
	GamepadSprint = Enum.KeyCode.ButtonL3,
	GamepadCrouch = Enum.KeyCode.ButtonB,
	GamepadFire = Enum.KeyCode.ButtonR2,
	GamepadAim = Enum.KeyCode.ButtonL2,
	GamepadReload = Enum.KeyCode.ButtonY,
}

-- DÉFAUT (valeurs techniques, ni texte ni gameplay) : cadences de calcul côté serveur
PlayerConfig.Technical = {
	Tick = 0.5, -- s entre deux mises à jour de santé, d'endurance et de peur
	FootstepNoiseInterval = 0.5, -- s entre deux bruits de pas en mouvement
	StanceSpeedTolerance = 1.25, -- vitesse réelle tolérée au-dessus de la vitesse de la posture (16.3)
	SpawnLift = 3, -- hauteur de pose d'un personnage au-dessus du point de départ (studs)
	InteractKey = Enum.KeyCode.F, -- touche d'interaction (A et E servent à se pencher, 7.2)
	InteractGamepadKey = Enum.KeyCode.ButtonX,
	HoldTolerance = 0.3, -- marge (s) sur le temps de maintien vérifié par le serveur
	VideoCheckInterval = 0.25, -- s entre deux contrôles de la vidéo de classe A
	DownedDamageKills = true, -- TODO(BIBLE): un coup reçu à terre tue-t-il ? PROVISOIRE : oui
}

-- TODO(BIBLE): qu'est-ce qui déclenche une hémorragie légère ou grave (seuil de dégâts, type d'attaque) ?
-- Tant que ces seuils valent nil, seules les attaques qui le précisent font saigner.
PlayerConfig.BleedOnDamage = { LightAt = nil, HeavyAt = nil }

-- TODO(BIBLE): sur quel membre agissent le bandage (+10 PV) et la trousse (+40 PV) ?
-- PROVISOIRE : le membre le plus abîmé (en proportion).
PlayerConfig.HealTarget = "MostDamaged"

-- TODO(BIBLE): sang rendu au joueur relevé après être tombé faute de sang. PROVISOIRE : le seuil (20).
PlayerConfig.ReviveBlood = 20

return PlayerConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="115">
        <Properties>
          <string name="Name">ProgressionConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/ProgressionConfig
-- Valeurs de la bible, section 16.4 (données, XP) et 16.2 (DataService).
-- Ne rien ajouter ici sans la bible.
-- Les règles de déblocage des skins (7.1) et de Cauchemar (5.4) sont ajoutées au jalon J14.
local ProgressionConfig = {}

-- 16.4 : DataStore PisteFroide_v1, clé player_<UserId>
ProgressionConfig.DataStoreName = "PisteFroide_v1"
ProgressionConfig.KeyPrefix = "player_"

-- 16.4 : champ « version » des données
ProgressionConfig.DataVersion = 1

-- 16.2 : sauvegarde toutes les 120 s et à la fermeture
ProgressionConfig.AutosaveInterval = 120

-- 16.4 : liste des preuves, 200 au plus
ProgressionConfig.MaxEvidence = 200

-- 16.4 : clés des fins (5.3)
ProgressionConfig.EndingIds = { "Survie", "Preuve", "Verite", "Ordonnance", "Silence" }

-- 16.4 et 4.3 : panneaux du musée M1 à M8
ProgressionConfig.MuseumPanelIds = { "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8" }

-- 16.4 : pages du carnet Halvorsen (DOC_12) ; la page 1 est débloquée au départ
ProgressionConfig.DefaultNotebookPages = { true, false, false }

-- 7.1 : 3 skins par personnage, A dès le début
ProgressionConfig.SkinIds = { "A", "B", "C" }
ProgressionConfig.DefaultSkin = "A"

-- 16.4 : niveau = partie entière de la racine de (XP ÷ 100)
ProgressionConfig.XPPerLevelDivisor = 100

-- 16.4 : gains d'XP ; preuves selon 8.4
ProgressionConfig.XPGains = {
	MuseumPanel = 5, -- panneau de musée lu (première fois, 4.2)
	GamePlayed = 50, -- partie jouée
	Survival = 200, -- survie
	EvidenceA = 500, -- 8.4 : vidéo du Caméraman
	EvidenceB = 150, -- 8.4 : moulage, cri, poils, photo
	EvidenceC = 50, -- 8.4 : document, photo du charnier
}

-- 16.2 : verrouillage de session (valeurs techniques acceptées le 4 novembre 2026, 16.4)
ProgressionConfig.SessionLock = {
	-- un verrou non rafraîchi depuis 360 s (3 sauvegardes manquées) est considéré abandonné
	StaleAfter = 360,
	-- nombre d'essais de chargement si une autre place tient encore le verrou (téléportation)
	LoadAttempts = 6,
	-- secondes entre deux essais de chargement
	LoadRetryDelay = 5,
}

return ProgressionConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="116">
        <Properties>
          <string name="Name">WeaponConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/WeaponConfig
-- Valeurs de la bible, section 8.2 (et 16.3 pour la validation). Ne rien ajouter ici sans la bible.
local WeaponConfig = {}

-- « Toute la carte » : la diagonale de la carte de 8 000 × 8 000 studs (section 0)
local WHOLE_MAP = math.ceil(8000 * math.sqrt(2))

-- 8.2 : armes. fireInterval = 1 tir toutes les n s ; reload = s par munition
WeaponConfig.Weapons = {
	WPN_Rifle = {
		name = "Fusil à verrou",
		ammo = 5,
		fireInterval = 1.4,
		reloadPerRound = 1.2,
		damageBody = 180,
		damageHead = 400,
		friendlyTorso = 120,
		noise = WHOLE_MAP,
	},
	WPN_Revolver = {
		name = "Revolver",
		ammo = 6,
		fireInterval = 0.6,
		reloadPerRound = 0.8,
		damageBody = 70,
		damageHead = 160,
		friendlyTorso = 60,
		noise = 2500,
	},
	WPN_Shotgun = {
		name = "Fusil à pompe",
		ammo = 4,
		fireInterval = 1.0,
		reloadPerRound = 0.9,
		pellets = 8,
		damagePerPellet = 18, -- jusqu'à 15 studs, puis −70 % à 40 studs
		fullDamageRange = 15,
		reducedRange = 40,
		reducedFactor = 0.3,
		-- TODO(BIBLE): forme de la baisse entre 15 et 40 studs (linéaire en attendant) et portée au-delà de 40
		friendlyPerPellet = 15,
		noise = WHOLE_MAP,
		-- TODO(BIBLE): écart des plombs (degrés). PROVISOIRE : 0 = tous dans l'axe
		spreadDegrees = 0,
	},
	WPN_FlareGun = {
		name = "Pistolet lance-fusées",
		owner = "Pyrotechnician",
		ammo = 3,
		reloadTime = 2,
		damage = 20,
		blindDuration = 3,
		creatureFleeDuration = 8,
		friendlyDamage = 30, -- + brûlure
		noise = 1200,
		-- TODO(BIBLE): cadence du pistolet lance-fusées (« — » dans 8.2) et effet de la brûlure sur un coéquipier
	},
	MEL_Axe = {
		name = "Hache",
		owner = "Athlete",
		melee = true,
		fireInterval = 1.1,
		damage = 25,
		grabReleaseHits = 1, -- un coup sur le bras qui saisit = lâcher
		friendlyDamage = 30,
		noise = 40,
	},
	MEL_Machete = {
		name = "Machette",
		melee = true,
		fireInterval = 0.8,
		damage = 18,
		grabReleaseHits = 2, -- deux coups = lâcher
		friendlyDamage = 20,
		noise = 30,
		-- TODO(BIBLE): qui porte la machette au départ, ou où se trouve-t-elle ?
	},
}

-- TODO(BIBLE): portée des armes de mêlée (studs). PROVISOIRE : 7, la portée du coup de la créature (9.10)
WeaponConfig.MeleeRange = 7

-- 8.2 : armes à feu selon la taille du groupe (1–3, 4–6, 7–10)
WeaponConfig.FirearmsByGroupSize = {
	{ maxPlayers = 3, weapons = { "WPN_Rifle" } },
	{ maxPlayers = 6, weapons = { "WPN_Rifle", "WPN_Revolver" } },
	{ maxPlayers = 10, weapons = { "WPN_Rifle", "WPN_Revolver", "WPN_Shotgun" } },
}
WeaponConfig.RifleToRole = "Tracker" -- le fusil revient d'office au Pisteur s'il est présent
WeaponConfig.NoFirearmRole = "RadioOperator" -- l'Opératrice ne peut pas en porter

-- 8.2 : boîte de munitions de secours (A1–A5, une seule ; absente en Cauchemar)
WeaponConfig.AmmoBox = { WPN_Rifle = 5, WPN_Revolver = 6, WPN_Shotgun = 4 }

-- 16.3 : RE_FireWeapon — origine à moins de 5 studs de la tête
WeaponConfig.MaxOriginOffset = 5

-- 4.4 : conflit au tableau des armes : vote à la majorité en 15 s, sinon tirage
WeaponConfig.ConflictVoteDuration = 15

-- 13.5 : icônes Icon_<ID> ; identifiants rbxassetid à renseigner après import (DÉFAUT : vide)
WeaponConfig.Icons = {}

return WeaponConfig
]]></string>
        </Properties>
      </Item>
