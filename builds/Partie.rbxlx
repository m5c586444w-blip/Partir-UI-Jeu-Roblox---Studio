      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Shared/RateLimiter
-- Limite d'appels des remotes client → serveur (section 16.3).
-- Fenêtre fixe : au plus `calls` appels par joueur toutes les `per` secondes, par remote.
-- Les limites viennent de Config/LaunchConfig.RateLimits.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))

local RateLimiter = {}
RateLimiter.__index = RateLimiter

local allLimiters = {}

function RateLimiter.new(calls, per)
	local limiter = setmetatable({ _calls = calls, _per = per, _windows = {} }, RateLimiter)
	table.insert(allLimiters, limiter)
	return limiter
end

-- limiteur réglé pour une remote donnée (valeur propre ou valeur par défaut de 16.3)
function RateLimiter.forRemote(remoteName)
	local limits = LaunchConfig.RateLimits[remoteName] or LaunchConfig.RateLimits.Default
	return RateLimiter.new(limits.calls, limits.per)
end

-- vrai si l'appel est autorisé pour cette clé (en général le joueur)
function RateLimiter:Allow(key)
	local now = os.clock()
	local window = self._windows[key]
	if window == nil or now - window.start >= self._per then
		window = { start = now, count = 0 }
		self._windows[key] = window
	end
	if window.count >= self._calls then
		return false
	end
	window.count += 1
	return true
end

function RateLimiter:Forget(key)
	self._windows[key] = nil
end

-- côté serveur : branche un handler sur une remote, derrière sa limite d'appels.
-- Les appels en trop sont ignorés sans réponse.
function RateLimiter.connect(remote, handler)
	local limiter = RateLimiter.forRemote(remote.Name)
	return remote.OnServerEvent:Connect(function(player, ...)
		if limiter:Allow(player) then
			handler(player, ...)
		end
	end)
end

-- un joueur qui part libère ses fenêtres dans tous les limiteurs
Players.PlayerRemoving:Connect(function(player)
	for _, limiter in allLimiters do
		limiter:Forget(player)
	end
end)

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Shared/Signal
-- Signal minimal en Luau pur : Connect, Once, Fire, Wait, DisconnectAll.
-- Les fonctions connectées tournent chacune dans leur propre fil (task.spawn).
local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local connections = self._signal._connections
	local index = table.find(connections, self)
	if index then
		table.remove(connections, index)
	end
end

function Signal.new()
	return setmetatable({ _connections = {} }, Signal)
end

function Signal:Connect(handler)
	local connection = setmetatable({
		Connected = true,
		_signal = self,
		_handler = handler,
	}, Connection)
	table.insert(self._connections, connection)
	return connection
end

function Signal:Once(handler)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...)
	-- copie : un handler peut se déconnecter pendant l'appel
	for _, connection in table.clone(self._connections) do
		if connection.Connected then
			task.spawn(connection._handler, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, connection in table.clone(self._connections) do
		connection:Disconnect()
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Shared/Types
-- Types Luau partagés (documentation du format des données ; aucun code).

-- 16.4 : données d'un joueur (DataStore PisteFroide_v1, clé player_<UserId>)
export type EvidenceEntry = {
	class: string, -- "A", "B" ou "C" (8.4)
	kind: string, -- ex. "Video"
	date: number,
}

export type PlayerData = {
	version: number,
	xp: number,
	plays: number,
	survivals: number,
	endings: { [string]: boolean },
	evidence: { EvidenceEntry }, -- 200 au plus
	skins: { [string]: { [string]: boolean } }, -- skins[role][skin]
	equipped: { [string]: string }, -- equipped[role] = skin
	notebookPages: { boolean },
	museumRead: { [string]: boolean },
	nightmareUnlocked: boolean,
	settings: { [string]: any },
}

-- 4.4 et 16.4 : configuration de partie écrite par LaunchService, lue par PartyLoaderService
export type LaunchPlayer = {
	userId: number,
	name: string, -- DisplayName, pour MSG_PlayerMissing (4.6)
	role: string?, -- rempli par RoleService (J9)
	weapon: string?, -- rempli par WeaponBoardService (J9)
}

export type LaunchData = {
	version: number, -- Shared/Version du Lobby
	players: { LaunchPlayer },
	difficulty: string?, -- rempli par VoteService (J9)
	weather: string?, -- rempli par VoteService (J9)
	start: string, -- "S1", "S2" ou "S3"
	seed: number, -- os.time() au lancement (3.4)
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Shared/Util
-- Fonctions utilitaires partagées par les deux places.
local Util = {}

-- copie profonde d'une table (sans métatables)
function Util.deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value do
		copy[key] = Util.deepCopy(child)
	end
	return copy
end

-- ajoute à `target` les clés de `template` qui lui manquent (récursif).
-- Les valeurs déjà présentes ne sont jamais écrasées.
function Util.reconcile(target, template)
	for key, templateValue in template do
		local current = target[key]
		if current == nil then
			target[key] = Util.deepCopy(templateValue)
		elseif type(current) == "table" and type(templateValue) == "table" then
			Util.reconcile(current, templateValue)
		end
	end
	return target
end

-- clés d'une table, triées
function Util.sortedKeys(dictionary)
	local keys = {}
	for key in dictionary do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

-- appelle `fn` jusqu'à `attempts` fois, avec `delay` secondes entre deux échecs.
-- Renvoie ok, puis le résultat (ou le dernier message d'erreur).
function Util.retry(attempts, delay, fn, ...)
	local ok, result
	for attempt = 1, attempts do
		ok, result = pcall(fn, ...)
		if ok then
			return true, result
		end
		if attempt < attempts then
			task.wait(delay)
		end
	end
	return false, result
end

-- cherche une remote dans ReplicatedStorage/Remotes ; avertissement clair si elle manque
function Util.getRemote(name)
	local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild(name)
	if remote == nil then
		warn("Remote manquante : Remotes/" .. name)
	end
	return remote
end

-- côté serveur : envoie un message système de LoreConfig.Messages (4.6) à un joueur.
-- `params` remplace {player} et {n} côté client (ex. { player = "Nora", n = 3 }).
function Util.notify(player, messageKey, params)
	local remote = Util.getRemote("RE_Notify")
	if remote ~= nil and player.Parent ~= nil then
		remote:FireClient(player, messageKey, params)
	end
end

-- côté client : texte final d'un message système, {player} et {n} remplacés
function Util.formatMessage(template, params)
	params = params or {}
	return (
		template:gsub("{(%w+)}", function(name)
			local value = params[name]
			return if value ~= nil then tostring(value) else "{" .. name .. "}"
		end)
	)
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Version</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Shared/Version
-- Numéro de version commun aux deux places (section 16.1) : le Lobby l'écrit dans la
-- configuration de partie, la Partie le compare au sien.
-- À augmenter de 1 à chaque publication qui change Config, Shared ou les remotes,
-- et publier alors les deux places ensemble.
local Version = {}

Version.Number = 1

return Version
]]></string>
        </Properties>
      </Item>
