	S1 = Vector3.new(2780, 120, 3220), -- autour du van ; 10 points espacés de 6 studs
	S2 = Vector3.new(-1380, 70, 3290), -- autour du bulldozer
	S3 = Vector3.new(-820, 230, 640), -- dans le camp, corps visibles
}

return MapConfig
]]></string>
