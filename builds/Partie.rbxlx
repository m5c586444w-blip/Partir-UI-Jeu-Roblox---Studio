		nightVision = true,
	},
	ITM_PhotoCamera = {
		name = "Appareil photo",
		weight = 0.5,
		stack = 1,
		uses = 12,
		noise = 15,
		effect = "Photo",
		flashLightFactor = 3,
		flashDuration = 0.2,
	},
	ITM_TabletField = { name = "Tablette de terrain", weight = 0.7, stack = 1, effect = "Tablet" },
	ITM_TabletGeo = { name = "Tablette des géologues", weight = 0.7, stack = 1, documents = { "DOC_07", "DOC_08" } },
	-- 8.4 : carte mémoire créée après une vidéo de classe A = preuve A
	ITM_SDCard = { name = "Carte mémoire", weight = 0, stack = 1, evidence = { class = "A", kind = "Video" } },
	-- 8.4 : preuves B et C (objets d'inventaire ; noms du tableau 8.4)
	EVD_Cast = { name = "Moulage d'empreinte", weight = 0, stack = 1, evidence = { class = "B", kind = "Cast" } },
	EVD_Call = { name = "Enregistrement d'un cri", weight = 0, stack = 1, evidence = { class = "B", kind = "Call" } },
	EVD_Hair = { name = "Poils", weight = 0, stack = 1, evidence = { class = "B", kind = "Hair" } },
	EVD_PhotoCreature = {
		name = "Photo de la créature",
		weight = 0,
		stack = 1,
		evidence = { class = "B", kind = "Photo" },
	},
	EVD_Document = { name = "Document", weight = 0, stack = 1, evidence = { class = "C", kind = "Document" } },
	EVD_PhotoCharnier = {
		name = "Photo du charnier P19",
		weight = 0,
		stack = 1,
		evidence = { class = "C", kind = "PhotoP19" },
	},
	-- 3.4 et 8.2 : munitions de réserve (boîte A1–A5)
	AMMO_WPN_Rifle = { name = "Balles de fusil", weight = 0, stack = 99, ammoFor = "WPN_Rifle" },
	AMMO_WPN_Revolver = { name = "Balles de revolver", weight = 0, stack = 99, ammoFor = "WPN_Revolver" },
	AMMO_WPN_Shotgun = { name = "Cartouches", weight = 0, stack = 99, ammoFor = "WPN_Shotgun" },
}
-- TODO(BIBLE): poids des preuves (carte mémoire, moulage, etc.) et des munitions. PROVISOIRE : 0 kg.
-- DÉFAUT : pile de 99 munitions (valeur technique de rangement).

-- 8.1, colonne « Où » : objets de départ par rôle (quantité = nombre d'unités)
ItemConfig.StartingItems = {
	All = { ITM_Walkie = 1, ITM_Bandage = 2 },
	-- lampe torche : tous sauf Descendante et Géologue
	Flashlight = { item = "ITM_Flashlight", exceptRoles = { Descendant = true, Geologist = true } },
	Roles = {
		Leader = { ITM_TabletField = 1 },
		Medic = { ITM_Medkit = 1 },
		Tracker = { ITM_PlasterKit = 1 },
		Cameraman = { ITM_Camcorder = 1 },
		Mechanic = { ITM_ToolBox = 1 },
		Descendant = { ITM_Headlamp = 1, ITM_Notebook = 1 },
		Geologist = { ITM_PowerLight = 1, ITM_Compass = 1 },
		RadioOperator = { ITM_RadioScanner = 1, ITM_AudioRecorder = 1 },
		-- TODO(BIBLE): combien de fusées à main pour le Pyrotechnicien au départ ? (1 en attendant)
		Pyrotechnician = { ITM_Flare = 1 },
	},
}

-- 8.3 : tablette de terrain
ItemConfig.Tablet = {
	BatteryMinutes = 30, -- d'écran allumé pour la nuit
	VisibilityFactor = 1.5,
	GpsError = 30, -- ±30 studs
	GpsInterval = 10,
	DenseForestNoSignalChance = 0.5,
	MaxMarkers = 8,
	-- Réseau : une barre au sommet de P11 et à P23
	NetworkPlaces = { "P11", "P23" },
}

-- 8.4 : preuves (XP dans ProgressionConfig.XPGains)
ItemConfig.Evidence = {
	VideoA = { minVisibleFraction = 0.6, maxDistance = 30, minDuration = 2 },
	PlasterB = { footprintMaxAge = 120, workTime = 30 },
	CallB = { maxDistance = 150 },
	HairB = { places = { "StickStructure", "P05" } }, -- structure de branches ou bord d'Ape Canyon
	PhotoB = { maxDistance = 40 },
	DocumentC = { "DOC_03", "DOC_04", "DOC_05", "DOC_06", "DOC_07", "DOC_08", "DOC_09", "DOC_10" },
	PhotoC = { place = "P19" }, -- photo du charnier
}

-- 13.5 : icônes Icon_<ID> (assets/ui/png). Identifiants rbxassetid à renseigner après import dans Studio.
-- DÉFAUT : chaîne vide = pas d'icône affichée.
ItemConfig.Icons = {}

-- DÉFAUT (technique) : bloc gris MANQUANT_ et pose au sol
ItemConfig.PlaceholderSize = Vector3.new(1, 1, 1)
ItemConfig.PlaceholderColor = Color3.fromRGB(128, 128, 128)
ItemConfig.SpawnLift = 0.5
ItemConfig.ClueItemSpacing = 1.5 -- écart entre deux objets posés sur le même point
ItemConfig.DocumentOffset = Vector3.new(0, 0, 3) -- document posé à côté du centre du lieu
-- DÉFAUT (affichage) : fusée et feu de camp posés au sol
ItemConfig.FireVisuals = {
	Size = Vector3.new(0.4, 0.4, 0.4),
	FlareColor = Color3.fromRGB(255, 40, 30),
	CampfireColor = Color3.fromRGB(255, 150, 60),
	GroundOffset = 2.5, -- sous le HumanoidRootPart
	CampfireAhead = 3, -- devant le joueur
}

-- TODO(BIBLE): distance et vitesse d'un lancer (pierre, branche). PROVISOIRE : 40 studs/s, 1 s de vol.
ItemConfig.Throw = { Speed = 40, Flight = 1 }
-- TODO(BIBLE): bruit du piège à bruit du Pyrotechnicien (boîte de conserve + corde). Sans valeur : pas de piège.
ItemConfig.NoiseTrapRadius = nil

-- 13.3 : modèles d'objets dans ReplicatedStorage/Items (Item_<Nom>) ; absent → bloc gris MANQUANT_<ID>
ItemConfig.ModelsFolder = "Items"

return ItemConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">LaunchConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/LaunchConfig
-- Groupe, lancement et téléportation Lobby ↔ Partie : bible, sections 4.4, 16.1, 16.3 et 16.4.
-- Ne rien ajouter ici sans la bible.
local LaunchConfig = {}

-- 16.4 : expérience « PISTE FROIDE (test) » (relevés le 22 octobre 2026 ;
-- à reconfirmer dans le Creator Dashboard si l'expérience a été recréée)
LaunchConfig.PlaceIds = {
	Lobby = 77677833738174,
	Partie = 103506696801797,
}

-- 4.4 : groupe
LaunchConfig.Party = {
	MinSize = 1, -- capacité 1 à 10
	MaxSize = 10,
	PrivateCodeDigits = 4, -- groupe privé : code à 4 chiffres
	ReadyCountdown = 10, -- tous « Prêt » → compte à rebours de 10 s
}

-- 16.4 : MemoryStore
LaunchConfig.MemoryStore = {
	-- « Parties » : carte triée des groupes du lobby, durée de vie 900 s
	PartiesMapName = "Parties",
	PartiesTTL = 900,
	-- limite de l'API Roblox (MemoryStoreSortedMap:GetRangeAsync lit 200 entrées au plus)
	PartiesScanCount = 200,
	-- « Launch_<PrivateServerId> » : configuration de partie lue par la Partie, durée de vie 600 s
	LaunchMapName = "Launch", -- DÉFAUT : carte de hachage qui contient les clés Launch_
	LaunchKeyPrefix = "Launch_",
	LaunchTTL = 600,
	-- valeurs techniques acceptées le 4 novembre 2026 (16.4) : essais et délai (s) par appel MemoryStore
	Attempts = 3,
	RetryDelay = 2,
}

-- DÉFAUT (valeurs techniques) : essais et délai (s) d'une téléportation ratée
-- (départ : MSG_TeleportRetry puis MSG_TeleportAbort, 4.6 ; retour au Lobby)
LaunchConfig.Teleport = {
	Attempts = 3,
	RetryDelay = 5,
}

-- 4.4 et 5.4 : votes. Sans vote : Normal, météo aléatoire. Égalité : la difficulté la plus basse
-- l'emporte ; pour la météo, aléatoire.
LaunchConfig.Votes = {
	Difficulties = { "Normal", "Hard", "Nightmare" }, -- de la plus basse à la plus haute
	Weathers = { "Random", "Clear", "Fog", "Rain", "Snow" }, -- « Random » = tirage de 12.3
	DefaultDifficulty = "Normal",
	DefaultWeather = "Random",
	TieWeather = "Random",
}

-- 16.2 : PartyLoaderService attend les joueurs 60 s au plus
LaunchConfig.ArrivalTimeout = 60

-- 16.3 : toutes les remotes client → serveur sont limitées à 10 appels par seconde ;
-- RE_Ping : 1 toutes les 2 s
LaunchConfig.RateLimits = {
	Default = { calls = 10, per = 1 },
	RE_Ping = { calls = 1, per = 2 },
}

return LaunchConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">LoreConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/LoreConfig
-- Textes de la bible : documents DOC_xx (2.7), panneaux M1-M8 (4.3), dialogues (4.2),
-- messages système (4.6). Claude Code recopie ces textes, il n'en rédige pas d'autre (section 2).
-- Les documents sont recopiés au jalon J7, le musée et les dialogues au jalon J14.
local LoreConfig = {}

-- 4.6 : messages système, affichés par NotificationGui.
-- Le serveur envoie la clé avec RE_Notify ; {player} et {n} sont remplacés par le code.
LoreConfig.Messages = {
	MSG_PartyFull = "Ce groupe est complet (10 joueurs).",
	MSG_CodeInvalid = "Aucun groupe ne correspond à ce code.",
	MSG_QuickJoinNone = "Aucun groupe public disponible. Crée le tien.",
	MSG_PartyLeft = "Tu as quitté le groupe.",
	MSG_HostLeft = "Le créateur du groupe est parti. {player} prend sa place.",
	MSG_RoleTaken = "Ce rôle est déjà pris par {player}.",
	MSG_RoleRequired = "Choisis un rôle avant d'être prêt.",
	MSG_WeaponTaken = "Cette arme est déjà attribuée à {player}.",
	MSG_WeaponNotAllowed = "L'opératrice radio ne peut pas porter d'arme à feu.",
	MSG_WeaponVote = "Deux joueurs veulent la même arme. Votez : 15 secondes.",
	MSG_NightmareLocked = "Cauchemar se débloque après une première survie.",
	MSG_WaitingReady = "En attente : {n} joueur(s) pas encore prêt(s).",
	MSG_Countdown = "Départ dans {n} s.",
	MSG_CountdownCancelled = "Départ annulé : un joueur n'est plus prêt.",
	MSG_Teleporting = "En route vers la forêt…",
	MSG_TeleportRetry = "Le départ a échoué. Nouvel essai…",
	MSG_TeleportAbort = "Impossible de partir pour l'instant. Réessayez dans un moment.",
	MSG_WaitingPlayers = "En attente des autres membres du groupe…",
	MSG_PlayerMissing = "{player} n'a pas rejoint la forêt.",
	MSG_VersionMismatch = "Une mise à jour est en cours. Retour en ville.",
	MSG_ReturnToLobby = "Retour en ville…",
	MSG_DataLoadFailed = "Ta progression n'a pas pu être chargée. Elle ne sera pas sauvegardée pendant cette session.",
	MSG_LaunchConfigMissing = "La partie n'a pas pu être préparée. Retour en ville.",
}

-- 15.6 : textes d'interface remplis par les scripts ({player} remplacé par le code)
LoreConfig.UI = {
	TakenBy = "Pris par {player}",
	Watching = "Tu regardes {player}",
	Lock = "Verrouillé",
}

-- 2.7 : documents trouvables (texte définitif). title = colonne « Type » ; body = texte affiché.
-- kind : "Paper" (papier), "Tape" (cassette / audio), "Image" (image + légende), "Video", "Map".
-- image / audio : assets à créer (13.5, 13.7), vides en attendant.
LoreConfig.Documents = {
	DOC_01 = {
		title = "Avis de recherche",
		kind = "Paper",
		body = "DISPARUS depuis le 7 octobre : Dr A. Whitcombe, S. Ito, B. Castillo, L. Brandt. Recherches suspendues. Toute information : Skamania County Sheriff.",
	},
	DOC_02 = {
		title = "Permis de recherche",
		kind = "Paper",
		body = "Pacific Cascades University — relevé géophysique des tubes de lave, secteur sud. Autorisation 30 jours. Interdiction d'entrer dans la zone fermée.",
	},
	DOC_03 = {
		title = "Cassette 1 (Ito)",
		kind = "Tape",
		body = "Jour 9. Encore des cailloux sur la bâche cette nuit. Alan dit que c'est le vent. Le vent ne vise pas.",
	},
	DOC_04 = {
		title = "Carnet de terrain (Castillo)",
		kind = "Paper",
		body = "Trois coups sur un tronc, au nord. Puis trois coups au sud. Ils se répondent.",
	},
	DOC_05 = {
		title = "Cassette 2 (Whitcombe)",
		kind = "Tape",
		body = "Il était petit. Il s'est approché du camp. J'ai tiré. Personne ne doit savoir. On part dans deux jours.",
	},
	DOC_06 = {
		title = "Photo d'empreinte",
		kind = "Image",
		body = "41 cm. Deux tailles différentes sur la même piste.",
		image = "Img_DOC06",
	},
	DOC_07 = { title = "Carte des tunnels", kind = "Map", body = "", image = "Img_TabletMap_Tunnels", unlocks = "E4" },
	DOC_08 = { title = "Vidéo de la tablette", kind = "Video", body = "", cinematic = "CS_05" },
	DOC_09 = {
		title = "Message radio (Ito)",
		kind = "Tape",
		body = "Ici Ito, tour de guet. Alan est descendu. Il dit qu'il va leur rendre. Si quelqu'un entend… ne dormez pas près de l'eau.",
	},
	DOC_10 = {
		title = "Dernier carnet (Ito)",
		kind = "Paper",
		body = "Ils ne mangent pas les morts tout de suite. Ils les rangent. Comme des réserves. Ou comme des avertissements.",
	},
	-- DOC_11 : résumé de l'enquête au musée (texte du panneau M2, 4.3) — rempli au jalon J14
	DOC_12 = {
		title = "Carnet de la famille Halvorsen",
		kind = "Paper",
		pages = {
			"Il n'a jamais voulu en parler. Il disait seulement : ne tire pas le premier.",
			"Ils frappaient les arbres avant les pierres.", -- débloquée au siège
			"On leur avait pris quelqu'un, à eux aussi.", -- fin « La vérité »
		},
	},
	DOC_13 = {
		title = "Note du ranger Hollis",
		kind = "Paper",
		body = "Zone fermée. Officiellement le sol. Officieusement, on retrouve des wapitis sans tête. Ne restez pas après la nuit tombée.",
	},
	DOC_14 = { title = "Enregistrement météo", kind = "Tape", body = "", audio = "SFX_Call_Long_01" }, -- 40 s de vent, puis un cri long
	DOC_15 = {
		title = "Panneau « Sasquatch Refuge »",
		kind = "Sign",
		body = "SKAMANIA COUNTY — SASQUATCH REFUGE — Ord. 69-01",
	},
	DOC_16 = { title = "Photo de groupe des géologues", kind = "Image", body = "", image = "Img_DOC16" },
}

-- 8.3 : tablette, appli Réseau
LoreConfig.Tablet = {
	NoNetwork = "Aucun réseau",
	NoGps = "Pas de signal GPS",
	HollisReply = "Restez groupés. Personne ne monte avant l'aube.",
}

-- Textes des invites ProximityPrompt (InteractGui > ActionText).
-- 15.6 : libellés courts absents du tableau → proposition de Claude Code, marquée DÉFAUT.
LoreConfig.Prompts = {
	Pickup = "Ramasser", -- DÉFAUT
	Revive = "Relever", -- DÉFAUT (7.3 : « Relever »)
	Barricade = "Barricader", -- DÉFAUT (5.2 : « Barricader 3 ouvertures »)
	Repair = "Réparer", -- DÉFAUT (5.2 : « réparer »)
	ChangeWheel = "Changer la roue", -- DÉFAUT (5.2 : « changer la roue lacérée »)
	Call = "Appeler", -- DÉFAUT (5.2 : « appel »)
	Drive = "Conduire", -- DÉFAUT (5.2 : « conduire »)
	ClearPlug = "Dégager le bouchon", -- DÉFAUT (5.2)
	Read = "Lire", -- 15.6 (Play : Lire)
	Open = "Ouvrir", -- DÉFAUT (sac d'un mort)
}

-- 5.3 : fins (titres de la colonne « Fin » ; texte : colonne « Récompense » quand elle est rédigée)
-- TODO(BIBLE): textes de fin affichés dans ResultsGui > EndingText (seul « Silence » en a un)
LoreConfig.Endings = {
	Survie = { title = "Survie", text = "" },
	Preuve = { title = "Preuve", text = "" },
	Verite = { title = "La vérité", text = "" },
	Ordonnance = { title = "Ordonnance 69-01", text = "" },
	Silence = { title = "Silence", text = "Le podcast est publié… incomplet" },
}

-- 15.6 : libellés courts absents du tableau → DÉFAUT (statuts de ResultsGui > Survivors)
LoreConfig.Status = {
	Extracted = "Extrait", -- DÉFAUT
	Dead = "Mort", -- DÉFAUT
	Missing = "Disparu", -- 5.1 : « disparus »
}

-- 15.6 : astuces de LoadingGui > Tip, tirées au hasard
LoreConfig.LoadingTips = {
	"Une lampe allumée se voit de très loin.",
	"Le bruit de l'eau couvre tes pas.",
	"Seul, tu es discret. Seul, tu es une proie.",
}

return LoreConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">MapConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/MapConfig
-- Toutes les positions viennent de la section 3 de la bible. Ne rien ajouter ici sans la bible.
-- Repère (3.1) : X vers l'est, Z vers le sud (nord = −Z), Y = altitude du sol.
local MapConfig = {}

-- 3.1 : zone jouable et bande décorative
MapConfig.Size = 8000
MapConfig.PlayableHalf = 4000
MapConfig.DecorHalf = 4600
MapConfig.WarnHalf = 3900 -- message « Tu t'éloignes trop du groupe »
MapConfig.WarnText = "Tu t'éloignes trop du groupe" -- 3.8
MapConfig.HighestPlayableY = 560

-- 3.2 : lieux. pos = (X, Y du sol, Z) ; radius en studs.
-- Pour les zones et couloirs : from / to (X, Z), Y bas → haut.
MapConfig.Places = {
	P01 = { name = "Parking du sentier d'Ape Canyon", pos = Vector3.new(2800, 120, 3200), radius = 60 },
	P02 = {
		name = "Coulée de lahar",
		corridor = { from = Vector2.new(1800, -1500), to = Vector2.new(2400, 3600), width = 600 },
		yLow = 110,
		yHigh = 380,
	},
	P03 = {
		name = "Lava Canyon (fond de gorge)",
		pos = Vector3.new(3200, 40, 2200),
		radius = 120,
		rimY = 110,
		floorY = 40,
	},
	P04 = {
		name = "Forêt ancienne",
		zone = { minX = 507, maxX = 1800, minZ = -507, maxZ = 2507 },
		yLow = 150,
		yHigh = 330,
	},
	P05 = { name = "Ape Canyon", pos = Vector3.new(2600, 250, -1400), radius = 300, rimY = 400, floorY = 250 },
	P05c = { name = "Ruine de la cabane de 1924", pos = Vector3.new(2550, 300, -1300), radius = 25 },
	P05s = { name = "« Étroit » du canyon", pos = Vector3.new(2700, 330, -1650), width = 9 },
	P06 = { name = "Plateau de cendres", pos = Vector3.new(1200, 480, -2600), radius = 900 },
	P07a = { name = "Ape Cave, entrée principale", pos = Vector3.new(-2507, 60, 2400), radius = 20, tubeY = 5 },
	P07b = { name = "Salle du repaire", pos = Vector3.new(-2900, 30, 1700), radius = 45, underground = true },
	P07c = { name = "Sortie basse bouchée par le lahar", pos = Vector3.new(-2300, 20, 3600), radius = 6 },
	P08 = {
		name = "Zone interdite (forêt soufflée)",
		zone = { minX = -3707, maxX = -507, minZ = -3707, maxZ = -800 },
		yLow = 300,
		yHigh = 430,
	},
	P09 = { name = "Camp des géologues", pos = Vector3.new(-800, 230, 600), radius = 50 },
