      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">LaunchConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/LaunchConfig
-- Groupe, lancement et téléportation Lobby ↔ Partie : bible, sections 4.4, 16.1, 16.3 et 16.4.
-- Ne rien ajouter ici sans la bible.
local LaunchConfig = {}

-- 16.4 : expérience « PISTE FROIDE (test) » (relevés le 22 octobre 2026 ;
-- à reconfirmer dans le Creator Dashboard si l'expérience a été recréée)
LaunchConfig.PlaceIds = {
	Lobby = 77677833738174,
	Partie = 103506696801797,
}

-- 4.4 : groupe
LaunchConfig.Party = {
	MinSize = 1, -- capacité 1 à 10
	MaxSize = 10,
	PrivateCodeDigits = 4, -- groupe privé : code à 4 chiffres
	ReadyCountdown = 10, -- tous « Prêt » → compte à rebours de 10 s
}

-- 16.4 : MemoryStore
LaunchConfig.MemoryStore = {
	-- « Parties » : carte triée des groupes du lobby, durée de vie 900 s
	PartiesMapName = "Parties",
	PartiesTTL = 900,
	-- limite de l'API Roblox (MemoryStoreSortedMap:GetRangeAsync lit 200 entrées au plus)
	PartiesScanCount = 200,
	-- « Launch_<PrivateServerId> » : configuration de partie lue par la Partie, durée de vie 600 s
	LaunchMapName = "Launch", -- DÉFAUT : carte de hachage qui contient les clés Launch_
	LaunchKeyPrefix = "Launch_",
	LaunchTTL = 600,
	-- valeurs techniques acceptées le 4 novembre 2026 (16.4) : essais et délai (s) par appel MemoryStore
	Attempts = 3,
	RetryDelay = 2,
}

-- DÉFAUT (valeurs techniques) : essais et délai (s) d'une téléportation ratée
-- (départ : MSG_TeleportRetry puis MSG_TeleportAbort, 4.6 ; retour au Lobby)
LaunchConfig.Teleport = {
	Attempts = 3,
	RetryDelay = 5,
}

-- 16.2 : PartyLoaderService attend les joueurs 60 s au plus
LaunchConfig.ArrivalTimeout = 60

-- 16.3 : toutes les remotes client → serveur sont limitées à 10 appels par seconde ;
-- RE_Ping : 1 toutes les 2 s
LaunchConfig.RateLimits = {
	Default = { calls = 10, per = 1 },
	RE_Ping = { calls = 1, per = 2 },
}

return LaunchConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">LoreConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/LoreConfig
-- Textes de la bible : documents DOC_xx (2.7), panneaux M1-M8 (4.3), dialogues (4.2),
-- messages système (4.6). Claude Code recopie ces textes, il n'en rédige pas d'autre (section 2).
-- Les documents sont recopiés au jalon J7, le musée et les dialogues au jalon J14.
local LoreConfig = {}

-- 4.6 : messages système, affichés par NotificationGui.
-- Le serveur envoie la clé avec RE_Notify ; {player} et {n} sont remplacés par le code.
LoreConfig.Messages = {
	MSG_PartyFull = "Ce groupe est complet (10 joueurs).",
	MSG_CodeInvalid = "Aucun groupe ne correspond à ce code.",
	MSG_QuickJoinNone = "Aucun groupe public disponible. Crée le tien.",
	MSG_PartyLeft = "Tu as quitté le groupe.",
	MSG_HostLeft = "Le créateur du groupe est parti. {player} prend sa place.",
	MSG_RoleTaken = "Ce rôle est déjà pris par {player}.",
	MSG_RoleRequired = "Choisis un rôle avant d'être prêt.",
	MSG_WeaponTaken = "Cette arme est déjà attribuée à {player}.",
	MSG_WeaponNotAllowed = "L'opératrice radio ne peut pas porter d'arme à feu.",
	MSG_WeaponVote = "Deux joueurs veulent la même arme. Votez : 15 secondes.",
	MSG_NightmareLocked = "Cauchemar se débloque après une première survie.",
	MSG_WaitingReady = "En attente : {n} joueur(s) pas encore prêt(s).",
	MSG_Countdown = "Départ dans {n} s.",
	MSG_CountdownCancelled = "Départ annulé : un joueur n'est plus prêt.",
	MSG_Teleporting = "En route vers la forêt…",
	MSG_TeleportRetry = "Le départ a échoué. Nouvel essai…",
	MSG_TeleportAbort = "Impossible de partir pour l'instant. Réessayez dans un moment.",
	MSG_WaitingPlayers = "En attente des autres membres du groupe…",
	MSG_PlayerMissing = "{player} n'a pas rejoint la forêt.",
	MSG_VersionMismatch = "Une mise à jour est en cours. Retour en ville.",
	MSG_ReturnToLobby = "Retour en ville…",
	MSG_DataLoadFailed = "Ta progression n'a pas pu être chargée. Elle ne sera pas sauvegardée pendant cette session.",
}

return LoreConfig
]]></string>
        </Properties>
      </Item>
