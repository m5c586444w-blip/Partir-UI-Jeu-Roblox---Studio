      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PlayerConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/PlayerConfig
-- Valeurs de la bible, sections 2.5 et 7. Ne rien ajouter ici sans la bible.
-- Jalon J1 : seulement la liste des rôles (nécessaire aux données de 16.4).
-- Le reste de la section 7 (vitesses, santé, endurance, peur...) est rempli au jalon J6 (phase A3).
local PlayerConfig = {}

-- 2.5 : les 10 rôles jouables, dans l'ordre de la bible.
-- id = identifiant anglais utilisé dans les noms (RoleCard_<ROLE>, Characters/<ROLE>, VO_<ROLE>_*)
-- et comme clé dans les données (skins, equipped, section 16.4).
-- Seul « Leader » est donné par la bible (16.4, VO_Leader_Order).
-- Un rôle sans id est ignoré par les scripts tant que la bible ne le donne pas.
PlayerConfig.Roles = {
	{ id = "Leader", title = "Meneur" },
	{ id = nil, title = "Médecin" }, -- TODO(BIBLE): identifiant anglais du rôle Médecin
	{ id = nil, title = "Pisteur" }, -- TODO(BIBLE): identifiant anglais du rôle Pisteur
	{ id = nil, title = "Caméraman" }, -- TODO(BIBLE): identifiant anglais du rôle Caméraman
	{ id = nil, title = "Mécanicienne" }, -- TODO(BIBLE): identifiant anglais du rôle Mécanicienne
	{ id = nil, title = "Descendante" }, -- TODO(BIBLE): identifiant anglais du rôle Descendante
	{ id = nil, title = "Géologue" }, -- TODO(BIBLE): identifiant anglais du rôle Géologue
	{ id = nil, title = "Sportif" }, -- TODO(BIBLE): identifiant anglais du rôle Sportif
	{ id = nil, title = "Opératrice radio" }, -- TODO(BIBLE): identifiant anglais du rôle Opératrice radio
	{ id = nil, title = "Pyrotechnicien" }, -- TODO(BIBLE): identifiant anglais du rôle Pyrotechnicien
}

return PlayerConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ProgressionConfig</string>
          <string name="Source"><![CDATA[-- ReplicatedStorage/Config/ProgressionConfig
-- Valeurs de la bible, section 16.4 (données, XP) et 16.2 (DataService).
-- Ne rien ajouter ici sans la bible.
-- Les règles de déblocage des skins (7.1) et de Cauchemar (5.4) sont ajoutées au jalon J14.
local ProgressionConfig = {}

-- 16.4 : DataStore PisteFroide_v1, clé player_<UserId>
ProgressionConfig.DataStoreName = "PisteFroide_v1"
ProgressionConfig.KeyPrefix = "player_"

-- 16.4 : champ « version » des données
ProgressionConfig.DataVersion = 1

-- 16.2 : sauvegarde toutes les 120 s et à la fermeture
ProgressionConfig.AutosaveInterval = 120

-- 16.4 : liste des preuves, 200 au plus
ProgressionConfig.MaxEvidence = 200

-- 16.4 : clés des fins (5.3)
ProgressionConfig.EndingIds = { "Survie", "Preuve", "Verite", "Ordonnance", "Silence" }

-- 16.4 et 4.3 : panneaux du musée M1 à M8
ProgressionConfig.MuseumPanelIds = { "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8" }

-- 16.4 : pages du carnet Halvorsen (DOC_12) ; la page 1 est débloquée au départ
ProgressionConfig.DefaultNotebookPages = { true, false, false }

-- 7.1 : 3 skins par personnage, A dès le début
ProgressionConfig.SkinIds = { "A", "B", "C" }
ProgressionConfig.DefaultSkin = "A"

-- 16.4 : niveau = partie entière de la racine de (XP ÷ 100)
ProgressionConfig.XPPerLevelDivisor = 100

-- 16.4 : gains d'XP ; preuves selon 8.4
ProgressionConfig.XPGains = {
	MuseumPanel = 5, -- panneau de musée lu (première fois, 4.2)
	GamePlayed = 50, -- partie jouée
	Survival = 200, -- survie
	EvidenceA = 500, -- 8.4 : vidéo du Caméraman
	EvidenceB = 150, -- 8.4 : moulage, cri, poils, photo
	EvidenceC = 50, -- 8.4 : document, photo du charnier
}

-- 16.2 : verrouillage de session. Ces trois valeurs ne sont pas dans la bible.
ProgressionConfig.SessionLock = {
	-- TODO(BIBLE): PROPOSITION — un verrou non rafraîchi depuis 360 s (3 sauvegardes manquées) est considéré abandonné
	StaleAfter = 360,
	-- TODO(BIBLE): PROPOSITION — nombre d'essais de chargement si une autre place tient encore le verrou (téléportation)
	LoadAttempts = 6,
	-- TODO(BIBLE): PROPOSITION — secondes entre deux essais de chargement
	LoadRetryDelay = 5,
}

return ProgressionConfig
]]></string>
        </Properties>
      </Item>
