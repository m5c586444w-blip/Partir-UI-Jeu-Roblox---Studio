      </Properties>
      <Item class="LocalScript" referent="782">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[-- StarterPlayer/StarterPlayerScripts/ClientBootstrap (les deux places)
-- DÉFAUT : charge tous les contrôleurs de StarterPlayerScripts/Controllers (16.1, 16.2) :
-- Init() de chacun, puis Start(). Un contrôleur en erreur n'arrête pas les autres.
local controllersFolder = script.Parent:WaitForChild("Controllers")

local controllers = {}
local names = {}
for _, module in controllersFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok then
			controllers[module.Name] = result
			table.insert(names, module.Name)
		else
			warn("ClientBootstrap : échec du chargement de " .. module.Name .. " : " .. tostring(result))
		end
	end
end
table.sort(names)

for _, name in names do
	local controller = controllers[name]
	if controller.Init then
		local ok, err = pcall(controller.Init, controller, controllers)
		if not ok then
			warn("ClientBootstrap : échec de " .. name .. ".Init : " .. tostring(err))
		end
	end
end

for _, name in names do
	local controller = controllers[name]
	if controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start, controller)
			if not ok then
				warn("ClientBootstrap : échec de " .. name .. ".Start : " .. tostring(err))
			end
		end)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="783">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="784">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[-- Controllers/CameraController (Partie)
-- Sections 7.2 et 6.3 : vue à la première personne verrouillée, FOV 70 (76 en course),
-- balancement de marche (par code, 14.3), se pencher ; caméra de mort : 4 s au-dessus du corps,
-- inclinée de 10°, puis spectateur (SpectatorController).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))

local CameraController = {}

local player = Players.LocalPlayer
local controllers = nil
local Interface = PlayerConfig.Interface
local bobTime = 0
local deathCamUntil = nil

-- 17.2 : « Réduire les mouvements » (balancement de caméra) ; lu par SettingsController
CameraController.ReduceMotion = false

function CameraController:IsDeathCam()
	return deathCamUntil ~= nil and os.clock() < deathCamUntil
end

local function startDeathCam()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root == nil then
		return
	end
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	-- 6.3 : légèrement au-dessus du corps, inclinée de 10°, sans gros plan
	local above = root.Position + Vector3.new(0, PlayerConfig.DeathCamera.Height, 0)
	camera.CFrame = CFrame.new(above)
		* CFrame.Angles(math.rad(PlayerConfig.DeathCamera.TiltDegrees) - math.pi / 2, 0, 0)
	deathCamUntil = os.clock() + PlayerConfig.DeathCamera.Duration
	task.delay(PlayerConfig.DeathCamera.Duration, function()
		if controllers.SpectatorController then
			controllers.SpectatorController:Begin()
		end
	end)
end

local function update(dt)
	if
		player:GetAttribute("isDead")
		or controllers.SpectatorController and controllers.SpectatorController:IsActive()
	then
		return
	end
	if controllers.CinematicController and controllers.CinematicController:IsPlaying() then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	local camera = workspace.CurrentCamera
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	local running = player:GetAttribute("stance") == "Run" and humanoid.MoveDirection.Magnitude > 0.1
	camera.FieldOfView = if running
		then PlayerConfig.Camera.RunFieldOfView
		else (CameraController.FieldOfView or PlayerConfig.Camera.FieldOfView)

	local lean = controllers.InputController and controllers.InputController:GetLean() or 0
	local offset = Vector3.new(lean * Interface.LeanOffset, 0, 0)
	if not CameraController.ReduceMotion and humanoid.MoveDirection.Magnitude > 0.1 then
		bobTime += dt * humanoid.WalkSpeed / PlayerConfig.Movement.Walk.speed * Interface.BobFrequency
		offset += Vector3.new(0, math.sin(bobTime) * Interface.BobAmplitude, 0)
	end
	humanoid.CameraOffset = offset
end

function CameraController:Init(all)
	controllers = all
end

function CameraController:Start()
	player:GetAttributeChangedSignal("isDead"):Connect(function()
		if player:GetAttribute("isDead") then
			startDeathCam()
		end
	end)
	RunService.RenderStepped:Connect(update)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="785">
          <Properties>
            <string name="Name">DocumentController</string>
            <string name="Source"><![CDATA[-- Controllers/DocumentController (Partie)
-- Sections 2.7 et 15.4 : DocumentGui. Paper > Title, Body, Picture, Close ; Tape > Label, Play,
-- Progress > Fill. RE_OpenDocument (docId). Textes : LoreConfig.Documents.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local AudioConfig = require(Config:WaitForChild("AudioConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local DocumentController = {}

local root = nil

local function find(path)
	return Util.findUI(root, "DocumentGui/" .. path)
end

local function notebookText(doc)
	local pages = Util.decode(Util.getMatchState():GetAttribute("notebookPages"), { true })
	local lines = {}
	for i, text in doc.pages do
		if pages[i] then
			table.insert(lines, text)
		end
	end
	return table.concat(lines, "\n\n")
end

function DocumentController:Open(docId)
	local doc = LoreConfig.Documents[docId]
	if doc == nil or root == nil then
		return
	end
	local paper, tape = find("Paper"), find("Tape")
	local isTape = doc.kind == "Tape"
	if paper then
		paper.Visible = true
		find("Paper/Title").Text = doc.title
		find("Paper/Body").Text = if doc.pages then notebookText(doc) else (doc.body or "")
		find("Paper/Picture").Visible = doc.image ~= nil
	end
	if tape then
		tape.Visible = isTape
		find("Tape/Label").Text = doc.title
	end
	self.current = docId
end

function DocumentController:Start()
	local gui = Util.waitGui("DocumentGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	local close = find("Paper/Close")
	if close then
		close.Activated:Connect(function()
			find("Paper").Visible = false
			find("Tape").Visible = false
		end)
	end
	local play = find("Tape/Play")
	if play then
		play.Activated:Connect(function()
			-- 13.7 : les enregistrements (cassettes, DOC_14) sont à fournir ; AudioConfig.Documents vide en attendant
			local soundId = AudioConfig.Documents and AudioConfig.Documents[self.current]
			if soundId == nil then
				warn("DocumentController : son manquant pour " .. tostring(self.current))
			end
		end)
	end
	local remote = Util.getRemote("RE_OpenDocument")
	if remote then
		remote.OnClientEvent:Connect(function(docId)
			self:Open(docId)
		end)
	end
end

return DocumentController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="786">
          <Properties>
            <string name="Name">DownedController</string>
            <string name="Source"><![CDATA[-- Controllers/DownedController (Partie)
-- Sections 7.3 et 15.4 : DownedGui > Countdown, HelpHint, Bleed > Fill, visibles à terre.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local DownedController = {}

local player = Players.LocalPlayer

function DownedController:Start()
	local gui = Util.waitGui("DownedGui")
	if gui == nil then
		return
	end
	local countdown = Util.findUI(gui.Parent, "DownedGui/Countdown")
	local hint = Util.findUI(gui.Parent, "DownedGui/HelpHint")
	local bleed = Util.findUI(gui.Parent, "DownedGui/Bleed")
	local fill = bleed and bleed:FindFirstChild("Fill")
	RunService.RenderStepped:Connect(function()
		local downed = player:GetAttribute("isDowned") == true and not player:GetAttribute("isDead")
		for _, element in { countdown, hint, bleed } do
			if element then
				element.Visible = downed
			end
		end
		if downed then
			local left = math.max(0, (player:GetAttribute("downedEnd") or 0) - workspace:GetServerTimeNow())
			if countdown then
				countdown.Text = tostring(math.ceil(left))
			end
			if fill then
				fill.Size = UDim2.new((player:GetAttribute("blood") or 0) / PlayerConfig.Blood.Max, 0, 1, 0)
			end
		end
	end)
end

return DownedController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="787">
          <Properties>
            <string name="Name">FearFXController</string>
            <string name="Source"><![CDATA[-- Controllers/FearFXController (Partie)
-- Sections 7.3 et 7.5 : effets locaux. Sang < 40 : vision qui se désature ; tête < 30 % : vision
-- floue ; peur ≥ 40 : battements de cœur (son à fournir, AudioConfig) ; le vignettage est dans HUDController.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))

local FearFXController = {}

local player = Players.LocalPlayer

function FearFXController:Start()
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "PlayerBloodFX"
	color.Parent = Lighting
	local blur = Instance.new("BlurEffect")
	blur.Name = "PlayerHeadFX"
	blur.Size = 0
	blur.Parent = Lighting
	RunService.RenderStepped:Connect(function()
		local blood = player:GetAttribute("blood") or PlayerConfig.Blood.Max
		local below = PlayerConfig.Blood.DesaturateBelow
		color.Saturation = if blood < below then PlayerConfig.Interface.LowBloodSaturation * (1 - blood / below) else 0
		local head = (player:GetAttribute("hpHead") or PlayerConfig.LimbHealth.Head) / PlayerConfig.LimbHealth.Head
		blur.Size = if head < PlayerConfig.LowLimbThreshold then PlayerConfig.Interface.LowHeadBlur else 0
	end)
end

return FearFXController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="788">
          <Properties>
            <string name="Name">HUDController</string>
            <string name="Source"><![CDATA[-- Controllers/HUDController (Partie)
-- Section 15.4 : HUDGui. Membres (Ok / Hurt / Critical, une seule visible), hémorragie, endurance,
-- pile, munitions, objet tenu, réticule (seulement en visant, 7.2), vignettage de peur (7.5 : jamais
-- de chiffre). 15.2 : le HUD s'efface après 4 s sans changement et réapparaît à la moindre variation.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local HUDController = {}

local player = Players.LocalPlayer
local controllers = nil
local root = nil
local ui = {}
local lastChange = 0
local hidden = false

local FADING = { "BodyStatus", "Stamina", "Battery", "Ammo", "HeldItem" }

local function find(path)
	return Util.findUI(root, "HUDGui/" .. path)
end

local function maxFor(limb)
	local override = PlayerConfig.RoleLimbHealth[player:GetAttribute("role")]
	return (override and override[limb]) or PlayerConfig.LimbHealth[limb]
end

local function touch()
	lastChange = os.clock()
	if hidden then
		hidden = false
		for _, name in FADING do
			if ui[name] then
				ui[name].Visible = true
			end
		end
		HUDController:Refresh()
	end
end

local function setFill(frame, value)
	local fill = frame and frame:FindFirstChild("Fill")
	if fill then
		fill.Size = UDim2.new(math.clamp(value, 0, 1), 0, fill.Size.Y.Scale, fill.Size.Y.Offset)
	end
end

function HUDController:Refresh()
	for _, limb in PlayerConfig.Limbs do
		local frame = ui.limbs[limb]
		if frame then
			local value = (player:GetAttribute("hp" .. limb) or maxFor(limb)) / maxFor(limb)
			-- DÉFAUT : Ok = intact, Hurt = touché, Critical = sous 30 % (7.3)
			local state = if value < PlayerConfig.LowLimbThreshold then "Critical" elseif value < 1 then "Hurt" else "Ok"
			for _, name in { "Ok", "Hurt", "Critical" } do
				local child = frame:FindFirstChild(name)
				if child then
					child.Visible = name == state
				end
			end
		end
	end
	if ui.BleedIcon then
		ui.BleedIcon.Visible = (player:GetAttribute("bleed") or "None") ~= "None"
	end
	local stamina = player:GetAttribute("stamina") or 0
	local maxStamina = PlayerConfig.Stamina.RoleMax[player:GetAttribute("role")] or PlayerConfig.Stamina.Max
	setFill(ui.Stamina, stamina / maxStamina)
	setFill(ui.Battery, player:GetAttribute("lightBattery") or 1)

	local held = player:GetAttribute("heldItem")
	local weapon = held and WeaponConfig.Weapons[held]
	if ui.Ammo then
		ui.Ammo.Visible = weapon ~= nil and weapon.ammo ~= nil and not hidden
		local count = ui.Ammo:FindFirstChild("Count")
		local reserve = ui.Ammo:FindFirstChild("Reserve")
		if count then
			count.Text = tostring(player:GetAttribute("ammo") or 0)
		end
		if reserve then
			reserve.Text = tostring(player:GetAttribute("ammoReserve") or 0)
		end
	end
	if ui.HeldItem then
		local def = held and (ItemConfig.Items[held] or WeaponConfig.Weapons[held])
		ui.HeldItem.Text = def and def.name or ""
	end
end

-- 7.7 : le Meneur voit ses coéquipiers en contour à travers le décor, à 30 studs
local outlines = {}
local function updateOutlines()
	local isLeader = player:GetAttribute("role") == "Leader" and not player:GetAttribute("isDead")
	local myRoot = Util.characterRoot(player)
	local range = PlayerConfig.Abilities.Leader.OutlineRange
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local character = other.Character
			local otherRoot = Util.characterRoot(other)
			local show = isLeader and myRoot and otherRoot and (otherRoot.Position - myRoot.Position).Magnitude <= range
			local highlight = outlines[other]
			if show and character and (highlight == nil or highlight.Parent ~= character) then
				highlight = Instance.new("Highlight")
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillTransparency = 1
				highlight.Parent = character
				outlines[other] = highlight
			elseif not show and highlight then
				highlight:Destroy()
				outlines[other] = nil
			end
		end
	end
end

local function update()
	updateOutlines()
	if ui.Crosshair then
		ui.Crosshair.Visible = controllers.InputController ~= nil and controllers.InputController:IsAiming()
	end
	if ui.FearVignette then
		-- 15.1 : transparence en fondu entre la valeur réglée et 1
		local fear = (player:GetAttribute("fear") or 0) / PlayerConfig.Fear.Max
		local minT = PlayerConfig.Interface.FearVignetteMinTransparency
		ui.FearVignette.ImageTransparency = 1 - fear * (1 - minT)
	end
	if not hidden and os.clock() - lastChange > PlayerConfig.Interface.HudFadeAfter then
		hidden = true
		for _, name in FADING do
			if ui[name] then
				ui[name].Visible = false
			end
		end
	end
end

function HUDController:Init(all)
	controllers = all
end

function HUDController:Start()
	local gui = Util.waitGui("HUDGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	ui.limbs = {}
	for _, limb in PlayerConfig.Limbs do
		ui.limbs[limb] = find("BodyStatus/" .. limb)
	end
	for _, name in { "BodyStatus", "BleedIcon", "Stamina", "Battery", "Ammo", "HeldItem", "Crosshair", "FearVignette" } do
		ui[name] = find(name)
	end
	local watched = { "bleed", "stamina", "lightBattery", "heldItem", "ammo", "ammoReserve", "role" }
	for _, limb in PlayerConfig.Limbs do
		table.insert(watched, "hp" .. limb)
	end
	for _, name in watched do
		player:GetAttributeChangedSignal(name):Connect(function()
			touch()
			HUDController:Refresh()
		end)
	end
	touch()
	self:Refresh()
	RunService.RenderStepped:Connect(update)
end

return HUDController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="789">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- Controllers/InputController (Partie)
-- Section 16.2 : clavier, manette, MobileControlsGui (visible seulement sur écran tactile, 15.4).
-- Envoie des intentions au serveur : RE_SetStance, RE_EquipSlot, RE_UseItem, RE_FireWeapon,
-- RE_Reload, RE_ToggleLight, RE_Ping, RE_TabletAction. Touches : PlayerConfig.Keys (DÉFAUT).
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local InputController = {}

local player = Players.LocalPlayer
local Keys = PlayerConfig.Keys
local remotes = {}
local controllers = nil
local stance = "Stand"
local lean = 0 -- −1 gauche, 0, 1 droite
local aiming = false
local activePrompt = nil

local function fire(name, ...)
	local remote = remotes[name]
	if remote then
		remote:FireServer(...)
	end
end

local function setStance(new)
	stance = new
	fire("RE_SetStance", new)
end

local function toggleStance(target)
	setStance(if stance == target then "Stand" else target)
end

function InputController:GetLean()
	return lean
end

function InputController:IsAiming()
	return aiming
end

local function selectedSlot()
	local inv = Util.decode(player:GetAttribute("inventory"), nil)
	return inv and inv.selected or 1
end

-- clic principal : tir si une arme est en main, sinon utiliser l'objet tenu
local function primary()
	local held = player:GetAttribute("heldItem")
	local camera = workspace.CurrentCamera
	if held and WeaponConfig.Weapons[held] then
		fire("RE_FireWeapon", camera.CFrame.Position, camera.CFrame.LookVector, workspace:GetServerTimeNow())
	elseif held and ItemConfig.Items[held] then
		fire("RE_UseItem", selectedSlot())
	end
end

local function ping()
	local camera = workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local hit = workspace:Raycast(
		camera.CFrame.Position,
		camera.CFrame.LookVector * PlayerConfig.Communication.PingRayLength,
		params
	)
	if hit then
		fire("RE_Ping", hit.Position)
	end
end

local ACTIONS = {
	Sprint = {
		down = function()
			setStance("Run")
		end,
		up = function()
			if stance == "Run" then
				setStance("Stand")
			end
		end,
	},
	Crouch = {
		down = function()
			toggleStance("Crouch")
		end,
	},
	Prone = {
		down = function()
			toggleStance("Prone")
		end,
	},
	LeanL = {
		down = function()
			lean = -1
		end,
		up = function()
			if lean == -1 then
				lean = 0
			end
		end,
	},
	LeanR = {
		down = function()
			lean = 1
		end,
		up = function()
			if lean == 1 then
				lean = 0
			end
		end,
	},
	Light = {
		down = function()
			fire("RE_ToggleLight")
		end,
	},
	Reload = {
		down = function()
			fire("RE_Reload")
		end,
	},
	Tablet = {
		down = function()
			fire("RE_TabletAction", "Device", "Toggle")
		end,
	},
	Ping = { down = ping },
	Bag = {
		down = function()
			if controllers.InventoryController then
				controllers.InventoryController:ToggleBag()
			end
		end,
	},
	Ability = {
		down = function()
			fire("RE_UseItem", 0)
		end,
	},
	Fire = { down = primary },
	Aim = {
		down = function()
			aiming = true
		end,
		up = function()
			aiming = false
		end,
	},
	Interact = {
		down = function()
			if activePrompt then
				activePrompt:InputHoldBegin()
			end
		end,
		up = function()
			if activePrompt then
				activePrompt:InputHoldEnd()
			end
		end,
	},
}

local KEYBOARD = {
	[Keys.Sprint] = "Sprint",
	[Keys.Crouch] = "Crouch",
	[Keys.Prone] = "Prone",
	[Keys.LeanL] = "LeanL",
	[Keys.LeanR] = "LeanR",
	[Keys.Light] = "Light",
	[Keys.Reload] = "Reload",
	[Keys.Tablet] = "Tablet",
	[Keys.Ping] = "Ping",
	[Keys.Bag] = "Bag",
	[Keys.Ability] = "Ability",
	[Keys.GamepadSprint] = "Sprint",
	[Keys.GamepadCrouch] = "Crouch",
	[Keys.GamepadFire] = "Fire",
	[Keys.GamepadAim] = "Aim",
	[Keys.GamepadReload] = "Reload",
}

local function onInput(input, processed, isDown)
	if processed and isDown then
		return
	end
	local name = KEYBOARD[input.KeyCode]
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		name = "Fire"
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		name = "Aim"
	end
	if name then
		local action = ACTIONS[name]
		local handler = if isDown then action.down else action.up
		if handler then
			handler()
		end
		return
	end
	if isDown then
		local slot = table.find(Keys.Slots, input.KeyCode)
		if slot then
			fire("RE_EquipSlot", slot)
		end
	end
end

-- MobileControlsGui : un bouton par action (15.4), visible seulement sur écran tactile
local function bindMobile()
	if not UserInputService.TouchEnabled then
		return
	end
	local gui = Util.waitGui("MobileControlsGui")
	if gui == nil then
		return
	end
	local map = {
		Sprint = "Sprint",
		Crouch = "Crouch",
		Prone = "Prone",
		Interact = "Interact",
		Aim = "Aim",
		Fire = "Fire",
		Reload = "Reload",
		Light = "Light",
		Tablet = "Tablet",
		Ping = "Ping",
		LeanL = "LeanL",
		LeanR = "LeanR",
	}
	for buttonName, actionName in map do
		local button = Util.findUI(gui.Parent, "MobileControlsGui/" .. buttonName)
		if button then
			button.Visible = true
			local action = ACTIONS[actionName]
			-- courir et viser : maintien ; les autres : appui
			button.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch and action.down then
					action.down()
				end
			end)
			button.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch and action.up then
					action.up()
				end
			end)
		end
	end
end

function InputController:Init(all)
	controllers = all
end

function InputController:Start()
	for _, name in
		{
			"RE_SetStance",
			"RE_EquipSlot",
			"RE_UseItem",
			"RE_FireWeapon",
			"RE_Reload",
			"RE_ToggleLight",
			"RE_Ping",
			"RE_TabletAction",
		}
	do
		remotes[name] = Util.getRemote(name)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		onInput(input, processed, true)
	end)
	UserInputService.InputEnded:Connect(function(input, processed)
		onInput(input, processed, false)
	end)
	ProximityPromptService.PromptShown:Connect(function(prompt)
		activePrompt = prompt
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		if activePrompt == prompt then
			activePrompt = nil
		end
	end)
	bindMobile()
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="790">
          <Properties>
            <string name="Name">InteractController</string>
            <string name="Source"><![CDATA[-- Controllers/InteractController (Partie)
-- Section 15.4 : InteractGui > Prompt > KeyHint, ActionText, Progress > Fill, pour les
-- ProximityPrompt en style Custom. La durée de maintien propre au joueur (rôle, outils) est lue
-- dans l'attribut hold_<UserId> de l'invite (InteractionService).
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local InteractController = {}

local player = Players.LocalPlayer
local frame, keyHint, actionText, fill = nil, nil, nil, nil
local current = nil
local holdBegan = nil

local function keyName(prompt)
	if UserInputService.TouchEnabled then
		return ""
	end
	return UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
end

local function show(prompt)
	current = prompt
	local hold = prompt:GetAttribute("hold_" .. player.UserId)
	if hold ~= nil then
		prompt.HoldDuration = hold
	end
	if frame then
		frame.Visible = true
		actionText.Text = prompt.ActionText
		keyHint.Text = keyName(prompt)
		fill.Size = UDim2.new(0, 0, fill.Size.Y.Scale, 0)
	end
end

local function hide(prompt)
	if current == prompt then
		current = nil
		holdBegan = nil
		if frame then
			frame.Visible = false
		end
	end
end

function InteractController:Start()
	local gui = Util.waitGui("InteractGui")
	if gui then
		frame = Util.findUI(gui.Parent, "InteractGui/Prompt")
		keyHint = Util.findUI(gui.Parent, "InteractGui/Prompt/KeyHint")
		actionText = Util.findUI(gui.Parent, "InteractGui/Prompt/ActionText")
		fill = Util.findUI(gui.Parent, "InteractGui/Prompt/Progress/Fill")
	end
	ProximityPromptService.PromptShown:Connect(function(prompt)
		if prompt.Style == Enum.ProximityPromptStyle.Custom then
			show(prompt)
		end
	end)
	ProximityPromptService.PromptHidden:Connect(hide)
	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
		if prompt == current then
			holdBegan = os.clock()
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
		if prompt == current then
			holdBegan = nil
			if fill then
				fill.Size = UDim2.new(0, 0, fill.Size.Y.Scale, 0)
			end
		end
	end)
	RunService.RenderStepped:Connect(function()
		if current and holdBegan and fill and current.HoldDuration > 0 then
			local progress = math.clamp((os.clock() - holdBegan) / current.HoldDuration, 0, 1)
			fill.Size = UDim2.new(progress, 0, fill.Size.Y.Scale, 0)
		end
	end)
	-- écran tactile : toucher la fenêtre de l'invite déclenche l'interaction
	if frame then
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch and current then
				current:InputHoldBegin()
			end
		end)
		frame.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch and current then
				current:InputHoldEnd()
			end
		end)
	end
end

return InteractController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="791">
          <Properties>
            <string name="Name">InventoryController</string>
            <string name="Source"><![CDATA[-- Controllers/InventoryController (Partie)
-- Section 15.4 : InventoryGui. QuickSlots > Slot_1 à Slot_4 (> Icon, Count, Key, Selected) ;
-- Bag > Weight, List > Template (Icon, Name, Count, Drop). Lit l'attribut inventory (JSON).
-- La Mécanicienne n'a que 3 emplacements rapides (Slot_4 caché).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local InventoryController = {}

local player = Players.LocalPlayer
local root = nil
local bag = nil
local equipRemote, dropRemote = nil, nil

local function def(id)
	return ItemConfig.Items[id] or WeaponConfig.Weapons[id]
end

local function icon(id)
	return ItemConfig.Icons[id] or WeaponConfig.Icons[id] or ""
end

local function countText(entry)
	if entry.uses then
		return tostring(entry.uses)
	end
	if (entry.count or 1) > 1 then
		return tostring(entry.count)
	end
	return ""
end

function InventoryController:ToggleBag()
	if bag then
		bag.Visible = not bag.Visible
	end
end

local function refresh()
	local inv = Util.decode(player:GetAttribute("inventory"), nil)
	if inv == nil or root == nil then
		return
	end
	local quickCount = #inv.quick
	for i = 1, ItemConfig.QuickSlots do
		local slot = Util.findUI(root, ("InventoryGui/QuickSlots/Slot_%d"):format(i))
		if slot then
			slot.Visible = i <= quickCount
			local entry = inv.quick[i]
			local iconLabel = slot:FindFirstChild("Icon")
			local count = slot:FindFirstChild("Count")
			local key = slot:FindFirstChild("Key")
			local selected = slot:FindFirstChild("Selected")
			if iconLabel then
				iconLabel.Image = if entry then icon(entry.id) else ""
			end
			if count then
				count.Text = if entry then countText(entry) else ""
			end
			if key then
				key.Text = tostring(i)
			end
			if selected then
				selected.Visible = inv.selected == i
			end
		end
	end
	if bag == nil then
		return
	end
	local weight = bag:FindFirstChild("Weight")
	if weight then
		-- DÉFAUT : format « 3,4 / 12 kg »
		weight.Text = (string.gsub(string.format("%.1f / %d kg", inv.weight or 0, ItemConfig.BagMaxWeight), "%.", ","))
	end
	local template = Util.findUI(root, "InventoryGui/Bag/List/Template")
	if template == nil then
		return
	end
	Util.clearClones(template)
	for index, entry in inv.bag do
		local row = Util.cloneTemplate(template, index)
		local d = def(entry.id)
		local name = row:FindFirstChild("Name")
		local count = row:FindFirstChild("Count")
		local iconLabel = row:FindFirstChild("Icon")
		local drop = row:FindFirstChild("Drop")
		if name then
			name.Text = d and d.name or entry.id
		end
		if count then
			count.Text = countText(entry)
		end
		if iconLabel then
			iconLabel.Image = icon(entry.id)
		end
		if drop and dropRemote then
			drop.Activated:Connect(function()
				dropRemote:FireServer(quickCount + index)
			end)
		end
	end
end

function InventoryController:Start()
	local gui = Util.waitGui("InventoryGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	bag = Util.findUI(root, "InventoryGui/Bag")
	equipRemote = Util.getRemote("RE_EquipSlot")
	dropRemote = Util.getRemote("RE_DropItem")
	for i = 1, ItemConfig.QuickSlots do
		local slot = Util.findUI(root, ("InventoryGui/QuickSlots/Slot_%d"):format(i))
		if slot then
			slot.InputBegan:Connect(function(input)
				local click = input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				if click and equipRemote then
					equipRemote:FireServer(i)
				end
			end)
		end
	end
	player:GetAttributeChangedSignal("inventory"):Connect(refresh)
	refresh()
end

return InventoryController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="792">
          <Properties>
            <string name="Name">LightController</string>
            <string name="Source"><![CDATA[-- Controllers/LightController (Partie)
-- Sections 8.1 et 12.1 : lampes. Sous 15 % de pile, clignotement aléatoire (effet local, sur toutes
-- les lampes de joueurs taguées « PlayerLamp » ; la pile est lue sur l'attribut lightBattery du porteur).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AmbienceConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("AmbienceConfig"))
local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))

local LightController = {}

function LightController:Start()
	local random = Random.new()
	RunService.Heartbeat:Connect(function()
		for _, lamp in CollectionService:GetTagged("PlayerLamp") do
			local character = lamp:FindFirstAncestorOfClass("Model")
			local owner = character and Players:GetPlayerFromCharacter(character)
			local battery = owner and owner:GetAttribute("lightBattery") or 1
			if battery < AmbienceConfig.Lamp.FlickerBelow then
				lamp.Enabled = random:NextNumber() > PlayerConfig.Interface.LampFlickerChance
			else
				lamp.Enabled = true
			end
		end
	end)
end

return LightController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="793">
          <Properties>
            <string name="Name">ObjectiveController</string>
            <string name="Source"><![CDATA[-- Controllers/ObjectiveController (Partie)
-- Sections 5.1, 5.4 et 15.4 : ObjectiveGui > ActName, ObjectiveText, Clock. En Cauchemar, pas
-- d'indications d'objectif à l'écran (tablette seulement) ; l'heure reste affichée (DÉFAUT).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local ObjectiveController = {}

local MINUTES = 60 -- constante (minutes dans une heure)

-- DÉFAUT : heure au format de la bible (« 19 h 00 »)
local function formatClock(clock)
	local hours = math.floor(clock)
	local minutes = math.floor((clock - hours) * MINUTES)
	return ("%02d h %02d"):format(hours, minutes)
end

function ObjectiveController:Start()
	local gui = Util.waitGui("ObjectiveGui")
	if gui == nil then
		return
	end
	local actName = Util.findUI(gui.Parent, "ObjectiveGui/ActName")
	local objective = Util.findUI(gui.Parent, "ObjectiveGui/ObjectiveText")
	local clock = Util.findUI(gui.Parent, "ObjectiveGui/Clock")
	local state = Util.getMatchState()
	local function refresh()
		local difficulty = state:GetAttribute("difficulty")
		local hints = ActConfig.difficulty(difficulty).objectiveHints
		local act = ActConfig.Acts[state:GetAttribute("act") or 0]
		if actName then
			actName.Visible = hints
			actName.Text = act and act.name or ""
		end
		if objective then
			objective.Visible = hints
			objective.Text = state:GetAttribute("objective") or ""
		end
		if clock then
			clock.Text = formatClock(state:GetAttribute("clock") or ActConfig.Acts[0].start)
		end
	end
	for _, name in { "act", "objective", "clock", "difficulty" } do
		state:GetAttributeChangedSignal(name):Connect(refresh)
	end
	refresh()
end

return ObjectiveController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="794">
          <Properties>
            <string name="Name">RadioController</string>
            <string name="Source"><![CDATA[-- Controllers/RadioController (Partie)
-- Sections 7.8 et 15.4 : RadioGui > Channel, Talking, Static. Visible avec le talkie-walkie en main ;
-- le talkie grésille dans les gorges (P03, P05) et les tunnels (P07a–P07c).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MapConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local RadioController = {}

local player = Players.LocalPlayer
local STATIC_PLACES = { "P03", "P05", "P07a", "P07b", "P07c" }

local function inStaticZone(position)
	for _, code in STATIC_PLACES do
		local place = MapConfig.Places[code]
		if
			place.pos
			and (Vector2.new(position.X, position.Z) - Vector2.new(place.pos.X, place.pos.Z)).Magnitude
				<= place.radius
		then
			return true
		end
	end
	return false
end

function RadioController:Start()
	local gui = Util.waitGui("RadioGui")
	if gui == nil then
		return
	end
	local channel = Util.findUI(gui.Parent, "RadioGui/Channel")
	local talking = Util.findUI(gui.Parent, "RadioGui/Talking")
	local static = Util.findUI(gui.Parent, "RadioGui/Static")
	RunService.Heartbeat:Connect(function()
		local holding = player:GetAttribute("heldItem") == "ITM_Walkie" and not player:GetAttribute("isDead")
		if channel then
			channel.Visible = holding
		end
		if talking then
			-- TODO(BIBLE): ce qui allume « Talking » (chat vocal de proximité, 19.4 : décision en attente)
			talking.Visible = false
		end
		local root = Util.characterRoot(player)
		if static then
			static.Visible = holding and root ~= nil and inStaticZone(root.Position)
		end
	end)
end

return RadioController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="795">
          <Properties>
            <string name="Name">SpectatorController</string>
            <string name="Source"><![CDATA[-- Controllers/SpectatorController (Partie)
-- Sections 7.3 et 15.4 : après la caméra de mort, vue « caméra corporelle » d'un survivant
-- (Prev / Next, flèches ou balayage). SpectatorGui > Watching (« Tu regardes {player} »), Note.
-- RE_Spectate (C → S) : joueur suivi. Le spectateur n'a plus que le canal spectateurs (7.3).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = ReplicatedStorage:WaitForChild("Config")
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local SpectatorController = {}

local player = Players.LocalPlayer
local active = false
local index = 1
local root = nil
local remote = nil

local function survivors()
	local list = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and not other:GetAttribute("isDead") and other.Character then
			table.insert(list, other)
		end
	end
	table.sort(list, function(a, b)
		return a.UserId < b.UserId
	end)
	return list
end

local function target()
	local list = survivors()
	if #list == 0 then
		return nil
	end
	index = ((index - 1) % #list) + 1
	return list[index]
end

local function refresh()
	local watched = target()
	local label = Util.findUI(root, "SpectatorGui/Watching")
	if label then
		label.Text = if watched
			then Util.formatMessage(LoreConfig.UI.Watching, { player = watched.DisplayName })
			else ""
	end
	if remote and watched then
		remote:FireServer(watched)
	end
end

local function step(delta)
	index += delta
	refresh()
end

function SpectatorController:IsActive()
	return active
end

function SpectatorController:Begin()
	if active then
		return
	end
	active = true
	for _, name in { "Watching", "Prev", "Next", "Note" } do
		local element = Util.findUI(root, "SpectatorGui/" .. name)
		if element then
			element.Visible = true
		end
	end
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	refresh()
end

function SpectatorController:Start()
	local gui = Util.waitGui("SpectatorGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	remote = Util.getRemote("RE_Spectate")
	local prev = Util.findUI(root, "SpectatorGui/Prev")
	local nextButton = Util.findUI(root, "SpectatorGui/Next")
	if prev then
		prev.Activated:Connect(function()
			step(-1)
		end)
	end
	if nextButton then
		nextButton.Activated:Connect(function()
			step(1)
		end)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not active or processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Left then
			step(-1)
		elseif input.KeyCode == Enum.KeyCode.Right then
			step(1)
		end
	end)
	UserInputService.TouchSwipe:Connect(function(direction)
		if active then
			step(if direction == Enum.SwipeDirection.Left then 1 else -1)
		end
	end)
	-- caméra corporelle : à la place de la tête du survivant suivi
	RunService.RenderStepped:Connect(function()
		if not active then
			return
		end
		local watched = target()
		local head = watched and watched.Character and watched.Character:FindFirstChild("Head")
		if head then
			workspace.CurrentCamera.CFrame = head.CFrame
		end
	end)
end

return SpectatorController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="796">
          <Properties>
            <string name="Name">TabletController</string>
            <string name="Source"><![CDATA[-- Controllers/TabletController (Partie)
-- Sections 8.3 et 15.4 : TabletGui. Applis Carte (GPS, repères, couche « tunnels »), Objectifs,
-- Journal (documents lus, dans l'ordre), Preuves (preuves du groupe, qui les porte), Réseau.
-- Ouverte quand l'attribut tabletOpen est vrai (TabletService).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local TabletController = {}

local player = Players.LocalPlayer
local root = nil
local remote = nil
local state = nil

local PAGES = {
	Btn_Map = "Page_Map",
	Btn_Objectives = "Page_Objectives",
	Btn_Journal = "Page_Journal",
	Btn_Evidence = "Page_Evidence",
	Btn_Network = "Page_Network",
}

local function find(path)
	return Util.findUI(root, "TabletGui/Device/" .. path)
end

local function showPage(pageName)
	for _, name in PAGES do
		local page = find("Screen/Pages/" .. name)
		if page then
			page.Visible = name == pageName
		end
	end
end

-- carte 8 000 × 8 000 studs → coordonnées de l'image (0..1)
local function toMap(x, z)
	local half = MapConfig.Size / 2
	return (x + half) / MapConfig.Size, (z + half) / MapConfig.Size
end

local function refreshMap()
	local dot = find("Screen/Pages/Page_Map/PlayerDot")
	local noSignal = find("Screen/Pages/Page_Map/NoSignal")
	local tunnels = find("Screen/Pages/Page_Map/TunnelLayer")
	local signal = player:GetAttribute("gpsSignal") ~= false
	if noSignal then
		noSignal.Visible = not signal
	end
	if dot then
		local x, z = player:GetAttribute("gpsX"), player:GetAttribute("gpsZ")
		-- 8.3 : dans les tunnels, seul le Géologue voit sa position sur le tracé
		local inTunnels = false
		local rootPart = Util.characterRoot(player)
		local p07 = MapConfig.Places.P07a
		if rootPart and rootPart.Position.Y < p07.pos.Y - p07.radius then
			inTunnels = true
		end
		dot.Visible = signal and x ~= nil and (not inTunnels or player:GetAttribute("role") == "Geologist")
		if x then
			local u, v = toMap(x, z)
			dot.Position = UDim2.new(u, 0, v, 0)
		end
	end
	if tunnels then
		tunnels.Visible = state:GetAttribute("tunnelLayer") == true
	end
	local template = find("Screen/Pages/Page_Map/Markers/Template")
	if template then
		Util.clearClones(template)
		for i, marker in Util.decode(state:GetAttribute("markers"), {}) do
			local clone = Util.cloneTemplate(template, i)
			local u, v = toMap(marker.x, marker.z)
			clone.Position = UDim2.new(u, 0, v, 0)
		end
	end
end

local function fillList(path, items, setup)
	local template = find(path)
	if template == nil then
		return
	end
	Util.clearClones(template)
	for i, item in items do
		setup(Util.cloneTemplate(template, i), item)
	end
end

local function refreshLists()
	fillList(
		"Screen/Pages/Page_Objectives/List/Template",
		Util.decode(state:GetAttribute("objectives"), {}),
		function(row, text)
			row.Text = text
		end
	)
	fillList(
		"Screen/Pages/Page_Journal/List/Template",
		Util.decode(state:GetAttribute("journal"), {}),
		function(row, docId)
			local doc = LoreConfig.Documents[docId]
			row.Text = doc and doc.title or docId
			row.Activated:Connect(function()
				local title = find("Screen/Pages/Page_Journal/Reader/Title")
				local body = find("Screen/Pages/Page_Journal/Reader/Body")
				if title and doc then
					title.Text = doc.title
				end
				if body and doc then
					body.Text = doc.body or table.concat(doc.pages or {}, "\n\n")
				end
			end)
		end
	)
	fillList(
		"Screen/Pages/Page_Evidence/List/Template",
		Util.decode(state:GetAttribute("evidence"), {}),
		function(row, e)
			local name = ""
			for _, def in ItemConfig.Items do
				if def.evidence and def.evidence.kind == e.kind then
					name = def.name
				end
			end
			-- DÉFAUT : « A · Carte mémoire · Theo »
			row.Text = ("%s · %s · %s"):format(e.class, name, e.holder)
		end
	)
end

local function refreshNetwork()
	local bars = find("Screen/Pages/Page_Network/Bars")
	local message = find("Screen/Pages/Page_Network/Message")
	local fill = bars and bars:FindFirstChild("Fill")
	if fill then
		fill.Size = UDim2.new(if player:GetAttribute("network") then 1 else 0, 0, 1, 0)
	end
	if message then
		message.Text = player:GetAttribute("tabletMessage") or LoreConfig.Tablet.NoNetwork
	end
end

local function refresh()
	local device = Util.findUI(root, "TabletGui/Device")
	if device then
		device.Visible = player:GetAttribute("tabletOpen") == true
	end
	local battery = find("BatteryText")
	if battery then
		battery.Text = ("%d %%"):format(math.floor((player:GetAttribute("tabletBattery") or 1) * 100))
	end
	refreshMap()
	refreshNetwork()
end

function TabletController:Start()
	local gui = Util.waitGui("TabletGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	state = Util.getMatchState()
	remote = Util.getRemote("RE_TabletAction")
	for buttonName, pageName in PAGES do
		local button = find("Screen/AppBar/" .. buttonName)
		if button then
			button.Activated:Connect(function()
				showPage(pageName)
			end)
		end
	end
	local close = find("Close")
	if close and remote then
		close.Activated:Connect(function()
			remote:FireServer("Device", "Close")
		end)
	end
	local send = find("Screen/Pages/Page_Network/Send")
	if send and remote then
		send.Activated:Connect(function()
			remote:FireServer("Network", "Send")
		end)
	end
	-- repère : clic sur la carte
	local map = find("Screen/Pages/Page_Map/MapImage")
	if map and remote then
		map.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				local rel = (Vector2.new(input.Position.X, input.Position.Y) - map.AbsolutePosition) / map.AbsoluteSize
				local half = MapConfig.Size / 2
				remote:FireServer(
					"Map",
					"AddMarker",
					{ x = rel.X * MapConfig.Size - half, z = rel.Y * MapConfig.Size - half }
				)
			end
		end)
	end
	for _, name in { "tabletOpen", "tabletBattery", "gpsX", "gpsSignal", "network", "tabletMessage" } do
		player:GetAttributeChangedSignal(name):Connect(refresh)
	end
	for _, name in { "markers", "tunnelLayer" } do
		state:GetAttributeChangedSignal(name):Connect(refreshMap)
	end
	for _, name in { "objectives", "journal", "evidence" } do
		state:GetAttributeChangedSignal(name):Connect(refreshLists)
	end
	showPage("Page_Map")
	refresh()
	refreshLists()
end

return TabletController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="797">
          <Properties>
            <string name="Name">AmbienceController</string>
            <string name="Source"><![CDATA[-- Controllers/AmbienceController (les deux places)
-- Sections 12.1, 12.2 et 12.5 : interpole la lumière selon l'heure en jeu (MatchState.clock),
-- le brouillard selon la zone (Atmosphere), la réverbération par zone. Réglage à l'œil en phase B2.
-- Dans le lobby (pas d'horloge), rien n'est changé : la lumière du lobby est réglée dans Studio.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Config = ReplicatedStorage:WaitForChild("Config")
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local AmbienceController = {}

local player = Players.LocalPlayer
local HOURS = 24 -- constante (heures dans une journée)
local START = AmbienceConfig.Moments[1].clockFrom -- l'horloge commence à 18 h 30

local function rgb(t)
	return Color3.fromRGB(table.unpack(t))
end

-- heure → position sur la nuit (0 à 18 h 30, croissante jusqu'à 6 h 00)
local function nightTime(clock)
	return (clock - START) % HOURS
end

-- images clés de 12.1 : début et fin de chaque moment
local keys = {}
for _, moment in AmbienceConfig.Moments do
	table.insert(keys, { t = nightTime(moment.clockFrom), m = moment })
	if moment.clockTo ~= moment.clockFrom then
		table.insert(keys, { t = nightTime(moment.clockTo % HOURS), m = moment })
	end
end
table.sort(keys, function(a, b)
	return a.t < b.t
end)

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function sample(clock)
	local t = nightTime(clock)
	local before, after = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if t >= keys[i].t and t <= keys[i + 1].t then
			before, after = keys[i], keys[i + 1]
			break
		end
	end
	local span = after.t - before.t
	local f = if span > 0 then math.clamp((t - before.t) / span, 0, 1) else 0
	local a, b = before.m, after.m
	return {
		brightness = lerp(a.brightness, b.brightness, f),
		outdoor = rgb(a.outdoorAmbient):Lerp(rgb(b.outdoorAmbient), f),
		ambient = rgb(a.ambient):Lerp(rgb(b.ambient), f),
		exposure = lerp(a.exposure, b.exposure, f),
	}
end

local function zoneOf(position)
	for zoneName, zone in AmbienceConfig.Fog do
		for _, code in zone.places or {} do
			local place = MapConfig.Places[code]
			if place and place.pos and place.radius then
				if
					(Vector2.new(position.X, position.Z) - Vector2.new(place.pos.X, place.pos.Z)).Magnitude
					<= place.radius
				then
					return zoneName
				end
			elseif place and place.zone then
				local z = place.zone
				if position.X >= z.minX and position.X <= z.maxX and position.Z >= z.minZ and position.Z <= z.maxZ then
					return zoneName
				end
			end
		end
	end
	return "Forest"
end

-- 17.2 : décalage de luminosité réglé par le joueur (SettingsController)
AmbienceController.Gamma = 0

function AmbienceController:Start()
	local state = ReplicatedStorage:FindFirstChild("MatchState")
		or ReplicatedStorage:WaitForChild("MatchState", Util.GUI_WAIT_TIMEOUT)
	if state == nil then
		return -- lobby
	end
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	local color = Lighting:FindFirstChild("AmbienceColor") or Instance.new("ColorCorrectionEffect")
	color.Name = "AmbienceColor"
	color.Saturation = AmbienceConfig.ColorCorrection.Saturation
	color.Contrast = AmbienceConfig.ColorCorrection.Contrast
	color.TintColor = rgb(AmbienceConfig.ColorCorrection.TintColor)
	color.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = AmbienceConfig.Bloom.Intensity
	bloom.Parent = Lighting

	RunService.RenderStepped:Connect(function()
		local clock = state:GetAttribute("clock")
		if clock == nil then
			return
		end
		Lighting.ClockTime = clock
		local s = sample(clock)
		Lighting.Brightness = s.brightness
		Lighting.OutdoorAmbient = s.outdoor
		Lighting.Ambient = s.ambient
		Lighting.ExposureCompensation = s.exposure + AmbienceController.Gamma

		local root = Util.characterRoot(player)
		if root == nil then
			return
		end
		local zoneName = zoneOf(root.Position)
		local zone = AmbienceConfig.Fog[zoneName]
		if zone.atmosphereDisabled then
			atmosphere.Density = 0
			atmosphere.Haze = 0
		else
			local weather = AmbienceConfig.Weathers[state:GetAttribute("weather") or "Clear"]
			atmosphere.Density = zone.density * ((weather and weather.fogDensityFactor) or 1)
			atmosphere.Haze = zone.haze
			atmosphere.Color = rgb(zone.color)
		end
		local reverb = AmbienceConfig.Reverb[zoneName] or AmbienceConfig.Reverb.Forest
		local ok, enum = pcall(function()
			return Enum.ReverbType[reverb]
		end)
		if ok and enum then
			SoundService.AmbientReverb = enum
		end
	end)
end

return AmbienceController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="798">
          <Properties>
            <string name="Name">CinematicController</string>
            <string name="Source"><![CDATA[-- Controllers/CinematicController (les deux places)
-- Sections 6.1, 6.2 et 15.5 : caméra Scriptable sur les Part Workspace/Cinematics/CS_xx_Shot_n,
-- transitions TweenService, bandes noires et sous-titres (CinematicGui). Passer : en lobby, bouton
-- après 10 s ; en partie, vote (RE_CinematicSkipVote). CS_00 joue à la première connexion au lobby
-- (attribut plays = 0, DÉFAUT : la bible ne prévoit pas de drapeau « déjà vue »).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = ReplicatedStorage:WaitForChild("Config")
local CinematicConfig = require(Config:WaitForChild("CinematicConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local CinematicController = {}

local player = Players.LocalPlayer
local root = nil
local playing = nil -- { id, token }
local isLobby = false
local skipRemote = nil

local function find(path)
	return Util.findUI(root, "CinematicGui/" .. path)
end

local function setVisible(visible)
	for _, name in { "BarTop", "BarBottom", "Subtitle", "Skip" } do
		local element = find(name)
		if element then
			element.Visible = visible
		end
	end
end

function CinematicController:IsPlaying()
	return playing ~= nil
end

local function stop()
	playing = nil
	setVisible(false)
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

function CinematicController:Play(id, extra)
	local def = CinematicConfig.Cinematics[id]
	if def == nil or root == nil then
		return
	end
	local token = {}
	playing = { id = id, token = token }
	setVisible(true)
	local subtitle = find("Subtitle")
	if subtitle then
		subtitle.Text = (extra and extra.text) or def.subtitle or def.screenText or ""
	end
	local skip = find("Skip")
	local votes = find("Skip/Votes")
	if votes then
		votes.Text = ""
	end
	if skip then
		skip.Visible = not isLobby -- en lobby, le bouton apparaît après 10 s
		if isLobby then
			task.delay(CinematicConfig.LobbySkipAfter, function()
				if playing and playing.token == token then
					skip.Visible = true
				end
			end)
		end
	end
	-- plans : Part invisibles CS_xx_Shot_n (6.1) ; sans plans posés, seules les bandes et le texte s'affichent
	local folder = workspace:FindFirstChild("Cinematics")
	local shots = {}
	for n = 1, def.shots or 0 do
		local shot = folder and folder:FindFirstChild(("%s_Shot_%d"):format(id, n))
		if shot and shot:IsA("BasePart") then
			table.insert(shots, shot)
		end
	end
	local camera = workspace.CurrentCamera
	if #shots > 0 and not def.noCut then
		camera.CameraType = Enum.CameraType.Scriptable
		if def.fov then
			camera.FieldOfView = def.fov
		end
		camera.CFrame = shots[1].CFrame
		local perShot = def.duration / #shots
		task.spawn(function()
			for i = 2, #shots do
				if not (playing and playing.token == token) then
					return
				end
				TweenService:Create(camera, TweenInfo.new(perShot, Enum.EasingStyle.Sine), { CFrame = shots[i].CFrame })
					:Play()
				task.wait(perShot)
			end
		end)
	elseif #shots == 0 and not def.noCut then
		warn(("CinematicController : aucun plan %s_Shot_n dans Workspace/Cinematics"):format(id))
	end
	task.delay(def.duration, function()
		if playing and playing.token == token then
			stop()
		end
	end)
end

function CinematicController:Start()
	-- la place Partie a Workspace/Places (16.1) ; le lobby non
	isLobby = workspace:FindFirstChild("Places") == nil
	local gui = Util.waitGui("CinematicGui")
	if gui == nil then
		return
	end
	root = gui.Parent
	skipRemote = Util.getRemote("RE_CinematicSkipVote")
	local skip = find("Skip")
	if skip then
		skip.Activated:Connect(function()
			if isLobby then
				stop()
			elseif skipRemote then
				skipRemote:FireServer()
			end
		end)
	end
	local remote = Util.getRemote("RE_PlayCinematic")
	if remote then
		remote.OnClientEvent:Connect(function(action, a, b)
			if action == "Play" then
				self:Play(a, b)
			elseif action == "Stop" then
				stop()
			elseif action == "SkipVotes" then
				local votes = find("Skip/Votes")
				if votes then
					votes.Text = ("%d/%d"):format(a, b)
				end
			end
		end)
	end
	-- 6.2 : CS_00 à la première connexion au lobby
	if isLobby then
		while player:GetAttribute("dataLoaded") == nil do
			task.wait(CinematicConfig.SafetyAfter)
		end
		if (player:GetAttribute("plays") or 0) == 0 then
			self:Play("CS_00")
		end
	end
end

return CinematicController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="799">
          <Properties>
            <string name="Name">NotificationController</string>
            <string name="Source"><![CDATA[-- Controllers/NotificationController (les deux places)
-- Sections 4.6 et 15.5 : affiche les messages système (RE_Notify : clé, paramètres) dans
-- NotificationGui > Stack > Template (Text). {player} et {n} sont remplacés.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local NotificationController = {}

local template = nil
local shown = {}
local order = 0

-- affiche un texte déjà rédigé (tiré de la bible)
function NotificationController:Show(text)
	if template == nil or text == nil or text == "" then
		return
	end
	order += 1
	local item = Util.cloneTemplate(template, order)
	local label = item:FindFirstChild("Text")
	if label then
		label.Text = text
	end
	table.insert(shown, item)
	while #shown > PlayerConfig.Interface.NotificationMax do
		table.remove(shown, 1):Destroy()
	end
	task.delay(PlayerConfig.Interface.NotificationDuration, function()
		local index = table.find(shown, item)
		if index then
			table.remove(shown, index)
		end
		item:Destroy()
	end)
end

function NotificationController:ShowMessage(key, params)
	local text = LoreConfig.Messages[key]
	if text == nil then
		warn("NotificationController : message inconnu " .. tostring(key))
		return
	end
	self:Show(Util.formatMessage(text, params))
end

function NotificationController:Start()
	local gui = Util.waitGui("NotificationGui")
	template = gui and Util.findUI(gui.Parent, "NotificationGui/Stack/Template")
	local remote = Util.getRemote("RE_Notify")
	if remote then
		remote.OnClientEvent:Connect(function(key, params)
			self:ShowMessage(key, params)
		end)
	end
end

return NotificationController
]]></string>
