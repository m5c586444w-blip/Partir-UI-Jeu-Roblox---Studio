    <Item class="Script" referent="59">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ServerScriptService/Bootstrap (Partie)
-- Section 16.1 : charge les services dans l'ordre. Chaque service reçoit Init(services)
-- (références entre services, aucune attente), puis Start() une fois tous initialisés.
local ServerScriptService = game:GetService("ServerScriptService")

local servicesFolder = ServerScriptService:WaitForChild("Services")

-- ordre de chargement : DataService d'abord, les autres en dépendent
local ORDER = {
	"DataService",
	"ReturnService",
	"PartyLoaderService",
	"NoiseService",
	"InteractionService",
	"CharacterService",
	"SpawnService",
	"HealthService",
	"StaminaService",
	"FearService",
	"InventoryService",
	"ItemSpawnService",
	"WeaponService",
	"EvidenceService",
	"DocumentService",
	"TabletService",
	"CinematicService",
	"WeatherService",
	"ExtractionService",
	"GameStateService",
}

local services = {}
for _, name in ORDER do
	local module = servicesFolder:FindFirstChild(name)
	if module == nil then
		warn("Bootstrap : service manquant : Services/" .. name)
	else
		services[name] = require(module)
	end
end

for _, name in ORDER do
	local service = services[name]
	if service ~= nil and service.Init ~= nil then
		local ok, err = pcall(service.Init, service, services)
		if not ok then
			warn("Bootstrap : échec de " .. name .. ".Init : " .. tostring(err))
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service ~= nil and service.Start ~= nil then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn("Bootstrap : échec de " .. name .. ".Start : " .. tostring(err))
		end
	end
end

print("Bootstrap (Partie) : services démarrés")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="60">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/CharacterService (Partie)
-- Sections 7.1 et 16.2 : l'avatar Roblox n'est jamais utilisé. Au spawn, le serveur clone le skin
-- choisi (ReplicatedStorage/Characters/<ROLE>/Skin_<n>) et l'assigne à Player.Character.
-- Modèle absent (MANQUANT, 13.3) : un mannequin Roblox neutre nommé MANQUANT_CHR_<ROLE>_Skin_<n>.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))

local CharacterService = {}

-- (player, character) : personnage créé et posé au départ
CharacterService.Spawned = Signal.new()

local services = nil
local roleOf = {} -- [Player] = role id
local order = {} -- ordre d'arrivée (index du point de départ)
local matchReady = false

local function takenRoles()
	local taken = {}
	for _, role in roleOf do
		taken[role] = true
	end
	return taken
end

-- rôle de la configuration de partie, sinon le premier rôle libre (DÉFAUT : test dans Studio, ou rôle non choisi)
local function assignRole(player, info)
	local entry = info.roles[player.UserId]
	local taken = takenRoles()
	if entry and entry.role and not taken[entry.role] then
		return entry.role
	end
	for _, role in PlayerConfig.Roles do
		if not taken[role.id] then
			return role.id
		end
	end
	return nil
end

local function equippedSkin(player, role)
	local data = services.DataService:WaitForData(player)
	local skin = data and data.equipped and data.equipped[role]
	return skin or ProgressionConfig.DefaultSkin
end

local function buildCharacter(player, role)
	local skin = equippedSkin(player, role)
	local folder = ReplicatedStorage:FindFirstChild(PlayerConfig.CharactersFolder)
	local roleFolder = folder and folder:FindFirstChild(role)
	local template = roleFolder and roleFolder:FindFirstChild(PlayerConfig.SkinPrefix .. skin)
	local character
	if template ~= nil then
		character = template:Clone()
	else
		-- 13.3 : CHR_<ROLE>_Skin_A–C MANQUANT → mannequin neutre, noté dans SUIVI.md
		warn(("CharacterService : modèle manquant Characters/%s/%s%s"):format(role, PlayerConfig.SkinPrefix, skin))
		character =
			Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
		character:SetAttribute("placeholder", ("MANQUANT_CHR_%s_%s%s"):format(role, PlayerConfig.SkinPrefix, skin))
	end
	character.Name = player.Name
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- la mort est gérée par HealthService (ragdoll, sac au sol), pas par Roblox
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
	end
	return character
end

-- personnage assigné à la main (CharacterAutoLoads = false) : Roblox ne copie pas StarterGui ;
-- le serveur clone donc chaque ScreenGui déjà présent (15.1 : clones de modèles existants)
local function ensureGui(player)
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	if playerGui == nil then
		return
	end
	for _, gui in game:GetService("StarterGui"):GetChildren() do
		if gui:IsA("LayerCollector") and playerGui:FindFirstChild(gui.Name) == nil then
			gui:Clone().Parent = playerGui
		end
	end
end

local function setup(player)
	if roleOf[player] ~= nil or player.Parent == nil then
		return
	end
	local info = services.PartyLoaderService:GetMatchInfo()
	local role = assignRole(player, info)
	if role == nil then
		warn("CharacterService : aucun rôle libre pour " .. player.Name)
		return
	end
	roleOf[player] = role
	table.insert(order, player)
	player:SetAttribute("role", role)

	ensureGui(player)
	local character = buildCharacter(player, role)
	player.Character = character
	character.Parent = workspace
	services.SpawnService:Place(player, character, info.start, table.find(order, player))
	CharacterService.Spawned:Fire(player, character)
end

function CharacterService:GetRole(player)
	return roleOf[player]
end

-- rôles présents dans la partie (4.4 : sous 10 joueurs, les rôles non pris n'existent pas)
function CharacterService:GetPlayersByRole()
	local result = {}
	for player, role in roleOf do
		if player.Parent ~= nil then
			result[role] = player
		end
	end
	return result
end

function CharacterService:IsMatchReady()
	return matchReady
end

function CharacterService:Init(allServices)
	services = allServices
	Players.CharacterAutoLoads = false
end

function CharacterService:Start()
	task.spawn(function()
		local _, players = services.PartyLoaderService:WaitUntilLoaded()
		matchReady = true
		for _, player in players do
			task.spawn(setup, player)
		end
		for _, player in Players:GetPlayers() do
			task.spawn(setup, player)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		if matchReady then
			setup(player)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		roleOf[player] = nil
	end)
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">CinematicService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/CinematicService (Partie)
-- Sections 6.1 et 16.2 : déclenche les cinématiques. Une cinématique de lieu ne joue que pour les
-- joueurs dans son rayon ; les cinématiques de fin jouent pour tous. Pendant une cinématique, le
-- personnage est invulnérable et retiré des cibles de la créature, plus 3 s après (attribut
-- cinematicUntil, heure serveur). En partie : passer = vote à la majorité des joueurs concernés.
-- RE_PlayCinematic (S → C) : ("Play", id, extra) / ("Stop", id) / ("SkipVotes", n, total).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local CinematicConfig = require(Config:WaitForChild("CinematicConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local CinematicService = {}

CinematicService.Finished = Signal.new() -- (id, skipped)

local remote = nil
local current = nil -- { id, viewers = {Player}, votes = {[Player]=true}, done = Signal }

local function viewersFor(id, explicit)
	local def = CinematicConfig.Cinematics[id]
	if explicit then
		return explicit
	end
	if def.scope == "Place" then
		local place = MapConfig.Places[def.place]
		local list = {}
		for _, player in Players:GetPlayers() do
			local root = Util.characterRoot(player)
			if root and (root.Position - place.pos).Magnitude <= (place.radius or 0) then
				table.insert(list, player)
			end
		end
		return list
	end
	return Players:GetPlayers()
end

local function finish(skipped)
	if current == nil then
		return
	end
	local ended = current
	current = nil
	local safeUntil = workspace:GetServerTimeNow() + CinematicConfig.SafetyAfter
	for _, player in ended.viewers do
		if player.Parent then
			player:SetAttribute("cinematicUntil", safeUntil)
			if skipped and remote then
				remote:FireClient(player, "Stop", ended.id)
			end
		end
	end
	CinematicService.Finished:Fire(ended.id, skipped)
	ended.done:Fire()
end

-- joue une cinématique et attend sa fin ; `players` facultatif (sinon selon la portée de 6.2)
function CinematicService:PlayAndWait(id, players, extra)
	local def = CinematicConfig.Cinematics[id]
	if def == nil then
		warn("CinematicService : cinématique inconnue " .. tostring(id))
		return
	end
	while current ~= nil do
		current.done:Wait()
	end
	local viewers = viewersFor(id, players)
	if #viewers == 0 then
		return
	end
	local done = Signal.new()
	current = { id = id, viewers = viewers, votes = {}, done = done }
	local untilTime = workspace:GetServerTimeNow() + def.duration + CinematicConfig.SafetyAfter
	for _, player in viewers do
		player:SetAttribute("cinematicUntil", untilTime)
		if remote then
			remote:FireClient(player, "Play", id, extra)
		end
	end
	local mine = current
	task.delay(def.duration, function()
		if current == mine then
			finish(false)
		end
	end)
	done:Wait()
end

function CinematicService:Play(id, players, extra)
	task.spawn(self.PlayAndWait, self, id, players, extra)
end

function CinematicService:IsProtected(player)
	return (player:GetAttribute("cinematicUntil") or 0) > workspace:GetServerTimeNow()
end

local function onSkipVote(player)
	if current == nil or not table.find(current.viewers, player) then
		return
	end
	current.votes[player] = true
	local count = 0
	for voter in current.votes do
		if voter.Parent then
			count += 1
		end
	end
	for _, viewer in current.viewers do
		if remote and viewer.Parent then
			remote:FireClient(viewer, "SkipVotes", count, #current.viewers)
		end
	end
	if count * 2 > #current.viewers then
		finish(true)
	end
end

function CinematicService:Init() end

function CinematicService:Start()
	remote = Util.getRemote("RE_PlayCinematic")
	local skip = Util.getRemote("RE_CinematicSkipVote")
	if skip then
		RateLimiter.connect(skip, onSkipVote)
	end
end

return CinematicService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">DocumentService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/DocumentService (Partie)
-- Sections 2.7, 8.3 et 16.2 : documents trouvés (texte de LoreConfig.Documents), journal du groupe
-- (appli Journal de la tablette, dans l'ordre de découverte), tablette des géologues (DOC_07, DOC_08),
-- carnet Halvorsen (DOC_12, pages débloquées par l'histoire).
-- RE_OpenDocument (S → C) : (docId) ; le client affiche DocumentGui.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local DocumentService = {}

DocumentService.Read = Signal.new() -- (docId, player) : première lecture par le groupe

local services = nil
local journal = {} -- liste ordonnée des docId lus par le groupe
local openRemote = nil

local function publish()
	Util.getMatchState():SetAttribute("journal", Util.encode(journal))
end

function DocumentService:HasRead(docId)
	return table.find(journal, docId) ~= nil
end

-- ajoute au journal du groupe ; renvoie true à la première lecture
function DocumentService:AddToJournal(docId, player)
	if self:HasRead(docId) then
		return false
	end
	table.insert(journal, docId)
	publish()
	self.Read:Fire(docId, player)
	return true
end

function DocumentService:Open(player, docId)
	if openRemote and LoreConfig.Documents[docId] then
		openRemote:FireClient(player, docId)
	end
end

-- document ramassé dans le monde
function DocumentService:Collect(player, docId, _part)
	self:AddToJournal(docId, player)
	self:Open(player, docId)
	services.EvidenceService:OnDocument(player, docId)
end

-- 16.4 et 2.7 : pages du carnet (la page 1 est débloquée au départ)
local pages = table.clone(ProgressionConfig.DefaultNotebookPages)

function DocumentService:UnlockNotebookPage(index)
	pages[index] = true
	Util.getMatchState():SetAttribute("notebookPages", Util.encode(pages))
end

function DocumentService:GetNotebookPages()
	return pages
end

local function onItemUsed(player, itemId)
	if itemId == "ITM_TabletGeo" then
		-- 8.3 : la tablette des géologues contient DOC_07 et DOC_08 ; la lire copie la couche « tunnels »
		for _, docId in ItemConfig.Items.ITM_TabletGeo.documents do
			DocumentService:AddToJournal(docId, player)
		end
		Util.getMatchState():SetAttribute("tunnelLayer", true)
		DocumentService:Open(player, "DOC_07")
	elseif itemId == "ITM_Notebook" then
		-- 7.7 : la Descendante lit le carnet familial
		if player:GetAttribute("role") == "Descendant" then
			DocumentService:Open(player, "DOC_12")
		end
	end
end

function DocumentService:Init(allServices)
	services = allServices
end

function DocumentService:Start()
	openRemote = Util.getRemote("RE_OpenDocument")
	publish()
	DocumentService:UnlockNotebookPage(1)
	services.InventoryService.ItemUsed:Connect(onItemUsed)
end

return DocumentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">EvidenceService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/EvidenceService (Partie)
-- Section 8.4 : preuves A/B/C. Une preuve est un objet d'inventaire ; elle ne compte que si un
-- survivant la sort de la forêt (CommitForSurvivor, appelé à l'extraction).
-- Vidéo A : créature visible à 60 % au moins, à 30 studs ou moins, 2 s sans interruption
-- (le caméscope a la vision nocturne). Carte mémoire ITM_SDCard créée après la vidéo.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local EvidenceService = {}

EvidenceService.Filmed = Signal.new() -- (player, creature, distance) : rancune +0,5 si filmée à moins de 30 studs (9.7)
EvidenceService.Created = Signal.new() -- (player, itemId)

local services = nil
local recordingSince = {} -- [Player] = os.clock() du début de la séquence visible
local Evidence = ItemConfig.Evidence

local VIDEO_CHECK = require(Config:WaitForChild("PlayerConfig")).Technical.VideoCheckInterval

local function creatures()
	return CollectionService:GetTagged("Creature")
end

-- fraction des parties de la créature visibles depuis `origin` (les feuillages tagués « Foliage » ne bloquent pas)
function EvidenceService:VisibleFraction(origin, creature, ignore)
	local parts = {}
	for _, part in creature:GetDescendants() do
		if part:IsA("BasePart") and part.Transparency < 1 then
			table.insert(parts, part)
		end
	end
	if #parts == 0 then
		return 0
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = { creature }
	for _, inst in ignore or {} do
		table.insert(filter, inst)
	end
	for _, foliage in CollectionService:GetTagged("Foliage") do
		table.insert(filter, foliage)
	end
	params.FilterDescendantsInstances = filter
	local visible = 0
	for _, part in parts do
		local hit = workspace:Raycast(origin, part.Position - origin, params)
		if hit == nil then
			visible += 1
		end
	end
	return visible / #parts
end

local function give(player, itemId, extra)
	if services.InventoryService:Add(player, itemId, 1, extra) then
		EvidenceService.Created:Fire(player, itemId)
		return true
	end
	return false
end

local function nearestCreature(position, maxDistance)
	local best, bestDistance = nil, maxDistance
	for _, creature in creatures() do
		local d = (creature:GetPivot().Position - position).Magnitude
		if d <= bestDistance then
			best, bestDistance = creature, d
		end
	end
	return best, bestDistance
end

local function checkVideo(dt)
	for _, player in Players:GetPlayers() do
		local entry = services.InventoryService:Selected(player)
		local head = player.Character and player.Character:FindFirstChild("Head")
		if entry and entry.id == "ITM_Camcorder" and entry.recording and head then
			-- 8.1 : 6 min d'enregistrement
			local minutes = ItemConfig.Items.ITM_Camcorder.recordMinutes
			entry.battery = math.max(0, (entry.battery or 1) - dt / (minutes * Util.SECONDS_PER_MINUTE))
			if entry.battery <= 0 then
				entry.recording = false
			end
			local creature, distance = nearestCreature(head.Position, Evidence.VideoA.maxDistance)
			local ok = creature ~= nil
				and EvidenceService:VisibleFraction(head.Position, creature, { player.Character })
					>= Evidence.VideoA.minVisibleFraction
			if ok then
				EvidenceService.Filmed:Fire(player, creature, distance)
				recordingSince[player] = recordingSince[player] or os.clock()
				if os.clock() - recordingSince[player] >= Evidence.VideoA.minDuration then
					recordingSince[player] = nil
					entry.recording = false
					give(player, "ITM_SDCard")
				end
			else
				recordingSince[player] = nil
			end
		else
			recordingSince[player] = nil
		end
	end
end

local function nearTagged(tag, position, range)
	for _, inst in CollectionService:GetTagged(tag) do
		local pos = inst:IsA("Model") and inst:GetPivot().Position or inst.Position
		if (pos - position).Magnitude <= range then
			return inst
		end
	end
	return nil
end

local function onItemUsed(player, itemId, entry)
	local root = Util.characterRoot(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if root == nil or head == nil then
		return
	end
	if itemId == "ITM_Camcorder" then
		-- 7.7 : seul le Caméraman produit des preuves de classe A
		if player:GetAttribute("role") == "Cameraman" then
			entry.recording = not entry.recording
			player:SetAttribute("isFilming", entry.recording)
		end
	elseif itemId == "ITM_PhotoCamera" then
		local def = ItemConfig.Items.ITM_PhotoCamera
		-- flash = lumière ×3 pendant 0,2 s (lu par la perception)
		player:SetAttribute("flashUntil", workspace:GetServerTimeNow() + def.flashDuration)
		entry.uses = (entry.uses or def.uses) - 1
		local creature = nearestCreature(head.Position, Evidence.PhotoB.maxDistance)
		if creature and EvidenceService:VisibleFraction(head.Position, creature, { player.Character }) > 0 then
			give(player, "EVD_PhotoCreature")
		elseif
			(root.Position - MapConfig.Places[Evidence.PhotoC.place].pos).Magnitude
			<= MapConfig.Places[Evidence.PhotoC.place].radius
		then
			give(player, "EVD_PhotoCharnier")
		end
		if entry.uses <= 0 then
			services.InventoryService:Remove(player, itemId, 1)
		end
	elseif itemId == "ITM_PlasterKit" then
		local print_ = nearTagged("Footprint", root.Position, ItemConfig.PickupDistance)
		local age = print_ and (os.clock() - (print_:GetAttribute("createdAt") or -math.huge))
		if print_ and age <= Evidence.PlasterB.footprintMaxAge then
			local now = workspace:GetServerTimeNow()
			player:SetAttribute("busyUntil", now + Evidence.PlasterB.workTime)
			task.delay(Evidence.PlasterB.workTime, function()
				player:SetAttribute("busyUntil", nil)
				if services.HealthService:IsUp(player) then
					entry.uses = (entry.uses or ItemConfig.Items.ITM_PlasterKit.uses) - 1
					give(player, "EVD_Cast")
					if entry.uses <= 0 then
						services.InventoryService:Remove(player, itemId, 1)
					end
				end
			end)
		end
	elseif itemId == "ITM_AudioRecorder" then
		entry.recording = not entry.recording
	elseif itemId == "ITM_SampleBag" then
		local p05 = MapConfig.Places.P05
		local nearStructure = nearTagged("StickStructure", root.Position, ItemConfig.PickupDistance)
		local nearRim = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(p05.pos.X, p05.pos.Z)).Magnitude
				<= p05.radius
			-- DÉFAUT : « au bord » = plus près du bord (Y 400) que du fond (Y 250)
			and root.Position.Y >= (p05.rimY + p05.floorY) / 2
		if nearStructure or nearRim then
			if services.InventoryService:Remove(player, itemId, 1) then
				give(player, "EVD_Hair")
			end
		end
	end
end

-- 8.4 : enregistrement d'un cri à moins de 150 studs (appelé par l'IA à chaque cri)
function EvidenceService:OnCreatureCall(position)
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		local entry = services.InventoryService:Selected(player)
		if root and entry and entry.id == "ITM_AudioRecorder" and entry.recording then
			if (root.Position - position).Magnitude <= Evidence.CallB.maxDistance then
				entry.recording = false
				give(player, "EVD_Call")
			end
		end
	end
end

-- 8.4 : document ramassé (DOC_03 à DOC_10) = preuve C
function EvidenceService:OnDocument(player, docId)
	if table.find(Evidence.DocumentC, docId) then
		give(player, "EVD_Document", { doc = docId })
	end
end

-- preuves portées par un joueur : { { itemId, class, kind, doc } }
function EvidenceService:Carried(player)
	local result = {}
	local inv = services.InventoryService:Get(player)
	if inv == nil then
		return result
	end
	for _, list in { inv.quick, inv.bag } do
		for _, entry in list do
			local def = entry and ItemConfig.Items[entry.id]
			if def and def.evidence then
				for _ = 1, entry.count or 1 do
					table.insert(
						result,
						{ itemId = entry.id, class = def.evidence.class, kind = def.evidence.kind, doc = entry.doc }
					)
				end
			end
		end
	end
	return result
end

function EvidenceService:CarriesClassA(player)
	for _, e in self:Carried(player) do
		if e.class == "A" then
			return true
		end
	end
	return false
end

-- 8.4 et 16.4 : un survivant sort de la forêt : preuves sauvegardées (200 au plus), XP de 8.4
function EvidenceService:CommitForSurvivor(player)
	local carried = self:Carried(player)
	local data = services.DataService:GetData(player)
	local xp = 0
	if data then
		for _, e in carried do
			table.insert(data.evidence, { class = e.class, kind = e.kind, date = os.time() })
			xp += ProgressionConfig.XPGains["Evidence" .. e.class] or 0
		end
		-- DÉFAUT : au-delà de 200, les plus anciennes sont retirées
		while #data.evidence > ProgressionConfig.MaxEvidence do
			table.remove(data.evidence, 1)
		end
		data.xp += xp
	end
	return carried, xp
end

-- appli Preuves de la tablette : preuves du groupe, classe, qui les porte
local function publishGroup()
	local list = {}
	for _, player in Players:GetPlayers() do
		for _, e in EvidenceService:Carried(player) do
			table.insert(list, { class = e.class, kind = e.kind, holder = player.DisplayName })
		end
	end
	Util.getMatchState():SetAttribute("evidence", Util.encode(list))
end

function EvidenceService:Init(allServices)
	services = allServices
end

function EvidenceService:Start()
	services.InventoryService.ItemUsed:Connect(onItemUsed)
	services.InventoryService.Changed:Connect(publishGroup)
	task.spawn(function()
		while true do
			task.wait(VIDEO_CHECK)
			checkVideo(VIDEO_CHECK)
		end
	end)
end

return EvidenceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">ExtractionService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/ExtractionService (Partie)
-- Sections 3.3, 5.2 et 16.2 : voies d'extraction E1–E4.
-- Une voie principale est tirée parmi E1, E2, E3 ; E4 est ouverte si DOC_07 a été lu.
-- Préparation (acte 3) : E1 changer la roue (cric, 20 s / 10 s Mécanicienne) ; E2 réparer la radio
-- (câble + batterie, 30 s) ; E3 réparer le bulldozer (jerrican + relais, 40 s).
-- Déclenchement (acte 4, DÉFAUT) : E1 démarrer le van (clés) ; E2 appeler puis tenir 180 s sur l'aire ;
-- E3 conduire 650 studs à 8 studs/s ; E4 dégager le bouchon (60 s, DOC_07 + une lampe).
-- Ancres : Part de Workspace/Places nommées E1_Van, E2_Radio, E2_Pad, E3_Bulldozer, E4_Plug si
-- Gabriel les pose ; sinon ancres invisibles aux coordonnées de MapConfig (DÉFAUT).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local ExtractionService = {}

ExtractionService.Prepared = Signal.new() -- (routeId) : la voie est prête (fin de l'acte 3)
ExtractionService.Extracted = Signal.new() -- (routeId, players) : extraction déclenchée
ExtractionService.Calling = Signal.new() -- (routeId, endTime) : E2, attente de l'hélicoptère

local services = nil
local routes = {} -- [routeId] = { prepared, triggered, prompts = {} }
local mainRoute = nil
local triggersOpen = false

local Routes = ActConfig.Routes

local function anchor(name, position)
	local places = workspace:FindFirstChild("Places")
	local found = places and places:FindFirstChild(name, true)
	if found and found:IsA("BasePart") then
		return found
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Size = ItemConfig.PlaceholderSize
	part.Position = position
	part.Parent = workspace
	return part
end

-- joueurs debout dans un rayon
local function playersNear(position, radius)
	local list = {}
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if root and services.HealthService:IsUp(player) and (root.Position - position).Magnitude <= radius then
			table.insert(list, player)
		end
	end
	return list
end

-- objets demandés : portés par le joueur ou par un coéquipier tout près
local function hasItems(player, position, items)
	local nearby = playersNear(position, ItemConfig.PickupDistance)
	if not table.find(nearby, player) then
		table.insert(nearby, player)
	end
	for _, id in items do
		local found = false
		for _, p in nearby do
			if services.InventoryService:Has(p, id) then
				found = true
			end
		end
		if not found then
			return false
		end
	end
	return true
end

local function consume(player, position, items)
	local nearby = playersNear(position, ItemConfig.PickupDistance)
	table.insert(nearby, 1, player)
	for _, id in items do
		for _, p in nearby do
			if services.InventoryService:Remove(p, id, 1) then
				break
			end
		end
	end
end

-- 8.1 : caisse à outils : réparations à vitesse normale ; sans elle, ×2 plus long ;
-- 5.2 et 7.7 : durée propre à la Mécanicienne
local function repairDuration(route, base)
	return function(player)
		local duration = (route.roleRepairTime and route.roleRepairTime[player:GetAttribute("role")]) or base
		if
			player:GetAttribute("role") == "Mechanic" and not (route.roleRepairTime and route.roleRepairTime.Mechanic)
		then
			duration /= require(Config:WaitForChild("PlayerConfig")).Abilities.Mechanic.RepairFactor
		end
		if not services.InventoryService:Has(player, "ITM_ToolBox") then
			duration *= ItemConfig.Items.ITM_ToolBox.withoutFactor
		end
		return duration
	end
end

local function prepared(routeId)
	routes[routeId].prepared = true
	ExtractionService.Prepared:Fire(routeId)
end

local function extract(routeId, players)
	local state = routes[routeId]
	if state.triggered then
		return
	end
	state.triggered = true
	ExtractionService.Extracted:Fire(routeId, players)
end

local function prompt(routeId, part, opts)
	local p = services.InteractionService:CreatePrompt(part, opts)
	table.insert(routes[routeId].prompts, p)
	return p
end

local SETUP = {}

SETUP.E1 = function(route)
	local part = anchor("E1_Van", MapConfig.Extractions.E1.pos)
	prompt("E1", part, {
		action = LoreConfig.Prompts.ChangeWheel,
		durationFor = repairDuration(route, route.repairTime),
		holdDuration = route.repairTime,
		canUse = function(player)
			return not routes.E1.prepared and hasItems(player, part.Position, { "ITM_Jack" })
		end,
		onTriggered = function()
			prepared("E1")
		end,
	})
	prompt("E1", part, {
		action = LoreConfig.Prompts.Drive,
		canUse = function(player)
			return routes.E1.prepared and triggersOpen and hasItems(player, part.Position, { "ITM_Keys" })
		end,
		onTriggered = function(player)
			-- 5.2 : démarrage bruyant ; les joueurs autour du van partent (P01, rayon 60)
			-- TODO(BIBLE): rayon du bruit du démarrage du van
			local noise = ActConfig.Routes.E1.startNoise
			if noise then
				services.NoiseService:Emit(part.Position, noise, NoiseTypes.Vehicle, player)
			end
			extract("E1", playersNear(MapConfig.Places.P01.pos, MapConfig.Places.P01.radius))
		end,
	})
end

SETUP.E2 = function(route)
	local p11 = MapConfig.Places.P11
	local radio = anchor("E2_Radio", p11.pos + Vector3.new(0, p11.cabinOffset, 0))
	local pad = MapConfig.Extractions.E2
	prompt("E2", radio, {
		action = LoreConfig.Prompts.Repair,
		durationFor = repairDuration(route, route.repairTime),
		holdDuration = route.repairTime,
		canUse = function(player)
			return not routes.E2.prepared and hasItems(player, radio.Position, route.needs)
		end,
		onTriggered = function(player)
			consume(player, radio.Position, route.needs)
			prepared("E2")
			-- 2.7 : DOC_09 rejoué quand la radio est réparée
			for _, listener in playersNear(radio.Position, p11.radius + p11.cabinOffset) do
				services.DocumentService:AddToJournal("DOC_09", listener)
				services.DocumentService:Open(listener, "DOC_09")
			end
		end,
	})
	prompt("E2", radio, {
		action = LoreConfig.Prompts.Call,
		canUse = function()
			return routes.E2.prepared and triggersOpen and not routes.E2.calling
		end,
		onTriggered = function()
			routes.E2.calling = true
			local endTime = workspace:GetServerTimeNow() + route.holdTime
			Util.getMatchState():SetAttribute("helicopterAt", endTime)
			ExtractionService.Calling:Fire("E2", endTime)
			task.delay(route.holdTime, function()
				local half = pad.area / 2
				local list = {}
				for _, player in Players:GetPlayers() do
					local root = Util.characterRoot(player)
					if root and services.HealthService:IsUp(player) then
						local d = root.Position - pad.pos
						if math.abs(d.X) <= half.X and math.abs(d.Z) <= half.Y then
							table.insert(list, player)
						end
					end
				end
				extract("E2", list)
			end)
		end,
	})
end

SETUP.E3 = function(route)
	local p10 = MapConfig.Places.P10
	local bulldozer = anchor("E3_Bulldozer", p10.pos)
	prompt("E3", bulldozer, {
		action = LoreConfig.Prompts.Repair,
		durationFor = repairDuration(route, route.repairTime),
		holdDuration = route.repairTime,
		canUse = function(player)
			return not routes.E3.prepared and hasItems(player, bulldozer.Position, route.needs)
		end,
		onTriggered = function(player)
			consume(player, bulldozer.Position, route.needs)
			prepared("E3")
		end,
	})
	prompt("E3", bulldozer, {
		action = LoreConfig.Prompts.Drive,
		canUse = function()
			return routes.E3.prepared and triggersOpen and not routes.E3.driving
		end,
		onTriggered = function()
			routes.E3.driving = true
			-- 5.2 : conduire 650 studs jusqu'à la barrière, lent (8 studs/s) ; la créature peut y grimper
			local target = MapConfig.Extractions.E3.pos
			local direction = (target - bulldozer.Position) * Vector3.new(1, 0, 1)
			local goal = bulldozer.Position + direction.Unit * route.driveDistance
			local duration = route.driveDistance / route.driveSpeed
			bulldozer:AddTag("Bulldozer")
			local tween =
				TweenService:Create(bulldozer, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Position = goal })
			tween:Play()
			tween.Completed:Wait()
			-- DÉFAUT : les joueurs à portée d'interaction du bulldozer partent avec lui
			extract("E3", playersNear(bulldozer.Position, ItemConfig.PickupDistance))
		end,
	})
end

SETUP.E4 = function(route)
	local plug = anchor("E4_Plug", MapConfig.Places.P07c.pos)
	prompt("E4", plug, {
		action = LoreConfig.Prompts.ClearPlug,
		holdDuration = route.clearTime,
		canUse = function(player)
			local hasLight = player:GetAttribute("lightOn") == true
			return triggersOpen and services.DocumentService:HasRead("DOC_07") and hasLight
		end,
		onTriggered = function()
			local p07c = MapConfig.Places.P07c
			-- DÉFAUT : les joueurs à portée d'interaction de la sortie partent
			extract("E4", playersNear(plug.Position, math.max(p07c.radius, ItemConfig.PickupDistance)))
		end,
	})
end

-- fin du siège : tirage de la voie principale (graine de la partie)
function ExtractionService:DrawMainRoute(seed)
	local random = Random.new(seed)
	mainRoute = ActConfig.MainRoutes[random:NextInteger(1, #ActConfig.MainRoutes)]
	Util.getMatchState():SetAttribute("mainRoute", mainRoute)
	return mainRoute
end

function ExtractionService:GetMainRoute()
	return mainRoute
end

-- acte 3 : active la voie principale, et E4 si DOC_07 a été lu
function ExtractionService:Activate()
	local list = { mainRoute }
	if services.DocumentService:HasRead(ActConfig.SecretRoute.requiresDocument) then
		table.insert(list, ActConfig.SecretRoute.id)
	end
	for _, routeId in list do
		if routes[routeId] == nil then
			routes[routeId] = { prompts = {} }
			SETUP[routeId](Routes[routeId])
		end
	end
	Util.getMatchState():SetAttribute("routes", Util.encode(list))
end

-- E4 ouverte dès que DOC_07 est lu pendant l'acte 3 ou 4
function ExtractionService:OnDocumentRead(docId)
	if docId == ActConfig.SecretRoute.requiresDocument and mainRoute ~= nil then
		self:Activate()
	end
end

-- acte 4 : les déclenchements deviennent possibles (DÉFAUT)
function ExtractionService:OpenTriggers()
	triggersOpen = true
end

function ExtractionService:IsPrepared(routeId)
	return routes[routeId] ~= nil and routes[routeId].prepared == true
end

function ExtractionService:Init(allServices)
	services = allServices
end

function ExtractionService:Start()
	services.DocumentService.Read:Connect(function(docId)
		self:OnDocumentRead(docId)
	end)
end

return ExtractionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">FearService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/FearService (Partie)
-- Section 7.5 : peur de 0 à 100 (attribut fear), jamais affichée en chiffre.
-- Lumière : la lampe du joueur allumée (attribut lightOn) ou une source taguée « LightSource »
-- dont la portée (attribut range) couvre le joueur. Feu et fusée : tag « FireSource » (attribut radius).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local NoiseTypes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NoiseTypes"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local FearService = {}

local Fear = PlayerConfig.Fear
local services = nil
local state = {} -- [Player] = { lastScream, seenBodies = {}, lastOrder }

local function nearestTeammate(player, position)
	local best = math.huge
	for _, other in Players:GetPlayers() do
		if other ~= player and services.HealthService:IsAlive(other) then
			local root = Util.characterRoot(other)
			if root then
				best = math.min(best, (root.Position - position).Magnitude)
			end
		end
	end
	return best
end

local function inLight(player, position, radius)
	if player:GetAttribute("lightOn") then
		return true
	end
	for _, source in CollectionService:GetTagged("LightSource") do
		local part = if source:IsA("BasePart") then source else source:FindFirstAncestorWhichIsA("BasePart")
		local range = source:GetAttribute("range") or 0
		if part and (part.Position - position).Magnitude <= math.max(range, radius) then
			return true
		end
	end
	return false
end

local function nearFire(position)
	for _, source in CollectionService:GetTagged("FireSource") do
		local part = if source:IsA("BasePart") then source else source:FindFirstAncestorWhichIsA("BasePart")
		local radius = source:GetAttribute("radius") or 0
		if part and (part.Position - position).Magnitude <= radius then
			return true
		end
	end
	return false
end

-- change la peur ; les hausses sont multipliées par le facteur du rôle (Descendante ×1,25)
function FearService:Add(player, amount)
	if not services.HealthService:IsAlive(player) then
		return
	end
	if amount > 0 then
		amount *= Fear.RoleFactor[player:GetAttribute("role")] or 1
	end
	local fear = math.clamp((player:GetAttribute("fear") or 0) + amount, 0, Fear.Max)
	player:SetAttribute("fear", fear)
	local s = state[player]
	if
		fear >= Fear.InvoluntaryScreamAt
		and s
		and os.clock() - (s.lastScream or -math.huge) >= Fear.InvoluntaryScreamCooldown
	then
		s.lastScream = os.clock()
		local root = Util.characterRoot(player)
		if root then
			-- 7.5 : cri involontaire (bruit 200) ; les coéquipiers à moins de 100 studs : +10
			services.NoiseService:Emit(root.Position, Fear.InvoluntaryScreamNoise, NoiseTypes.Scream, player)
			self:OnScream(root.Position, player)
		end
	end
end

-- 7.5 : cri à moins de 100 studs : +10 (cri de joueur ou de créature)
function FearService:OnScream(position, except)
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if player ~= except and root and (root.Position - position).Magnitude <= Fear.ScreamRadius then
			self:Add(player, Fear.Scream)
		end
	end
end

-- 7.5 : coup sur tronc entendu (+4) ; appelé par l'IA
function FearService:OnWoodKnock(player)
	self:Add(player, Fear.WoodKnock)
end

-- 7.5 : voir la créature (+20 à +35, plus si proche) ; appelé par l'IA
function FearService:OnSeeCreature(player, distance)
	if Fear.SeeCreatureRange == nil or distance > Fear.SeeCreatureRange then
		return
	end
	local closeness = 1 - distance / Fear.SeeCreatureRange
	self:Add(player, Fear.SeeCreatureMin + (Fear.SeeCreatureMax - Fear.SeeCreatureMin) * closeness)
end

-- 7.7 : ordre du Meneur : −20 aux coéquipiers à 15 studs, recharge 90 s
function FearService:LeaderOrder(player)
	local ability = PlayerConfig.Abilities.Leader
	local s = state[player]
	local root = Util.characterRoot(player)
	if player:GetAttribute("role") ~= "Leader" or not s or not root then
		return false
	end
	if os.clock() - (s.lastOrder or -math.huge) < ability.OrderCooldown then
		return false
	end
	s.lastOrder = os.clock()
	for _, other in Players:GetPlayers() do
		local otherRoot = Util.characterRoot(other)
		if otherRoot and (otherRoot.Position - root.Position).Magnitude <= ability.OrderRange then
			self:Add(other, ability.OrderFear)
		end
	end
	return true
end

local function tick(dt)
	for _, player in Players:GetPlayers() do
		local root = Util.characterRoot(player)
		if state[player] and root and services.HealthService:IsAlive(player) then
			local position = root.Position
			local delta = 0
			if inLight(player, position, Fear.NoLightRadius) then
				delta += Fear.InLightPerSecond
			else
				delta += Fear.NoLightPerSecond
			end
			local mate = nearestTeammate(player, position)
			if mate > Fear.AloneRadius then
				delta += Fear.AlonePerSecond
			elseif mate <= Fear.TeammateRadius then
				delta += Fear.TeammatePerSecond
			end
			if nearFire(position) then
				delta += Fear.NearFirePerSecond
			end
			-- 7.5 : voir un corps (+15 une fois par corps), si la portée est donnée par la bible
			if Fear.SeeBodyRange then
				for _, corpse in CollectionService:GetTagged("Corpse") do
					local s = state[player]
					local pivot = corpse:IsA("Model") and corpse:GetPivot().Position or corpse.Position
					if not s.seenBodies[corpse] and (pivot - position).Magnitude <= Fear.SeeBodyRange then
						s.seenBodies[corpse] = true
						FearService:Add(player, Fear.SeeBody)
					end
				end
			end
			FearService:Add(player, delta * dt)
		end
	end
end

function FearService:Init(allServices)
	services = allServices
end

function FearService:Start()
	services.CharacterService.Spawned:Connect(function(player)
		state[player] = { seenBodies = {} }
		player:SetAttribute("fear", 0)
	end)
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
		end
	end)
end

return FearService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">GameStateService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/GameStateService (Partie)
-- Sections 5 et 16.2 : actes, horloge, siège (acte 2), voie d'extraction, fins, fin à 06 h 00.
-- État publié dans MatchState : act, clock (heure décimale), objective, objectives (JSON),
-- siegeActive, finalAssault, creatureRetreat, mainRoute, routes, gameOver.
-- Interprétation (DÉFAUT, voir SUIVI.md) : un acte ne s'achève pas avant sa durée minimale, même
-- si sa condition est remplie ; il s'achève à sa durée maximale sinon.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local CinematicConfig = require(Config:WaitForChild("CinematicConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local GameStateService = {}

local HOURS = 24 -- constante (heures dans une journée)

GameStateService.ActChanged = Signal.new() -- (act)
GameStateService.SiegeStarted = Signal.new()
GameStateService.SiegeEnded = Signal.new()
GameStateService.BarricadeBroken = Signal.new() -- (openingPart) : tentative d'entrée (ATK_ReachThrough)
GameStateService.GameEnded = Signal.new() -- (results)

local services = nil
local state = nil
local info = nil
local act = 0
local actStartedAt = 0
local transition = nil -- { from, to, startedAt }
local cluesFound = {}
local campEntered = false
local cabinEnteredAt = nil
local alphaKilled = false
local extracted = {} -- [Player] = routeId
local extractionDone = false
local openings = {} -- [name] = part

local function setObjective(text)
	state:SetAttribute("objective", text or "")
	local list = Util.decode(state:GetAttribute("objectives"), {})
	if text and text ~= "" and list[#list] ~= text then
		table.insert(list, text)
		state:SetAttribute("objectives", Util.encode(list))
	end
	local remote = Util.getRemote("RE_Objective")
	if remote then
		remote:FireAllClients(act, text)
	end
end

local function elapsedInAct()
	return os.clock() - actStartedAt
end

-- 5.1 : dans un acte, l'heure avance linéairement de l'heure de début à l'heure de fin sur la
-- durée maximale ; au changement d'acte, elle saute à l'heure de début suivante en 10 s
local function updateClock()
	local def = ActConfig.Acts[act]
	local clock
	if transition then
		local t = math.clamp((os.clock() - transition.startedAt) / ActConfig.ActTransition, 0, 1)
		local to = transition.to
		if to < transition.from then
			to += HOURS
		end
		clock = (transition.from + (to - transition.from) * t) % HOURS
		if t >= 1 then
			transition = nil
		end
	else
		local t = math.clamp(elapsedInAct() / def.maxDuration, 0, 1)
		clock = (def.start + (def.finish - def.start) * t) % HOURS
		if def.finish == HOURS and t >= 1 then
			clock = 0
		end
	end
	state:SetAttribute("clock", clock)
	return clock
end

local function setAct(newAct)
	local previous = state:GetAttribute("clock") or ActConfig.Acts[newAct].start
	act = newAct
	actStartedAt = os.clock()
	if newAct > 0 then
		transition = { from = previous, to = ActConfig.Acts[newAct].start, startedAt = os.clock() }
	end
	state:SetAttribute("act", newAct)
	GameStateService.ActChanged:Fire(newAct)
	print(("GameStateService : acte %d (%s)"):format(newAct, ActConfig.Acts[newAct].name))
end

local function maxReached()
	return elapsedInAct() >= ActConfig.Acts[act].maxDuration
end

local function minReached()
	return elapsedInAct() >= ActConfig.Acts[act].minDuration
end

local function step()
	task.wait(PlayerConfig.Technical.Tick)
	updateClock()
end

local function alivePlayers()
	local list = {}
	for _, player in Players:GetPlayers() do
		if services.HealthService:IsAlive(player) and extracted[player] == nil then
			table.insert(list, player)
		end
	end
	return list
end

local function anyInside(place)
	for _, player in alivePlayers() do
		local root = Util.characterRoot(player)
		if root and (root.Position - place.pos).Magnitude <= place.radius then
			return true
		end
	end
	return false
end

-- 5.2 : barricades de la cabane (porte, fenêtre, trou du toit). Part nommées Door, Window, RoofHole
-- dans Workspace/Places/P05c si posées à la main ; sinon ancres invisibles autour de P05c (DÉFAUT).
local function setupBarricades()
	local cabin = MapConfig.Places.P05c
	local places = workspace:FindFirstChild("Places")
	local folder = places and places:FindFirstChild("P05c")
	for index, name in ActConfig.Siege.Openings do
		local part = folder and folder:FindFirstChild(name)
		if part == nil or not part:IsA("BasePart") then
			part = Instance.new("Part")
			part.Name = name
			part.Anchored = true
			part.CanCollide = false
			part.Transparency = 1
			part.Size = ItemConfig.PlaceholderSize
			local angle = (index - 1) * (2 * math.pi / #ActConfig.Siege.Openings)
			local r = cabin.radius / 2
			part.Position = cabin.pos + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
			part.Parent = workspace
		end
		part:SetAttribute("planks", 0)
		part:SetAttribute("impacts", 0)
		part:AddTag("Barricade")
		openings[name] = part
		services.InteractionService:CreatePrompt(part, {
			action = require(Config:WaitForChild("LoreConfig")).Prompts.Barricade,
			holdDuration = ActConfig.Siege.PlankTime,
			roleHoldDuration = ActConfig.Siege.RolePlankTime,
			canUse = function(player)
				return part:GetAttribute("planks") == 0 and services.InventoryService:Has(player, "ITM_Plank")
			end,
			onTriggered = function(player)
				if services.InventoryService:Remove(player, "ITM_Plank", 1) then
					part:SetAttribute("planks", 1)
					part:SetAttribute("impacts", 0)
					services.NoiseService:Emit(
						part.Position,
						ItemConfig.Items.ITM_Plank.nailNoise,
						NoiseTypes.Repair,
						player
					)
				end
			end,
		})
	end
end

-- 5.2 : une planche reçoit 4 impacts avant de céder ; appelé par l'IA (pierres du siège)
function GameStateService:HitBarricade(part)
	if part:GetAttribute("planks") ~= 1 then
		return
	end
	local impacts = (part:GetAttribute("impacts") or 0) + 1
	part:SetAttribute("impacts", impacts)
	if impacts >= ActConfig.Siege.PlankImpacts then
		part:SetAttribute("planks", 0)
		self.BarricadeBroken:Fire(part)
	end
end

function GameStateService:GetOpenings()
	return openings
end

function GameStateService:GetAct()
	return act
end

-- 9.12 et 5.3 : appelé par l'IA quand l'Alpha meurt
function GameStateService:OnAlphaKilled()
	alphaKilled = true
	state:SetAttribute("alphaKilled", true)
end

local function runAct1()
	setAct(1)
	setObjective(ActConfig.Objectives[1])
	local tabletRead = false
	while true do
		if not campEntered and anyInside(MapConfig.Places[ActConfig.Act1.CampPlace]) then
			campEntered = true
			services.CinematicService:Play("CS_04") -- 1re entrée dans P09
		end
		tabletRead = services.DocumentService:HasRead("DOC_07")
		local found = 0
		for _ in cluesFound do
			found += 1
		end
		if tabletRead and state:GetAttribute("objective") ~= ActConfig.Objectives.Cabin then
			-- 5.2 : la tablette indique le point de repli : la cabane de 1924
			setObjective(ActConfig.Objectives.Cabin)
		end
		if extractionDone or (tabletRead and found >= ActConfig.Act1.CluesNeeded and minReached()) or maxReached() then
			break
		end
		step()
	end
	if state:GetAttribute("objective") ~= ActConfig.Objectives.Cabin then
		setObjective(ActConfig.Objectives.Cabin)
	end
end

local function runAct2()
	setAct(2)
	services.WeatherService:SiegeChange() -- 5.2 : la météo se dégrade
	local siege = ActConfig.Siege
	local cabin = MapConfig.Places[siege.CabinPlace]
	-- le siège commence 60 s après l'entrée du premier joueur, ou à 23 h 05 si personne n'y est
	while true do
		if cabinEnteredAt == nil and anyInside(cabin) then
			cabinEnteredAt = os.clock()
		end
		local clock = updateClock()
		if extractionDone or (cabinEnteredAt and os.clock() - cabinEnteredAt >= siege.StartDelayAfterEntry) then
			break
		end
		if transition == nil and clock >= siege.StartHourIfNobody and clock < ActConfig.Acts[2].finish then
			break
		end
		step()
	end
	state:SetAttribute("siegeActive", true)
	GameStateService.SiegeStarted:Fire()
	services.CinematicService:Play("CS_06")
	local started = os.clock()
	while os.clock() - started < siege.Duration and not extractionDone do
		step()
	end
	state:SetAttribute("siegeActive", false)
	state:SetAttribute("silence", true)
	local quiet = os.clock()
	while os.clock() - quiet < siege.SilenceAfter and not extractionDone do
		step()
	end
	state:SetAttribute("silence", false)
	GameStateService.SiegeEnded:Fire()
	-- 5.2 : page 2 du carnet ; voie d'extraction tirée et annoncée (CS_07)
	services.DocumentService:UnlockNotebookPage(siege.NotebookPageUnlocked)
	for _, player in Players:GetPlayers() do
		local data = services.DataService:GetData(player)
		if data then
			data.notebookPages[siege.NotebookPageUnlocked] = true
		end
	end
	local route = services.ExtractionService:DrawMainRoute(info.seed)
	local routeText = ActConfig.Objectives.Extraction[route]
	services.CinematicService:PlayAndWait("CS_07", nil, { text = routeText })
	setObjective(routeText)
end

local function runAct3()
	setAct(3) -- constante (numéro d'acte, 5.1)
	services.CinematicService:Play("CS_08")
	services.ExtractionService:Activate()
	while true do
		local route = services.ExtractionService:GetMainRoute()
		if extractionDone or (services.ExtractionService:IsPrepared(route) and minReached()) or maxReached() then
			break
		end
		step()
	end
end

local function runAct4()
	setAct(4) -- constante (numéro d'acte, 5.1)
	services.CinematicService:Play("CS_09")
	-- 5.2 : à 05 h 00, dernier assaut
	state:SetAttribute("finalAssault", true)
	services.ExtractionService:OpenTriggers()
	while not extractionDone do
		local clock = updateClock()
		if clock >= ActConfig.Dawn.CreatureRetreatHour then
			state:SetAttribute("creatureRetreat", true) -- aucune attaque après 05 h 50, sauf dans les tunnels
		end
		if maxReached() or clock >= ActConfig.EndHour then
			break
		end
		step()
	end
end

-- 5.3 : fins et récompenses
local function computeResults()
	local endings = {}
	local survivors, truthSurvivors = 0, 0
	local classA = false
	for player, route in extracted do
		if route == "E4" then
			truthSurvivors += 1
		else
			survivors += 1
		end
		if services.EvidenceService:CarriesClassA(player) then
			classA = true
		end
	end
	if survivors > 0 then
		endings.Survie = true
		if classA then
			endings.Preuve = true
		end
	end
	if truthSurvivors > 0 then
		endings.Verite = true
		if classA then
			endings.Preuve = true
		end
	end
	if alphaKilled then
		endings.Ordonnance = true
		endings.Survie = nil -- Ordonnance 69-01 remplace Survie
	end
	if survivors + truthSurvivors == 0 then
		endings.Silence = true
	end

	local players = {}
	local evidence = {}
	local xpByUser = {}
	for _, player in Players:GetPlayers() do
		local status = if extracted[player]
			then "Extracted"
			elseif player:GetAttribute("isDead") then "Dead"
			else "Missing"
		table.insert(players, { name = player.DisplayName, status = status })
		local data = services.DataService:GetData(player)
		local xp = ProgressionConfig.XPGains.GamePlayed
		if extracted[player] then
			local carried, evidenceXp = services.EvidenceService:CommitForSurvivor(player)
			xp += ProgressionConfig.XPGains.Survival + evidenceXp
			for _, e in carried do
				table.insert(evidence, { class = e.class, kind = e.kind, holder = player.DisplayName })
			end
		end
		if data then
			data.plays += 1
			-- l'XP des preuves a déjà été ajoutée par EvidenceService:CommitForSurvivor
			data.xp += ProgressionConfig.XPGains.GamePlayed + (if extracted[player]
				then ProgressionConfig.XPGains.Survival
				else 0)
			if extracted[player] then
				data.survivals += 1
				data.nightmareUnlocked = true -- 5.4 : Cauchemar après une première survie
			end
			for ending in endings do
				data.endings[ending] = true
			end
			if endings.Verite then
				data.notebookPages[ActConfig.Endings.Verite.notebookPage] = true -- 5.3 : page 3 du carnet
			end
			services.DataService:Save(player)
		end
		xpByUser[tostring(player.UserId)] = xp
	end
	return { endings = endings, players = players, evidence = evidence, xp = xpByUser }
end

local function endingCinematics(results)
	local order = {}
	if results.endings.Ordonnance then
		table.insert(order, ActConfig.Endings.Ordonnance.cinematic)
	end
	if results.endings.Survie then
		for _, route in extracted do
			if route ~= "E4" then
				table.insert(order, ActConfig.Endings.Survie.cinematics[route])
				break
			end
		end
	end
	if results.endings.Verite then
		table.insert(order, ActConfig.Endings.Verite.cinematic)
	end
	if results.endings.Preuve then
		table.insert(order, ActConfig.Endings.Preuve.cinematic)
	end
	if results.endings.Silence then
		table.insert(order, ActConfig.Endings.Silence.cinematic)
	end
	for _, id in order do
		services.CinematicService:PlayAndWait(id, Players:GetPlayers())
	end
end

local function endGame()
	state:SetAttribute("gameOver", true)
	local results = computeResults()
	GameStateService.GameEnded:Fire(results)
	endingCinematics(results)
	local remote = Util.getRemote("RE_EndGame")
	if remote then
		remote:FireAllClients(results)
	end
	services.ReturnService:ReturnAll(results)
end

local function run()
	local _, players = services.PartyLoaderService:WaitUntilLoaded()
	info = services.PartyLoaderService:GetMatchInfo()
	-- attendre que les personnages soient posés
	local waited = 0
	while waited < PlayerConfig.Technical.Tick * 10 do
		local ready = true
		for _, player in players do
			if player.Parent and player:GetAttribute("role") == nil then
				ready = false
			end
		end
		if ready then
			break
		end
		task.wait(PlayerConfig.Technical.Tick)
		waited += PlayerConfig.Technical.Tick
	end
	state:SetAttribute("difficulty", info.difficulty)
	services.WeatherService:Begin(info)
	setupBarricades()

	-- acte 0 : arrivée, 3 min fixes
	setAct(0)
	setObjective(ActConfig.Objectives[0])
	services.CinematicService:Play(CinematicConfig.StartCinematic[info.start] or CinematicConfig.StartCinematic.S1)
	if info.start == "S3" then
		campEntered = true -- 5.2 : déjà au camp si départ S3
	end
	while not maxReached() and not extractionDone do
		step()
	end
	local acts = { runAct1, runAct2, runAct3, runAct4 }
	for _, runAct in acts do
		if extractionDone or #alivePlayers() == 0 then
			break
		end
		runAct()
	end
	endGame()
end

function GameStateService:Init(allServices)
	services = allServices
	state = Util.getMatchState()
	state:SetAttribute("act", 0)
	state:SetAttribute("clock", ActConfig.Acts[0].start)
end

function GameStateService:Start()
	services.ItemSpawnService.ClueFound:Connect(function(clueId)
		cluesFound[clueId] = true
		state:SetAttribute("cluesFound", Util.encode(Util.sortedKeys(cluesFound)))
	end)
	services.ExtractionService.Extracted:Connect(function(routeId, list)
		for _, player in list do
			extracted[player] = routeId
			player:SetAttribute("extracted", routeId)
		end
		if #list > 0 then
			extractionDone = true
		end
	end)
	-- DOC_08 lu : vidéo de la tablette (CS_05) pour le lecteur
	services.DocumentService.Read:Connect(function(docId, player)
		if docId == "DOC_08" and player then
			services.CinematicService:Play("CS_05", { player })
		end
	end)
	-- tous morts : la partie s'arrête (Silence)
	services.HealthService.Died:Connect(function()
		if #alivePlayers() == 0 and not state:GetAttribute("gameOver") then
			extractionDone = true
		end
	end)
	task.spawn(run)
end

return GameStateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">HealthService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/HealthService (Partie)
-- Section 7.3 : santé par membre, sang, hémorragies, à terre, relever, mort définitive, ragdoll.
-- Attributs du joueur (16.3) : hpHead, hpTorso, hpArmL, hpArmR, hpLegL, hpLegR, blood,
-- bleed ("None", "Light", "Heavy"), splinted, isDowned, downedEnd (heure serveur), isDead.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ActConfig = require(Config:WaitForChild("ActConfig"))
local GoreConfig = require(Config:WaitForChild("GoreConfig"))
local CreatureConfig = require(Config:WaitForChild("CreatureConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))

local HealthService = {}

HealthService.Damaged = Signal.new() -- (player, limb, amount, source)
HealthService.Downed = Signal.new() -- (player)
HealthService.Revived = Signal.new() -- (player, rescuer)
HealthService.Died = Signal.new() -- (player, cause)

-- 9.4 : points de piste laissés par une hémorragie { position, time }
HealthService.BloodTrail = {}

local services = nil
local state = {} -- [Player] = { downedLimb, lastTrail, revivePrompt, downedThread }

local function attr(limb)
	return "hp" .. limb
end

local function maxHealth(player, limb)
	local role = player:GetAttribute("role")
	local override = PlayerConfig.RoleLimbHealth[role]
	return (override and override[limb]) or PlayerConfig.LimbHealth[limb]
end

local function fraction(player, limb)
	return (player:GetAttribute(attr(limb)) or 0) / maxHealth(player, limb)
end

function HealthService:GetFraction(player, limb)
	return fraction(player, limb)
end

function HealthService:IsAlive(player)
	return player:GetAttribute("isDead") ~= true and player:GetAttribute("hpTorso") ~= nil
end

function HealthService:IsUp(player)
	return self:IsAlive(player) and player:GetAttribute("isDowned") ~= true
end

-- 7.3 : membre sous 30 %
function HealthService:IsLow(player, limb)
	return fraction(player, limb) < PlayerConfig.LowLimbThreshold
end

-- 7.2 : boiter (jambe < 30 %, sauf attelle)
function HealthService:IsLimping(player)
	if player:GetAttribute("splinted") then
		return false
	end
	return self:IsLow(player, "LegL") or self:IsLow(player, "LegR")
end

function HealthService:Setup(player)
	for _, limb in PlayerConfig.Limbs do
		player:SetAttribute(attr(limb), maxHealth(player, limb))
	end
	player:SetAttribute("blood", PlayerConfig.Blood.Max)
	player:SetAttribute("bleed", "None")
	player:SetAttribute("splinted", false)
	player:SetAttribute("isDowned", false)
	player:SetAttribute("downedEnd", nil)
	player:SetAttribute("isDead", false)
	state[player] = { lastTrail = nil }
end

-- 11.5 : ragdoll — chaque Motor6D devient un BallSocketConstraint ; ancré après 10 s immobile
local function ragdoll(character)
	for _, motor in character:GetDescendants() do
		if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then
			local a0 = Instance.new("Attachment")
			a0.CFrame = motor.C0
			a0.Parent = motor.Part0
			local a1 = Instance.new("Attachment")
			a1.CFrame = motor.C1
			a1.Parent = motor.Part1
			local socket = Instance.new("BallSocketConstraint")
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.Parent = motor.Parent
			motor.Enabled = false
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end
	task.spawn(function()
		local root = character:FindFirstChild("HumanoidRootPart")
		local still = 0
		local step = 1
		while character.Parent ~= nil and root and still < GoreConfig.Ragdoll.AnchorAfterStill do
			task.wait(step)
			if root.AssemblyLinearVelocity.Magnitude < 0.5 then
				still += step
			else
				still = 0
			end
		end
		for _, part in character:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
	end)
end

local function clearRevivePrompt(player)
	local s = state[player]
	if s and s.revivePrompt then
		s.revivePrompt:Destroy()
		s.revivePrompt = nil
	end
	if s and s.downedThread then
		task.cancel(s.downedThread)
		s.downedThread = nil
	end
end

function HealthService:Kill(player, cause)
	if player:GetAttribute("isDead") then
		return
	end
	clearRevivePrompt(player)
	player:SetAttribute("isDead", true)
	player:SetAttribute("isDowned", false)
	player:SetAttribute("downedEnd", nil)
	local character = player.Character
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")
		-- 7.3 : l'inventaire tombe dans un sac ramassable
		if root and services.InventoryService then
			services.InventoryService:DropAllAsBag(player, root.Position)
		end
		character:AddTag("Corpse")
		ragdoll(character)
	end
	self.Died:Fire(player, cause)
end

function HealthService:Revive(player, rescuer)
	if not player:GetAttribute("isDowned") or player:GetAttribute("isDead") then
		return
	end
	local s = state[player]
	clearRevivePrompt(player)
	-- 7.3 : le joueur revient avec 20 % sur le membre touché
	local limb = s and s.downedLimb
	if limb == "Blood" then
		player:SetAttribute("blood", PlayerConfig.ReviveBlood)
	elseif limb ~= nil then
		player:SetAttribute(attr(limb), maxHealth(player, limb) * PlayerConfig.Downed.ReviveLimbFraction)
	end
	player:SetAttribute("isDowned", false)
	player:SetAttribute("downedEnd", nil)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = false
	end
	self.Revived:Fire(player, rescuer)
end

function HealthService:SetDowned(player, limb)
	if player:GetAttribute("isDowned") or player:GetAttribute("isDead") then
		return
	end
	local info = services.PartyLoaderService:GetMatchInfo()
	local duration = ActConfig.difficulty(info.difficulty).downedTime
	local s = state[player]
	s.downedLimb = limb
	player:SetAttribute("isDowned", true)
	player:SetAttribute("downedEnd", workspace:GetServerTimeNow() + duration)
	self.Downed:Fire(player)

	-- relever : un coéquipier maintient l'invite 6 s (3 s pour la Médecin)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root and services.InteractionService then
		s.revivePrompt = services.InteractionService:CreatePrompt(root, {
			action = LoreConfig.Prompts.Revive,
			holdDuration = PlayerConfig.Downed.ReviveTime,
			roleHoldDuration = PlayerConfig.Downed.RoleReviveTime,
			canUse = function(rescuer)
				return rescuer ~= player and HealthService:IsUp(rescuer)
			end,
			onTriggered = function(rescuer)
				HealthService:Revive(player, rescuer)
			end,
		})
	end
	s.downedThread = task.delay(duration, function()
		s.downedThread = nil
		HealthService:Kill(player, "DownedTimeout")
	end)
end

local function setBleed(player, level)
	local order = { None = 0, Light = 1, Heavy = 2 }
	if order[level] > order[player:GetAttribute("bleed") or "None"] then
		player:SetAttribute("bleed", level)
	end
end

function HealthService:StartBleed(player, level)
	if self:IsAlive(player) then
		setBleed(player, level)
	end
end

-- bandage : arrête une hémorragie légère ; grave → légère. Médecin avec trousse : arrête la grave.
function HealthService:TreatBleed(player, canStopHeavy)
	local bleed = player:GetAttribute("bleed")
	if bleed == "Heavy" then
		player:SetAttribute("bleed", if canStopHeavy then "None" else "Light")
	elseif bleed == "Light" then
		player:SetAttribute("bleed", "None")
	end
end

-- membre le plus abîmé (proportion), voir PlayerConfig.HealTarget
function HealthService:MostDamagedLimb(player)
	local worst, worstFraction = PlayerConfig.Limbs[1], math.huge
	for _, limb in PlayerConfig.Limbs do
		local f = fraction(player, limb)
		if f < worstFraction then
			worst, worstFraction = limb, f
		end
	end
	return worst
end

function HealthService:Heal(player, limb, amount)
	limb = limb or self:MostDamagedLimb(player)
	local value = math.min(maxHealth(player, limb), (player:GetAttribute(attr(limb)) or 0) + amount)
	player:SetAttribute(attr(limb), value)
end

function HealthService:Splint(player)
	player:SetAttribute("splinted", true)
end

-- dégâts sur un membre ; `bleed` optionnel ("Light" / "Heavy")
function HealthService:Damage(player, limb, amount, source, bleed)
	if not self:IsAlive(player) or amount <= 0 then
		return
	end
	-- 6.1 : invulnérable pendant une cinématique, plus 3 s
	if services.CinematicService and services.CinematicService:IsProtected(player) then
		return
	end
	if player:GetAttribute("isDowned") then
		if PlayerConfig.Technical.DownedDamageKills then
			self:Kill(player, source)
		end
		return
	end
	local value = math.max(0, (player:GetAttribute(attr(limb)) or 0) - amount)
	player:SetAttribute(attr(limb), value)
	if bleed then
		setBleed(player, bleed)
	elseif PlayerConfig.BleedOnDamage.HeavyAt and amount >= PlayerConfig.BleedOnDamage.HeavyAt then
		setBleed(player, "Heavy")
	elseif PlayerConfig.BleedOnDamage.LightAt and amount >= PlayerConfig.BleedOnDamage.LightAt then
		setBleed(player, "Light")
	end
	if player:GetAttribute("splinted") and (limb == "LegL" or limb == "LegR") then
		player:SetAttribute("splinted", false)
	end
	self.Damaged:Fire(player, limb, amount, source)
	-- 7.3 : à terre quand la tête ou le torse tombe à 0
	if value <= 0 and (limb == "Head" or limb == "Torso") then
		self:SetDowned(player, limb)
	end
end

local function rootOf(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function tick(dt)
	for _, player in Players:GetPlayers() do
		if HealthService:IsAlive(player) then
			local bleed = player:GetAttribute("bleed")
			if bleed ~= "None" then
				local rate = if bleed == "Heavy"
					then PlayerConfig.Blood.HeavyBleedPerSecond
					else PlayerConfig.Blood.LightBleedPerSecond
				local blood = math.max(0, player:GetAttribute("blood") - rate * dt)
				player:SetAttribute("blood", blood)
				if blood <= 0 then
					HealthService:Kill(player, "Blood")
				elseif blood < PlayerConfig.Blood.DownedBelow then
					HealthService:SetDowned(player, "Blood")
				end
				-- 9.4 : un point de piste tous les n studs, actif n secondes
				local smell = CreatureConfig.Smell
				local root = rootOf(player)
				if smell and smell.TrailSpacing and root then
					local s = state[player]
					if s.lastTrail == nil or (root.Position - s.lastTrail).Magnitude >= smell.TrailSpacing then
						s.lastTrail = root.Position
						table.insert(HealthService.BloodTrail, { position = root.Position, time = os.clock() })
					end
				end
			end
		end
	end
	-- purge des points de piste expirés
	local smell = CreatureConfig.Smell
	if smell and smell.TrailLifetime then
		local now = os.clock()
		local trail = HealthService.BloodTrail
		while #trail > 0 and now - trail[1].time > smell.TrailLifetime do
			table.remove(trail, 1)
		end
	end
end

function HealthService:Init(allServices)
	services = allServices
end

function HealthService:Start()
	services.CharacterService.Spawned:Connect(function(player)
		HealthService:Setup(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		clearRevivePrompt(player)
		state[player] = nil
	end)
	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
		end
	end)
end

return HealthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">InteractionService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/InteractionService (Partie)
-- Section 16.2 et 16.3 : les interactions passent par des ProximityPrompt (style Custom, affichés par
-- InteractGui). Durée de maintien propre à chaque joueur (rôle, caisse à outils) : le serveur écrit
-- l'attribut hold_<UserId> sur l'invite ; le client l'applique ; le serveur vérifie le temps réel.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("ItemConfig"))
local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))

local InteractionService = {}

local KEY = PlayerConfig.Technical.InteractKey
local GAMEPAD_KEY = PlayerConfig.Technical.InteractGamepadKey
local HOLD_TOLERANCE = PlayerConfig.Technical.HoldTolerance

local prompts = {} -- [ProximityPrompt] = opts
local holdStart = {} -- [prompt][player] = os.clock()

local function durationFor(opts, player)
	if opts.durationFor then
		return opts.durationFor(player)
	end
	local role = player:GetAttribute("role")
	return (opts.roleHoldDuration and opts.roleHoldDuration[role]) or opts.holdDuration or 0
end

local function refresh(prompt, opts)
	for _, player in Players:GetPlayers() do
		prompt:SetAttribute("hold_" .. player.UserId, durationFor(opts, player))
	end
end

-- crée une invite sur `parent` (BasePart ou Attachment). opts : action, object, holdDuration,
-- roleHoldDuration, durationFor(player), canUse(player), onTriggered(player), maxDistance
function InteractionService:CreatePrompt(parent, opts)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.ActionText = opts.action or ""
	prompt.ObjectText = opts.object or ""
	prompt.KeyboardKeyCode = KEY
	prompt.GamepadKeyCode = GAMEPAD_KEY
	prompt.HoldDuration = opts.holdDuration or 0
	prompt.MaxActivationDistance = opts.maxDistance or ItemConfig.PickupDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	prompts[prompt] = opts
	holdStart[prompt] = {}
	refresh(prompt, opts)

	prompt.PromptButtonHoldBegan:Connect(function(player)
		holdStart[prompt][player] = os.clock()
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player)
		holdStart[prompt][player] = nil
	end)
	prompt.Triggered:Connect(function(player)
		if opts.canUse and not opts.canUse(player) then
			return
		end
		local needed = durationFor(opts, player)
		if needed > 0 then
			local began = holdStart[prompt][player]
			if began == nil or os.clock() - began + HOLD_TOLERANCE < needed then
				return -- maintien trop court : refusé
			end
		end
		holdStart[prompt][player] = nil
		opts.onTriggered(player)
	end)
	prompt.Destroying:Connect(function()
		prompts[prompt] = nil
		holdStart[prompt] = nil
	end)
	return prompt
end

-- recalcule les durées propres à chaque joueur (inventaire ou rôle changé)
function InteractionService:Refresh()
	for prompt, opts in prompts do
		refresh(prompt, opts)
	end
end

function InteractionService:Init() end

-- 7.8 et 16.3 : RE_Ping (position) — repère visible 10 s par le groupe ;
-- clone de ReplicatedStorage/UITemplates/PingMarker (15.5)
local function onPing(player, position)
	if typeof(position) ~= "Vector3" or player:GetAttribute("isDead") then
		return
	end
	local templates = ReplicatedStorage:FindFirstChild("UITemplates")
	local marker = templates and templates:FindFirstChild("PingMarker")
	local anchor = Instance.new("Part")
	anchor.Name = "Ping_" .. player.Name
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = position
	anchor.Parent = workspace
	if marker then
		marker:Clone().Parent = anchor
	else
		warn("UI manquante : UITemplates/PingMarker")
	end
	game:GetService("Debris"):AddItem(anchor, PlayerConfig.Communication.PingDuration)
end

function InteractionService:Start()
	Players.PlayerAdded:Connect(function()
		self:Refresh()
	end)
	local remote = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util")).getRemote("RE_Ping")
	if remote then
		require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RateLimiter")).connect(remote, onPing)
	end
end

return InteractionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/InventoryService (Partie)
-- Sections 8 et 8.1, 16.3 : 4 emplacements rapides (3 pour la Mécanicienne), sac limité à 12 kg,
-- objets lourds (> 5 kg) à deux mains, utilisation des objets, lampes et piles.
-- Remotes : RE_EquipSlot, RE_UseItem, RE_DropItem, RE_PickupItem, RE_ToggleLight.
-- Numéros d'emplacement (DÉFAUT) : 1..N = emplacements rapides, N+1.. = lignes du sac ; 0 = capacité du rôle.
-- État répliqué : attribut inventory (JSON { quick, bag, selected, weight }), heldItem, heavyHands,
-- lightOn, lightBattery, busyUntil.
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local InventoryService = {}

InventoryService.Changed = Signal.new() -- (player)
InventoryService.ItemUsed = Signal.new() -- (player, itemId, entry)
InventoryService.AbilityUsed = Signal.new() -- (player, role)
InventoryService.BearSpray = Signal.new() -- (player, origin, direction, cone)
InventoryService.ProjectileLanded = Signal.new() -- (player, itemId, position)

local services = nil
local inventories = {} -- [Player] = { quick = {}, bag = {}, selected = 1 }

local THROW_SPEED = ItemConfig.Throw.Speed
local THROW_FLIGHT = ItemConfig.Throw.Flight
local NOISE_TRAP_RADIUS = ItemConfig.NoiseTrapRadius

local function itemDef(id)
	return ItemConfig.Items[id] or WeaponConfig.Weapons[id]
end

local function weightOf(entry)
	local def = itemDef(entry.id)
	return ((def and def.weight) or 0) * (entry.count or 1)
end

local function isHeavy(id)
	local def = ItemConfig.Items[id]
	return def ~= nil and (def.twoHands or (def.weight or 0) > ItemConfig.HeavyAbove)
end

local function quickCount(player)
	if player:GetAttribute("role") == "Mechanic" then
		return PlayerConfig.Abilities.Mechanic.QuickSlots
	end
	return ItemConfig.QuickSlots
end

local function bagWeight(inv)
	local total = 0
	for _, entry in inv.bag do
		total += weightOf(entry)
	end
	return total
end

local function publish(player)
	local inv = inventories[player]
	if inv == nil then
		return
	end
	local quick = {}
	for i = 1, quickCount(player) do
		quick[i] = inv.quick[i] or false
	end
	player:SetAttribute(
		"inventory",
		Util.encode({ quick = quick, bag = inv.bag, selected = inv.selected, weight = bagWeight(inv) })
	)
	local held = inv.quick[inv.selected]
	player:SetAttribute("heldItem", held and held.id or nil)
	local heavy = false
	for _, entry in inv.quick do
		if entry and isHeavy(entry.id) then
			heavy = true
		end
	end
	player:SetAttribute("heavyHands", heavy)
	InventoryService.Changed:Fire(player)
end

-- entrée par numéro d'emplacement ; renvoie entry, liste, index
local function entryAt(player, slot)
	local inv = inventories[player]
	if inv == nil or type(slot) ~= "number" then
		return nil
	end
	local n = quickCount(player)
	if slot >= 1 and slot <= n then
		return inv.quick[slot], inv.quick, slot
	end
	local bagIndex = slot - n
	return inv.bag[bagIndex], inv.bag, bagIndex
end

local function newEntry(id, count, extra)
	local entry = { id = id, count = count or 1 }
	local def = itemDef(id)
	if def and def.uses then
		entry.uses = def.uses
	end
	if def and (def.light or def.recordMinutes) then
		entry.battery = 1
	end
	if WeaponConfig.Weapons[id] and WeaponConfig.Weapons[id].ammo then
		-- TODO(BIBLE): munitions au départ (chargeur plein, réserve ?). PROVISOIRE : chargeur plein, réserve 0.
		entry.ammo = WeaponConfig.Weapons[id].ammo
	end
	if extra then
		for k, v in extra do
			entry[k] = v
		end
	end
	return entry
end

function InventoryService:Get(player)
	return inventories[player]
end

function InventoryService:Selected(player)
	local inv = inventories[player]
	return inv and inv.quick[inv.selected] or nil, inv and inv.selected or nil
end

-- nombre d'unités d'un objet dans tout l'inventaire
function InventoryService:Count(player, id)
	local inv = inventories[player]
	local total = 0
	if inv then
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if entry and entry.id == id then
					total += entry.count or 1
				end
			end
		end
	end
	return total
end

function InventoryService:Has(player, id)
	return self:Count(player, id) > 0
end

-- retire `count` unités d'un objet ; renvoie true si tout a été retiré
function InventoryService:Remove(player, id, count)
	local inv = inventories[player]
	count = count or 1
	if inv == nil or self:Count(player, id) < count then
		return false
	end
	for _, list in { inv.quick, inv.bag } do
		for key, entry in list do
			if count > 0 and entry and entry.id == id then
				local take = math.min(count, entry.count or 1)
				entry.count -= take
				count -= take
				if entry.count <= 0 then
					if list == inv.quick then
						list[key] = nil
					else
						table.remove(list, key)
					end
				end
			end
		end
	end
	publish(player)
	return true
end

-- ajoute un objet : d'abord une pile existante, puis un emplacement rapide libre, puis le sac (12 kg).
-- Un objet lourd (> 5 kg) va seulement dans un emplacement rapide (porté à deux mains).
function InventoryService:Add(player, id, count, extra)
	local inv = inventories[player]
	local def = itemDef(id)
	if inv == nil then
		return false
	end
	count = count or 1
	local stack = (def and def.stack) or 1
	if extra == nil then
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if count > 0 and entry and entry.id == id and entry.count < stack then
					local add = math.min(count, stack - entry.count)
					entry.count += add
					count -= add
				end
			end
		end
	end
	while count > 0 do
		local put = math.min(count, stack)
		local entry = newEntry(id, put, extra)
		local placed = false
		for i = 1, quickCount(player) do
			if inv.quick[i] == nil then
				inv.quick[i] = entry
				placed = true
				break
			end
		end
		if not placed and not isHeavy(id) and bagWeight(inv) + weightOf(entry) <= ItemConfig.BagMaxWeight then
			table.insert(inv.bag, entry)
			placed = true
		end
		if not placed then
			publish(player)
			return false
		end
		count -= put
	end
	publish(player)
	return true
end

-- objet posé dans le monde (ItemSpawnService) ; renvoie la Part
function InventoryService:SpawnWorld(id, count, position, extra)
	return services.ItemSpawnService:SpawnWorldItem(id, count, position, extra)
end

local function dropEntry(player, entry)
	local root = Util.characterRoot(player)
	if root then
		local extra = table.clone(entry)
		extra.id = nil
		extra.count = nil
		InventoryService:SpawnWorld(entry.id, entry.count, root.Position - Vector3.new(0, 2, 0), extra)
		local def = itemDef(entry.id)
		if def and def.dropNoise then
			services.NoiseService:Emit(root.Position, def.dropNoise, NoiseTypes.Item, player)
		end
	end
end

function InventoryService:Drop(player, slot)
	local entry, list, index = entryAt(player, slot)
	if entry == nil then
		return
	end
	if list == inventories[player].quick then
		list[index] = nil
	else
		table.remove(list, index)
	end
	if entry.lit then
		self:SetLight(player, false)
	end
	dropEntry(player, entry)
	publish(player)
end

-- 7.3 : à la mort, l'inventaire tombe dans un sac ramassable
function InventoryService:DropAllAsBag(player, position)
	local inv = inventories[player]
	if inv == nil then
		return
	end
	self:SetLight(player, false)
	local contents = {}
	for i = 1, quickCount(player) do
		if inv.quick[i] then
			table.insert(contents, inv.quick[i])
		end
	end
	for _, entry in inv.bag do
		table.insert(contents, entry)
	end
	inv.quick, inv.bag = {}, {}
	publish(player)
	if #contents > 0 then
		services.ItemSpawnService:SpawnBag(contents, position)
	end
end

-- prend le contenu d'un sac au sol ; le reste y reste
function InventoryService:TakeBag(player, bagPart)
	local contents = Util.decode(bagPart:GetAttribute("contents"), {})
	local left = {}
	for _, entry in contents do
		local extra = table.clone(entry)
		extra.id, extra.count = nil, nil
		if not self:Add(player, entry.id, entry.count, next(extra) and extra or nil) then
			table.insert(left, entry)
		end
	end
	if #left == 0 then
		bagPart:Destroy()
	else
		bagPart:SetAttribute("contents", Util.encode(left))
	end
end

function InventoryService:Pickup(player, part)
	if part == nil or not part:IsDescendantOf(workspace) then
		return false
	end
	local root = Util.characterRoot(player)
	if root == nil or not services.HealthService:IsUp(player) then
		return false
	end
	local position = part:IsA("Model") and part:GetPivot().Position or part.Position
	if (position - root.Position).Magnitude > ItemConfig.PickupDistance then
		return false
	end
	local id = part:GetAttribute("itemId")
	if id == nil then
		return false
	end
	-- documents (2.7) : lus et rangés dans le journal du groupe
	if string.match(id, "^DOC_") then
		services.DocumentService:Collect(player, id, part)
		part:Destroy()
		return true
	end
	if id == "AmmoBox" then
		-- 3.4 : 5 balles de fusil + 6 de revolver + 4 cartouches (rangées en réserve, AMMO_<arme>)
		for weaponId, amount in WeaponConfig.AmmoBox do
			self:Add(player, "AMMO_" .. weaponId, amount)
		end
		part:Destroy()
		return true
	end
	local extra = Util.decode(part:GetAttribute("payload"), nil)
	if self:Add(player, id, part:GetAttribute("count") or 1, extra) then
		services.ItemSpawnService:OnPickedUp(player, part)
		part:Destroy()
		return true
	end
	return false
end

function InventoryService:Equip(player, slot)
	local inv = inventories[player]
	if inv == nil or type(slot) ~= "number" or slot < 1 or slot > quickCount(player) then
		return
	end
	-- 8 : objet lourd porté : il reste en main
	local held = inv.quick[inv.selected]
	if held and isHeavy(held.id) and slot ~= inv.selected then
		return
	end
	if held and held.lit and not (itemDef(held.id).light or {}).handsFree then
		self:SetLight(player, false)
	end
	inv.selected = slot
	publish(player)
end

-- lampes (8.1, 12.1) : SpotLight à 45° sur la tête du personnage, portée de l'objet
local function lightEntry(player)
	local inv = inventories[player]
	if inv == nil then
		return nil
	end
	local held = inv.quick[inv.selected]
	if held and itemDef(held.id) and itemDef(held.id).light then
		return held
	end
	for _, list in { inv.quick, inv.bag } do
		for _, entry in list do
			local def = entry and itemDef(entry.id)
			if def and def.light and def.light.handsFree then
				return entry -- la frontale éclaire sans être en main
			end
		end
	end
	return nil
end

function InventoryService:SetLight(player, on)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local existing = head and head:FindFirstChild("PlayerLamp")
	local inv = inventories[player]
	if inv then
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if entry then
					entry.lit = nil
				end
			end
		end
	end
	if not on then
		if existing then
			existing:Destroy()
		end
		player:SetAttribute("lightOn", false)
		publish(player)
		return
	end
	local entry = lightEntry(player)
	if entry == nil or (entry.battery or 0) <= 0 or head == nil then
		return
	end
	local def = itemDef(entry.id).light
	entry.lit = true
	if existing then
		existing:Destroy()
	end
	local lamp = Instance.new("SpotLight")
	lamp.Name = "PlayerLamp"
	lamp.Angle = def.angle
	lamp.Range = math.min(def.range, AmbienceConfig.Lamp.EngineMaxRange)
	lamp.Shadows = true
	lamp.Face = Enum.NormalId.Front
	lamp:SetAttribute("range", def.range) -- portée de jeu (8.1), lue par la perception
	lamp:AddTag("PlayerLamp")
	lamp.Parent = head
	player:SetAttribute("lightOn", true)
	player:SetAttribute("lightRange", def.range)
	publish(player)
end

-- utilisation à durée : bloque les autres actions (« pas en action », 16.3)
local function busy(player, duration, done)
	local now = workspace:GetServerTimeNow()
	if (player:GetAttribute("busyUntil") or 0) > now then
		return false
	end
	player:SetAttribute("busyUntil", now + duration)
	task.delay(duration, function()
		player:SetAttribute("busyUntil", nil)
		if services.HealthService:IsUp(player) then
			done()
		end
	end)
	return true
end

local function consumeUse(player, entry, slot)
	if entry.uses then
		entry.uses -= 1
		if entry.uses <= 0 then
			entry.count -= 1
			if entry.count <= 0 then
				local _, list, index = entryAt(player, slot)
				if list == inventories[player].quick then
					list[index] = nil
				else
					table.remove(list, index)
				end
			else
				entry.uses = itemDef(entry.id).uses
			end
		end
	else
		InventoryService:Remove(player, entry.id, 1)
	end
	publish(player)
end

local function placeSource(position, duration, opts)
	local part = Instance.new("Part")
	part.Name = opts.name
	part.Size = ItemConfig.FireVisuals.Size
	part.Anchored = true
	part.CanCollide = false
	part.Color = opts.color
	part.Material = Enum.Material.Neon
	part.Position = position
	local light = Instance.new("PointLight")
	light.Color = opts.color
	light.Range = math.min(opts.radius, AmbienceConfig.Lamp.EngineMaxRange)
	light.Parent = part
	part:SetAttribute("radius", opts.radius)
	part:SetAttribute("range", opts.radius)
	part:SetAttribute("keepAway", opts.keepAway)
	part:SetAttribute("visibleRange", opts.visibleRange)
	CollectionService:AddTag(part, "FireSource")
	CollectionService:AddTag(part, "LightSource")
	part.Parent = workspace
	Debris:AddItem(part, duration)
	return part
end

local function throw(player, entry, slot)
	local root = Util.characterRoot(player)
	if root == nil then
		return
	end
	local def = itemDef(entry.id)
	local landing = root.Position + root.CFrame.LookVector * THROW_SPEED * THROW_FLIGHT
	consumeUse(player, entry, slot)
	task.delay(THROW_FLIGHT, function()
		local noise = def.impactNoise or def.breakNoise
		services.NoiseService:Emit(landing, noise, NoiseTypes.Impact, player)
		InventoryService.ProjectileLanded:Fire(player, entry.id, landing)
	end)
end

local EFFECTS = {}

EFFECTS.RechargeLight = function(player, entry, slot, def)
	local light = lightEntry(player)
	if light == nil then
		return
	end
	busy(player, def.duration, function()
		light.battery = 1
		consumeUse(player, entry, slot)
	end)
end

local function healDuration(player, def)
	-- 7.7 : la Médecin soigne ×2 (DÉFAUT : deux fois plus vite)
	if player:GetAttribute("role") == "Medic" then
		return def.duration / PlayerConfig.Abilities.Medic.HealFactor
	end
	return def.duration
end

EFFECTS.Bandage = function(player, entry, slot, def)
	busy(player, healDuration(player, def), function()
		services.HealthService:TreatBleed(player, false)
		services.HealthService:Heal(player, nil, def.heal)
		consumeUse(player, entry, slot)
	end)
end

EFFECTS.Splint = function(player, entry, slot, def)
	busy(player, healDuration(player, def), function()
		services.HealthService:Splint(player)
		consumeUse(player, entry, slot)
	end)
end

EFFECTS.Medkit = function(player, entry, slot, def)
	busy(player, healDuration(player, def), function()
		services.HealthService:Heal(player, nil, def.heal)
		-- 8.1 : arrête une hémorragie grave (Médecin seulement)
		if player:GetAttribute("role") == "Medic" then
			services.HealthService:TreatBleed(player, true)
		end
		consumeUse(player, entry, slot)
	end)
end

EFFECTS.Flare = function(player, entry, slot, def)
	local root = Util.characterRoot(player)
	if root == nil then
		return
	end
	consumeUse(player, entry, slot)
	services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
	-- DÉFAUT : la fusée allumée est posée aux pieds du joueur
	placeSource(root.Position - Vector3.new(0, ItemConfig.FireVisuals.GroundOffset, 0), def.burn, {
		name = "Flare",
		color = ItemConfig.FireVisuals.FlareColor,
		radius = def.lightRadius,
		keepAway = def.creatureKeepAway,
	})
end

EFFECTS.Campfire = function(player, entry, slot, def)
	local root = Util.characterRoot(player)
	if root == nil or InventoryService:Count(player, "ITM_Branch") < def.branchesNeeded then
		return
	end
	InventoryService:Remove(player, "ITM_Branch", def.branchesNeeded)
	consumeUse(player, entry, slot)
	services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
	local flare = ItemConfig.Items.ITM_Flare
	placeSource(
		root.Position
			+ root.CFrame.LookVector * ItemConfig.FireVisuals.CampfireAhead
			- Vector3.new(0, ItemConfig.FireVisuals.GroundOffset, 0),
		def.burn,
		{
			name = "Campfire",
			color = ItemConfig.FireVisuals.CampfireColor,
			radius = flare.lightRadius, -- 8.1 : même effet qu'une fusée
			keepAway = flare.creatureKeepAway,
			visibleRange = def.visibleRange,
		}
	)
end

EFFECTS.BearSpray = function(player, entry, slot, def)
	local root = Util.characterRoot(player)
	if root == nil then
		return
	end
	consumeUse(player, entry, slot)
	services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
	InventoryService.BearSpray:Fire(player, root.Position, root.CFrame.LookVector, def.cone)
end

local function useAbility(player)
	local role = player:GetAttribute("role")
	if role == "Leader" then
		services.FearService:LeaderOrder(player)
	elseif role == "Pyrotechnician" then
		-- 7.7 : 1 fusée par 2 piles + 1 ruban ; piège : boîte de conserve + corde
		local recipes = PlayerConfig.Abilities.Pyrotechnician
		local function canCraft(recipe)
			for id, n in recipe do
				if InventoryService:Count(player, id) < n then
					return false
				end
			end
			return true
		end
		if canCraft(recipes.FlareRecipe) then
			for id, n in recipes.FlareRecipe do
				InventoryService:Remove(player, id, n)
			end
			InventoryService:Add(player, "ITM_Flare", 1)
		elseif canCraft(recipes.NoiseTrapRecipe) and NOISE_TRAP_RADIUS then
			for id, n in recipes.NoiseTrapRecipe do
				InventoryService:Remove(player, id, n)
			end
		end
	end
	InventoryService.AbilityUsed:Fire(player, role)
end

function InventoryService:Use(player, slot)
	if not services.HealthService:IsUp(player) then
		return
	end
	if slot == 0 then
		useAbility(player)
		return
	end
	local entry = entryAt(player, slot)
	if entry == nil then
		return
	end
	local def = itemDef(entry.id)
	if def == nil then
		return
	end
	if def.throwable then
		throw(player, entry, slot)
	elseif def.effect and EFFECTS[def.effect] then
		local root = Util.characterRoot(player)
		if def.noise and root and def.effect ~= "Flare" and def.effect ~= "BearSpray" then
			services.NoiseService:Emit(root.Position, def.noise, NoiseTypes.Item, player)
		end
		EFFECTS[def.effect](player, entry, slot, def)
	end
	-- effets traités ailleurs : preuves, tablette, documents (EvidenceService, TabletService, DocumentService)
	self.ItemUsed:Fire(player, entry.id, entry, slot)
end

-- 8.1 et 8.3 : décharge des lampes allumées
local function drainLights(dt)
	for player, inv in inventories do
		for _, list in { inv.quick, inv.bag } do
			for _, entry in list do
				if entry and entry.lit then
					local def = itemDef(entry.id).light
					entry.battery =
						math.max(0, (entry.battery or 0) - dt / (def.batteryMinutes * Util.SECONDS_PER_MINUTE))
					player:SetAttribute("lightBattery", entry.battery)
					if entry.battery <= 0 then
						InventoryService:SetLight(player, false)
					end
				end
			end
		end
	end
end

-- objets de départ (8.1, colonne « Où »)
function InventoryService:GiveStarting(player, weaponId)
	local role = player:GetAttribute("role")
	local start = ItemConfig.StartingItems
	if not start.Flashlight.exceptRoles[role] then
		self:Add(player, start.Flashlight.item, 1)
	end
	for id, n in start.Roles[role] or {} do
		self:Add(player, id, n)
	end
	for id, n in start.All do
		self:Add(player, id, n)
	end
	-- 8.2 : armes de rôle (pistolet lance-fusées, hache) et arme choisie au lobby
	for id, weapon in WeaponConfig.Weapons do
		if weapon.owner == role then
			self:Add(player, id, 1)
		end
	end
	if weaponId and WeaponConfig.Weapons[weaponId] then
		self:Add(player, weaponId, 1)
	end
end

function InventoryService:Init(allServices)
	services = allServices
end

function InventoryService:Start()
	services.CharacterService.Spawned:Connect(function(player)
		inventories[player] = { quick = {}, bag = {}, selected = 1 }
		local info = services.PartyLoaderService:GetMatchInfo()
		local entry = info.roles[player.UserId]
		self:GiveStarting(player, entry and entry.weapon)
		services.InteractionService:Refresh()
	end)
	Players.PlayerRemoving:Connect(function(player)
		inventories[player] = nil
	end)

	local handlers = {
		RE_EquipSlot = function(player, slot)
			self:Equip(player, slot)
		end,
		RE_UseItem = function(player, slot)
			self:Use(player, slot)
		end,
		RE_DropItem = function(player, slot)
			self:Drop(player, slot)
		end,
		RE_PickupItem = function(player, part)
			if typeof(part) == "Instance" then
				self:Pickup(player, part)
			end
		end,
		RE_ToggleLight = function(player)
			-- 16.3 : lampe équipée, pile > 0
			local root = Util.characterRoot(player)
			local on = not player:GetAttribute("lightOn")
			self:SetLight(player, on)
			if root then
				services.NoiseService:Emit(
					root.Position,
					ItemConfig.Items.ITM_Flashlight.noise,
					NoiseTypes.Item,
					player
				)
			end
		end,
	}
	for name, handler in handlers do
		local remote = Util.getRemote(name)
		if remote then
			RateLimiter.connect(remote, handler)
		end
	end

	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			drainLights(step)
		end
	end)
end

return InventoryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">ItemSpawnService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/ItemSpawnService (Partie)
-- Sections 3.4, 8.1 et 2.7 : tirages avec la graine de la partie (écrite dans la console) :
-- 6 points d'indice sur 12, un emplacement par objet clé, objets et documents à lieu fixe.
-- Modèles : ReplicatedStorage/Items/Item_<Nom> (13.3) ; absent → bloc gris MANQUANT_<ID>.
-- Workspace/CluePoints peut contenir des Part nommées comme les codes (C01, K1, A3…) : elles
-- remplacent les coordonnées de MapConfig (réglage à la main en phase B).
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local ItemSpawnService = {}

ItemSpawnService.ClueFound = Signal.new() -- (clueId, player)

local services = nil
local folder = nil
local drawn = {} -- résultat du tirage, pour la console et les tests

local PLACEHOLDER_SIZE = ItemConfig.PlaceholderSize
local SPAWN_LIFT = ItemConfig.SpawnLift

local function modelName(id)
	return (string.gsub(id, "^ITM_", "Item_"))
end

local function makeVisual(id, position)
	local itemsFolder = ReplicatedStorage:FindFirstChild(ItemConfig.ModelsFolder)
	local template = itemsFolder and itemsFolder:FindFirstChild(modelName(id))
	if template then
		local clone = template:Clone()
		local part = clone:IsA("BasePart") and clone
			or clone.PrimaryPart
			or clone:FindFirstChildWhichIsA("BasePart", true)
		clone:PivotTo(CFrame.new(position))
		return clone, part
	end
	local part = Instance.new("Part")
	part.Name = "MANQUANT_" .. modelName(id)
	part.Size = PLACEHOLDER_SIZE
	part.Color = ItemConfig.PlaceholderColor
	part.Material = Enum.Material.SmoothPlastic
	part.Position = position
	return part, part
end

-- objet posé dans le monde, ramassable (ProximityPrompt « Ramasser »)
function ItemSpawnService:SpawnWorldItem(id, count, position, payload, clueId)
	local visual, part = makeVisual(id, position + Vector3.new(0, SPAWN_LIFT, 0))
	if part == nil then
		visual:Destroy()
		visual, part = makeVisual("MANQUANT", position)
	end
	for _, p in visual:IsA("BasePart") and { visual } or visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	visual:SetAttribute("itemId", id)
	visual:SetAttribute("count", count or 1)
	if payload and next(payload) then
		visual:SetAttribute("payload", Util.encode(payload))
	end
	if clueId then
		visual:SetAttribute("clueId", clueId)
		CollectionService:AddTag(visual, "Clue")
	end
	CollectionService:AddTag(visual, "WorldItem")
	visual.Parent = folder
	local def = ItemConfig.Items[id]
	services.InteractionService:CreatePrompt(part, {
		action = LoreConfig.Prompts.Pickup,
		object = def and def.name or "",
		onTriggered = function(player)
			services.InventoryService:Pickup(player, visual)
		end,
	})
	return visual
end

-- sac d'un joueur mort (7.3)
function ItemSpawnService:SpawnBag(contents, position)
	local visual, part = makeVisual("ITM_Bag", position)
	visual.Name = "DeadBag"
	for _, p in visual:IsA("BasePart") and { visual } or visual:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
		end
	end
	visual:SetAttribute("contents", Util.encode(contents))
	visual.Parent = folder
	services.InteractionService:CreatePrompt(part, {
		action = LoreConfig.Prompts.Open,
		onTriggered = function(player)
			services.InventoryService:TakeBag(player, visual)
		end,
	})
	return visual
end

function ItemSpawnService:OnPickedUp(player, part)
	local clueId = part:GetAttribute("clueId")
	if clueId then
		self.ClueFound:Fire(clueId, player)
	end
end

local function markerOr(code, fallback)
	local markers = workspace:FindFirstChild("CluePoints")
	local marker = markers and markers:FindFirstChild(code)
	if marker and marker:IsA("BasePart") then
		return marker.Position
	end
	return fallback
end

local function shuffle(list, random)
	for i = #list, 2, -1 do
		local j = random:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- 3.4 : 6 points sur 12. DÉFAUT (algorithme) : chacun des 4 documents tirés (DOC_03 à DOC_06)
-- reçoit un point distinct parmi ceux qui peuvent le contenir ; les points restants sont tirés
-- parmi C09–C12 (objets). Chaque point tiré contient donc quelque chose.
local function drawCluePoints(random)
	local documents = { "DOC_03", "DOC_04", "DOC_05", "DOC_06" }
	local docPoints, itemPoints = {}, {}
	for code, point in MapConfig.CluePoints do
		if string.match(point.contents[1], "^DOC_") then
			table.insert(docPoints, code)
		else
			table.insert(itemPoints, code)
		end
	end
	table.sort(docPoints)
	table.sort(itemPoints)
	local assignment
	-- appariement aléatoire document → point compatible (recommencé jusqu'à réussir)
	for _ = 1, 100 do
		assignment = {}
		local used = {}
		local ok = true
		for _, doc in shuffle(table.clone(documents), random) do
			local options = {}
			for _, code in docPoints do
				if not used[code] and table.find(MapConfig.CluePoints[code].contents, doc) then
					table.insert(options, code)
				end
			end
			if #options == 0 then
				ok = false
				break
			end
			local code = options[random:NextInteger(1, #options)]
			used[code] = true
			assignment[code] = { doc }
		end
		if ok then
			break
		end
	end
	local remaining = MapConfig.CluePointsDrawn - #documents
	for _, code in shuffle(table.clone(itemPoints), random) do
		if remaining <= 0 then
			break
		end
		assignment[code] = MapConfig.CluePoints[code].contents
		remaining -= 1
	end
	return assignment
end

local function spawnAll(info)
	local random = Random.new(info.seed)
	print(("ItemSpawnService : graine %d"):format(info.seed))

	-- points d'indice
	local clues = drawCluePoints(random)
	drawn.clues = clues
	local drawnCodes = Util.sortedKeys(clues)
	print("ItemSpawnService : points d'indice tirés : " .. table.concat(drawnCodes, ", "))
	for code, contents in clues do
		local base = markerOr(code, MapConfig.CluePoints[code].pos)
		for i, id in contents do
			local offset = Vector3.new((i - 1) * ItemConfig.ClueItemSpacing, 0, 0)
			local count = if string.match(id, "^DOC_") then 1 else MapConfig.ClueItemQuantity
			ItemSpawnService:SpawnWorldItem(id, count, base + offset, nil, code)
		end
	end

	-- objets clés (un emplacement tiré par objet)
	local difficulty = ActConfig.difficulty(info.difficulty)
	for key, spec in MapConfig.KeyItems do
		if spec.item == "AmmoBox" and not difficulty.ammoBox then
			continue -- 5.4 : pas de boîte de munitions en Cauchemar
		end
		local index = random:NextInteger(1, #spec.spots)
		local code = ({
			Keys = "K",
			AmmoBox = "A",
			Jack = "J",
			CoaxCable = "R",
			CarBattery = "R",
			Jerrycan = "R",
			StarterRelay = "R",
		})[key] .. tostring(index)
		local position = markerOr(code, MapConfig.resolve(spec.spots[index]))
		drawn[key] = index
		if position then
			ItemSpawnService:SpawnWorldItem(spec.item, 1, position)
		end
	end

	-- objets à lieu fixe (8.1)
	for _, spec in MapConfig.FixedItems do
		for _, place in spec.places do
			local position = MapConfig.resolve(place)
			if position then
				ItemSpawnService:SpawnWorldItem(spec.item, spec.count or 1, position)
			end
		end
	end
	-- DÉFAUT : l'appareil photo de C03–C06 est posé sur un des points tirés parmi eux, s'il y en a un
	local photoPoints = {}
	for _, code in MapConfig.PhotoCameraCluePoints do
		if clues[code] then
			table.insert(photoPoints, code)
		end
	end
	if #photoPoints > 0 then
		local code = photoPoints[random:NextInteger(1, #photoPoints)]
		ItemSpawnService:SpawnWorldItem(
			"ITM_PhotoCamera",
			1,
			markerOr(code, MapConfig.CluePoints[code].pos) + Vector3.new(0, 0, ItemConfig.ClueItemSpacing)
		)
	end

	-- documents à lieu fixe (2.7) ; DOC_09 est un message radio (rejoué par la tour, J9)
	for doc, place in MapConfig.FixedDocuments do
		if doc ~= "DOC_09" and LoreConfig.Documents and LoreConfig.Documents[doc] then
			local position = MapConfig.resolve(place)
			if position then
				ItemSpawnService:SpawnWorldItem(doc, 1, position + ItemConfig.DocumentOffset)
			end
		end
	end
end

function ItemSpawnService:GetDraw()
	return drawn
end

function ItemSpawnService:Init(allServices)
	services = allServices
	folder = Instance.new("Folder")
	folder.Name = "WorldItems"
	folder.Parent = workspace
end

function ItemSpawnService:Start()
	task.spawn(function()
		services.PartyLoaderService:WaitUntilLoaded()
		spawnAll(services.PartyLoaderService:GetMatchInfo())
	end)
end

return ItemSpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">NoiseService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/NoiseService (Partie)
-- Section 16.2 : reçoit tous les bruits (sections 7 et 8) et les diffuse à la perception (9.4).
-- Un bruit = { position, radius, kind, source, time }.
-- DÉFAUT : la pluie (×0,6, 12.3 et 9.4) est appliquée une seule fois, par la perception (AI/Perception).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))

local NoiseService = {}

-- (noise) : chaque bruit émis
NoiseService.Emitted = Signal.new()

local history = {} -- [Player] = { {time, radius} } (9.7 : bruit des 10 dernières secondes)

function NoiseService:Emit(position, radius, kind, source)
	if radius == nil or radius <= 0 then
		return
	end
	local noise = {
		position = position,
		radius = radius,
		kind = kind or NoiseTypes.Other,
		source = source,
		time = os.clock(),
	}
	if typeof(source) == "Instance" and source:IsA("Player") then
		local list = history[source]
		if list == nil then
			list = {}
			history[source] = list
		end
		table.insert(list, { time = noise.time, radius = noise.radius })
	end
	self.Emitted:Fire(noise)
	return noise
end

-- 9.7 : plus fort bruit fait par le joueur pendant les `window` dernières secondes
-- (interprétation de « bruit des 10 dernières secondes », voir SUIVI.md)
function NoiseService:RecentNoise(player, window)
	local list = history[player]
	if list == nil then
		return 0
	end
	local now = os.clock()
	local loudest = 0
	for index = #list, 1, -1 do
		local entry = list[index]
		if now - entry.time > window then
			table.remove(list, index)
		elseif entry.radius > loudest then
			loudest = entry.radius
		end
	end
	return loudest
end

function NoiseService:Init() end

function NoiseService:Start()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		history[player] = nil
	end)
end

return NoiseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">PartyLoaderService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/PartyLoaderService (Partie)
-- Section 16.2 : lit la configuration de partie écrite par le Lobby (MemoryStore,
-- clé Launch_<id>, 16.4), puis attend les joueurs, 60 s au plus.
-- Section 16.1 : si la version du Lobby diffère de celle de la Partie, la partie n'a pas lieu.
local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))
local Version = require(Shared:WaitForChild("Version"))

local PartyLoaderService = {}

-- (launchData, players) : configuration lue et joueurs présents à la fin de l'attente.
-- launchData vaut nil hors serveur réservé (test dans Studio).
PartyLoaderService.Loaded = Signal.new()

local services = nil
local memory = LaunchConfig.MemoryStore
local launchMap = nil
local state = "loading" -- "loading", "ready" ou "rejecting"
local rejectKey = nil
local launchData = nil
local presentPlayers = {}
local waitingFor = nil -- [userId] = true pendant l'attente des joueurs

local function sendBack(player)
	services.ReturnService:ReturnPlayers({ player }, nil, rejectKey)
end

-- la partie ne peut pas avoir lieu : chaque joueur présent ou à venir repart au Lobby
-- avec le message `messageKey` (4.6)
local function reject(messageKey, reason)
	warn("PartyLoaderService : " .. reason)
	state = "rejecting"
	rejectKey = messageKey
	for _, player in Players:GetPlayers() do
		task.spawn(sendBack, player)
	end
end

local function finish(data, players)
	state = "ready"
	launchData = data
	presentPlayers = players
	PartyLoaderService.Loaded:Fire(data, players)
end

-- attend les joueurs annoncés dans la configuration, ArrivalTimeout secondes au plus
local function waitForPlayers(data)
	local expected = {}
	local expectedCount = 0
	for _, entry in data.players do
		expected[entry.userId] = true
		expectedCount += 1
	end
	waitingFor = expected
	-- 4.6 : MSG_WaitingPlayers aux joueurs déjà là (les suivants le reçoivent à l'arrivée)
	for _, player in Players:GetPlayers() do
		Util.notify(player, "MSG_WaitingPlayers")
	end

	local done = false
	local connection = nil

	local function complete()
		if done then
			return
		end
		done = true
		waitingFor = nil
		if connection ~= nil then
			connection:Disconnect()
		end
		local present = {}
		for userId in expected do
			local player = Players:GetPlayerByUserId(userId)
			if player ~= nil then
				table.insert(present, player)
			end
		end
		-- 4.6 : MSG_PlayerMissing pour chaque absent, envoyé aux présents
		for _, entry in data.players do
			if Players:GetPlayerByUserId(entry.userId) == nil then
				for _, player in present do
					Util.notify(player, "MSG_PlayerMissing", { player = entry.name })
				end
			end
		end
		-- TODO(J9): un joueur absent après 60 s — son rôle n'existe pas dans la partie (4.4, étape 3)
		print(("PartyLoaderService : %d/%d joueur(s) arrivé(s)"):format(#present, expectedCount))
		finish(data, present)
	end

	local function check()
		for userId in expected do
			if Players:GetPlayerByUserId(userId) == nil then
				return
			end
		end
		complete()
	end

	connection = Players.PlayerAdded:Connect(check)
	task.delay(LaunchConfig.ArrivalTimeout, complete)
	check()
end

local function load()
	if game.PrivateServerId == "" then
		-- DÉFAUT : hors serveur réservé (test dans Studio), aucune configuration de partie
		warn("PartyLoaderService : pas de serveur réservé (Studio ?), aucune configuration de partie")
		finish(nil, Players:GetPlayers())
		return
	end
	if launchMap == nil then
		-- 4.6 : configuration introuvable → MSG_LaunchConfigMissing
		reject("MSG_LaunchConfigMissing", "MemoryStore inaccessible")
		return
	end

	local key = memory.LaunchKeyPrefix .. game.PrivateServerId
	local ok, data = Util.retry(memory.Attempts, memory.RetryDelay, function()
		return launchMap:GetAsync(key)
	end)
	if not ok then
		reject("MSG_LaunchConfigMissing", "lecture de la configuration impossible : " .. tostring(data))
		return
	end
	if type(data) ~= "table" then
		reject("MSG_LaunchConfigMissing", "configuration de partie introuvable (" .. key .. ")")
		return
	end
	if data.version ~= Version.Number then
		-- 16.1 : la Partie compare les versions et renvoie le groupe au Lobby
		reject(
			"MSG_VersionMismatch",
			("version du Lobby %s, version de la Partie %d"):format(tostring(data.version), Version.Number)
		)
		return
	end

	-- 3.4 : graine écrite dans la console pour rejouer un bug
	print(("PartyLoaderService : graine %s, départ %s"):format(tostring(data.seed), tostring(data.start)))
	waitForPlayers(data)
end

-- informations de partie pour les autres services (difficulté, météo, départ, graine, rôles).
-- DÉFAUT : hors serveur réservé (Studio), partie de test : Normal, météo aléatoire, départ S1,
-- graine os.time(), rôles attribués dans l'ordre de PlayerConfig.Roles.
local testSeed = os.time()
function PartyLoaderService:GetMatchInfo()
	local data = launchData
	local roles = {}
	if data ~= nil then
		for _, entry in data.players do
			roles[entry.userId] = { role = entry.role, weapon = entry.weapon }
		end
	end
	return {
		difficulty = data and data.difficulty or LaunchConfig.Votes.DefaultDifficulty,
		weather = data and data.weather or LaunchConfig.Votes.DefaultWeather,
		start = data and data.start or "S1",
		seed = data and data.seed or testSeed,
		roles = roles,
		playerCount = if data then #data.players else #Players:GetPlayers(),
		isTest = data == nil,
	}
end

-- configuration de la partie (nil tant qu'elle n'est pas lue, ou hors serveur réservé)
function PartyLoaderService:GetLaunchData()
	return launchData
end

-- attend la fin du chargement ; renvoie la configuration et les joueurs présents
function PartyLoaderService:WaitUntilLoaded()
	if state ~= "ready" then
		self.Loaded:Wait()
	end
	return launchData, presentPlayers
end

function PartyLoaderService:Init(allServices)
	services = allServices
	local ok, result = pcall(function()
		return MemoryStoreService:GetHashMap(memory.LaunchMapName)
	end)
	if ok then
		launchMap = result
	else
		warn("PartyLoaderService : MemoryStore inaccessible : " .. tostring(result))
	end
end

function PartyLoaderService:Start()
	Players.PlayerAdded:Connect(function(player)
		if state == "rejecting" then
			sendBack(player)
		elseif waitingFor ~= nil then
			Util.notify(player, "MSG_WaitingPlayers")
		end
		-- DÉFAUT : un joueur absent de la configuration, ou arrivé après les 60 s, peut rester
	end)

	task.spawn(load)
end

return PartyLoaderService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">ReturnService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/ReturnService (Partie)
-- Section 16.2 : téléportation vers le Lobby avec les résultats.
-- Les résultats (fin obtenue, survivants, preuves sorties, XP : 4.4 étape 8) sont calculés au jalon J9.
-- Ils voyagent dans les données de téléportation pour l'affichage seulement (ResultsGui) :
-- les gains sont sauvegardés par DataService ici (au départ du joueur), jamais relus depuis ces données.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local LaunchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("LaunchConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Version = require(Shared:WaitForChild("Version"))

local ReturnService = {}

-- renvoie les joueurs au Lobby (MSG_ReturnToLobby, 4.6) ; `results` = table affichée à l'arrivée (peut être nil)
function ReturnService:ReturnPlayers(players, results, messageKey)
	local placeId = LaunchConfig.PlaceIds.Lobby
	local travellers = {}
	for _, player in players do
		if player.Parent ~= nil then
			table.insert(travellers, player)
			Util.notify(player, messageKey or "MSG_ReturnToLobby")
		end
	end
	if #travellers == 0 then
		return true
	end

	local options = Instance.new("TeleportOptions")
	options:SetTeleportData({ version = Version.Number, results = results })

	-- DÉFAUT : nouvel essai après un échec, comme au départ (LaunchConfig.Teleport)
	local teleport = LaunchConfig.Teleport
	for attempt = 1, teleport.Attempts do
		local ok, err = pcall(function()
			return TeleportService:TeleportAsync(placeId, travellers, options)
		end)
		if ok then
			return true
		end
		warn(
			("ReturnService : retour au Lobby impossible (essai %d, normal en Studio) : %s"):format(
				attempt,
				tostring(err)
			)
		)
		if attempt < teleport.Attempts then
			task.wait(teleport.RetryDelay)
		end
	end
	return false
end

function ReturnService:ReturnAll(results)
	return self:ReturnPlayers(Players:GetPlayers(), results)
end

function ReturnService:Init() end

function ReturnService:Start()
	TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
		warn(
			("ReturnService : téléportation échouée pour %s (%s) : %s"):format(
				player.Name,
				tostring(teleportResult),
				tostring(errorMessage)
			)
		)
	end)
end

return ReturnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/SpawnService (Partie)
-- Sections 3.3 et 16.2 : départs S1–S3 ; autour du point, 10 points espacés de 6 studs.
-- Workspace/SpawnPoints peut contenir des Part nommées S1_1 … S3_10 (posées à la main en phase B) :
-- elles remplacent le calcul.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("MapConfig"))
local PlayerConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PlayerConfig"))

local SpawnService = {}

-- DÉFAUT : les 10 points sont alignés d'ouest en est, centrés sur le départ
local SPAWN_LIFT = PlayerConfig.Technical.SpawnLift

local function computedPoint(start, index)
	local base = MapConfig.Spawns[start] or MapConfig.Spawns.S1
	local count = MapConfig.SpawnPointCount
	local slot = ((index - 1) % count) - (count - 1) / 2
	return base + Vector3.new(slot * MapConfig.SpawnPointSpacing, SPAWN_LIFT, 0)
end

function SpawnService:GetPoint(start, index)
	local folder = workspace:FindFirstChild("SpawnPoints")
	local marker = folder and folder:FindFirstChild(("%s_%d"):format(start, index))
	if marker and marker:IsA("BasePart") then
		return marker.Position + Vector3.new(0, SPAWN_LIFT, 0)
	end
	return computedPoint(start, index)
end

function SpawnService:Place(_player, character, start, index)
	local point = self:GetPoint(start, index or 1)
	character:PivotTo(CFrame.new(point))
end

function SpawnService:Init() end

function SpawnService:Start() end

return SpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">StaminaService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/StaminaService (Partie)
-- Sections 7.2 et 7.4 : postures (RE_SetStance), vitesses, endurance, bruits de pas et de saut.
-- Attributs : stance ("Stand", "Crouch", "Prone", "Run"), stamina, isExhausted.
-- Le serveur fixe Humanoid.WalkSpeed ; il compare la vitesse réelle à la posture (16.3).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))

local StaminaService = {}

local VOXEL = 4 -- constante (résolution des voxels du terrain Roblox)

local services = nil
local state = {} -- [Player] = { lastEffort, exhaustedUntil, lastStep, moving }
local Movement = PlayerConfig.Movement
local Stamina = PlayerConfig.Stamina

local function maxStamina(player)
	local role = player:GetAttribute("role")
	local value = Stamina.RoleMax[role] or Stamina.Max
	if services.HealthService:IsLow(player, "Torso") then
		value *= PlayerConfig.LowTorsoStaminaFactor
	end
	return value
end

-- matériau sous les pieds : "Water" (eau aux genoux), "Ash" (Sand = cendre, 3.6), "Snow", ou nil
local function terrainKind(character, humanoid)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		local knee = root.Position - Vector3.new(0, VOXEL / 2, 0)
		local half = Vector3.one * (VOXEL / 2)
		local region = Region3.new(knee - half, knee + half):ExpandToGrid(VOXEL)
		local ok, materials, occupancies = pcall(function()
			return workspace.Terrain:ReadVoxels(region, VOXEL)
		end)
		if ok and materials[1] and materials[1][1] and materials[1][1][1] == Enum.Material.Water then
			if occupancies[1][1][1] > 0 then
				return "Water"
			end
		end
	end
	local floor = humanoid.FloorMaterial
	if floor == Enum.Material.Sand then
		return "Ash"
	elseif floor == Enum.Material.Snow then
		return "Snow"
	end
	return nil
end

local function canRun(player)
	local s = state[player]
	return not (s and s.exhaustedUntil and os.clock() < s.exhaustedUntil)
		and (player:GetAttribute("stamina") or 0) > 0
		and not services.HealthService:IsLimping(player)
		and player:GetAttribute("heavyHands") ~= true -- 8 : objet lourd à deux mains : pas de course
		and (player:GetAttribute("carrying") == nil or Movement.RoleCanRunCarrying[player:GetAttribute("role")])
end

-- mode de déplacement effectif et vitesse
local function movementFor(player)
	local stance = player:GetAttribute("stance") or "Stand"
	local role = player:GetAttribute("role")
	if player:GetAttribute("isDowned") then
		return "Downed", PlayerConfig.Downed.CrawlSpeed, 0
	end
	local mode = PlayerConfig.Stances[stance] or "Walk"
	if mode == "Run" and not canRun(player) then
		mode = "Walk"
	end
	if player:GetAttribute("carrying") ~= nil and mode ~= "Run" then
		mode = "Carry"
	end
	local entry = Movement[mode]
	local speed = entry.speed
	local noise = entry.noise
	if mode == "Run" then
		speed = Movement.RoleRunSpeed[role] or speed
		noise = Movement.RoleRunNoise[role] or noise
	elseif mode == "Carry" then
		speed = Movement.RoleCarrySpeed[role] or speed
	end
	if services.HealthService:IsLimping(player) then
		speed *= Movement.LimpSpeedFactor
		noise += Movement.LimpNoiseBonus
	end
	return mode, speed, noise
end

local function tick(dt)
	local weather = services.PartyLoaderService:GetMatchInfo().weather
	local weatherEntry = AmbienceConfig.Weathers[weather]
	for _, player in Players:GetPlayers() do
		local s = state[player]
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if s and humanoid and services.HealthService:IsAlive(player) then
			local mode, speed, noise = movementFor(player)
			local kind = terrainKind(character, humanoid)
			if kind then
				speed *= Movement.TerrainSpeedFactor[kind]
				if kind == "Water" then
					noise *= Movement.WaterNoiseFactor
				end
			end
			humanoid.WalkSpeed = speed

			local root = character:FindFirstChild("HumanoidRootPart")
			local velocity = root and root.AssemblyLinearVelocity or Vector3.zero
			local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			local moving = humanoid.MoveDirection.Magnitude > 0.1 and horizontal > 0.5
			if
				horizontal > speed * PlayerConfig.Technical.StanceSpeedTolerance + 1
				and humanoid.FloorMaterial ~= Enum.Material.Air
			then
				warn(("StaminaService : vitesse anormale pour %s (%.1f > %.1f)"):format(player.Name, horizontal, speed))
			end

			-- endurance (7.4)
			local stamina = player:GetAttribute("stamina") or maxStamina(player)
			local cost = 0
			if moving and mode == "Run" then
				cost += Stamina.RunCostPerSecond
			end
			if player:GetAttribute("carrying") ~= nil and moving then
				cost += Stamina.CarryCostPerSecond
			end
			if cost > 0 then
				stamina -= cost * dt
				s.lastEffort = os.clock()
			elseif os.clock() - (s.lastEffort or 0) >= Stamina.RegenDelay then
				local regen = if moving then Stamina.RegenWalkingPerSecond else Stamina.RegenIdlePerSecond
				if (player:GetAttribute("fear") or 0) >= PlayerConfig.Fear.MisplacedSoundsAt then
					regen *= PlayerConfig.Fear.StaminaRegenFactorAt80
				end
				-- TODO(BIBLE): 12.3 « endurance ×0,85 » par neige — PROVISOIRE : appliqué à la récupération
				if weatherEntry and weatherEntry.staminaFactor then
					regen *= weatherEntry.staminaFactor
				end
				stamina += regen * dt
			end
			stamina = math.clamp(stamina, 0, maxStamina(player))
			if stamina <= 0 and not (s.exhaustedUntil and os.clock() < s.exhaustedUntil) then
				s.exhaustedUntil = os.clock() + Stamina.ExhaustedDuration
			end
			local exhausted = s.exhaustedUntil ~= nil and os.clock() < s.exhaustedUntil
			player:SetAttribute("stamina", stamina)
			player:SetAttribute("isExhausted", exhausted)
			if exhausted and root then
				services.NoiseService:Emit(root.Position, Stamina.ExhaustedPantNoise, NoiseTypes.Pant, player)
			end

			-- bruits de pas
			if
				moving
				and root
				and noise > 0
				and os.clock() - (s.lastStep or 0) >= PlayerConfig.Technical.FootstepNoiseInterval
			then
				s.lastStep = os.clock()
				services.NoiseService:Emit(root.Position, noise, NoiseTypes.Footstep, player)
			end
		end
	end
end

local function onCharacter(player, character)
	state[player] = { lastEffort = 0 }
	player:SetAttribute("stance", "Stand")
	player:SetAttribute("stamina", maxStamina(player))
	player:SetAttribute("isExhausted", false)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	humanoid.StateChanged:Connect(function(_, new)
		local root = character:FindFirstChild("HumanoidRootPart")
		if new == Enum.HumanoidStateType.Jumping then
			player:SetAttribute("stamina", math.max(0, (player:GetAttribute("stamina") or 0) - Stamina.JumpCost))
			state[player].lastEffort = os.clock()
		elseif new == Enum.HumanoidStateType.Landed and root then
			services.NoiseService:Emit(root.Position, Movement.JumpLandNoise, NoiseTypes.Jump, player)
		end
	end)
end

function StaminaService:Init(allServices)
	services = allServices
end

function StaminaService:Start()
	services.CharacterService.Spawned:Connect(onCharacter)
	local remote = Util.getRemote("RE_SetStance")
	if remote then
		RateLimiter.connect(remote, function(player, stance)
			if type(stance) == "string" and PlayerConfig.Stances[stance] then
				player:SetAttribute("stance", stance)
			end
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
	task.spawn(function()
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
		end
	end)
end

return StaminaService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">TabletService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/TabletService (Partie)
-- DÉFAUT : module ajouté — 16.2 ne nomme pas le service qui traite RE_TabletAction (16.3).
-- Section 8.3 : une tablette par groupe (Meneur, sinon le premier joueur), écran = visibilité ×1,5,
-- batterie de 30 min d'écran allumé, GPS à ±30 studs toutes les 10 s (50 % « Pas de signal GPS »
-- sous forêt dense), 8 repères, Réseau : une barre au sommet de P11 et à P23, SMS au ranger Hollis.
-- RE_TabletAction (C → S) : (app, action, data). Contrôle : porte la tablette.
-- Attributs : tabletOpen, tabletBattery, gpsX, gpsZ, gpsSignal, tabletMessage (joueur) ;
-- markers (MatchState, JSON).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ItemConfig = require(Config:WaitForChild("ItemConfig"))
local LoreConfig = require(Config:WaitForChild("LoreConfig"))
local MapConfig = require(Config:WaitForChild("MapConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Util = require(Shared:WaitForChild("Util"))

local TabletService = {}

local services = nil
local Tablet = ItemConfig.Tablet
local markers = {}
local random = Random.new()

local function tabletEntry(player)
	local inv = services.InventoryService:Get(player)
	if inv == nil then
		return nil
	end
	for _, list in { inv.quick, inv.bag } do
		for _, entry in list do
			if entry and entry.id == "ITM_TabletField" then
				return entry
			end
		end
	end
	return nil
end

local function setOpen(player, open)
	local entry = tabletEntry(player)
	if entry == nil or (open and (entry.battery or 1) <= 0) then
		open = false
	end
	player:SetAttribute("tabletOpen", open)
end

local function inDenseForest(position)
	local zone = MapConfig.Places.P04.zone
	return position.X >= zone.minX and position.X <= zone.maxX and position.Z >= zone.minZ and position.Z <= zone.maxZ
end

-- 8.3 : une barre au sommet de P11 et à P23 (DÉFAUT : « sommet » = dans le rayon et au niveau de la cabine)
local function hasNetwork(position)
	for _, code in Tablet.NetworkPlaces do
		local place = MapConfig.Places[code]
		local flat = Vector2.new(position.X - place.pos.X, position.Z - place.pos.Z).Magnitude
		local minY = place.pos.Y + (place.cabinOffset or 0) / 2
		if flat <= place.radius and position.Y >= minY then
			return true
		end
	end
	return false
end

local function updateGps(player)
	local root = Util.characterRoot(player)
	if root == nil or tabletEntry(player) == nil then
		return
	end
	if inDenseForest(root.Position) and random:NextNumber() < Tablet.DenseForestNoSignalChance then
		player:SetAttribute("gpsSignal", false)
		return
	end
	local e = Tablet.GpsError
	player:SetAttribute("gpsSignal", true)
	player:SetAttribute("gpsX", root.Position.X + random:NextNumber(-e, e))
	player:SetAttribute("gpsZ", root.Position.Z + random:NextNumber(-e, e))
	player:SetAttribute("network", hasNetwork(root.Position))
end

local ACTIONS = {
	Device = {
		Toggle = function(player)
			setOpen(player, not player:GetAttribute("tabletOpen"))
		end,
		Close = function(player)
			setOpen(player, false)
		end,
	},
	Map = {
		AddMarker = function(_player, data)
			if type(data) ~= "table" or type(data.x) ~= "number" or type(data.z) ~= "number" then
				return
			end
			if #markers >= Tablet.MaxMarkers then
				return
			end
			table.insert(markers, { x = data.x, z = data.z })
			Util.getMatchState():SetAttribute("markers", Util.encode(markers))
		end,
		RemoveMarker = function(_player, data)
			if type(data) == "table" and type(data.index) == "number" and markers[data.index] then
				table.remove(markers, data.index)
				Util.getMatchState():SetAttribute("markers", Util.encode(markers))
			end
		end,
	},
	Network = {
		Send = function(player)
			local root = Util.characterRoot(player)
			if root and hasNetwork(root.Position) then
				-- 8.3 : réponse automatique du ranger Hollis
				player:SetAttribute("tabletMessage", LoreConfig.Tablet.HollisReply)
			else
				player:SetAttribute("tabletMessage", LoreConfig.Tablet.NoNetwork)
			end
		end,
	},
}

local function onAction(player, app, action, data)
	if type(app) ~= "string" or type(action) ~= "string" then
		return
	end
	if tabletEntry(player) == nil then
		return -- 16.3 : porte la tablette
	end
	local handlers = ACTIONS[app]
	local handler = handlers and handlers[action]
	if handler then
		handler(player, data)
	end
end

local function tick(dt)
	for _, player in Players:GetPlayers() do
		local entry = tabletEntry(player)
		if entry == nil and player:GetAttribute("tabletOpen") then
			player:SetAttribute("tabletOpen", false)
		end
		if entry and player:GetAttribute("tabletOpen") then
			entry.battery = math.max(0, (entry.battery or 1) - dt / (Tablet.BatteryMinutes * Util.SECONDS_PER_MINUTE))
			player:SetAttribute("tabletBattery", entry.battery)
			if entry.battery <= 0 then
				setOpen(player, false)
			end
		elseif entry then
			player:SetAttribute("tabletBattery", entry.battery or 1)
		end
	end
end

function TabletService:Init(allServices)
	services = allServices
end

function TabletService:Start()
	local remote = Util.getRemote("RE_TabletAction")
	if remote then
		RateLimiter.connect(remote, onAction)
	end
	services.InventoryService.ItemUsed:Connect(function(player, itemId)
		if itemId == "ITM_TabletField" then
			setOpen(player, not player:GetAttribute("tabletOpen"))
		end
	end)
	-- 8.3 : sans Meneur, la tablette va au premier joueur du groupe
	task.spawn(function()
		local _, players = services.PartyLoaderService:WaitUntilLoaded()
		task.wait(PlayerConfig.Technical.Tick * 2)
		local hasLeader = false
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("role") == "Leader" then
				hasLeader = true
			end
		end
		local first = players[1] or Players:GetPlayers()[1]
		if not hasLeader and first then
			services.InventoryService:Add(first, "ITM_TabletField", 1)
		end
	end)
	task.spawn(function()
		local elapsed = 0
		local step = PlayerConfig.Technical.Tick
		while true do
			task.wait(step)
			tick(step)
			elapsed += step
			if elapsed >= Tablet.GpsInterval then
				elapsed = 0
				for _, player in Players:GetPlayers() do
					updateGps(player)
				end
			end
		end
	end)
end

return TabletService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/WeaponService (Partie)
-- Sections 8.2 et 16.3 : validation des tirs (origine à moins de 5 studs de la tête, cadence,
-- munitions), dégâts sur la créature (corps / tête), tir allié en Difficile et Cauchemar,
-- rechargement balle par balle interruptible, mêlée.
-- Créatures : modèles tagués « Creature » ; un coup est signalé par CreatureHit (l'IA applique les PV).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local ActConfig = require(Config:WaitForChild("ActConfig"))
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local WeaponConfig = require(Config:WaitForChild("WeaponConfig"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NoiseTypes = require(Shared:WaitForChild("NoiseTypes"))
local RateLimiter = require(Shared:WaitForChild("RateLimiter"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local WeaponService = {}

-- (creatureModel, damage, shooter, weaponId, isHead, hitPart) ; extra = { blind, flee, grabRelease }
WeaponService.CreatureHit = Signal.new()
WeaponService.Fired = Signal.new() -- (player, weaponId, origin)

local services = nil
local lastShot = {} -- [Player] = os.clock()
local reloading = {} -- [Player] = thread

-- DÉFAUT : portée maximale d'un rayon de tir (la diagonale de la carte)
local MAX_RANGE = WeaponConfig.Weapons.WPN_Rifle.noise

local function heldWeapon(player)
	local entry = services.InventoryService:Selected(player)
	if entry and WeaponConfig.Weapons[entry.id] then
		return entry, WeaponConfig.Weapons[entry.id]
	end
	return nil
end

local function creatureFrom(part)
	local node = part
	while node and node ~= workspace do
		if CollectionService:HasTag(node, "Creature") then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function playerFrom(part)
	local model = part:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

local function friendlyFireOn()
	local info = services.PartyLoaderService:GetMatchInfo()
	return ActConfig.difficulty(info.difficulty).friendlyFire
end

local function cast(shooter, origin, direction, range)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { shooter.Character }
	return workspace:Raycast(origin, direction.Unit * range, params)
end

local function applyHit(shooter, weaponId, weapon, result, creatureDamage, friendlyDamage)
	if result == nil then
		return
	end
	local creature = creatureFrom(result.Instance)
	if creature then
		local isHead = result.Instance.Name == "Head"
		local damage = creatureDamage
		if weapon.damageHead and isHead then
			damage = weapon.damageHead
		end
		WeaponService.CreatureHit:Fire(creature, damage, shooter, weaponId, isHead, result.Instance, {
			blind = weapon.blindDuration,
			flee = weapon.creatureFleeDuration,
			grabReleaseHits = weapon.grabReleaseHits,
		})
		return
	end
	local victim = playerFrom(result.Instance)
	if victim and victim ~= shooter and friendlyFireOn() then
		-- 8.2 : tir allié (torse)
		services.HealthService:Damage(victim, "Torso", friendlyDamage, shooter)
	end
end

local function cancelReload(player)
	local thread = reloading[player]
	if thread then
		task.cancel(thread)
		reloading[player] = nil
		player:SetAttribute("isReloading", false)
	end
end

local function publishAmmo(player)
	local entry, weapon = heldWeapon(player)
	if entry and weapon.ammo then
		player:SetAttribute("ammo", entry.ammo or 0)
		player:SetAttribute("ammoReserve", services.InventoryService:Count(player, "AMMO_" .. entry.id))
	else
		player:SetAttribute("ammo", nil)
		player:SetAttribute("ammoReserve", nil)
	end
end

local function onFire(player, origin, direction, _timestamp)
	if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" or direction.Magnitude < 0.01 then
		return
	end
	if not services.HealthService:IsUp(player) or player:GetAttribute("heavyHands") then
		return
	end
	local head = player.Character and player.Character:FindFirstChild("Head")
	local entry, weapon = heldWeapon(player)
	if head == nil or entry == nil then
		return
	end
	-- 16.3 : origine à moins de 5 studs de la tête
	if (origin - head.Position).Magnitude > WeaponConfig.MaxOriginOffset then
		return
	end
	-- 7.7 : l'Opératrice ne peut pas porter d'arme à feu
	if not weapon.melee and player:GetAttribute("role") == WeaponConfig.NoFirearmRole then
		return
	end
	-- cadence
	local interval = weapon.fireInterval or weapon.reloadTime or 0
	if os.clock() - (lastShot[player] or -math.huge) < interval then
		return
	end
	if weapon.ammo and (entry.ammo or 0) <= 0 then
		return -- 8.2 : tir impossible sans munitions
	end
	cancelReload(player) -- le rechargement est interruptible
	lastShot[player] = os.clock()

	if weapon.melee then
		local result = cast(player, origin, direction, WeaponConfig.MeleeRange)
		applyHit(player, entry.id, weapon, result, weapon.damage, weapon.friendlyDamage)
		services.NoiseService:Emit(head.Position, weapon.noise, NoiseTypes.Melee, player)
		return
	end

	entry.ammo -= 1
	services.NoiseService:Emit(head.Position, weapon.noise, NoiseTypes.Gunshot, player)
	WeaponService.Fired:Fire(player, entry.id, origin)
	if weapon.pellets then
		for _ = 1, weapon.pellets do
			local spread = math.rad(weapon.spreadDegrees or 0)
			local dir = (CFrame.lookAt(Vector3.zero, direction) * CFrame.Angles(
				(math.random() - 0.5) * spread,
				(math.random() - 0.5) * spread,
				0
			)).LookVector
			local result = cast(player, origin, dir, MAX_RANGE)
			if result then
				local distance = (result.Position - origin).Magnitude
				-- 8.2 : plein dégât jusqu'à 15 studs, −70 % à 40 studs (linéaire entre les deux, PROVISOIRE)
				local factor = 1
				if distance > weapon.fullDamageRange then
					local t = math.clamp(
						(distance - weapon.fullDamageRange) / (weapon.reducedRange - weapon.fullDamageRange),
						0,
						1
					)
					factor = 1 - (1 - weapon.reducedFactor) * t
				end
				applyHit(player, entry.id, weapon, result, weapon.damagePerPellet * factor, weapon.friendlyPerPellet)
			end
		end
	else
		local result = cast(player, origin, direction, MAX_RANGE)
		applyHit(
			player,
			entry.id,
			weapon,
			result,
			weapon.damageBody or weapon.damage,
			weapon.friendlyTorso or weapon.friendlyDamage
		)
	end
	publishAmmo(player)
end

-- 8.2 : rechargement manuel balle par balle, interruptible ; bras < 30 % : ×1,5 plus lent (7.3)
local function onReload(player)
	local entry, weapon = heldWeapon(player)
	if entry == nil or not weapon.ammo or reloading[player] then
		return
	end
	local ammoId = "AMMO_" .. entry.id
	if services.InventoryService:Count(player, ammoId) <= 0 then
		return -- 16.3 : réserve > 0
	end
	local perRound = weapon.reloadPerRound or weapon.reloadTime
	if services.HealthService:IsLow(player, "ArmL") or services.HealthService:IsLow(player, "ArmR") then
		perRound *= PlayerConfig.LowArmReloadFactor
	end
	player:SetAttribute("isReloading", true)
	reloading[player] = task.spawn(function()
		while (entry.ammo or 0) < weapon.ammo and services.InventoryService:Count(player, ammoId) > 0 do
			task.wait(perRound)
			local current = heldWeapon(player)
			if current ~= entry or not services.InventoryService:Remove(player, ammoId, 1) then
				break
			end
			entry.ammo += 1
			publishAmmo(player)
		end
		reloading[player] = nil
		player:SetAttribute("isReloading", false)
	end)
end

function WeaponService:Init(allServices)
	services = allServices
end

function WeaponService:Start()
	local fire = Util.getRemote("RE_FireWeapon")
	if fire then
		RateLimiter.connect(fire, onFire)
	end
	local reload = Util.getRemote("RE_Reload")
	if reload then
		RateLimiter.connect(reload, onReload)
	end
	services.InventoryService.Changed:Connect(function(player)
		local entry = heldWeapon(player)
		if reloading[player] and entry == nil then
			cancelReload(player)
		end
		publishAmmo(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastShot[player] = nil
		cancelReload(player)
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">WeatherService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/WeatherService (Partie)
-- Sections 12.3 et 12.4 : météo tirée à chaque partie (sauf vote « fixe »), passage en pluie
-- (ou neige au-dessus de Y = 350) pendant l'acte 2, vent global et rafales.
-- État : MatchState.weather (Clear, Fog, Rain, Snow).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local AmbienceConfig = require(Config:WaitForChild("AmbienceConfig"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local WeatherService = {}

local services = nil
local current = nil
local random = nil

local function draw()
	local roll = random:NextNumber()
	local sum = 0
	for _, id in AmbienceConfig.WeatherOrder do
		sum += AmbienceConfig.Weathers[id].probability
		if roll <= sum then
			return id
		end
	end
	return AmbienceConfig.WeatherOrder[#AmbienceConfig.WeatherOrder]
end

local function apply(id)
	current = id
	Util.getMatchState():SetAttribute("weather", id)
	local wind = AmbienceConfig.Wind[id]
	workspace.GlobalWind = Vector3.new(table.unpack(wind.base))
end

function WeatherService:Get()
	return current
end

function WeatherService:Entry()
	return AmbienceConfig.Weathers[current]
end

-- 12.3 : pendant l'acte 2, nuit claire ou brouillard → pluie ; neige au-dessus de 350 (la cabane)
function WeatherService:SiegeChange()
	local rule = AmbienceConfig.SiegeWeather
	if rule.from[current] then
		local cabin = require(Config:WaitForChild("MapConfig")).Places.P05c
		apply(if cabin.pos.Y > rule.snowAboveY then rule.toAbove else rule.to)
	end
end

-- 12.4 : rafales (ajoutées au vent de base dans sa direction)
local function gustLoop()
	while true do
		local wind = AmbienceConfig.Wind[current]
		if wind == nil or (wind.gust or 0) <= 0 or wind.gustIntervalMin == nil then
			task.wait(AmbienceConfig.Wind.Clear.gustIntervalMin)
		else
			task.wait(random:NextNumber(wind.gustIntervalMin, wind.gustIntervalMax))
			local base = Vector3.new(table.unpack(wind.base))
			workspace.GlobalWind = base + base.Unit * wind.gust
			task.wait(AmbienceConfig.GustDuration)
			workspace.GlobalWind = base
		end
	end
end

function WeatherService:Begin(info)
	random = Random.new(info.seed)
	local chosen = info.weather
	if chosen == nil or chosen == "Random" or AmbienceConfig.Weathers[chosen] == nil then
		chosen = draw()
	end
	apply(chosen)
	print("WeatherService : météo " .. chosen)
	task.spawn(gustLoop)
end

function WeatherService:Init(allServices)
	services = allServices
end

function WeatherService:Start()
	local _ = services
end

return WeatherService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- ServerScriptService/Services/DataService (les deux places)
-- Section 16.2 et 16.4 : DataStore PisteFroide_v1, clé player_<UserId>,
-- verrouillage de session, sauvegarde toutes les 120 s et à la fermeture.
-- Le verrou est rangé dans les métadonnées de la clé : la valeur garde exactement le format de 16.4.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local PlayerConfig = require(Config:WaitForChild("PlayerConfig"))
local ProgressionConfig = require(Config:WaitForChild("ProgressionConfig"))
local Signal = require(Shared:WaitForChild("Signal"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

-- (player, data) : données chargées et prêtes
DataService.Loaded = Signal.new()

local store = nil -- nil si les API DataStore sont inaccessibles (Studio sans accès)
local sessions = {} -- [Player] = { data = table, released = bool }

local function keyFor(userId)
	return ProgressionConfig.KeyPrefix .. tostring(userId)
end

-- données par défaut d'un nouveau joueur (16.4)
local function buildDefaultData()
	local endings = {}
	for _, endingId in ProgressionConfig.EndingIds do
		endings[endingId] = false
	end

	local skins = {}
	local equipped = {}
	for _, role in PlayerConfig.Roles do
		-- un rôle sans identifiant n'a pas de clé de données
		if role.id ~= nil then
			local owned = {}
			for _, skinId in ProgressionConfig.SkinIds do
				owned[skinId] = skinId == ProgressionConfig.DefaultSkin
			end
			skins[role.id] = owned
			equipped[role.id] = ProgressionConfig.DefaultSkin
		end
	end

	local museumRead = {}
	for _, panelId in ProgressionConfig.MuseumPanelIds do
		museumRead[panelId] = false
	end

	return {
		version = ProgressionConfig.DataVersion,
		xp = 0,
		plays = 0,
		survivals = 0,
		endings = endings,
		evidence = {},
		skins = skins,
		equipped = equipped,
		notebookPages = Util.deepCopy(ProgressionConfig.DefaultNotebookPages),
		museumRead = museumRead,
		nightmareUnlocked = false,
		-- TODO(J15): valeurs par défaut des réglages de la section 17.2 (Défaut PC / mobile)
		settings = {},
	}
end

-- vrai si une autre session (autre serveur) tient un verrou encore frais
local function isLockedByOther(metadata)
	if metadata == nil or metadata.lockJobId == nil then
		return false
	end
	if metadata.lockJobId == game.JobId then
		return false
	end
	local age = os.time() - (metadata.lockTime or 0)
	return age < ProgressionConfig.SessionLock.StaleAfter
end

local function lockMetadata()
	return { lockJobId = game.JobId, lockTime = os.time() }
end

-- une tentative : prend le verrou et lit les données.
-- Renvoie "ok" + données, ou "locked" si une autre session tient le verrou.
local function tryAcquire(userId)
	local status = "ok"
	local loaded = nil
	store:UpdateAsync(keyFor(userId), function(current, keyInfo)
		local metadata = keyInfo and keyInfo:GetMetadata() or nil
		if isLockedByOther(metadata) then
			status = "locked"
			return nil -- annule l'écriture
		end
		status = "ok"
		loaded = current or buildDefaultData()
		return loaded, { userId }, lockMetadata()
	end)
	return status, loaded
end

-- écrit les données ; `release` libère le verrou (départ du joueur, fermeture)
local function writeSession(player, session, release)
	if store == nil then
		return
	end
	local userId = player.UserId
	local stolen = false
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(userId), function(_current, keyInfo)
			local metadata = keyInfo and keyInfo:GetMetadata() or nil
			if isLockedByOther(metadata) then
				stolen = true
				return nil -- une autre session a repris la clé : ne pas l'écraser
			end
			stolen = false
			local newMetadata = if release then {} else lockMetadata()
			return session.data, { userId }, newMetadata
		end)
	end)
	if not ok then
		warn(("DataService : échec de sauvegarde pour %d : %s"):format(userId, tostring(err)))
	elseif stolen then
		warn(("DataService : verrou repris par une autre session pour %d, sauvegarde annulée"):format(userId))
	end
end

-- DÉFAUT : quelques compteurs publiés en attributs pour l'interface (lecture seule côté client)
local PUBLISHED = { "xp", "plays", "survivals", "nightmareUnlocked" }
local function publishAttributes(player, data)
	for _, key in PUBLISHED do
		player:SetAttribute(key, data[key])
	end
end

local function onPlayerAdded(player)
	if sessions[player] ~= nil then
		return
	end

	if store == nil then
		-- Studio sans accès aux API : données par défaut, jamais sauvegardées
		sessions[player] = { data = buildDefaultData(), released = true }
		player:SetAttribute("dataLoaded", true)
		DataService.Loaded:Fire(player, sessions[player].data)
		return
	end

	local lock = ProgressionConfig.SessionLock
	for attempt = 1, lock.LoadAttempts do
		if player.Parent == nil then
			return -- le joueur est parti pendant le chargement
		end
		local ok, status, data = pcall(tryAcquire, player.UserId)
		if ok and status == "ok" then
			local session = { data = Util.reconcile(data, buildDefaultData()), released = false }
			if player.Parent == nil then
				-- parti entre-temps : on rend le verrou tout de suite
				writeSession(player, session, true)
				return
			end
			sessions[player] = session
			publishAttributes(player, session.data)
			player:SetAttribute("dataLoaded", true)
			DataService.Loaded:Fire(player, session.data)
			return
		end
		if not ok then
			warn(
				("DataService : échec de chargement pour %d (essai %d) : %s"):format(
					player.UserId,
					attempt,
					tostring(status)
				)
			)
		end
		if attempt < lock.LoadAttempts then
			task.wait(lock.LoadRetryDelay)
		end
	end

	-- 4.6 : le joueur joue sans données, rien n'est sauvegardé pour lui (MSG_DataLoadFailed)
	warn(
		("DataService : données indisponibles pour %d, aucune sauvegarde pendant cette session"):format(player.UserId)
	)
	Util.notify(player, "MSG_DataLoadFailed")
	player:SetAttribute("dataLoaded", false)
end

local function releaseSession(player)
	local session = sessions[player]
	if session == nil then
		return
	end
	sessions[player] = nil
	if session.released then
		return
	end
	session.released = true
	writeSession(player, session, true)
end

-- données du joueur, ou nil si pas (encore) chargées
function DataService:GetData(player)
	local session = sessions[player]
	return session and session.data or nil
end

function DataService:IsLoaded(player)
	return sessions[player] ~= nil
end

-- attend les données du joueur ; nil si le joueur part ou si le chargement échoue
function DataService:WaitForData(player)
	while player.Parent ~= nil and sessions[player] == nil and player:GetAttribute("dataLoaded") ~= false do
		task.wait()
	end
	return self:GetData(player)
end

-- sauvegarde immédiate en gardant le verrou
function DataService:Save(player)
	local session = sessions[player]
	if session ~= nil and not session.released then
		publishAttributes(player, session.data)
		writeSession(player, session, false)
	end
end

function DataService:Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(ProgressionConfig.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn(
			"DataService : DataStore inaccessible (en Studio : activer l'accès aux API). Données non sauvegardées. "
				.. tostring(result)
		)
	end
end

function DataService:Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(releaseSession)

	-- sauvegarde périodique (16.2 : toutes les 120 s)
	task.spawn(function()
		while true do
			task.wait(ProgressionConfig.AutosaveInterval)
			for player in table.clone(sessions) do
				task.spawn(DataService.Save, DataService, player)
			end
		end
	end)

	-- sauvegarde à la fermeture du serveur
	game:BindToClose(function()
		local pending = 0
		for player in table.clone(sessions) do
			pending += 1
			task.spawn(function()
				releaseSession(player)
				pending -= 1
			end)
		end
		while pending > 0 do
			task.wait()
		end
	end)
end

return DataService
]]></string>
